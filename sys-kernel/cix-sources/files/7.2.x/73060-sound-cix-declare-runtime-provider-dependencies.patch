sound: cix: declare runtime provider dependencies

Select the Sky1 audio clock, reset and DMA providers required by the
HDA, I2S and HiFi5 consumers. Add module soft dependencies so a direct
modprobe loads those providers before the consuming driver.

diff --git a/drivers/remoteproc/Kconfig b/drivers/remoteproc/Kconfig
--- a/drivers/remoteproc/Kconfig
+++ b/drivers/remoteproc/Kconfig
@@ -52,12 +52,14 @@ config CIX_DSP_RPROC
 	depends on ARCH_CIX || COMPILE_TEST
 	depends on ACPI || OF
 	depends on CIX_HIFI5_FIRMWARE_XAF
+	select CLK_SKY1_AUDSS if ARCH_CIX
 	select CIX_MBOX
 	select CIX_HIFI5_COMMON if ARCH_CIX
 	select DMABUF_HEAPS
 	select DMABUF_HEAPS_CIX_DSP if ARCH_CIX
 	select MAILBOX
 	select MFD_SYSCON
+	select RESET_SKY1_AUDSS if ARCH_CIX
 	select RPMSG_VIRTIO
 	help
 	  Say y or m here to control the HiFi5 audio DSP in CIX Sky1
diff --git a/drivers/remoteproc/cix_dsp_rproc.c b/drivers/remoteproc/cix_dsp_rproc.c
--- a/drivers/remoteproc/cix_dsp_rproc.c
+++ b/drivers/remoteproc/cix_dsp_rproc.c
@@ -807,5 +807,6 @@ static struct platform_driver cix_dsp_driver = {
 };
 module_platform_driver(cix_dsp_driver);
 
+MODULE_SOFTDEP("pre: cix_mailbox clk_sky1_audss reset_sky1_audss");
 MODULE_DESCRIPTION("CIX Sky1 HiFi5 remote processor driver");
 MODULE_LICENSE("GPL");
diff --git a/sound/hda/controllers/Kconfig b/sound/hda/controllers/Kconfig
--- a/sound/hda/controllers/Kconfig
+++ b/sound/hda/controllers/Kconfig
@@ -33,6 +33,8 @@ config SND_HDA_TEGRA
 config SND_HDA_CIX_IPBLOQ
 	tristate "CIX IPBLOQ HD Audio"
 	depends on ARCH_CIX || COMPILE_TEST
+	select CLK_SKY1_AUDSS if ARCH_CIX
+	select RESET_SKY1_AUDSS if ARCH_CIX
 	select SND_HDA
 	select SND_HDA_ALIGNED_MMIO
 	imply GPIO_CADENCE
diff --git a/sound/hda/controllers/cix-ipbloq.c b/sound/hda/controllers/cix-ipbloq.c
--- a/sound/hda/controllers/cix-ipbloq.c
