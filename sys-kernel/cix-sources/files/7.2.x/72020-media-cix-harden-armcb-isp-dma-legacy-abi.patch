 	depends on I2C
+	depends on PM && RESET_CONTROLLER && COMMON_CLK
 	depends on ACPI || OF
 	depends on ARCH_CIX || COMPILE_TEST
 	select DMA_SHARED_BUFFER
@@ -49,4 +50,7 @@ config VIDEO_CIX_ARMCB_ISP_KUNIT_TEST
 	depends on VIDEO_CIX_ARMCB_ISP
 	default KUNIT_ALL_TESTS
 	help
-	  Build focused tests for the CIX ISP frame-completion state machine.
+	  Build focused KUnit tests for the CIX ISP frame-completion state
+	  machine. These tests exercise buffer-state transitions without
+	  requiring camera hardware and are intended for development and
+	  regression testing rather than production kernels.
