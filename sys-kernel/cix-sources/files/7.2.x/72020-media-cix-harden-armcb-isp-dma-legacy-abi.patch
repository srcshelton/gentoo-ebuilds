+static void armcb_subdev_lifetime_release(struct kref *refcount)
+{
+	struct armcb_sd_subdev *subdev =
+		container_of(refcount, struct armcb_sd_subdev, refcount);
+
+	/* The V4L2 core still touches sd after ->release() returns. */
+	kvfree_call_rcu(&subdev->rcu, subdev->allocation);
+}
+
+void armcb_subdev_lifetime_init(struct armcb_sd_subdev *subdev,
+				void *allocation)
+{
+	if (WARN_ON_ONCE(!subdev || !allocation))
+		return;
+
+	kref_init(&subdev->refcount);
+	subdev->allocation = allocation;
+	subdev->ref_initialized = true;
+}
+
+bool armcb_subdev_get(struct armcb_sd_subdev *subdev)
+{
+	return subdev && subdev->ref_initialized &&
+	       kref_get_unless_zero(&subdev->refcount);
+}
+
+void armcb_subdev_put(struct armcb_sd_subdev *subdev)
+{
+	if (WARN_ON_ONCE(!subdev || !subdev->ref_initialized))
+		return;
+	kref_put(&subdev->refcount, armcb_subdev_lifetime_release);
+}
