+void armcb_subdev_unregister_all(struct armcb_v4l2_dev *dev)
+{
+	struct armcb_sd_subdev *subdev;
+	struct v4l2_device *owner;
+	bool async_registered;
+
+	if (!dev)
+		return;
+
+	mutex_lock(&armcb_subdev_state_lock);
+	for (;;) {
+		mutex_lock(&dev->ordered_sd_mutex);
+		if (list_empty(&dev->ordered_sd_list)) {
+			mutex_unlock(&dev->ordered_sd_mutex);
+			break;
+		}
+
+		subdev = list_first_entry(&dev->ordered_sd_list,
+					  struct armcb_sd_subdev, list);
+		list_del_init(&subdev->list);
+		subdev->ordered = false;
+		subdev->ordered_lock = NULL;
+		owner = subdev->owner_v4l2_dev;
+		WARN_ON_ONCE(owner != &dev->v4l2_dev);
+		subdev->owner_v4l2_dev = NULL;
+		async_registered = subdev->async_registered;
+		subdev->async_registered = false;
+		mutex_unlock(&dev->ordered_sd_mutex);
+
+		if (async_registered)
+			v4l2_async_unregister_subdev(&subdev->sd);
+		if (owner)
+			v4l2_device_put(owner);
+	}
+	mutex_unlock(&armcb_subdev_state_lock);
+}
