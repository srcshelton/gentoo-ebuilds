+static int armcb_ahb_read_checked(u32 addr, u32 *value)
+{
+#ifdef ARMCB_CAM_AHB
+	if (addr >= AHB_CSIRCSU0_REG_BASE && addr <= AHB_CSIRCSU0_REG_END)
+		return cix_ahb_csircsu_read_reg(addr, value);
+	if (addr >= AHB_CSI0_REG_BASE && addr <= AHB_CSI1_REG_END)
+		return cix_ahb_csi_read_reg(addr, value);
+	if (addr >= AHB_DPHY0_REG_BASE && addr <= AHB_DPHY0_REG_END)
+		return cix_ahb_dphy_read_reg(addr, value);
+	if (addr >= AHB_CSIDMA0_REG_BASE && addr <= AHB_CSIDMA1_REG_END)
+		return cix_ahb_csidma_read_reg(addr, value);
+	if (addr >= AHB_CSIRCSU1_REG_BASE && addr <= AHB_CSIRCSU1_REG_END)
+		return cix_ahb_csircsu_read_reg(addr, value);
+	if (addr >= AHB_CSI2_REG_BASE && addr <= AHB_CSI3_REG_END)
+		return cix_ahb_csi_read_reg(addr, value);
+	if (addr >= AHB_DPHY1_REG_BASE && addr <= AHB_DPHY1_REG_END)
+		return cix_ahb_dphy_read_reg(addr, value);
+	if (addr >= AHB_CSIDMA2_REG_BASE && addr <= AHB_CSIDMA3_REG_END)
+		return cix_ahb_csidma_read_reg(addr, value);
+	if (addr >= AHB_PMCTRL_RES_REG_BASE &&
+	    addr <= AHB_PMCTRL_RES_REG_END)
+		return armcb_ahb_pmctrl_res_read_reg(
+			addr - AHB_PMCTRL_RES_REG_BASE, value);
+	if (addr >= ISP_GDC_REG_BASE)
+		return armcb_isp_reg_read(addr - ISP_GDC_REG_BASE, true, value);
