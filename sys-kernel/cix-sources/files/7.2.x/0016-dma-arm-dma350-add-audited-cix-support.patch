+static int d350_stop_channel(struct d350_chan *dch)
+{
+	u32 status;
+	int ret;
+
+	writel(CH_CMD_STOP, dch->base + CH_CMD);
+	ret = readl_poll_timeout_atomic(dch->base + CH_STATUS, status,
+					status & (CH_STAT_STOPPED |
+						  CH_STAT_DISABLED),
+					1, 1000);
+	if (!ret)
+		return 0;
+
+	/* A disabled channel cannot fetch another linked command. */
+	writel(CH_CMD_DISABLE, dch->base + CH_CMD);
+	return readl_poll_timeout_atomic(dch->base + CH_STATUS, status,
+					 status & CH_STAT_DISABLED, 1, 1000);
+}
