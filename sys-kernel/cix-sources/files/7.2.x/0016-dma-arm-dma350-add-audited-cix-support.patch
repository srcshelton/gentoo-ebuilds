+static struct regmap *d350_get_remote_ctrl(struct device *dev)
+{
+	struct fwnode_handle *fw;
+	struct device *syscon_dev;
+	struct regmap *regmap;
+
+	if (!device_property_present(dev, "arm,remote-ctrl"))
+		return NULL;
+
+	if (dev->of_node)
+		return syscon_regmap_lookup_by_phandle(dev->of_node,
+						 "arm,remote-ctrl");
+
+	fw = fwnode_find_reference(dev_fwnode(dev), "arm,remote-ctrl", 0);
+	if (IS_ERR(fw))
+		return ERR_CAST(fw);
+
+	syscon_dev = bus_find_device_by_fwnode(&platform_bus_type, fw);
+	fwnode_handle_put(fw);
+	if (!syscon_dev)
+		return ERR_PTR(-EPROBE_DEFER);
+
+	regmap = dev_get_regmap(syscon_dev, NULL);
+	put_device(syscon_dev);
+
+	return regmap ?: ERR_PTR(-EPROBE_DEFER);
+}
