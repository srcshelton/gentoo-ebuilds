+/*
+ * Slave DMA support
+ */
+static int d350_slave_params(struct d350_chan *dch,
+			     enum dma_transfer_direction dir,
+			     dma_addr_t *dev_addr, u8 *transize)
+{
+	struct d350 *dmac = to_d350(dch->vc.chan.device);
+	enum dma_slave_buswidth width;
+	phys_addr_t addr;
+	u32 widths;
+
+	if (!dch->initialized || !dch->has_trig ||
+	    dch->req_line >= dmac->nreq ||
+	    !FIELD_FIT(CH_TRIGINCFG_SEL, dch->req_line))
+		return -EINVAL;
+
+	if (dir == DMA_MEM_TO_DEV) {
+		addr = dch->slave_cfg.dst_addr;
+		width = dch->slave_cfg.dst_addr_width;
+		widths = dmac->dma.dst_addr_widths;
+	} else if (dir == DMA_DEV_TO_MEM) {
+		addr = dch->slave_cfg.src_addr;
+		width = dch->slave_cfg.src_addr_width;
+		widths = dmac->dma.src_addr_widths;
+	} else {
+		return -EINVAL;
+	}
+
+	if (!width || !is_power_of_2(width) || width > BIT(dch->tsz) ||
+	    !(widths & BIT(width)) || !IS_ALIGNED(addr, width))
+		return -EINVAL;
+
+	*transize = __ffs(width);
+	return d350_translate_reg_range(dmac, addr, width, dev_addr);
+}
+
+static int d350_device_config(struct dma_chan *chan,
+			      struct dma_slave_config *config)
+{
+	struct d350_chan *dch = to_d350_chan(chan);
+
+	memcpy(&dch->slave_cfg, config, sizeof(*config));
+	return 0;
+}
+
+static struct dma_chan *
+d350_get_slave_channel(struct d350 *dmac, int channel_id)
+{
+	struct d350_chan *dch;
+	struct dma_chan *chan;
+
+	if (channel_id >= 0 && channel_id != 0xff) {
+		if (channel_id >= dmac->nchan)
+			return NULL;
+		dch = &dmac->channels[channel_id];
+		if (!dch->initialized || !dch->has_trig)
+			return NULL;
+		return dma_get_slave_channel(&dch->vc.chan);
+	}
+
+	for (int i = 0; i < dmac->nchan; i++) {
+		dch = &dmac->channels[i];
+		if (!dch->initialized || !dch->has_trig)
+			continue;
+		chan = dma_get_slave_channel(&dch->vc.chan);
+		if (chan)
+			return chan;
+	}
+
+	return NULL;
+}
+
+static bool d350_request_valid(struct d350 *dmac, int request)
+{
+	return request >= 0 && request < dmac->nreq &&
+	       FIELD_FIT(CH_TRIGINCFG_SEL, request);
+}
+
+static struct dma_chan *d350_of_xlate(struct of_phandle_args *dma_spec,
+				      struct of_dma *ofdma)
+{
+	struct d350 *dmac = ofdma->of_dma_data;
+	struct dma_chan *chan;
+	struct d350_chan *dch;
+	u32 request;
+
+	if (dma_spec->args_count != 1)
+		return NULL;
+
+	request = dma_spec->args[0];
+	if (!d350_request_valid(dmac, request))
+		return NULL;
+
+	/* The binding's single cell is a trigger, not a channel number. */
+	chan = d350_get_slave_channel(dmac, -1);
+
+	if (!chan)
+		return NULL;
+
+	dch = to_d350_chan(chan);
+	dch->req_line = request;
+
+	return chan;
+}
