+/*
+ * Deployed CIX firmware predates a standard ACPI _DMA description and
+ * publishes the AUDSS memory-bus offset as an arm,ram-map base pair.  Install
+ * that offset in the DMA API once: DMAengine clients map scatterlists with
+ * this device, and every dma_addr_t passed back to this driver is already a
+ * device-visible address.  Never translate those handles a second time.
+ */
+static int d350_configure_dma_range(struct device *dev, u64 addr_mask)
+{
+	struct d350_dma_range *owned;
+	u32 ram_map[2];
+	u64 span;
+	int count, ret;
+
+	if (!device_property_present(dev, "arm,ram-map")) {
+		if (dev->dma_range_map) {
+			dev_dbg(dev, "Using standard firmware DMA range\n");
+			return 0;
+		}
+
+		if (d350_requires_dma_range(dev))
+			return dev_err_probe(dev, -EINVAL,
+					     "Missing DMA memory address translation\n");
+
+		return 0;
+	}
+
+	count = device_property_count_u32(dev, "arm,ram-map");
+	if (count != (int)ARRAY_SIZE(ram_map))
+		return dev_err_probe(dev, -EINVAL,
+				     "arm,ram-map needs two cells\n");
+
+	ret = device_property_read_u32_array(dev, "arm,ram-map", ram_map,
+					     ARRAY_SIZE(ram_map));
+	if (ret)
+		return dev_err_probe(dev, ret, "Invalid arm,ram-map\n");
+
+	if (ram_map[0] < ram_map[1] || ram_map[1] > addr_mask)
+		return dev_err_probe(dev, -ERANGE,
+				     "arm,ram-map is outside the DMA address space\n");
+
+	if (dev->dma_range_map) {
+		if (!d350_dma_range_matches(dev, ram_map[0], ram_map[1]))
+			return dev_err_probe(dev, -EINVAL,
+					     "arm,ram-map conflicts with the DMA API range\n");
+		dev_dbg(dev, "Using firmware DMA range matching %#x -> %#x\n",
+			ram_map[0], ram_map[1]);
+		return 0;
+	}
+
+	span = min(addr_mask - ram_map[1], U64_MAX - ram_map[0]);
+	if (span == U64_MAX)
+		return dev_err_probe(dev, -EOVERFLOW,
+				     "arm,ram-map range is not representable\n");
+	span++;
+
+	owned = devm_kzalloc(dev, sizeof(*owned), GFP_KERNEL);
+	if (!owned)
+		return -ENOMEM;
+	owned->dev = dev;
+	owned->regions[0].cpu_start = ram_map[0];
+	owned->regions[0].dma_start = ram_map[1];
+	owned->regions[0].size = span;
+	dev->dma_range_map = owned->regions;
+	ret = devm_add_action_or_reset(dev, d350_release_dma_range, owned);
+	if (ret)
+		return ret;
+
+	dev_dbg(dev, "DMA range: %#x -> %#x, size %#llx\n",
+		ram_map[0], ram_map[1], span);
+	return 0;
+}
