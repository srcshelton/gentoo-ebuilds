+/* A full linked command occupies 15 words; pad each entry to 64 bytes. */
+#define CMDLINK_WORDS_PER_ENTRY		16
+#define CMDLINK_ENTRY_SIZE		(CMDLINK_WORDS_PER_ENTRY * sizeof(u32))
+
+static int d350_build_slave_command(struct d350 *dmac,
+				    struct d350_chan *dch, u32 *cmd,
+				    dma_addr_t mem_dma, dma_addr_t dev_addr,
+				    size_t len, u8 transize,
+				    enum dma_transfer_direction dir,
+				    bool clear, bool complete,
+				    dma_addr_t next_cmd)
+{
+	dma_addr_t src_addr, dst_addr;
+	u32 header, ctrl, xaddrinc, trigincfg;
+	u32 srctranscfg, destranscfg, xsize;
+	int idx = 0, ret;
+
+	ret = d350_validate_dma_range(dmac, mem_dma, len);
+	if (ret)
+		return ret;
+
+	if (dir == DMA_MEM_TO_DEV) {
+		src_addr = mem_dma;
+		dst_addr = dev_addr;
+		xaddrinc = FIELD_PREP(CH_XY_SRC, 1);
+		srctranscfg = dch->coherent ? TRANSCFG_WB : TRANSCFG_NC;
+		destranscfg = TRANSCFG_DEVICE;
+	} else {
+		src_addr = dev_addr;
+		dst_addr = mem_dma;
+		xaddrinc = FIELD_PREP(CH_XY_DES, 1);
+		srctranscfg = TRANSCFG_DEVICE;
+		destranscfg = dch->coherent ? TRANSCFG_WB : TRANSCFG_NC;
+	}
+
+	xsize = len >> transize;
+	header = LINK_INTREN | LINK_CTRL | LINK_SRCADDR | LINK_SRCADDRHI |
+		 LINK_DESADDR | LINK_DESADDRHI | LINK_XSIZE | LINK_XSIZEHI |
+		 LINK_SRCTRANSCFG | LINK_DESTRANSCFG | LINK_XADDRINC |
+		 LINK_LINKADDR | LINK_LINKADDRHI;
+	if (clear)
+		header |= LINK_REGCLEAR;
+	if (dir == DMA_MEM_TO_DEV)
+		header |= LINK_DESTRIGINCFG;
+	else
+		header |= LINK_SRCTRIGINCFG;
+
+	ctrl = FIELD_PREP(CH_CTRL_TRANSIZE, transize) |
+	       FIELD_PREP(CH_CTRL_XTYPE, CH_CTRL_XTYPE_CONTINUE) |
+	       FIELD_PREP(CH_CTRL_DONETYPE, complete ? CH_CTRL_DONETYPE_CMD :
+							 CH_CTRL_DONETYPE_NONE);
+	ctrl |= dir == DMA_MEM_TO_DEV ? CH_CTRL_USEDESTRIGIN :
+					       CH_CTRL_USESRCTRIGIN;
+	trigincfg = d350_build_trigincfg(dch);
+
+	cmd[idx++] = header;
+	cmd[idx++] = CH_INTREN_ERR | (complete ? CH_INTREN_DONE : 0);
+	cmd[idx++] = ctrl;
+	cmd[idx++] = lower_32_bits(src_addr);
+	cmd[idx++] = upper_32_bits(src_addr);
+	cmd[idx++] = lower_32_bits(dst_addr);
+	cmd[idx++] = upper_32_bits(dst_addr);
+	cmd[idx++] = FIELD_PREP(CH_XY_SRC, lower_16_bits(xsize)) |
+		     FIELD_PREP(CH_XY_DES, lower_16_bits(xsize));
+	cmd[idx++] = FIELD_PREP(CH_XY_SRC, upper_16_bits(xsize)) |
+		     FIELD_PREP(CH_XY_DES, upper_16_bits(xsize));
+	cmd[idx++] = srctranscfg;
+	cmd[idx++] = destranscfg;
+	cmd[idx++] = xaddrinc;
+	cmd[idx++] = trigincfg;
+	cmd[idx++] = next_cmd ? lower_32_bits(next_cmd) | CH_LINKADDR_EN : 0;
+	cmd[idx++] = next_cmd ? upper_32_bits(next_cmd) : 0;
+
+	return WARN_ON_ONCE(idx > CMDLINK_WORDS_PER_ENTRY) ? -EOVERFLOW : 0;
+}
