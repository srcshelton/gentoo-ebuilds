+
+static int d350_validate_dma_range(struct d350 *dmac, dma_addr_t addr,
+				   size_t len)
+{
+	u64 end;
+
+	if (!len)
+		return -EINVAL;
+	if (check_add_overflow((u64)addr, (u64)len - 1, &end) ||
+	    end > dmac->addr_mask)
+		return -ERANGE;
+
+	return 0;
+}
+
+/* Translate a CPU-visible peripheral register into the DMA-350 view. */
+static int d350_translate_reg_range(struct d350 *dmac, phys_addr_t addr,
+				    size_t len, dma_addr_t *translated)
+{
+	u64 result, end;
+
+	if (!len)
+		return -EINVAL;
+
+	if (dmac->addr_xlat.reg_cpu) {
+		if (addr < dmac->addr_xlat.reg_cpu ||
+		    check_add_overflow(dmac->addr_xlat.reg_dma,
+				       (u64)addr - dmac->addr_xlat.reg_cpu,
+				       &result))
+			return -ERANGE;
+	} else {
+		result = addr;
+	}
+
+	if (check_add_overflow(result, (u64)len - 1, &end) ||
+	    end > dmac->addr_mask)
+		return -ERANGE;
+
+	*translated = result;
+	return 0;
+}
+
+static bool d350_dma_range_matches(struct device *dev, u64 cpu_base,
+				   u64 dma_base)
+{
+	const struct bus_dma_region *range = dev->dma_range_map;
+	u64 offset = cpu_base - dma_base;
+
+	if (!range || !range->size)
+		return false;
+
+	for (; range->size; range++) {
+		if (range->cpu_start < range->dma_start ||
+		    range->cpu_start - range->dma_start != offset)
+			return false;
+	}
+
+	return true;
+}
+
+static void d350_release_dma_range(void *data)
+{
+	struct d350_dma_range *owned = data;
+
+	if (owned->dev->dma_range_map == owned->regions)
+		owned->dev->dma_range_map = NULL;
+}
+
+static bool d350_requires_dma_range(struct device *dev)
+{
+#ifdef CONFIG_ACPI
+	struct acpi_device *adev = ACPI_COMPANION(dev);
+
+	return adev && acpi_dev_hid_match(adev, "CIXH1006");
+#else
+	(void)dev;
+	return false;
+#endif
+}
