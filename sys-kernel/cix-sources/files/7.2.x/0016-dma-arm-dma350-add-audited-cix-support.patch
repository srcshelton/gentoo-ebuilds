+static struct dma_async_tx_descriptor *
+d350_prep_slave_sg(struct dma_chan *chan, struct scatterlist *sgl,
+		   unsigned int sg_len, enum dma_transfer_direction dir,
+		   unsigned long flags, void *context)
+{
+	struct d350_chan *dch = to_d350_chan(chan);
+	struct d350 *dmac = to_d350(chan->device);
+	struct device *dev = chan->device->dev;
+	struct d350_desc *desc;
+	struct scatterlist *sg;
+	dma_addr_t dev_addr, next_cmd;
+	size_t cmdlink_size, total_len = 0;
+	u32 *cmd;
+	u8 transize;
+	unsigned int i, width;
+	int ret;
+
+	if (!sgl || !sg_len ||
+	    (dir != DMA_MEM_TO_DEV && dir != DMA_DEV_TO_MEM))
+		return NULL;
+
+	ret = d350_slave_params(dch, dir, &dev_addr, &transize);
+	if (ret)
+		return NULL;
+	width = BIT(transize);
+
+	desc = kzalloc_obj(*desc, GFP_NOWAIT);
+	if (!desc)
+		return NULL;
+
+	desc->scatter_gather = true;
+	desc->sg_len = sg_len;
+	desc->dir = dir;
+	desc->tsz = transize;
+
+	cmdlink_size = size_mul(sg_len, CMDLINK_ENTRY_SIZE);
+	if (cmdlink_size == SIZE_MAX)
+		goto err_free_desc;
+
+	desc->cmdlink_virt = dma_alloc_coherent(dev, cmdlink_size,
+						&desc->cmdlink_dma, GFP_NOWAIT);
+	if (!desc->cmdlink_virt)
+		goto err_free_desc;
+	desc->cmdlink_size = cmdlink_size;
+	memset(desc->cmdlink_virt, 0, cmdlink_size);
+
+	ret = d350_validate_dma_range(dmac, desc->cmdlink_dma, cmdlink_size);
+	if (ret || !IS_ALIGNED(desc->cmdlink_dma, CMDLINK_ENTRY_SIZE))
+		goto err_free_cmdlink;
+
+	for_each_sg(sgl, sg, sg_len, i) {
+		dma_addr_t mem_addr = sg_dma_address(sg);
+		size_t len = sg_dma_len(sg);
+		bool last_entry = (i == sg_len - 1);
+
+		if (!len || !IS_ALIGNED(mem_addr, width) ||
+		    !IS_ALIGNED(len, width) || (len >> transize) > U32_MAX ||
+		    check_add_overflow(total_len, len, &total_len) ||
+		    total_len > U32_MAX)
+			goto err_free_cmdlink;
+
+		next_cmd = last_entry ? 0 :
+			desc->cmdlink_dma + (i + 1) * CMDLINK_ENTRY_SIZE;
+		cmd = &desc->cmdlink_virt[i * CMDLINK_WORDS_PER_ENTRY];
+		ret = d350_build_slave_command(dmac, dch, cmd, mem_addr,
+					       dev_addr, len, transize, dir,
+					       i == 0, last_entry, next_cmd);
+		if (ret)
+			goto err_free_cmdlink;
+	}
+
+	desc->total_len = total_len;
+	return vchan_tx_prep(&dch->vc, &desc->vd, flags);
+
+err_free_cmdlink:
+	dma_free_coherent(dev, desc->cmdlink_size, desc->cmdlink_virt,
+			  desc->cmdlink_dma);
+err_free_desc:
+	kfree(desc);
+	return NULL;
+}
+
+static struct dma_async_tx_descriptor *
+d350_prep_dma_cyclic(struct dma_chan *chan, dma_addr_t buf_addr,
+		     size_t buf_len, size_t period_len,
+		     enum dma_transfer_direction dir, unsigned long flags)
+{
+	struct d350_chan *dch = to_d350_chan(chan);
+	struct d350 *dmac = to_d350(chan->device);
+	struct device *dev = chan->device->dev;
+	struct d350_desc *desc;
+	size_t num_periods, cmdlink_size;
+	dma_addr_t dev_addr, next_cmd;
+	u32 *cmd;
+	u8 transize;
+	unsigned int width;
+	size_t i, offset;
+	int ret;
+
+	if (dir != DMA_MEM_TO_DEV && dir != DMA_DEV_TO_MEM)
+		return NULL;
+
+	ret = d350_slave_params(dch, dir, &dev_addr, &transize);
+	if (ret)
+		return NULL;
+	width = BIT(transize);
+
+	if (!buf_len || !period_len || buf_len > U32_MAX ||
+	    buf_len % period_len || !IS_ALIGNED(buf_addr, width) ||
+	    !IS_ALIGNED(period_len, width) ||
+	    (period_len >> transize) > U32_MAX ||
+	    d350_validate_dma_range(dmac, buf_addr, buf_len))
+		return NULL;
+	num_periods = buf_len / period_len;
+
+	desc = kzalloc_obj(*desc, GFP_NOWAIT);
+	if (!desc)
+		return NULL;
+
+	desc->cyclic = true;
+	desc->num_periods = num_periods;
+	desc->period_len = period_len;
+	desc->dir = dir;
+	desc->tsz = transize;
+	desc->total_len = buf_len;
+
+	cmdlink_size = size_mul(num_periods, CMDLINK_ENTRY_SIZE);
+	if (cmdlink_size == SIZE_MAX)
+		goto err_free_desc;
+
+	desc->cmdlink_virt = dma_alloc_coherent(dev, cmdlink_size,
+						&desc->cmdlink_dma, GFP_NOWAIT);
+	if (!desc->cmdlink_virt)
+		goto err_free_desc;
+	desc->cmdlink_size = cmdlink_size;
+	memset(desc->cmdlink_virt, 0, cmdlink_size);
+
+	ret = d350_validate_dma_range(dmac, desc->cmdlink_dma, cmdlink_size);
+	if (ret || !IS_ALIGNED(desc->cmdlink_dma, CMDLINK_ENTRY_SIZE))
+		goto err_free_cmdlink;
+
+	for (i = 0; i < num_periods; i++) {
+		offset = i * period_len;
+		next_cmd = i == num_periods - 1 ? desc->cmdlink_dma :
+			desc->cmdlink_dma + (i + 1) * CMDLINK_ENTRY_SIZE;
+		cmd = &desc->cmdlink_virt[i * CMDLINK_WORDS_PER_ENTRY];
+		ret = d350_build_slave_command(dmac, dch, cmd,
+					       buf_addr + offset, dev_addr,
+					       period_len, transize, dir,
+					       i == 0, true, next_cmd);
+		if (ret)
+			goto err_free_cmdlink;
+	}
+
+	return vchan_tx_prep(&dch->vc, &desc->vd, flags);
+
+err_free_cmdlink:
+	dma_free_coherent(dev, desc->cmdlink_size, desc->cmdlink_virt,
+			  desc->cmdlink_dma);
+err_free_desc:
+	kfree(desc);
+	return NULL;
+}
