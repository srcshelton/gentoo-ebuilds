+static u32 d350_build_trigincfg(struct d350_chan *dch)
+{
+	u32 mode = dch->slave_cfg.device_fc ? TRIGIN_MODE_PERIPH_FLOW :
+						 TRIGIN_MODE_DMA_FLOW;
+
+	return FIELD_PREP(CH_TRIGINCFG_SEL, dch->req_line) |
+	       FIELD_PREP(CH_TRIGINCFG_TYPE, TRIGIN_TYPE_HW) |
+	       FIELD_PREP(CH_TRIGINCFG_MODE, mode);
+}
