+static int __maybe_unused d350_runtime_suspend(struct device *dev)
+{
+	struct d350 *dmac = dev_get_drvdata(dev);
+	int ret;
+
+	if (!dmac)
+		return 0;
+
+	if (dmac->rst) {
+		ret = reset_control_assert(dmac->rst);
+		if (ret)
+			return ret;
+	}
+
+	clk_disable_unprepare(dmac->clk);
+	return 0;
+}
+
+static int __maybe_unused d350_runtime_resume(struct device *dev)
+{
+	struct d350 *dmac = dev_get_drvdata(dev);
+	int ret;
+
+	if (!dmac)
+		return 0;
+
+	ret = clk_prepare_enable(dmac->clk);
+	if (ret)
+		return ret;
+
+	if (dmac->rst) {
+		ret = reset_control_deassert(dmac->rst);
+		if (ret) {
+			clk_disable_unprepare(dmac->clk);
+			return ret;
+		}
+		usleep_range(10, 20);
+	}
+
+	return 0;
 }
 
