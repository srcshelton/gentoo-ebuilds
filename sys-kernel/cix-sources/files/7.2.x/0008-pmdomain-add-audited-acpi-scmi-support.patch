+/**
+ * genpd_add_fwnode_provider_onecell() - Register a fwnode-based PM domain provider
+ * @fwnode: Firmware node to associate with this provider
+ * @data: Onecell data with domain array indexed by domain specifier
+ *
+ * Registers a fwnode-based PM domain provider for ACPI platforms where
+ * consumers reference power domains via _DSD properties rather than DT
+ * phandles.  Consumers call fwnode_property_get_reference_args() on their
+ * "power-domains" property and the resulting fwnode + args[0] index are
+ * used to look up the provider and select the domain.
+ *
+ * Performance domains must obtain their OPP table from firmware rather than
+ * from a device-tree OPP table.
+ *
+ * Returns 0 on success, negative errno on failure.
+ */
+int genpd_add_fwnode_provider_onecell(struct fwnode_handle *fwnode,
+				      struct genpd_onecell_data *data)
+{
+	struct fwnode_genpd_provider *existing, *p;
+	struct generic_pm_domain *genpd;
+	unsigned int i;
+	int ret = -EINVAL;
+
+	if (!fwnode || !data || !data->domains || !data->num_domains)
+		return -EINVAL;
+
+	if (!genpd_bus_registered)
+		return -ENODEV;
+
+	p = kzalloc_obj(*p);
+	if (!p)
+		return -ENOMEM;
+
+	p->fwnode = fwnode_handle_get(fwnode);
+	if (!p->fwnode) {
+		kfree(p);
+		return -EINVAL;
+	}
+	p->data = data;
+
+	for (i = 0; i < data->num_domains; i++) {
+		genpd = data->domains[i];
+		if (!genpd)
+			continue;
+		if (!genpd_present(genpd))
+			goto err_domains;
+		if (genpd->set_performance_state &&
+		    !genpd_is_opp_table_fw(genpd)) {
+			ret = -EOPNOTSUPP;
+			goto err_domains;
+		}
+
+		genpd->dev.parent = genpd_provider_bus;
+		ret = device_add(&genpd->dev);
+		if (ret)
+			goto err_domains;
+
+		genpd->provider = p->fwnode;
+		genpd->has_provider = true;
+	}
+
+	mutex_lock(&genpd_provider_mutex);
+	list_for_each_entry(existing, &fwnode_genpd_providers, link) {
+		if (genpd_fwnode_matches(existing->fwnode, fwnode)) {
+			ret = -EEXIST;
+			goto err_unlock;
+		}
+	}
+	list_add(&p->link, &fwnode_genpd_providers);
+	fwnode_dev_initialized(fwnode, true);
+	mutex_unlock(&genpd_provider_mutex);
+
+	pr_debug("Added fwnode domain provider %pfwf\n", fwnode);
+
+	return 0;
+
+err_unlock:
+	mutex_unlock(&genpd_provider_mutex);
+err_domains:
+	while (i--) {
+		genpd = data->domains[i];
+		if (!genpd)
+			continue;
+		genpd->provider = NULL;
+		genpd->has_provider = false;
+		device_del(&genpd->dev);
+	}
+	fwnode_handle_put(p->fwnode);
+	kfree(p);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(genpd_add_fwnode_provider_onecell);
+
+/**
+ * genpd_del_fwnode_provider() - Remove a fwnode-based PM domain provider
+ * @fwnode: The firmware node whose provider to remove
+ */
+void genpd_del_fwnode_provider(struct fwnode_handle *fwnode)
+{
+	struct fwnode_genpd_provider *p, *tmp;
+	struct generic_pm_domain *genpd;
+
+	mutex_lock(&gpd_list_lock);
+	mutex_lock(&genpd_provider_mutex);
+	list_for_each_entry_safe(p, tmp, &fwnode_genpd_providers, link) {
+		if (genpd_fwnode_matches(p->fwnode, fwnode)) {
+			list_for_each_entry(genpd, &gpd_list, gpd_list_node) {
+				if (!genpd_fwnode_matches(genpd->provider,
+							  p->fwnode))
+					continue;
+				genpd->has_provider = false;
+				device_del(&genpd->dev);
+			}
+
+			fwnode_dev_initialized(p->fwnode, false);
+			list_del(&p->link);
+			fwnode_handle_put(p->fwnode);
+			kfree(p);
+			break;
+		}
+	}
+	mutex_unlock(&genpd_provider_mutex);
+	mutex_unlock(&gpd_list_lock);
+}
+EXPORT_SYMBOL_GPL(genpd_del_fwnode_provider);
+
+static bool genpd_fwnode_matches(struct fwnode_handle *provider,
+				 struct fwnode_handle *consumer)
+{
+	if (provider == consumer)
+		return true;
+
+#ifdef CONFIG_ACPI
+	if (is_acpi_device_node(provider) && is_acpi_device_node(consumer))
+		return to_acpi_device_node(provider)->handle ==
+		       to_acpi_device_node(consumer)->handle;
+#endif
+
+	return false;
+}
