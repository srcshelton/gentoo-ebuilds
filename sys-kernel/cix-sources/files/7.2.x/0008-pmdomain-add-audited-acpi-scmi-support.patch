+static int genpd_get_acpi_power_domain_args(struct device *dev,
+					    unsigned int index,
+					    struct fwnode_reference_args *args)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(dev);
+
+	if (!is_acpi_device_node(fwnode))
+		return -ENOENT;
+
+	/*
+	 * ACPI consumers encode onecell references as Package () { REF, INT }.
+	 * Unlike DT providers, their referenced nodes need not carry a separate
+	 * #power-domain-cells property.
+	 */
+	return fwnode_property_get_reference_args(fwnode, "power-domains", NULL,
+						 1, index, args);
+}
+
+static int genpd_count_acpi_power_domains(struct device *dev)
+{
+	struct fwnode_reference_args args = {};
+	int count = 0;
+	int ret;
+
+	for (;;) {
+		ret = genpd_get_acpi_power_domain_args(dev, count, &args);
+		if (ret == -ENOENT)
+			return count;
+		if (ret)
+			return ret;
+
+		fwnode_handle_put(args.fwnode);
+		count++;
+	}
+}
