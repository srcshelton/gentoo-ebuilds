+static bool armcb_optional_resource_missing(int ret)
+{
+	return ret == -ENODEV || ret == -ENOENT || ret == -EINVAL;
+}
+
+static int armcb_imgsens_get_resources(struct armcb_imgsens_subdev *sensor)
+{
+	struct armcb_camera_inst *inst = &sensor->imgs_inst;
+	struct device *dev = sensor->pdev;
+	int ret;
+
+	inst->pinctrl = devm_pinctrl_get(dev);
+	if (IS_ERR(inst->pinctrl)) {
+		ret = PTR_ERR(inst->pinctrl);
+		inst->pinctrl = NULL;
+		if (!armcb_optional_resource_missing(ret))
+			return dev_err_probe(dev, ret, "failed to get pinctrl\n");
+	} else {
+		inst->pins_default = pinctrl_lookup_state(inst->pinctrl,
+							  PINCTRL_STATE_DEFAULT);
+		if (IS_ERR(inst->pins_default)) {
+			ret = PTR_ERR(inst->pins_default);
+			inst->pins_default = NULL;
+			if (!armcb_optional_resource_missing(ret))
+				return dev_err_probe(dev, ret,
+						     "failed to get default pin state\n");
+		}
+
+		inst->pins_sleep = pinctrl_lookup_state(inst->pinctrl,
+							PINCTRL_STATE_SLEEP);
+		if (IS_ERR(inst->pins_sleep)) {
+			ret = PTR_ERR(inst->pins_sleep);
+			inst->pins_sleep = NULL;
+			if (!armcb_optional_resource_missing(ret))
+				return dev_err_probe(dev, ret,
+						     "failed to get sleep pin state\n");
+		}
+
+		if (inst->pins_default) {
+			ret = pinctrl_select_state(inst->pinctrl,
+						   inst->pins_default);
+			if (ret)
+				return dev_err_probe(dev, ret,
+						     "failed to select default pin state\n");
+		}
+	}
+
+	inst->pwn_gpio = devm_gpiod_get_optional(dev, "pwdn", GPIOD_OUT_LOW);
+	if (IS_ERR(inst->pwn_gpio))
+		return dev_err_probe(dev, PTR_ERR(inst->pwn_gpio),
+				     "failed to get pwdn GPIO\n");
+
+	inst->rst_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(inst->rst_gpio))
+		return dev_err_probe(dev, PTR_ERR(inst->rst_gpio),
+				     "failed to get reset GPIO\n");
+
+	sensor->vsupply_0 = devm_regulator_get_optional(dev, "power0");
+	if (IS_ERR(sensor->vsupply_0)) {
+		ret = PTR_ERR(sensor->vsupply_0);
+		sensor->vsupply_0 = NULL;
+		if (ret != -ENODEV)
+			return dev_err_probe(dev, ret, "failed to get power0\n");
+	}
+
+	sensor->vsupply_1 = devm_regulator_get_optional(dev, "power1");
+	if (IS_ERR(sensor->vsupply_1)) {
+		ret = PTR_ERR(sensor->vsupply_1);
+		sensor->vsupply_1 = NULL;
+		if (ret != -ENODEV)
+			return dev_err_probe(dev, ret, "failed to get power1\n");
+	}
+
+	if (is_acpi_device_node(dev_fwnode(dev)))
+		inst->mclk = devm_clk_get_optional(
+			&to_acpi_device_node(dev_fwnode(dev))->dev, "mclk");
+	else
+		inst->mclk = devm_clk_get_optional(dev, "mclk");
+	if (IS_ERR(inst->mclk))
+		return dev_err_probe(dev, PTR_ERR(inst->mclk),
+				     "failed to get mclk\n");
+
+	return 0;
+}
