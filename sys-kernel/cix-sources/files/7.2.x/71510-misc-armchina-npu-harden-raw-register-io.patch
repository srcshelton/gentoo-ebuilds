diff --git a/drivers/misc/armchina-npu/aipu_io.c b/drivers/misc/armchina-npu/aipu_io.c
--- a/drivers/misc/armchina-npu/aipu_io.c
+++ b/drivers/misc/armchina-npu/aipu_io.c
@@ -54,17 +54,24 @@ void deinit_aipu_ioregion(struct io_region *region)
  * @offset: AIPU register offset
  * Return: u32 value in the register or error code
  */
-int aipu_read32(struct io_region *region, int offset)
+bool aipu_ioregion_valid32(const struct io_region *region, u32 offset)
+{
+	return region && region->kern && region->size >= sizeof(u32) &&
+	       !(offset & (sizeof(u32) - 1)) &&
+	       offset <= region->size - sizeof(u32);
+}
+
+int aipu_read32(struct io_region *region, u32 offset)
 {
 	u32 val = 0;
 
-	if (region && region->kern && offset < region->size) {
-		val = readl((void __iomem *)((unsigned long)(region->kern) + offset));
-		pr_debug("[Read AIPU Register]: reg addr: 0x%llx + 0x%x, read back value: 0x%x\n",
-			 region->phys, offset, val);
-		return val;
-	}
-	return -EINVAL;
+	if (!aipu_ioregion_valid32(region, offset))
+		return -EINVAL;
+
+	val = readl((u8 __iomem *)region->kern + offset);
+	pr_debug("[Read AIPU Register]: reg addr: 0x%llx + 0x%x, read back value: 0x%x\n",
+		 region->phys, offset, val);
+	return val;
 }
 
 /**
@@ -73,10 +80,13 @@ int aipu_read32(struct io_region *region, int offset)
  * @offset: AIPU register offset
  * @data:   u32 data to be writen
  */
-void aipu_write32(struct io_region *region, int offset, unsigned int data)
+int aipu_write32(struct io_region *region, u32 offset, u32 data)
 {
-	if (region && region->kern && offset < region->size)
-		writel((u32)data, (void __iomem *)((unsigned long)(region->kern) + offset));
+	if (!aipu_ioregion_valid32(region, offset))
+		return -EINVAL;
+
+	writel(data, (u8 __iomem *)region->kern + offset);
 	pr_debug("[Write AIPU Register]: reg addr: 0x%llx + 0x%x, write value: 0x%x\n",
-		 region->phys, offset, (u32)data);
+		 region->phys, offset, data);
+	return 0;
 }
