+# SPDX-License-Identifier: GPL-2.0-only
+menu "CIX SoC drivers"
+
+config CIX_SKY1_SYSCON
+	bool "CIX Sky1 ACPI syscon support"
+	depends on ACPI
+	depends on ARCH_CIX || COMPILE_TEST
+	select MFD_SYSCON
+	help
+	  Register the CIXHA018 register block as a syscon provider for Sky1
+	  devices described by ACPI firmware. Other CIX platform drivers use
+	  this provider for shared reset and clock-control registers. Enable
+	  this on ACPI-based Sky1 systems.
+
+endmenu
