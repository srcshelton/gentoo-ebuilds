+
+#define INFO_HIFI0				0x00
+#define INFO_CLK_GATE				0x10
+#define INFO_CLK_DIV				0x14
+#define INFO_CLK_MUX				0x18
+#define INFO_MCLK				0x70
+
+#define SKY1_AUDSS_CLK_PARENTS_CNT		4
+#define SKY1_AUDSS_NUM_CLKS			(CLK_MCLK4 + 1)
+#define SKY1_AUDSS_INFO_GATE_COUNT		17
+
+#define SKY1_AUDSS_HIFI5_DIV_NAME		"audss_hifi5_div"
+#define SKY1_AUDSS_HIFI5_DIV2_NAME		"audss_hifi5_div2"
+#define SKY1_AUDSS_HIFI5_DIV4_NAME		"audss_hifi5_div4"
+
+static const unsigned int sky1_reg_save[] = {
+	INFO_CLK_DIV,
+	INFO_CLK_MUX,
+	INFO_HIFI0,
+	INFO_CLK_GATE,
+	INFO_MCLK,
+};
+
+static const char * const sky1_audss_clk_names[SKY1_AUDSS_CLK_PARENTS_CNT] = {
+	"x8k", "x11k", "sys", "48m",
+};
+
+static const u32 sky1_clk_rate_default[SKY1_AUDSS_CLK_PARENTS_CNT] = {
+	294912000,
+	270950400,
+	800000000,
+	48000000,
+};
+
+/*
+ * ACPI CLKT entries identify the four SCMI inputs as audio_clk0, audio_clk2,
+ * audio_clk4 and audio_clk5. DT labels the same inputs x8k, x11k, sys and 48m
+ * through clock-names. Keep their common hardware-name mapping explicit so
+ * child clocks can hold direct parent references instead of relying on a
+ * process-global clock-name lookup.
+ */
+static const char * const sky1_audss_root_clk_names[SKY1_AUDSS_CLK_PARENTS_CNT] = {
+	"audio_clk0", "audio_clk2", "audio_clk4", "audio_clk5",
+};
+
