+struct sky1_audss_clka_publication {
+	struct sky1_audss_clka_map *maps;
+	unsigned int published;
+};
+
+static void sky1_audss_drop_clka(void *data)
+{
+	struct sky1_audss_clka_publication *publication = data;
+
+	while (publication->published > 0) {
+		publication->published--;
+		clkdev_drop(publication->maps[publication->published].lookup);
+	}
+}
+
+static int sky1_audss_copy_acpi_string(char *dst, size_t dst_len,
+				       union acpi_object *object)
+{
+	size_t len;
+
+	if (object->type != ACPI_TYPE_STRING || !object->string.pointer)
+		return -EINVAL;
+
+	len = object->string.length;
+	if (len >= dst_len || strnlen(object->string.pointer, len + 1) != len)
+		return -EOVERFLOW;
+
+	memcpy(dst, object->string.pointer, len);
+	dst[len] = '\0';
+	return 0;
+}
+
+static int sky1_audss_parse_clka(struct device *dev,
+				 struct clk_hw_onecell_data *clk_data)
+{
+	struct sky1_audss_clka_publication *publication;
+	struct sky1_audss_clka_map *maps;
+	acpi_handle handle = ACPI_HANDLE(dev);
+	struct acpi_buffer output = { ACPI_ALLOCATE_BUFFER, NULL };
+	union acpi_object *object;
+	acpi_status status;
+	unsigned int count, i, j;
+	int ret = 0;
+
+	status = acpi_evaluate_object_typed(handle, "CLKA", NULL, &output,
+					    ACPI_TYPE_PACKAGE);
+	if (ACPI_FAILURE(status))
+		return -EIO;
+
+	object = output.pointer;
+	count = object->package.count;
+	if (!count) {
+		ret = -EINVAL;
+		goto out_free_output;
+	}
+
+	maps = devm_kcalloc(dev, count, sizeof(*maps), GFP_KERNEL);
+	if (!maps) {
+		ret = -ENOMEM;
+		goto out_free_output;
+	}
+
+	/* Validate the whole table before making any lookup visible. */
+	for (i = 0; i < count; i++) {
+		struct acpi_device *consumer;
+		union acpi_object *elements;
+		union acpi_object *entry = &object->package.elements[i];
+		u64 clk_id;
+
+		if (entry->type != ACPI_TYPE_PACKAGE ||
+		    entry->package.count != 3) {
+			ret = -EINVAL;
+			goto out_free_output;
+		}
+
+		elements = entry->package.elements;
+		if (elements[0].type != ACPI_TYPE_INTEGER ||
+		    elements[0].integer.value > UINT_MAX ||
+		    elements[2].type != ACPI_TYPE_LOCAL_REFERENCE) {
+			ret = -EINVAL;
+			goto out_free_output;
+		}
+
+		clk_id = elements[0].integer.value;
+		if (clk_id >= clk_data->num || !clk_data->hws[clk_id] ||
+		    IS_ERR(clk_data->hws[clk_id])) {
+			ret = -EINVAL;
+			goto out_free_output;
+		}
+
+		consumer = acpi_fetch_acpi_dev(elements[2].reference.handle);
+		if (!consumer) {
+			ret = -ENODEV;
+			goto out_free_output;
+		}
+
+		ret = strscpy(maps[i].dev_id, acpi_dev_name(consumer),
+			      sizeof(maps[i].dev_id));
+		if (ret < 0) {
+			ret = -EOVERFLOW;
+			goto out_free_output;
+		}
+
+		ret = sky1_audss_copy_acpi_string(maps[i].con_id,
+						  sizeof(maps[i].con_id),
+						  &elements[1]);
+		if (ret)
+			goto out_free_output;
+		maps[i].has_con_id = maps[i].con_id[0] != '\0';
+		maps[i].hw = clk_data->hws[clk_id];
+
+		for (j = 0; j < i; j++) {
+			if (!strcmp(maps[j].dev_id, maps[i].dev_id) &&
+			    maps[j].has_con_id == maps[i].has_con_id &&
+			    (!maps[i].has_con_id ||
+			     !strcmp(maps[j].con_id, maps[i].con_id))) {
+				ret = -EEXIST;
+				goto out_free_output;
+			}
+		}
+	}
+
+	/* Allocate every lookup before entering the no-fail publish phase. */
+	for (i = 0; i < count; i++) {
+		maps[i].lookup = kzalloc_obj(*maps[i].lookup, GFP_KERNEL);
+		if (!maps[i].lookup) {
+			ret = -ENOMEM;
+			goto out_free_lookups;
+		}
+
+		maps[i].lookup->clk_hw = maps[i].hw;
+		maps[i].lookup->dev_id = maps[i].dev_id;
+		if (maps[i].has_con_id)
+			maps[i].lookup->con_id = maps[i].con_id;
+	}
+
+	publication = devm_kzalloc(dev, sizeof(*publication), GFP_KERNEL);
+	if (!publication) {
+		ret = -ENOMEM;
+		goto out_free_lookups;
+	}
+	publication->maps = maps;
+
+	ret = devm_add_action_or_reset(dev, sky1_audss_drop_clka, publication);
+	if (ret)
+		goto out_free_lookups;
+
+	for (i = 0; i < count; i++) {
+		clkdev_add(maps[i].lookup);
+		publication->published++;
+	}
+
+	dev_info(dev, "published %u ACPI AUDSS clock lookup entries\n", count);
+	goto out_free_output;
+
+out_free_lookups:
+	while (i > 0) {
+		i--;
+		kfree(maps[i].lookup);
+	}
+
+out_free_output:
+	kfree(output.pointer);
+	return ret;
+}
