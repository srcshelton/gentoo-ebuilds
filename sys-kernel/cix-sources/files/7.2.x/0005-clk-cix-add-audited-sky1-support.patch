diff --git a/drivers/clk/cix/clk-sky1-acpi.c b/drivers/clk/cix/clk-sky1-acpi.c
new file mode 100644
--- /dev/null
+++ b/drivers/clk/cix/clk-sky1-acpi.c
@@ -0,0 +1,282 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * CIX Sky1 ACPI clock lookup table (CLKT) driver
+ *
+ * The vendor DSDT describes SCMI clock consumers with packages of the form:
+ *
+ *   Package (3) { scmi_clock_id, connection_name, consumer_reference }
+ *
+ * Parse the complete namespace before publishing any clkdev lookup.  This
+ * prevents malformed firmware or a deferred SCMI provider from leaving a
+ * partially visible clock map whose lookup order depends on probe history.
+ */
+
+#include <linux/acpi.h>
+#include <linux/clk/scmi.h>
+#include <linux/clkdev.h>
+#include <linux/limits.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+
+/* Keep these in sync with the audited clkdev allocation limits. */
+#define SKY1_CLKDEV_DEV_ID_LEN	24
+#define SKY1_CLKDEV_CON_ID_LEN	32
+
+struct sky1_clk_map {
+	struct clk_hw *hw;
+	struct clk_lookup *lookup;
+	char dev_id[SKY1_CLKDEV_DEV_ID_LEN];
+	char con_id[SKY1_CLKDEV_CON_ID_LEN];
+};
+
+struct sky1_acpi_clk {
+	struct device *dev;
+	struct fwnode_handle *provider_fwnode;
+	struct sky1_clk_map *maps;
+	unsigned int map_count;
+	unsigned int published;
+	int error;
+};
+
+static void sky1_drop_clkt(void *data)
+{
+	struct sky1_acpi_clk *priv = data;
+
+	while (priv->published > 0) {
+		priv->published--;
+		clkdev_drop(priv->maps[priv->published].lookup);
+	}
+}
+
+static int sky1_copy_acpi_string(char *dst, size_t dst_len,
+				 const union acpi_object *object)
+{
+	size_t len;
+
+	if (object->type != ACPI_TYPE_STRING || !object->string.pointer)
+		return -EINVAL;
+
+	len = object->string.length;
+	if (len >= dst_len || strnlen(object->string.pointer, len + 1) != len)
+		return -EOVERFLOW;
+
+	memcpy(dst, object->string.pointer, len);
+	dst[len] = '\0';
+	return 0;
+}
+
+static int sky1_collect_clkt_entry(struct sky1_acpi_clk *priv,
+				   const union acpi_object *entry)
+{
+	struct sky1_clk_map *maps, *map;
+	struct acpi_device *consumer;
+	const union acpi_object *elements;
+	unsigned int clock_id;
+	unsigned int i;
+	int ret;
+
+	if (entry->type != ACPI_TYPE_PACKAGE || entry->package.count != 3)
+		return -EINVAL;
+
+	elements = entry->package.elements;
+	if (elements[0].type != ACPI_TYPE_INTEGER ||
+	    elements[0].integer.value > UINT_MAX ||
+	    elements[2].type != ACPI_TYPE_LOCAL_REFERENCE)
+		return -EINVAL;
+
+	consumer = acpi_fetch_acpi_dev(elements[2].reference.handle);
+	if (!consumer)
+		return -ENODEV;
+
+	maps = devm_krealloc_array(priv->dev, priv->maps,
+				   priv->map_count + 1, sizeof(*maps), GFP_KERNEL);
+	if (!maps)
+		return -ENOMEM;
+	priv->maps = maps;
+	map = &maps[priv->map_count];
+	memset(map, 0, sizeof(*map));
+
+	ret = strscpy(map->dev_id, acpi_dev_name(consumer),
+		      sizeof(map->dev_id));
+	if (ret < 0)
+		return -EOVERFLOW;
+
+	ret = sky1_copy_acpi_string(map->con_id, sizeof(map->con_id),
+				    &elements[1]);
+	if (ret)
+		return ret;
+	for (i = 0; i < priv->map_count; i++) {
+		if (!strcmp(maps[i].dev_id, map->dev_id) &&
+		    !strcmp(maps[i].con_id, map->con_id))
+			return -EEXIST;
+	}
+
+	clock_id = elements[0].integer.value;
+	map->hw = scmi_clk_acpi_get_hw(priv->dev, priv->provider_fwnode,
+				       clock_id);
+	if (IS_ERR(map->hw))
+		return PTR_ERR(map->hw);
+
+	priv->map_count++;
+	return 0;
+}
+
+static int sky1_collect_clkt(struct sky1_acpi_clk *priv,
+			     acpi_handle handle,
+			     const union acpi_object *object)
+{
+	unsigned int i;
+	int ret;
+
+	if (!object || object->type != ACPI_TYPE_PACKAGE) {
+		acpi_handle_err(handle, "CLKT is not a package\n");
+		return -EINVAL;
+	}
+
+	for (i = 0; i < object->package.count; i++) {
+		ret = sky1_collect_clkt_entry(priv, &object->package.elements[i]);
+		if (ret) {
+			if (ret != -EPROBE_DEFER)
+				acpi_handle_err(handle,
+						"invalid CLKT entry %u: %pe\n",
+						i, ERR_PTR(ret));
+			return ret;
+		}
+	}
+
+	return 0;
+}
+
+static acpi_status sky1_clkt_walk_cb(acpi_handle handle, u32 level,
+				     void *context, void **return_value)
+{
+	struct sky1_acpi_clk *priv = context;
+	struct acpi_buffer buffer = { ACPI_ALLOCATE_BUFFER, NULL };
+	acpi_handle clkt;
+	acpi_status status;
+
+	status = acpi_get_handle(handle, "CLKT", &clkt);
+	if (status == AE_NOT_FOUND)
+		return AE_OK;
+	if (ACPI_FAILURE(status)) {
+		priv->error = -EIO;
+		return AE_CTRL_TERMINATE;
+	}
+
+	status = acpi_evaluate_object(clkt, NULL, NULL, &buffer);
+	if (ACPI_FAILURE(status)) {
+		priv->error = -EIO;
+		return AE_CTRL_TERMINATE;
+	}
+
+	priv->error = sky1_collect_clkt(priv, handle, buffer.pointer);
+	kfree(buffer.pointer);
+
+	return priv->error ? AE_CTRL_TERMINATE : AE_OK;
+}
+
+static int sky1_publish_clkt(struct sky1_acpi_clk *priv)
+{
+	unsigned int i;
+	int ret;
+
+	/* Allocate the whole map before entering the no-fail publish phase. */
+	for (i = 0; i < priv->map_count; i++) {
+		struct sky1_clk_map *map = &priv->maps[i];
+
+		map->lookup = kzalloc_obj(*map->lookup, GFP_KERNEL);
+		if (!map->lookup) {
+			ret = -ENOMEM;
+			goto free_unpublished;
+		}
+
+		map->lookup->clk_hw = map->hw;
+		map->lookup->dev_id = map->dev_id;
+		if (map->con_id[0])
+			map->lookup->con_id = map->con_id;
+	}
+
+	ret = devm_add_action_or_reset(priv->dev, sky1_drop_clkt, priv);
+	if (ret)
+		goto free_unpublished;
+
+	for (i = 0; i < priv->map_count; i++) {
+		clkdev_add(priv->maps[i].lookup);
+		priv->published++;
+	}
+
+	return 0;
+
+free_unpublished:
+	while (i > 0) {
+		i--;
+		kfree(priv->maps[i].lookup);
+	}
+	return ret;
+}
+
+static int sky1_acpi_clk_probe(struct platform_device *pdev)
+{
+	struct acpi_device *parent;
+	struct acpi_device *provider;
+	struct sky1_acpi_clk *priv;
+	acpi_status status;
+	int ret;
+
+	priv = devm_kzalloc(&pdev->dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+	priv->dev = &pdev->dev;
+	provider = acpi_dev_get_first_match_dev("CIXHA009", NULL, -1);
+	if (!provider)
+		return dev_err_probe(&pdev->dev, -EPROBE_DEFER,
+				     "SCMI clock provider is not available\n");
+	parent = acpi_dev_parent(provider);
+	if (!parent || !acpi_dev_hid_uid_match(parent, "CIXHA006", NULL)) {
+		acpi_dev_put(provider);
+		return dev_err_probe(&pdev->dev, -ENODEV,
+				     "invalid SCMI clock provider\n");
+	}
+	priv->provider_fwnode = acpi_fwnode_handle(provider);
+
+	status = acpi_walk_namespace(ACPI_TYPE_DEVICE, ACPI_ROOT_OBJECT,
+				     ACPI_UINT32_MAX, sky1_clkt_walk_cb,
+				     NULL, priv, NULL);
+	acpi_dev_put(provider);
+	if (priv->error)
+		return dev_err_probe(&pdev->dev, priv->error,
+				     "invalid or unavailable CLKT entry\n");
+	if (ACPI_FAILURE(status))
+		return dev_err_probe(&pdev->dev, -EIO,
+				     "ACPI namespace walk failed\n");
+	if (!priv->map_count)
+		return dev_err_probe(&pdev->dev, -ENODEV,
+				     "firmware contains no CLKT entries\n");
+
+	ret = sky1_publish_clkt(priv);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+				     "failed to publish CLKT entries\n");
+
+	dev_dbg(&pdev->dev, "published %u ACPI clock lookup entries\n",
+		priv->map_count);
+	return 0;
+}
+
+static const struct acpi_device_id sky1_acpi_clk_ids[] = {
+	{ "CIXHA010", 0 },
+	{ }
+};
+MODULE_DEVICE_TABLE(acpi, sky1_acpi_clk_ids);
+
+static struct platform_driver sky1_acpi_clk_driver = {
+	.driver = {
+		.name = "clk-sky1-acpi",
+		.acpi_match_table = sky1_acpi_clk_ids,
+	},
+	.probe = sky1_acpi_clk_probe,
+};
+module_platform_driver(sky1_acpi_clk_driver);
+
+MODULE_DESCRIPTION("CIX Sky1 ACPI clock lookup table driver");
+MODULE_LICENSE("GPL");
