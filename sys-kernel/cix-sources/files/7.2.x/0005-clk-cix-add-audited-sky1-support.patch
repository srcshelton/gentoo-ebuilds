+struct sky1_audss_clka_map {
+	struct clk_hw *hw;
+	struct clk_lookup *lookup;
+	char dev_id[SKY1_AUDSS_CLKDEV_DEV_ID_LEN];
+	char con_id[SKY1_AUDSS_CLKDEV_CON_ID_LEN];
+	bool has_con_id;
+};
