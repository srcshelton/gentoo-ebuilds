+static inline void sky1_audss_acpi_clear_dependencies(struct device *dev)
+{
+}
+
+static inline struct regmap *sky1_audss_get_acpi_regmap(struct device *dev)
+{
+	return ERR_PTR(-ENODEV);
+}
+#endif
+
+/*
+ * clk_ops for audss clock mux/divider/gate
+ */
+struct sky1_clk_divider {
+	struct clk_divider div;
+	struct regmap *regmap;
+	int offset;
+};
+
+struct sky1_clk_gate {
+	struct clk_gate gate;
+	struct regmap *regmap;
+	int offset;
+	unsigned int *shared_count;
+};
+
+struct sky1_clk_mux {
+	struct clk_mux mux;
+	struct regmap *regmap;
+	int offset;
+};
+
+static inline struct sky1_clk_mux *to_sky1_clk_mux(struct clk_mux *mux)
+{
+	return container_of(mux, struct sky1_clk_mux, mux);
+}
+
+static u8 sky1_audss_clk_mux_get_parent(struct clk_hw *hw)
+{
+	struct clk_mux *mux = to_clk_mux(hw);
+	struct sky1_clk_mux *sky1_mux = to_sky1_clk_mux(mux);
+	u32 val;
+
+	if (regmap_read(sky1_mux->regmap, sky1_mux->offset, &val))
+		return 0;
+	val = val >> mux->shift;
+	val &= mux->mask;
+
+	return clk_mux_val_to_index(hw, mux->table, mux->flags, val);
+}
+
+static int sky1_audss_clk_mux_set_parent(struct clk_hw *hw, u8 index)
+{
+	struct clk_mux *mux = to_clk_mux(hw);
+	u32 val = clk_mux_index_to_val(mux->table, mux->flags, index);
+	struct sky1_clk_mux *sky1_mux = to_sky1_clk_mux(mux);
+	unsigned long flags = 0;
+	u32 mask, reg;
+	int ret;
+
+	if (mux->lock)
+		spin_lock_irqsave(mux->lock, flags);
+	else
+		__acquire(mux->lock);
+
+	mask = mux->mask << mux->shift;
+	val <<= mux->shift;
+	if (mux->flags & CLK_MUX_HIWORD_MASK) {
+		reg = mask << 16 | val;
+		ret = regmap_write(sky1_mux->regmap, sky1_mux->offset, reg);
+	} else {
+		ret = regmap_update_bits(sky1_mux->regmap, sky1_mux->offset,
+					 mask, val);
+	}
+
+	if (mux->lock)
+		spin_unlock_irqrestore(mux->lock, flags);
+	else
+		__release(mux->lock);
+
+	return ret;
+}
+
+static int sky1_audss_clk_mux_determine_rate(struct clk_hw *hw,
+					     struct clk_rate_request *req)
+{
+	struct clk_mux *mux = to_clk_mux(hw);
+
+	return clk_mux_determine_rate_flags(hw, req, mux->flags);
+}
+
+static const struct clk_ops sky1_audss_clk_mux_ops = {
+	.get_parent = sky1_audss_clk_mux_get_parent,
+	.set_parent = sky1_audss_clk_mux_set_parent,
+	.determine_rate = sky1_audss_clk_mux_determine_rate,
+};
+
+static inline struct sky1_clk_divider *to_sky1_clk_divider(struct clk_divider *div)
+{
+	return container_of(div, struct sky1_clk_divider, div);
+}
+
+static unsigned long sky1_audss_clk_divider_recalc_rate(struct clk_hw *hw,
+							unsigned long parent_rate)
+{
+	struct clk_divider *divider = to_clk_divider(hw);
+	struct sky1_clk_divider *sky1_div = to_sky1_clk_divider(divider);
+	unsigned int val;
+
+	if (regmap_read(sky1_div->regmap, sky1_div->offset, &val))
+		return parent_rate;
+	val = val >> divider->shift;
+	val &= clk_div_mask(divider->width);
+
+	return divider_recalc_rate(hw, parent_rate, val, divider->table,
+				   divider->flags, divider->width);
+}
+
+static int sky1_audss_clk_divider_determine_rate(struct clk_hw *hw,
+						 struct clk_rate_request *req)
+{
+	struct clk_divider *divider = to_clk_divider(hw);
+	struct sky1_clk_divider *sky1_div = to_sky1_clk_divider(divider);
+
+	/* if read only, just return current value */
+	if (divider->flags & CLK_DIVIDER_READ_ONLY) {
+		int ret;
+		u32 val;
+
+		ret = regmap_read(sky1_div->regmap, sky1_div->offset, &val);
+		if (ret)
+			return ret;
+		val = val >> divider->shift;
+		val &= clk_div_mask(divider->width);
+
+		return divider_ro_determine_rate(hw, req, divider->table,
+						 divider->width,
+						 divider->flags, val);
+	}
+
+	return divider_determine_rate(hw, req, divider->table, divider->width,
+				      divider->flags);
+}
+
+static int sky1_audss_clk_divider_set_rate(struct clk_hw *hw,
+					   unsigned long rate,
+					   unsigned long parent_rate)
+{
+	struct clk_divider *divider = to_clk_divider(hw);
+	struct sky1_clk_divider *sky1_div = to_sky1_clk_divider(divider);
+	int value;
+	unsigned long flags = 0;
+	u32 mask, reg, val;
+	int ret;
+
+	value = divider_get_val(rate, parent_rate, divider->table,
+				divider->width, divider->flags);
+	if (value < 0)
+		return value;
+
+	if (divider->lock)
+		spin_lock_irqsave(divider->lock, flags);
+	else
+		__acquire(divider->lock);
+
+	mask = clk_div_mask(divider->width) << divider->shift;
+	val = (u32)value << divider->shift;
+	if (divider->flags & CLK_DIVIDER_HIWORD_MASK) {
+		reg = mask << 16 | val;
+		ret = regmap_write(sky1_div->regmap, sky1_div->offset, reg);
+	} else {
+		ret = regmap_update_bits(sky1_div->regmap, sky1_div->offset,
+					 mask, val);
+	}
+
+	if (divider->lock)
+		spin_unlock_irqrestore(divider->lock, flags);
+	else
+		__release(divider->lock);
+
+	return ret;
+}
+
+static const struct clk_ops sky1_audss_clk_divider_ops = {
+	.recalc_rate = sky1_audss_clk_divider_recalc_rate,
+	.determine_rate = sky1_audss_clk_divider_determine_rate,
+	.set_rate = sky1_audss_clk_divider_set_rate,
+};
+
+static inline struct sky1_clk_gate *to_sky1_clk_gate(struct clk_gate *gate)
+{
+	return container_of(gate, struct sky1_clk_gate, gate);
+}
+
+static int sky1_audss_clk_gate_update(struct sky1_clk_gate *sky1_gate,
+				      bool enable)
+{
+	struct clk_gate *gate = &sky1_gate->gate;
+	int set = gate->flags & CLK_GATE_SET_TO_DISABLE ? 1 : 0;
+	u32 mask, reg, val;
+
+	set ^= enable;
+
+	if (gate->flags & CLK_GATE_HIWORD_MASK) {
+		reg = BIT(gate->bit_idx + 16);
+		if (set)
+			reg |= BIT(gate->bit_idx);
+		return regmap_write(sky1_gate->regmap, sky1_gate->offset, reg);
+	}
+
+	mask = BIT(gate->bit_idx);
+	val = set ? mask : 0;
+	return regmap_update_bits(sky1_gate->regmap, sky1_gate->offset,
+				  mask, val);
+}
+
+static int sky1_audss_clk_gate_endisable(struct clk_hw *hw, bool enable)
+{
+	struct clk_gate *gate = to_clk_gate(hw);
+	struct sky1_clk_gate *sky1_gate = to_sky1_clk_gate(gate);
+	unsigned long flags = 0;
+	int ret;
+
+	if (gate->lock)
+		spin_lock_irqsave(gate->lock, flags);
+	else
+		__acquire(gate->lock);
+
+	ret = sky1_audss_clk_gate_update(sky1_gate, enable);
+
+	if (gate->lock)
+		spin_unlock_irqrestore(gate->lock, flags);
+	else
+		__release(gate->lock);
+
+	return ret;
+}
+
+static int sky1_audss_clk_gate_enable(struct clk_hw *hw)
+{
+	struct clk_gate *gate = to_clk_gate(hw);
+	struct sky1_clk_gate *sky1_gate = to_sky1_clk_gate(gate);
+	unsigned long flags = 0;
+	int ret = 0;
+
+	if (!sky1_gate->shared_count)
+		return sky1_audss_clk_gate_endisable(hw, true);
+
+	if (gate->lock)
+		spin_lock_irqsave(gate->lock, flags);
+	else
+		__acquire(gate->lock);
+
+	if (*sky1_gate->shared_count == UINT_MAX) {
+		ret = -EOVERFLOW;
+		goto out_unlock;
+	}
+
+	if (!*sky1_gate->shared_count) {
+		ret = sky1_audss_clk_gate_update(sky1_gate, true);
+		if (ret)
+			goto out_unlock;
+	}
+
+	(*sky1_gate->shared_count)++;
+
+out_unlock:
+	if (gate->lock)
+		spin_unlock_irqrestore(gate->lock, flags);
+	else
+		__release(gate->lock);
+
+	return ret;
+}
+
+static void sky1_audss_clk_gate_disable(struct clk_hw *hw)
+{
+	struct clk_gate *gate = to_clk_gate(hw);
+	struct sky1_clk_gate *sky1_gate = to_sky1_clk_gate(gate);
+	unsigned long flags = 0;
+
+	if (!sky1_gate->shared_count) {
+		/* The common clock disable callback cannot report an MMIO failure. */
+		sky1_audss_clk_gate_endisable(hw, false);
+		return;
+	}
+
+	if (gate->lock)
+		spin_lock_irqsave(gate->lock, flags);
+	else
+		__acquire(gate->lock);
+
+	if (WARN_ON_ONCE(!*sky1_gate->shared_count))
+		goto out_unlock;
+
+	(*sky1_gate->shared_count)--;
+	if (!*sky1_gate->shared_count)
+		WARN_ON_ONCE(sky1_audss_clk_gate_update(sky1_gate, false));
+
+out_unlock:
+	if (gate->lock)
+		spin_unlock_irqrestore(gate->lock, flags);
+	else
+		__release(gate->lock);
+}
+
+static void sky1_audss_clk_gate_disable_unused(struct clk_hw *hw)
+{
+	struct clk_gate *gate = to_clk_gate(hw);
+	struct sky1_clk_gate *sky1_gate = to_sky1_clk_gate(gate);
+	unsigned long flags = 0;
+
+	if (!sky1_gate->shared_count) {
+		sky1_audss_clk_gate_endisable(hw, false);
+		return;
+	}
+
+	if (gate->lock)
+		spin_lock_irqsave(gate->lock, flags);
+	else
+		__acquire(gate->lock);
+
+	if (!*sky1_gate->shared_count)
+		WARN_ON_ONCE(sky1_audss_clk_gate_update(sky1_gate, false));
+
+	if (gate->lock)
+		spin_unlock_irqrestore(gate->lock, flags);
+	else
+		__release(gate->lock);
+}
+
+static int sky1_audss_clk_gate_is_enabled(struct clk_hw *hw)
+{
+	struct clk_gate *gate = to_clk_gate(hw);
+	struct sky1_clk_gate *sky1_gate = to_sky1_clk_gate(gate);
+	u32 reg;
+
+	if (regmap_read(sky1_gate->regmap, sky1_gate->offset, &reg))
+		return 0;
+
+	/* if a set bit disables this clk, flip it before masking */
+	if (gate->flags & CLK_GATE_SET_TO_DISABLE)
+		reg ^= BIT(gate->bit_idx);
+
+	reg &= BIT(gate->bit_idx);
+
+	return !!reg;
+}
+
+static const struct clk_ops sky1_audss_clk_gate_ops = {
+	.enable = sky1_audss_clk_gate_enable,
+	.disable = sky1_audss_clk_gate_disable,
+	.is_enabled = sky1_audss_clk_gate_is_enabled,
+	.disable_unused = sky1_audss_clk_gate_disable_unused,
+};
+
+static struct clk_hw *sky1_audss_parent_clk_hw(struct sky1_audss_clks_priv *priv,
+					       const char *name)
+{
+	size_t i;
+
+	for (i = 0; i < ARRAY_SIZE(sky1_audss_root_clk_names); i++) {
+		if (!strcmp(name, sky1_audss_root_clk_names[i]))
+			return __clk_get_hw(priv->clks[i]);
+	}
+
+	if (!strcmp(name, SKY1_AUDSS_HIFI5_DIV_NAME))
+		return priv->hifi5_div;
+	if (!strcmp(name, SKY1_AUDSS_HIFI5_DIV2_NAME))
+		return priv->hifi5_div2;
+	if (!strcmp(name, SKY1_AUDSS_HIFI5_DIV4_NAME))
+		return priv->hifi5_div4;
+	if (!strcmp(name, "audio_clk4_div2"))
+		return priv->clk_data->hws[CLK_AUD_CLK4_DIV2];
+	if (!strcmp(name, "audio_clk4_div4"))
+		return priv->clk_data->hws[CLK_AUD_CLK4_DIV4];
+	if (!strcmp(name, "audio_clk5_div2"))
+		return priv->clk_data->hws[CLK_AUD_CLK5_DIV2];
+
+	return NULL;
+}
+
+static struct clk_hw *sky1_audss_clk_register(struct sky1_audss_clks_priv *priv,
+					      const char *name,
+					      const char * const *parent_names,
+					      int num_parents,
+					      struct regmap *regmap,
+					      const u32 *mux_table,
+					      struct muxdiv_cfg *mux_cfg,
+					      struct muxdiv_cfg *div_cfg,
+					      struct gate_cfg *gate_cfg,
+					      unsigned long flags,
+					      spinlock_t *lock)
+{
+	const struct clk_ops *sky1_mux_ops = NULL;
+	const struct clk_ops *sky1_div_ops = NULL;
+	const struct clk_ops *sky1_gate_ops = NULL;
+	struct clk_hw *hw;
+	struct sky1_clk_divider *sky1_div = NULL;
+	struct sky1_clk_gate *sky1_gate = NULL;
+	struct sky1_clk_mux *sky1_mux = NULL;
+	struct clk_parent_data *parent_data;
+	struct device *dev = priv->dev;
+	int i;
+
+	if (num_parents <= 0)
+		return ERR_PTR(-EINVAL);
+
+	parent_data = devm_kcalloc(dev, num_parents, sizeof(*parent_data),
+				   GFP_KERNEL);
+	if (!parent_data)
+		return ERR_PTR(-ENOMEM);
+
+	for (i = 0; i < num_parents; i++) {
+		parent_data[i].hw = sky1_audss_parent_clk_hw(priv,
+							     parent_names[i]);
+		if (!parent_data[i].hw) {
+			dev_err(dev, "%s has unknown parent %s\n", name,
+				parent_names[i]);
+			return ERR_PTR(-EINVAL);
+		}
+	}
+
+	if (mux_cfg->offset >= 0) {
+		sky1_mux = devm_kzalloc(dev, sizeof(*sky1_mux), GFP_KERNEL);
+		if (!sky1_mux)
+			return ERR_PTR(-ENOMEM);
+
+		sky1_mux->mux.reg = NULL;
+		sky1_mux->mux.shift = mux_cfg->shift;
+		sky1_mux->mux.mask = BIT(mux_cfg->width) - 1;
+		sky1_mux->mux.flags = mux_cfg->flags;
+		sky1_mux->mux.table = mux_table;
+		sky1_mux->mux.lock = lock;
+		sky1_mux_ops = &sky1_audss_clk_mux_ops;
+		sky1_mux->regmap = regmap;
+		sky1_mux->offset = mux_cfg->offset;
+	}
+
+	if (div_cfg->offset >= 0) {
+		sky1_div = devm_kzalloc(dev, sizeof(*sky1_div), GFP_KERNEL);
+		if (!sky1_div)
+			return ERR_PTR(-ENOMEM);
+
+		sky1_div->div.reg = NULL;
+		sky1_div->div.shift = div_cfg->shift;
+		sky1_div->div.width = div_cfg->width;
+		sky1_div->div.flags = div_cfg->flags | CLK_DIVIDER_POWER_OF_TWO;
+		sky1_div->div.lock = lock;
+		sky1_div_ops = &sky1_audss_clk_divider_ops;
+		sky1_div->regmap = regmap;
+		sky1_div->offset = div_cfg->offset;
+	}
+
+	if (gate_cfg->offset >= 0) {
+		sky1_gate = devm_kzalloc(dev, sizeof(*sky1_gate), GFP_KERNEL);
+		if (!sky1_gate)
+			return ERR_PTR(-ENOMEM);
+
+		sky1_gate->gate.reg = NULL;
+		sky1_gate->gate.bit_idx = gate_cfg->shift;
+		sky1_gate->gate.flags = gate_cfg->flags;
+		sky1_gate->gate.lock = lock;
+		sky1_gate_ops = &sky1_audss_clk_gate_ops;
+		sky1_gate->regmap = regmap;
+		sky1_gate->offset = gate_cfg->offset;
+		if (gate_cfg->offset == INFO_CLK_GATE) {
+			if (gate_cfg->shift >= ARRAY_SIZE(priv->info_gate_users))
+				return ERR_PTR(-EINVAL);
+			sky1_gate->shared_count =
+				&priv->info_gate_users[gate_cfg->shift];
+		}
+	}
+
+	hw = devm_clk_hw_register_composite_pdata(dev, name, parent_data,
+						  num_parents,
+						  sky1_mux ? &sky1_mux->mux.hw : NULL,
+						  sky1_mux_ops,
+						  sky1_div ? &sky1_div->div.hw : NULL,
+						  sky1_div_ops,
+						  sky1_gate ? &sky1_gate->gate.hw : NULL,
+						  sky1_gate_ops, flags);
+	if (IS_ERR(hw)) {
+		dev_err(dev, "register %s clock failed with err = %ld\n",
+			name, PTR_ERR(hw));
+		return hw;
+	}
+
+	return hw;
+}
+
+static int sky1_audss_hifi5_clk_register(struct sky1_audss_clks_priv *priv)
+{
+	struct muxdiv_cfg no_mux = { .offset = -1 };
+	struct muxdiv_cfg hifi5_div = {
+		.offset = INFO_CLK_DIV,
+		.shift = 0,
+		.width = 2,
+	};
+	struct gate_cfg no_gate = { .offset = -1 };
+	struct device *dev = priv->dev;
+
+	/* INFO_CLK_DIV[1:0] is one physical HIFI5 divider, not per-leaf state. */
+	priv->hifi5_div = sky1_audss_clk_register(priv,
+						  SKY1_AUDSS_HIFI5_DIV_NAME,
+						  hifi5_div_parent,
+						  ARRAY_SIZE(hifi5_div_parent),
+						  priv->regmap_cru, NULL,
+						  &no_mux, &hifi5_div, &no_gate,
+						  CLK_SET_RATE_GATE, &priv->lock);
+	if (IS_ERR(priv->hifi5_div))
+		return PTR_ERR(priv->hifi5_div);
+
+	priv->hifi5_div2 = devm_clk_hw_register_fixed_factor_parent_hw(
+		dev, SKY1_AUDSS_HIFI5_DIV2_NAME, priv->hifi5_div,
+		CLK_SET_RATE_PARENT, 1, 2);
+	if (IS_ERR(priv->hifi5_div2))
+		return PTR_ERR(priv->hifi5_div2);
+
+	priv->hifi5_div4 = devm_clk_hw_register_fixed_factor_parent_hw(
+		dev, SKY1_AUDSS_HIFI5_DIV4_NAME, priv->hifi5_div,
+		CLK_SET_RATE_PARENT, 1, 4);
+	if (IS_ERR(priv->hifi5_div4))
+		return PTR_ERR(priv->hifi5_div4);
+
+	return 0;
+}
+
+static int sky1_audss_clks_get(struct sky1_audss_clks_priv *priv)
+{
+	const struct sky1_audss_clks_devtype_data *devtype_data = priv->devtype_data;
+	size_t i;
+
+	for (i = 0; i < devtype_data->clk_num; i++) {
+		priv->clks[i] = devm_clk_get(priv->dev, devtype_data->clk_names[i]);
+		if (IS_ERR(priv->clks[i]))
+			return dev_err_probe(priv->dev, PTR_ERR(priv->clks[i]),
+					     "failed to get clock %s", devtype_data->clk_names[i]);
+	}
+
+	return 0;
+}
+
+static int sky1_audss_clks_enable(struct sky1_audss_clks_priv *priv)
+{
+	const struct sky1_audss_clks_devtype_data *devtype_data = priv->devtype_data;
+	size_t i;
+	int err;
+
+	for (i = 0; i < devtype_data->clk_num; i++) {
+		err = clk_prepare_enable(priv->clks[i]);
+		if (err) {
+			dev_err(priv->dev, "failed to enable clock %s\n",
+				devtype_data->clk_names[i]);
+			goto err_clks;
+		}
+	}
+
+	return 0;
+
+err_clks:
+	while (i > 0) {
+		i--;
+		clk_disable_unprepare(priv->clks[i]);
+	}
+
+	return err;
+}
+
+static void sky1_audss_clks_disable(struct sky1_audss_clks_priv *priv)
+{
+	const struct sky1_audss_clks_devtype_data *devtype_data = priv->devtype_data;
+	size_t i = devtype_data->clk_num;
+
+	while (i > 0) {
+		i--;
+		clk_disable_unprepare(priv->clks[i]);
+	}
+}
+
+static int sky1_audss_clks_set_rate(struct sky1_audss_clks_priv *priv)
+{
+	const struct sky1_audss_clks_devtype_data *devtype_data = priv->devtype_data;
+	size_t i, rollback;
+	int err;
+
+	if (devtype_data->clk_num > ARRAY_SIZE(priv->initial_rates))
+		return -EINVAL;
+
+	for (i = 0; i < devtype_data->clk_num; i++)
+		priv->initial_rates[i] = clk_get_rate(priv->clks[i]);
+
+	for (i = 0; i < devtype_data->clk_num; i++) {
+		err = clk_set_rate(priv->clks[i], devtype_data->clk_rate_default[i]);
+		if (err) {
+			dev_err(priv->dev, "failed to set clock rate %s\n",
+				devtype_data->clk_names[i]);
+			rollback = i + 1;
+			while (rollback > 0) {
+				rollback--;
+				if (priv->initial_rates[rollback] &&
+				    clk_set_rate(priv->clks[rollback],
+						 priv->initial_rates[rollback]))
+					dev_warn(priv->dev,
+						 "failed to restore clock rate %s\n",
+						 devtype_data->clk_names[rollback]);
+			}
+			return err;
+		}
+	}
+
+	return 0;
+}
+
+static void sky1_audss_clks_restore_rate(struct sky1_audss_clks_priv *priv)
+{
+	const struct sky1_audss_clks_devtype_data *devtype_data = priv->devtype_data;
+	size_t i = devtype_data->clk_num;
+
+	while (i > 0) {
+		i--;
+		if (priv->initial_rates[i] &&
+		    clk_set_rate(priv->clks[i], priv->initial_rates[i]))
+			dev_warn(priv->dev, "failed to restore clock rate %s\n",
+				 devtype_data->clk_names[i]);
+	}
+}
+
+/* Run from devres only after published clocks and the reset child are gone. */
+static void sky1_audss_probe_power_down(void *data)
+{
+	struct sky1_audss_clks_priv *priv = data;
+	int ret;
+
+	if (!pm_runtime_status_suspended(priv->dev)) {
+		ret = pm_runtime_force_suspend(priv->dev);
+		if (ret) {
+			dev_warn(priv->dev,
+				 "failed to suspend AUDSS during teardown: %d\n",
+				 ret);
+		} else {
+			/* Balance force_suspend before devm disables runtime PM. */
+			pm_runtime_enable(priv->dev);
+		}
+	}
+
+	if (!pm_runtime_status_suspended(priv->dev)) {
+		if (reset_control_assert(priv->rst_noc))
+			dev_warn(priv->dev,
+				 "failed to reassert AUDSS NOC reset\n");
+		sky1_audss_clks_disable(priv);
+	}
+	if (!priv->probe_complete)
+		sky1_audss_clks_restore_rate(priv);
+	if (priv->probe_pm_ref) {
+		priv->probe_pm_ref = false;
+		pm_runtime_put_noidle(priv->dev);
+	}
+}
+
+/* register sky1 audio subsystem clocks */
+static int sky1_audss_clk_probe(struct platform_device *pdev)
+{
+	const struct sky1_audss_clks_devtype_data *devtype_data;
+	struct sky1_audss_clks_priv *priv;
+	struct device *dev = &pdev->dev;
+	struct clk_hw **clk_table;
+	void __iomem *base;
+	size_t i;
+	int ret;
+
+	devtype_data = device_get_match_data(dev);
+	if (!devtype_data)
+		return -ENODEV;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+	priv->dev = dev;
+	priv->devtype_data = devtype_data;
+	platform_set_drvdata(pdev, priv);
+
+	spin_lock_init(&priv->lock);
+
+	priv->clk_data = devm_kzalloc(dev,
+				      struct_size(priv->clk_data, hws, SKY1_AUDSS_NUM_CLKS),
+				      GFP_KERNEL);
+	if (!priv->clk_data)
+		return -ENOMEM;
+
+	priv->clk_data->num = SKY1_AUDSS_NUM_CLKS;
+	clk_table = priv->clk_data->hws;
+
+	if (has_acpi_companion(dev)) {
+		ret = sky1_audss_acpi_power_on(dev);
+		if (ret)
+			return dev_err_probe(dev, ret,
+					     "failed to transition AUDSS to D0\n");
+
+		priv->regmap_cru = sky1_audss_get_acpi_regmap(dev);
+		if (IS_ERR(priv->regmap_cru))
+			return dev_err_probe(dev, PTR_ERR(priv->regmap_cru),
+					     "failed to get audss_cru regmap\n");
+	} else {
+		base = devm_platform_ioremap_resource(pdev, 0);
+		if (IS_ERR(base))
+			return PTR_ERR(base);
+
+		priv->regmap_cru = devm_regmap_init_mmio(dev, base,
+							 &sky1_audss_regmap_config);
+		if (IS_ERR(priv->regmap_cru))
+			return dev_err_probe(dev, PTR_ERR(priv->regmap_cru),
+					     "failed to initialize regmap\n");
+	}
+
+	priv->rst_noc = devm_reset_control_get_exclusive(
+		dev, has_acpi_companion(dev) ? "noc" : NULL);
+	if (IS_ERR(priv->rst_noc))
+		return dev_err_probe(dev, PTR_ERR(priv->rst_noc),
+				     "failed to get AUDSS NOC reset\n");
+
+	ret = sky1_audss_clks_get(priv);
+	if (ret)
+		return ret;
+
+	ret = sky1_audss_clks_set_rate(priv);
+	if (ret)
+		return ret;
+
+	ret = sky1_audss_clks_enable(priv);
+	if (ret)
+		goto err_restore_rates;
+
+	ret = reset_control_assert(priv->rst_noc);
+	if (ret)
+		goto err_disable_clks;
+
+	ret = reset_control_deassert(priv->rst_noc);
+	if (ret)
+		goto err_disable_clks;
+
+	/* Clock registration snapshots whether the provider uses runtime PM. */
+	pm_runtime_get_noresume(dev);
+	ret = pm_runtime_set_active(dev);
+	if (ret) {
+		pm_runtime_put_noidle(dev);
+		goto err_assert_reset;
+	}
+	ret = devm_pm_runtime_enable(dev);
+	if (ret) {
+		pm_runtime_put_noidle(dev);
+		goto err_assert_reset;
+	}
+	priv->probe_pm_ref = true;
+	ret = devm_add_action_or_reset(dev, sky1_audss_probe_power_down, priv);
+	if (ret)
+		return ret;
+
+	ret = sky1_audss_hifi5_clk_register(priv);
+	if (ret)
+		return ret;
+
+	/* audio_clk4 clock fixed divider */
+	clk_table[CLK_AUD_CLK4_DIV2] =
+		devm_clk_hw_register_fixed_factor_parent_hw(dev,
+							    "audio_clk4_div2",
+							    __clk_get_hw(priv->clks[2]),
+							    0, 1, 2);
+	if (IS_ERR(clk_table[CLK_AUD_CLK4_DIV2])) {
+		ret = PTR_ERR(clk_table[CLK_AUD_CLK4_DIV2]);
+		return ret;
+	}
+
+	clk_table[CLK_AUD_CLK4_DIV4] =
+		devm_clk_hw_register_fixed_factor_parent_hw(dev,
+							    "audio_clk4_div4",
+							    __clk_get_hw(priv->clks[2]),
+							    0, 1, 4);
+	if (IS_ERR(clk_table[CLK_AUD_CLK4_DIV4])) {
+		ret = PTR_ERR(clk_table[CLK_AUD_CLK4_DIV4]);
+		return ret;
+	}
+
+	/* audio_clk5 clock fixed divider */
+	clk_table[CLK_AUD_CLK5_DIV2] =
+		devm_clk_hw_register_fixed_factor_parent_hw(dev,
+							    "audio_clk5_div2",
+							    __clk_get_hw(priv->clks[3]),
+							    0, 1, 2);
+	if (IS_ERR(clk_table[CLK_AUD_CLK5_DIV2])) {
+		ret = PTR_ERR(clk_table[CLK_AUD_CLK5_DIV2]);
+		return ret;
+	}
+
+	for (i = 0; i < devtype_data->clk_cfg_size; i++) {
+		clk_table[devtype_data->clk_cfg[i].id] =
+			sky1_audss_clk_register(priv,
+						devtype_data->clk_cfg[i].name,
+						devtype_data->clk_cfg[i].parent_names,
+						devtype_data->clk_cfg[i].num_parents,
+						priv->regmap_cru,
+						devtype_data->clk_cfg[i].mux_table,
+						devtype_data->clk_cfg[i].mux_cfg,
+						devtype_data->clk_cfg[i].div_cfg,
+						devtype_data->clk_cfg[i].gate_cfg,
+						devtype_data->clk_cfg[i].flags,
+						&priv->lock);
+		if (IS_ERR(clk_table[devtype_data->clk_cfg[i].id])) {
+			ret = PTR_ERR(clk_table[devtype_data->clk_cfg[i].id]);
+			return ret;
+		}
+	}
+
+	ret = sky1_audss_reset_controller_register(dev);
+	if (ret)
+		return ret;
+
+	if (has_acpi_companion(dev))
+		ret = sky1_audss_parse_clka(dev, priv->clk_data);
+	else
+		ret = devm_of_clk_add_hw_provider(dev, of_clk_hw_onecell_get,
+						  priv->clk_data);
+	if (ret) {
+		dev_err(dev, "failed to publish clock provider: %d\n", ret);
+		return ret;
+	}
+
+	/* Allow DLKL consumers (DMA, I2S, HDA, etc.) to enumerate now. */
+	if (has_acpi_companion(dev))
+		sky1_audss_acpi_clear_dependencies(dev);
+
+	priv->probe_complete = true;
+	priv->probe_pm_ref = false;
+	pm_runtime_put(dev);
+
+	return 0;
+
+err_assert_reset:
+	if (reset_control_assert(priv->rst_noc))
+		dev_warn(dev, "failed to reassert AUDSS NOC reset\n");
+err_disable_clks:
+	sky1_audss_clks_disable(priv);
+err_restore_rates:
+	sky1_audss_clks_restore_rate(priv);
+	return ret;
+}
+
+static int __maybe_unused sky1_audss_clk_runtime_suspend(struct device *dev)
+{
+	struct sky1_audss_clks_priv *priv = dev_get_drvdata(dev);
+	const struct sky1_audss_clks_devtype_data *devtype_data = priv->devtype_data;
+	unsigned long flags;
+	size_t i;
+	int ret = 0;
+
+	spin_lock_irqsave(&priv->lock, flags);
+	for (i = 0; i < devtype_data->reg_save_size; i++) {
+		ret = regmap_read(priv->regmap_cru, devtype_data->reg_save[i],
+				  &priv->reg_save[i]);
+		if (ret)
+			break;
+	}
+	spin_unlock_irqrestore(&priv->lock, flags);
+	if (ret)
+		return ret;
+
+	ret = reset_control_assert(priv->rst_noc);
+	if (ret)
+		return ret;
+
+	sky1_audss_clks_disable(priv);
+	return 0;
+}
+
+static int __maybe_unused sky1_audss_clk_runtime_resume(struct device *dev)
+{
+	struct sky1_audss_clks_priv *priv = dev_get_drvdata(dev);
+	const struct sky1_audss_clks_devtype_data *devtype_data = priv->devtype_data;
+	unsigned long flags;
+	size_t i;
+	int ret;
+
+	ret = sky1_audss_clks_enable(priv);
+	if (ret)
+		return ret;
+
+	ret = reset_control_deassert(priv->rst_noc);
+	if (ret) {
+		sky1_audss_clks_disable(priv);
+		return ret;
+	}
+
+	spin_lock_irqsave(&priv->lock, flags);
+	for (i = 0; i < devtype_data->reg_save_size; i++) {
+		ret = regmap_write(priv->regmap_cru, devtype_data->reg_save[i],
+				   priv->reg_save[i]);
+		if (ret)
+			break;
+	}
+	spin_unlock_irqrestore(&priv->lock, flags);
+	if (ret) {
+		if (reset_control_assert(priv->rst_noc))
+			dev_warn(dev, "failed to reassert AUDSS NOC reset\n");
+		sky1_audss_clks_disable(priv);
+	}
+
+	return ret;
+}
+
+static const struct dev_pm_ops sky1_audss_clk_pm_ops = {
+	SET_RUNTIME_PM_OPS(sky1_audss_clk_runtime_suspend,
+			   sky1_audss_clk_runtime_resume, NULL)
+	SET_SYSTEM_SLEEP_PM_OPS(pm_runtime_force_suspend,
+				pm_runtime_force_resume)
+};
+
+static const struct sky1_audss_clks_devtype_data sky1_devtype_data = {
+	.reg_save = sky1_reg_save,
+	.reg_save_size = ARRAY_SIZE(sky1_reg_save),
+	.clk_names = sky1_audss_clk_names,
+	.clk_num = ARRAY_SIZE(sky1_audss_clk_names),
+	.clk_rate_default = sky1_clk_rate_default,
+	.clk_cfg = sky1_audss_clks,
+	.clk_cfg_size = ARRAY_SIZE(sky1_audss_clks),
+};
+
+/* Same as sky1_devtype_data but with ACPI (CLKT) parent clock names. */
+static const struct sky1_audss_clks_devtype_data sky1_acpi_devtype_data = {
+	.reg_save = sky1_reg_save,
+	.reg_save_size = ARRAY_SIZE(sky1_reg_save),
+	.clk_names = sky1_audss_root_clk_names,
+	.clk_num = ARRAY_SIZE(sky1_audss_root_clk_names),
+	.clk_rate_default = sky1_clk_rate_default,
+	.clk_cfg = sky1_audss_clks,
+	.clk_cfg_size = ARRAY_SIZE(sky1_audss_clks),
+};
+
+static const struct of_device_id sky1_audss_clk_of_match[] = {
+	{ .compatible = "cix,sky1-audss-cru", .data = &sky1_devtype_data, },
+	{ /* sentinel */ },
+};
+MODULE_DEVICE_TABLE(of, sky1_audss_clk_of_match);
+
+static const struct acpi_device_id sky1_audss_clk_acpi_match[] = {
+	{ "CIXH6061", .driver_data = (kernel_ulong_t)&sky1_acpi_devtype_data },
+	{ /* sentinel */ },
+};
+MODULE_DEVICE_TABLE(acpi, sky1_audss_clk_acpi_match);
+
+static struct platform_driver sky1_audss_clk_driver = {
+	.probe = sky1_audss_clk_probe,
+	.driver = {
+		.name = "sky1-audss-clk",
+		.suppress_bind_attrs = true,
+		.of_match_table = sky1_audss_clk_of_match,
+		.acpi_match_table = ACPI_PTR(sky1_audss_clk_acpi_match),
+		.pm = &sky1_audss_clk_pm_ops,
+	},
+};
+module_platform_driver(sky1_audss_clk_driver);
+
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("Joakim Zhang <joakim.zhang@cixtech.com>");
+MODULE_DESCRIPTION("Cixtech Sky1 Audio Subsystem Clock Controller Driver");
diff --git a/drivers/mfd/syscon.c b/drivers/mfd/syscon.c
--- a/drivers/mfd/syscon.c
+++ b/drivers/mfd/syscon.c
@@ -10,12 +10,17 @@
 
 #include <linux/cleanup.h>
 #include <linux/clk.h>
+#include <linux/device/bus.h>
 #include <linux/err.h>
 #include <linux/hwspinlock.h>
+#include <linux/io.h>
 #include <linux/list.h>
+#include <linux/limits.h>
 #include <linux/mutex.h>
 #include <linux/of.h>
 #include <linux/of_address.h>
+#include <linux/platform_device.h>
+#include <linux/property.h>
 #include <linux/regmap.h>
 #include <linux/reset.h>
 #include <linux/mfd/syscon.h>
@@ -360,3 +365,88 @@ struct regmap *syscon_regmap_lookup_by_phandle_optional(struct device_node *np,
 	return regmap;
 }
 EXPORT_SYMBOL_GPL(syscon_regmap_lookup_by_phandle_optional);
+
+struct regmap *device_syscon_regmap_lookup_by_property(struct device *dev,
+						       const char *property)
+{
+	struct fwnode_handle *fwnode;
+	struct device *syscon_dev;
+	struct regmap *regmap;
+	int ret;
+
+	fwnode = fwnode_find_reference(dev_fwnode(dev), property, 0);
+	if (IS_ERR(fwnode))
+		return ERR_CAST(fwnode);
+
+	syscon_dev = bus_find_device_by_fwnode(&platform_bus_type, fwnode);
+	fwnode_handle_put(fwnode);
+	if (!syscon_dev)
+		return ERR_PTR(-EPROBE_DEFER);
+
+	if (dev == syscon_dev) {
+		regmap = dev_get_regmap(syscon_dev, NULL);
+		if (!regmap)
+			regmap = ERR_PTR(-EPROBE_DEFER);
+		goto out_put_device;
+	}
+
+	/* Serialize the borrowed regmap and managed link against unbind. */
+	device_lock(syscon_dev);
+	if (!device_is_bound(syscon_dev)) {
+		ret = -EPROBE_DEFER;
+	} else if (!device_link_add(dev, syscon_dev,
+				    DL_FLAG_AUTOPROBE_CONSUMER)) {
+		ret = -EINVAL;
+	} else {
+		ret = 0;
+	}
+
+	regmap = ret ? ERR_PTR(ret) : dev_get_regmap(syscon_dev, NULL);
+	if (!regmap)
+		regmap = ERR_PTR(-EPROBE_DEFER);
+	device_unlock(syscon_dev);
+
+out_put_device:
+	put_device(syscon_dev);
+
+	return regmap;
+}
+EXPORT_SYMBOL_GPL(device_syscon_regmap_lookup_by_property);
+
+struct regmap *devm_syscon_register(struct platform_device *pdev,
+				    const char *name)
+{
+	struct device *dev = &pdev->dev;
+	struct regmap_config syscon_config = syscon_regmap_config;
+	struct regmap *regmap;
+	struct resource *res;
+	resource_size_t size;
+	void __iomem *base;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res)
+		return ERR_PTR(-ENOENT);
+
+	size = resource_size(res);
+	if (size < syscon_config.reg_stride ||
+	    size - syscon_config.reg_stride > U32_MAX)
+		return ERR_PTR(dev_err_probe(dev, -EINVAL,
+					     "invalid register range %pR\n", res));
+
+	base = devm_ioremap_resource(dev, res);
+	if (IS_ERR(base))
+		return ERR_CAST(base);
+
+	syscon_config.max_register = size - syscon_config.reg_stride;
+	if (!syscon_config.max_register)
+		syscon_config.max_register_is_0 = true;
+	syscon_config.name = name;
+
+	regmap = devm_regmap_init_mmio(dev, base, &syscon_config);
+	if (IS_ERR(regmap))
+		return dev_err_cast_probe(dev, regmap,
+					  "failed to register regmap\n");
+
+	return regmap;
+}
+EXPORT_SYMBOL_GPL(devm_syscon_register);
