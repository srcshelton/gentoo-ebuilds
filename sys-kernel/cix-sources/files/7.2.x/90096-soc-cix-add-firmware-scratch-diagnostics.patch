diff --git a/drivers/soc/cix/sky1-reboot-reason.c b/drivers/soc/cix/sky1-reboot-reason.c
new file mode 100644
--- /dev/null
+++ b/drivers/soc/cix/sky1-reboot-reason.c
@@ -0,0 +1,206 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * CIX Sky1 firmware scratch diagnostics driver
+ */
+
+#include <linux/errno.h>
+#include <linux/io.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+
+struct sky1_reboot_reason {
+	void __iomem *scratch_base;
+	void __iomem *hw_base;
+};
+
+static unsigned int sky1_reboot_reason_read(void __iomem *base)
+{
+	return readl_relaxed(base) & 0xff;
+}
+
+static const char *sky1_firmware_scratch_name(unsigned int reason)
+{
+	switch (reason) {
+	case 0x00:
+		return "power-on-or-unknown";
+	case 0x01:
+		return "default-exception";
+	case 0x02:
+		return "watchdog-interrupt";
+	case 0x04:
+		return "warm-reset";
+	case 0xff:
+		return "invalid";
+	default:
+		return "unknown";
+	}
+}
+
+static const char *sky1_hw_reboot_reason_name(unsigned int reason)
+{
+	switch (reason) {
+	case 0x00:
+		return "assumed-rsmrst";
+	case 0x01:
+		return "assumed-str";
+	case 0x02:
+		return "assumed-sd";
+	case 0x03:
+		return "assumed-watchdog-second-timeout";
+	case 0x04:
+		return "assumed-warm-reset";
+	case 0x05:
+		return "assumed-external-reset";
+	case 0x07:
+		return "assumed-power-button-override";
+	default:
+		return "unknown";
+	}
+}
+
+static ssize_t firmware_scratch_raw_show(struct device *dev,
+					 struct device_attribute *attr, char *buf)
+{
+	struct sky1_reboot_reason *rr = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "0x%02x\n",
+			  sky1_reboot_reason_read(rr->scratch_base));
+}
+static DEVICE_ATTR_RO(firmware_scratch_raw);
+
+static ssize_t firmware_scratch_reason_show(struct device *dev,
+					    struct device_attribute *attr,
+					    char *buf)
+{
+	struct sky1_reboot_reason *rr = dev_get_drvdata(dev);
+	unsigned int reason;
+
+	reason = sky1_reboot_reason_read(rr->scratch_base);
+
+	return sysfs_emit(buf, "%s\n", sky1_firmware_scratch_name(reason));
+}
+static DEVICE_ATTR_RO(firmware_scratch_reason);
+
+static ssize_t hardware_reason_raw_show(struct device *dev,
+					struct device_attribute *attr,
+					char *buf)
+{
+	struct sky1_reboot_reason *rr = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "0x%02x\n",
+			  sky1_reboot_reason_read(rr->hw_base));
+}
+static DEVICE_ATTR_RO(hardware_reason_raw);
+
+static ssize_t hardware_reason_show(struct device *dev,
+				    struct device_attribute *attr, char *buf)
+{
+	struct sky1_reboot_reason *rr = dev_get_drvdata(dev);
+	unsigned int reason;
+
+	reason = sky1_reboot_reason_read(rr->hw_base);
+
+	return sysfs_emit(buf, "%s\n", sky1_hw_reboot_reason_name(reason));
+}
+static DEVICE_ATTR_RO(hardware_reason);
+
+static struct attribute *sky1_firmware_scratch_attrs[] = {
+	&dev_attr_firmware_scratch_raw.attr,
+	&dev_attr_firmware_scratch_reason.attr,
+	NULL,
+};
+
+static const struct attribute_group sky1_firmware_scratch_group = {
+	.attrs = sky1_firmware_scratch_attrs,
+};
+
+static struct attribute *sky1_hardware_reason_attrs[] = {
+	&dev_attr_hardware_reason_raw.attr,
+	&dev_attr_hardware_reason.attr,
+	NULL,
+};
+
+static const struct attribute_group sky1_hardware_reason_group = {
+	.attrs = sky1_hardware_reason_attrs,
+};
+
+static int sky1_reboot_reason_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct resource *res;
+	struct sky1_reboot_reason *rr;
+	unsigned int reason;
+	int ret;
+
+	rr = devm_kzalloc(dev, sizeof(*rr), GFP_KERNEL);
+	if (!rr)
+		return -ENOMEM;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res || resource_size(res) < sizeof(u32))
+		return -EINVAL;
+
+	/*
+	 * Firmware may already reserve these always-on diagnostic registers as
+	 * system resources. Map them read-only for reporting without claiming
+	 * the regions a second time.
+	 */
+	rr->scratch_base = devm_ioremap(dev, res->start, resource_size(res));
+	if (!rr->scratch_base)
+		return -ENOMEM;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 1);
+	if (res) {
+		if (resource_size(res) < sizeof(u32))
+			return -EINVAL;
+
+		rr->hw_base = devm_ioremap(dev, res->start,
+					   resource_size(res));
+		if (!rr->hw_base)
+			return -ENOMEM;
+	}
+
+	platform_set_drvdata(pdev, rr);
+
+	ret = devm_device_add_group(dev, &sky1_firmware_scratch_group);
+	if (ret)
+		return ret;
+
+	if (rr->hw_base) {
+		ret = devm_device_add_group(dev, &sky1_hardware_reason_group);
+		if (ret)
+			return ret;
+	}
+
+	reason = sky1_reboot_reason_read(rr->scratch_base);
+	dev_info(dev, "firmware scratch value: %s (0x%02x; may be stale)\n",
+		 sky1_firmware_scratch_name(reason), reason);
+
+	if (rr->hw_base) {
+		reason = sky1_reboot_reason_read(rr->hw_base);
+		dev_info(dev, "hardware reset reason: %s (0x%02x)\n",
+			 sky1_hw_reboot_reason_name(reason), reason);
+	}
+
+	return 0;
+}
+
+static const struct of_device_id sky1_reboot_reason_of_match[] = {
+	{ .compatible = "cix,sky1-reboot-reason" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sky1_reboot_reason_of_match);
+
+static struct platform_driver sky1_reboot_reason_driver = {
+	.probe = sky1_reboot_reason_probe,
+	.driver = {
+		.name = "sky1-reboot-reason",
+		.of_match_table = sky1_reboot_reason_of_match,
+	},
+};
+module_platform_driver(sky1_reboot_reason_driver);
+
+MODULE_DESCRIPTION("CIX Sky1 firmware scratch diagnostics driver");
+MODULE_LICENSE("GPL");
