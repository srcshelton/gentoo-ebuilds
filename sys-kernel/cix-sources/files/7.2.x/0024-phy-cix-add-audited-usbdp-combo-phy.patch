From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jianfeng Liu <Jianfeng.Liu@cixtech.com>
Date: Tue, 31 Mar 2026 14:25:25 +0800
Subject: phy: add cix phy driver
Signed-off-by: Jianfeng Liu <Jianfeng.Liu@cixtech.com>

Technical note: retain only the CIXH2033 USB/DisplayPort combo PHY from the
vendor import. The overlay form validates firmware data, owns ACPI lookups,
propagates setup failures, preserves active firmware state at probe, and
refuses unproven active lane transitions.

Source: cixtech/cix-linux-main commit
19f2947303670f2e5734d6a96ffc72a80fd9b942.

diff --git a/drivers/phy/Kconfig b/drivers/phy/Kconfig
--- a/drivers/phy/Kconfig
+++ b/drivers/phy/Kconfig
@@ -139,6 +139,7 @@ source "drivers/phy/apple/Kconfig"
 source "drivers/phy/broadcom/Kconfig"
 source "drivers/phy/cadence/Kconfig"
 source "drivers/phy/canaan/Kconfig"
+source "drivers/phy/cix/Kconfig"
 source "drivers/phy/eswin/Kconfig"
 source "drivers/phy/freescale/Kconfig"
 source "drivers/phy/hisilicon/Kconfig"
diff --git a/drivers/phy/Makefile b/drivers/phy/Makefile
--- a/drivers/phy/Makefile
+++ b/drivers/phy/Makefile
@@ -23,6 +23,7 @@ obj-$(CONFIG_GENERIC_PHY)		+= allwinner/	\
 					   broadcom/	\
 					   cadence/	\
 					   canaan/	\
+					   cix/		\
 					   eswin/	\
 					   freescale/	\
 					   hisilicon/	\
diff --git a/drivers/phy/cix/Kconfig b/drivers/phy/cix/Kconfig
new file mode 100644
--- /dev/null
+++ b/drivers/phy/cix/Kconfig
@@ -0,0 +1,15 @@
+# SPDX-License-Identifier: GPL-2.0-only
+
+config PHY_CIX_USBDP
+	tristate "CIX Sky1 USB-DP combo PHY driver"
+	depends on ARCH_CIX || COMPILE_TEST
+	depends on ACPI || OF
+	depends on TYPEC || TYPEC=n
+	select GENERIC_PHY
+	select REGMAP
+	help
+	  Enable this to support the USB-DP combo PHY on CIX Sky1 SoCs.
+	  The provider owns the shared USB3 and DisplayPort lane routing used
+	  by CIXH2033 firmware nodes and Device Tree compatibles.
+	  It also publishes Type-C orientation and mode-switch providers when
+	  those controls are described by firmware.
diff --git a/drivers/phy/cix/Makefile b/drivers/phy/cix/Makefile
new file mode 100644
--- /dev/null
+++ b/drivers/phy/cix/Makefile
@@ -0,0 +1,2 @@
+# SPDX-License-Identifier: GPL-2.0
+obj-$(CONFIG_PHY_CIX_USBDP)	+= phy-cix-usbdp.o
