+static const struct phy_ops cix_dp_phy_ops = {
+	.power_on	= udphy_dp_phy_power_on,
+	.power_off	= udphy_dp_phy_power_off,
+	.configure	= udphy_dp_phy_configure,
+	.set_mode	= udphy_dp_phy_set_mode,
+	.owner		= THIS_MODULE,
+};
+
+static int cix_u3phy_init(struct phy *phy)
+{
+	struct cix_udphy *udphy = phy_get_drvdata(phy);
+	int ret = 0;
+
+	mutex_lock(&udphy->mutex);
+	if (!(udphy->next_mode & UDPHY_MODE_USB)) {
+		ret = -EOPNOTSUPP;
+		goto unlock;
+	}
+
+	if (udphy->cur_mode & UDPHY_MODE_USB)
+		goto unlock;
+
+	/* Preserve a live GOP handoff without double-enabling the shared clock. */
+	if (udphy->phy_init_skip_count) {
+		if (udphy->cur_mode == UDPHY_MODE_NONE)
+			ret = sky1_udphy_clk_enable(udphy->apb_clk);
+		if (!ret)
+			udphy->phy_init_skip_count = 0;
+		goto set_cur;
+	}
+	ret = cix_usbdp_phy_power_on(udphy);
+
+set_cur:
+	if (ret)
+		goto unlock;
+	udphy->cur_mode |= UDPHY_MODE_USB;
+
+unlock:
+	mutex_unlock(&udphy->mutex);
+	return ret;
+}
+
+static int cix_u3phy_exit(struct phy *phy)
+{
+	struct cix_udphy *udphy = phy_get_drvdata(phy);
+	int ret = 0;
+
+	mutex_lock(&udphy->mutex);
+
+	if (!(udphy->cur_mode & UDPHY_MODE_USB))
+		goto unlock;
+
+	udphy->cur_mode &= ~UDPHY_MODE_USB;
+
+	if (udphy->cur_mode == UDPHY_MODE_NONE)
+		ret = cix_usbdp_phy_power_off(udphy);
+
+unlock:
+	mutex_unlock(&udphy->mutex);
+	return ret;
+}
+
+static int cix_u3phy_set_mode(struct phy *phy, enum phy_mode mode, int submode)
+{
+	if (mode == PHY_MODE_INVALID)
+		return cix_u3phy_exit(phy);
+	if (mode != PHY_MODE_USB_HOST && mode != PHY_MODE_USB_DEVICE &&
+	    mode != PHY_MODE_USB_OTG)
+		return -EINVAL;
+
+	return cix_u3phy_init(phy);
+}
+
+static const struct phy_ops cix_u3phy_ops = {
+	.set_mode       = cix_u3phy_set_mode,
+	.exit		= cix_u3phy_exit,
+	.owner		= THIS_MODULE,
+};
+
+/*
+ * PHY lane to PMA lane mapping for a normal plug orientation
+
+PMA LANE     C       D                 E
+0          DP TX2   USB TX0          DP TX2
+1          DP TX3   USB RX0          DP TX3
+2          DP TX0   USB RX1/DP TX0   DP TX0
+3          DP TX1   USB TX1/DP TX1   DP TX1
+
+ * PHY lane to PMA lane mapping for a flipped plug orientation
+
+PMA LANE     C       D                 E
+0          DP TX1   USB TX1/DP TX1   DP TX1
+1          DP TX0   USB RX1/DP TX0   DP TX0
+2          DP TX3   USB RX0          DP TX3
+3          DP TX2   USB TX0          DP TX2
+
+ */
+static int udphy_set_default_mode(struct cix_udphy *udphy)
+{
+	udphy->cur_mode = UDPHY_MODE_NONE;
+	return 0;
+}
+
+static void cix_udphy_remove_lookup(void *data)
+{
+	struct cix_udphy_lookup *lookup = data;
+
+	phy_remove_lookup(lookup->phy, lookup->con_id, lookup->dev_id);
+}
+
+static int cix_udphy_create_lookup(struct cix_udphy *udphy, struct phy *phy,
+				   const char *con_id)
+{
+	struct cix_udphy_lookup *lookup;
+	int ret;
+
+	lookup = devm_kzalloc(udphy->dev, sizeof(*lookup), GFP_KERNEL);
+	if (!lookup)
+		return -ENOMEM;
+
+	lookup->con_id = devm_kstrdup(udphy->dev, con_id, GFP_KERNEL);
+	lookup->dev_id = devm_kstrdup(udphy->dev, dev_name(udphy->dev),
+				      GFP_KERNEL);
+	if (!lookup->con_id || !lookup->dev_id)
+		return -ENOMEM;
+	lookup->phy = phy;
+
+	ret = phy_create_lookup(lookup->phy, lookup->con_id, lookup->dev_id);
+	if (ret)
+		return ret;
+
+	return devm_add_action_or_reset(udphy->dev, cix_udphy_remove_lookup,
+					lookup);
+}
+
+static int cix_udphy_probe(struct platform_device *pdev)
+{
+	struct cix_udphy *udphy;
+	struct device *dev = &pdev->dev;
+	struct phy_provider *phy_provider = NULL;
+	u32 property_id;
+	int dp_children = 0;
+	int usb_children = 0;
+	bool has_mode_switch;
+	int id;
+	int ret;
+	struct gop_status __iomem *g_status;
+	enum phy_role gop_value = USB_ROLE_NONE;
+
+	udphy = devm_kzalloc(dev, sizeof(*udphy), GFP_KERNEL);
+	if (!udphy)
+		return -ENOMEM;
+
+	platform_set_drvdata(pdev, udphy);
+	udphy->dev = dev;
+
+	id = dev->of_node ? of_alias_get_id(dev->of_node, "usbdpphy") : -ENODEV;
+	if (id < 0) {
+		ret = device_property_read_u32(dev, "id", &property_id);
+		if (ret)
+			return dev_err_probe(dev, ret,
+					     "missing USB/DP PHY instance ID\n");
+		id = property_id;
+	}
+	if (id < 0 || id >= CIX_UDPHY_COUNT)
+		return dev_err_probe(dev, -EINVAL,
+				     "USB/DP PHY instance ID %d is out of range\n",
+				     id);
+	udphy->id = id;
+
+	udphy->cfg = device_get_match_data(dev);
+	if (!udphy->cfg)
+		return dev_err_probe(dev, -EINVAL, "missing match data\n");
+
+	udphy->reset = devm_reset_control_get(dev, "reset");
+	if (IS_ERR(udphy->reset))
+		return dev_err_probe(dev, PTR_ERR(udphy->reset),
+				     "failed to get PHY reset\n");
+
+	udphy->preset = devm_reset_control_get(dev, "preset");
+	if (IS_ERR(udphy->preset))
+		return dev_err_probe(dev, PTR_ERR(udphy->preset),
+				     "failed to get PHY preset\n");
+
+	ret = device_property_read_u8(dev, "default_conf", &udphy->next_mode);
+	if (ret && ret != -EINVAL && ret != -ENODATA)
+		return dev_err_probe(dev, ret,
+				     "failed to read default PHY mode\n");
+	if (udphy->next_mode > UDPHY_MODE_DP_USB)
+		return dev_err_probe(dev, -EINVAL,
+				     "invalid default PHY mode %#x\n",
+				     udphy->next_mode);
+
+	/*
+	 * Determine whether the first consumer must reprogram the PHY.
+	 *
+	 * Under ACPI, firmware has already configured all PHYs and the
+	 * xHCI controllers are active via PNP0D10 platform devices.
+	 * Resetting PHYs during probe would kill active USB connections. Skip the
+	 * GOP status check entirely — it reflects UEFI-time state that
+	 * is stale by the time Linux drivers probe.
+	 *
+	 * Under DT, the GOP status tells us which PHYs are in use by
+	 * the UEFI graphics output (dp+usb3 hub should not be reset,
+	 * dp-only should not be reset).
+	 */
+	udphy->phy_init_skip_count = 0;
+
+	if (!ACPI_COMPANION(dev)) {
+		g_status = ioremap(GOP_STATUS_ADDRESS, GOP_STATUS_SIZE);
+		if (g_status) {
+			gop_value = readb(&g_status->phy_status[id]);
+			switch (gop_value) {
+			case USB_ROLE_HOST:
+				udphy->phy_init_skip_count = 2;
+				break;
+			case USB_ROLE_HOST_20:
+			case USB_ROLE_NONE:
+			case USB_ROLE_DEVICE:
+			default:
+				udphy->phy_init_skip_count = 0;
+				break;
+			}
+			iounmap(g_status);
+		}
+		dev_dbg(dev, "GOP PHY status[%d]: %d\n", id, gop_value);
+	}
+
+	udphy->apb_clk = devm_clk_get(dev, "pclk");
+	if (IS_ERR(udphy->apb_clk))
+		return dev_err_probe(dev, PTR_ERR(udphy->apb_clk),
+				     "failed to get PHY APB clock\n");
+
+	udphy->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(udphy->base))
+		return PTR_ERR(udphy->base);
+
+	udphy->phy_regmap = devm_regmap_init(dev, NULL, udphy, &cix_udphy_regmap_cfg);
+	if (IS_ERR(udphy->phy_regmap))
+		return dev_err_probe(dev, PTR_ERR(udphy->phy_regmap),
+				     "failed to create PHY regmap\n");
+
+	udphy->usbphy_syscon =
+		device_syscon_regmap_lookup_by_property(&pdev->dev,
+					"cix,usbphy_syscon");
+	if (IS_ERR(udphy->usbphy_syscon))
+		return dev_err_probe(dev, PTR_ERR(udphy->usbphy_syscon),
+				     "failed to get USB PHY syscon\n");
+
+	mutex_init(&udphy->mutex);
+	udphy_set_default_mode(udphy);
+	has_mode_switch = IS_REACHABLE(CONFIG_TYPEC) &&
+			  device_property_present(dev, "mode-switch");
+
+	device_for_each_child_node_scoped(dev, child) {
+		struct device_node *child_np = to_of_node(child);
+		const char *name = fwnode_get_name(child);
+		struct phy *phy;
+
+		if (name && (!strncmp(name, "dp-port", 7) ||
+			     !strncmp(name, "UDPP", 4))) {
+			if (dp_children++)
+				return dev_err_probe(dev, -EINVAL,
+						     "duplicate DisplayPort PHY child\n");
+			phy = devm_phy_create(dev, child_np, &cix_dp_phy_ops);
+		} else if (name && (!strncmp(name, "usb-port", 8) ||
+				    !strncmp(name, "USB", 3))) {
+			if (usb_children++)
+				return dev_err_probe(dev, -EINVAL,
+						     "duplicate USB PHY child\n");
+			phy = devm_phy_create(dev, child_np, &cix_u3phy_ops);
+		} else {
+			continue;
+		}
+
+		if (IS_ERR(phy))
+			return dev_err_probe(dev, PTR_ERR(phy),
+					     "failed to create %s PHY\n", name);
+
+		phy_set_drvdata(phy, udphy);
+		ret = cix_udphy_create_lookup(udphy, phy, name);
+		if (ret)
+			return dev_err_probe(dev, ret,
+					     "failed to create %s PHY lookup\n", name);
+
+		if (!strncmp(name, "dp-port", 7) || !strncmp(name, "UDPP", 4))
+			udphy->dp_phy = phy;
+	}
+
+	if (dp_children != 1 || usb_children != 1)
+		return dev_err_probe(dev, -EINVAL,
+				     "expected one USB and one DisplayPort PHY child\n");
+
+	if (dev->of_node) {
+		phy_provider = devm_of_phy_provider_register(dev,
+						     of_phy_simple_xlate);
+		if (IS_ERR(phy_provider))
+			return dev_err_probe(dev, PTR_ERR(phy_provider),
+					     "failed to register OF PHY provider\n");
+	}
+
+	if (IS_REACHABLE(CONFIG_TYPEC) &&
+	    device_property_present(dev, "orientation-switch")) {
+		ret = udphy_setup_orien_switch(udphy);
+		if (ret)
+			return ret;
+
+		ret = devm_add_action_or_reset(dev, udphy_orien_switch_unregister,
+					       udphy);
+		if (ret)
+			return ret;
+	}
+
+	if (has_mode_switch) {
+		ret = udphy_setup_typec_mux(udphy);
+		if (ret)
+			return ret;
+
+		ret = devm_add_action_or_reset(dev, udphy_typec_mux_unregister,
+					       udphy);
+		if (ret)
+			return ret;
+	}
+
+	if (!has_mode_switch) {
+		if (udphy->next_mode == UDPHY_MODE_NONE)
+			udphy->next_mode = UDPHY_MODE_DP_USB;
+		ret = usbdp_set_dpphy_mode(udphy);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static const struct of_device_id cix_udphy_dt_match[] = {
+	{
+		.compatible = "cix,sky1-usbdp-phy",
+		.data = &sky1_udphy_cfg
+	},
+	{ /* sentinel */ }
+};
+
+MODULE_DEVICE_TABLE(of, cix_udphy_dt_match);
+
+static const struct acpi_device_id cix_udphy_acpi_match[] = {
+	{ "CIXH2033", (kernel_ulong_t)&sky1_udphy_cfg },
+	{ },
+};
+
+MODULE_DEVICE_TABLE(acpi, cix_udphy_acpi_match);
+
+static struct platform_driver cix_udphy_driver = {
+	.probe		= cix_udphy_probe,
+	.driver		= {
+		.name	= "cix-usbdp-phy",
+		.of_match_table = cix_udphy_dt_match,
+		.acpi_match_table = cix_udphy_acpi_match,
+		.pm = NULL,
+	},
+};
+
+module_platform_driver(cix_udphy_driver);
+
+MODULE_AUTHOR("Chao Zeng <chao.zeng@cixteck.com>");
+MODULE_DESCRIPTION("Cix USBDP Combo PHY driver");
+MODULE_LICENSE("GPL");
