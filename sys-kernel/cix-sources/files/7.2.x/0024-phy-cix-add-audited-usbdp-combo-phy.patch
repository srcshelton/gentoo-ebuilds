+static int udphy_dplane_get(struct cix_udphy *udphy)
+{
+	int dp_lanes;
+
+	switch (udphy->next_mode) {
+	case UDPHY_MODE_DP:
+		dp_lanes = 4;
+		break;
+	case UDPHY_MODE_DP_USB:
+		dp_lanes = 2;
+		break;
+	case UDPHY_MODE_USB:
+		fallthrough;
+	default:
+		dp_lanes = 0;
+		break;
+	}
+
+	return dp_lanes;
+}
+
+static int sky1_udphy_clk_enable(struct clk *clk)
+{
+	int i, ret = -EBUSY;
+
+	/*
+	 * If the clock could not enable 10 iterations,
+	 * it considers this clock is broken.
+	 */
+	for (i = 0; i < 10; i++) {
+		ret = clk_prepare_enable(clk);
+		if (!ret)
+			return 0;
+
+		usleep_range(5000, 6000);
+	}
+
+	return ret;
+}
+
+static int sky1_udphy_exit(struct cix_udphy *udphy)
+{
+	int preset_ret;
+	int reset_ret;
+
+	dev_dbg(udphy->dev, "%s\n", __func__);
+	reset_ret = reset_control_assert(udphy->reset);
+	preset_ret = reset_control_assert(udphy->preset);
+	clk_disable_unprepare(udphy->apb_clk);
+
+	return reset_ret ?: preset_ret;
+}
+
+static int sky1_udphy_init(struct cix_udphy *udphy)
+{
+	int ret;
+	u32 value;
+
+	ret = regmap_update_bits(udphy->usbphy_syscon,
+				 udphy->cfg->con_dir[udphy->id].offset,
+				 BIT(udphy->cfg->con_dir[udphy->id].bit),
+				 udphy->flip << udphy->cfg->con_dir[udphy->id].bit);
+	if (ret)
+		return ret;
+
+	udelay(10);
+
+	ret = regmap_read(udphy->usbphy_syscon,
+			  udphy->cfg->con_dir[udphy->id].offset, &value);
+	if (ret)
+		return ret;
+	dev_dbg(udphy->dev, "Type-C direction register: %#x\n", value);
+
+	ret = reset_control_assert(udphy->reset);
+	if (ret)
+		return ret;
+
+	ret = reset_control_assert(udphy->preset);
+	if (ret)
+		return ret;
+
+	ret = sky1_udphy_clk_enable(udphy->apb_clk);
+	if (ret)
+		return ret;
+
+	ret = reset_control_deassert(udphy->preset);
+	if (ret)
+		goto disable_clock;
+
+	if (udphy->next_mode == UDPHY_MODE_DP) {
+		dev_dbg(udphy->dev, "programming four-lane DisplayPort mode\n");
+		ret = regmap_multi_reg_write(udphy->phy_regmap, sky1_udphy_dp_conf,
+						ARRAY_SIZE(sky1_udphy_dp_conf));
+		if (ret)
+			goto assert_resets;
+	} else if (!udphy->flip) {
+		ret = regmap_multi_reg_write(udphy->phy_regmap,
+					     sky1_udphy_usbdp_conf_normal,
+					     ARRAY_SIZE(sky1_udphy_usbdp_conf_normal));
+		if (ret)
+			goto assert_resets;
+	} else {
+		ret = regmap_multi_reg_write(udphy->phy_regmap,
+					     sky1_udphy_usbdp_conf_flip,
+					     ARRAY_SIZE(sky1_udphy_usbdp_conf_flip));
+		if (ret)
+			goto assert_resets;
+	}
+
+	ret = reset_control_deassert(udphy->reset);
+	if (ret)
+		goto assert_resets;
+
+	return 0;
+
+assert_resets:
+	reset_control_assert(udphy->reset);
+	reset_control_assert(udphy->preset);
+disable_clock:
+	clk_disable_unprepare(udphy->apb_clk);
+	return ret;
+}
