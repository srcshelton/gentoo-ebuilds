@@ -244,6 +252,38 @@ static void sbsa_gwdt_get_version(struct watchdog_device *wdd)
 		!action && (impl == SBSA_GWDT_IMPL_MEDIATEK);
 }
 
+static bool sbsa_gwdt_is_cix_sky1(struct platform_device *pdev)
+{
+	const struct resource *cf_res;
+	const struct resource *rf_res;
+#if IS_ENABLED(CONFIG_ACPI)
+	struct acpi_table_header *gtdt;
+	bool match;
+#endif
+
+	cf_res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	rf_res = platform_get_resource(pdev, IORESOURCE_MEM, 1);
+	if (!cf_res || !rf_res ||
+	    cf_res->start != CIX_SKY1_GWDT_CONTROL_BASE ||
+	    rf_res->start != CIX_SKY1_GWDT_REFRESH_BASE)
+		return false;
+
+#if IS_ENABLED(CONFIG_ACPI)
+	if (acpi_disabled ||
+	    ACPI_FAILURE(acpi_get_table(ACPI_SIG_GTDT, 0, &gtdt)))
+		return false;
+
+	match = !memcmp(gtdt->oem_id, "CIXTEK", ACPI_OEM_ID_SIZE) &&
+		!memcmp(gtdt->oem_table_id, "SKY1EDK2",
+			ACPI_OEM_TABLE_ID_SIZE);
+	acpi_put_table(gtdt);
+
+	return match;
+#else
+	return false;
+#endif
+}
+
 static int sbsa_gwdt_start(struct watchdog_device *wdd)
 {
