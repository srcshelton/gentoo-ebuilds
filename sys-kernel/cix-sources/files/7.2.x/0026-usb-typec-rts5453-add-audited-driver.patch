Validate Type-C connector ownership and state, and initialize the
connector-search result before iteration.

Source: cixtech/cix-linux-main commit
19f2947303670f2e5734d6a96ffc72a80fd9b942.

diff --git a/drivers/usb/typec/Kconfig b/drivers/usb/typec/Kconfig
--- a/drivers/usb/typec/Kconfig
+++ b/drivers/usb/typec/Kconfig
@@ -110,6 +110,22 @@ config TYPEC_WUSB3801
 	  If you choose to build this driver as a dynamically linked module, the
 	  module will be called wusb3801.ko.
 
+config TYPEC_RTS5453
+	tristate "Realtek RTS5453 Type-C PD controller driver"
+	depends on I2C
+	depends on ACPI || OF
+	depends on USB_ROLE_SWITCH || !USB_ROLE_SWITCH
+	select PHY_CIX_USBDP if ACPI && ARCH_CIX
+	select REGMAP_I2C
+	help
+	  Say Y or M here if your system has a Realtek RTS5453H USB Type-C
+	  Power Delivery controller. The controller handles USB PD negotiation
+	  autonomously; this driver reports connector state and controls the
+	  firmware-described USB role, orientation and DisplayPort muxes.
+
+	  If you choose to build this driver as a dynamically linked module, the
+	  module will be called rts5453.ko.
+
 source "drivers/usb/typec/mux/Kconfig"
 
 source "drivers/usb/typec/altmodes/Kconfig"
