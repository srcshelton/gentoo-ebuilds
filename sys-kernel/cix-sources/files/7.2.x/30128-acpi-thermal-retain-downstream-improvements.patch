+static char *acpi_thermal_get_label(struct acpi_device *device)
+{
+	struct acpi_buffer buffer = { ACPI_ALLOCATE_BUFFER, NULL };
+	union acpi_object *obj;
+	acpi_status status;
+	char *label = NULL;
+	int length;
+
+	status = acpi_evaluate_object_typed(device->handle, "_STR", NULL,
+					    &buffer, ACPI_TYPE_BUFFER);
+	if (ACPI_FAILURE(status))
+		return NULL;
+
+	obj = buffer.pointer;
+	if (!obj || !obj->buffer.pointer || !obj->buffer.length ||
+	    obj->buffer.length % sizeof(wchar_t) ||
+	    obj->buffer.length > (INT_MAX - 1) / 2)
+		goto out;
+
+	label = kmalloc(obj->buffer.length * 2 + 1, GFP_KERNEL);
+	if (!label)
+		goto out;
+
+	length = utf16s_to_utf8s((const wchar_t *)obj->buffer.pointer,
+				 obj->buffer.length / sizeof(wchar_t),
+				 UTF16_LITTLE_ENDIAN, label,
+				 obj->buffer.length * 2);
+	if (length <= 0) {
+		kfree(label);
+		label = NULL;
+	} else {
+		label[length] = '\0';
+	}
+
+out:
+	ACPI_FREE(buffer.pointer);
+	return label;
+}
