+{
+	struct mpam_resctrl_res *res =
+		&mpam_resctrl_controls[RDT_RESOURCE_MBW_PROP];
+
+	if (!res->class)
+		return enable ? -EOPNOTSUPP : 0;
+
+	if (enable && cdp_enabled)
+		return -EINVAL;
+
+	if (res->class->mbw_prop_enabled == enable)
+		return 0;
+
+	res->class->mbw_prop_enabled = enable;
+	if (enable)
