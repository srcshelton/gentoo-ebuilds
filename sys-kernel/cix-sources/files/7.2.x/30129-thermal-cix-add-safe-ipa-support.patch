+	const char *driver = cpufreq_get_current_driver();
+	struct cppc_cpudata *cpu_data;
+
+	if (!driver || strcmp(driver, cppc_cpufreq_driver.name))
+		return NULL;
+
+	cpu_data = policy->driver_data;
+	if (!cpu_data)
+		return NULL;
+
+	return cpu_data->cix_thermal;
+}
+
+int cix_cppc_thermal_opp_count(struct cpufreq_policy *policy)
+{
+	struct cix_cppc_thermal_data *thermal = cix_cppc_thermal_data(policy);
+
+	return thermal ? thermal->count : -ENODEV;
+}
+
+int cix_cppc_thermal_state_to_freq(struct cpufreq_policy *policy,
+				   unsigned long state, unsigned int *freq)
+{
+	struct cix_cppc_thermal_data *thermal = cix_cppc_thermal_data(policy);
+	unsigned int index;
+
+	if (!thermal)
+		return -ENODEV;
+	if (state >= thermal->count)
+		return -EINVAL;
+
+	index = thermal->count - state - 1;
+	*freq = thermal->opp[index].freq_khz;
+	return 0;
+}
+
+int cix_cppc_thermal_state_to_power(struct cpufreq_policy *policy,
+				    unsigned long state, u32 *power)
+{
+	struct cix_cppc_thermal_data *thermal = cix_cppc_thermal_data(policy);
+	unsigned int index;
+
+	if (!thermal)
+		return -ENODEV;
+	if (state >= thermal->count)
+		return -EINVAL;
+
+	index = thermal->count - state - 1;
+	/* SCMI proves mW; the vendor cpufreq model defines one-CPU cost. */
+	*power = thermal->opp[index].power_mw;
+	return 0;
+}
+
+static int cix_cppc_thermal_policy_domain(struct cpufreq_policy *policy,
+					  u32 *domain)
+{
+	struct acpi_object_list input;
+	union acpi_object param;
+	bool have_domain = false;
+	unsigned int cpu;
+
+	param.type = ACPI_TYPE_INTEGER;
+	input.count = 1;
+	input.pointer = &param;
+
+	for_each_cpu(cpu, policy->cpus) {
+		struct acpi_madt_generic_interrupt *gicc;
+		unsigned long long value;
+		acpi_status status;
+
+		gicc = acpi_cpu_get_madt_gicc(cpu);
+		if (!gicc)
+			return -ENODEV;
+
+		param.integer.value = gicc->uid;
+		status = acpi_evaluate_integer(NULL, "\\_SB.PMMX.PEGM",
+					       &input, &value);
+		if (ACPI_FAILURE(status))
+			return status == AE_NOT_FOUND ? -ENODEV : -EIO;
+		if (value > U32_MAX)
+			return -ERANGE;
+
+		if (!have_domain) {
+			*domain = value;
+			have_domain = true;
+		} else if (*domain != value) {
+			return -EBADMSG;
+		}
+	}
+
+	return have_domain ? 0 : -ENODATA;
+}
+
+static int cix_cppc_thermal_check_power_units(u32 domain)
+{
+	struct acpi_buffer buffer = { ACPI_ALLOCATE_BUFFER, NULL };
+	union acpi_object *object;
+	const u8 *data;
+	acpi_status status;
+	s32 scmi_status;
+	u16 num_domains;
+	u16 flags;
+	int ret;
+
+	status = acpi_evaluate_object(NULL, "\\_SB.PMMX.PEGA", NULL, &buffer);
+	if (ACPI_FAILURE(status)) {
+		ret = status == AE_NOT_FOUND ? -ENODEV : -EIO;
+		goto out;
+	}
+
+	object = buffer.pointer;
+	if (!object || object->type != ACPI_TYPE_BUFFER ||
+	    !object->buffer.pointer || object->buffer.length < 20) {
+		ret = -EBADMSG;
+		goto out;
+	}
+
+	data = object->buffer.pointer;
+	scmi_status = get_unaligned_le32(data);
+	num_domains = get_unaligned_le16(data + 4);
+	flags = get_unaligned_le16(data + 6);
+	/*
+	 * Accept the SCMI v1 milliwatt contract only.  The response contains a
+	 * 16-bit domain count followed by 16-bit flags; flag bit 0 denotes mW,
+	 * while bit 1 denotes the incompatible uW contract in SCMI v3.  Firmware
+	 * PEFG accepts the SCMI domain obtained by mapping each ACPI processor
+	 * UID through the table-upgrade PEGM method.
+	 */
+	if (scmi_status || !num_domains || domain >= num_domains ||
+	    flags != BIT(0))
+		ret = -EBADMSG;
+	else
+		ret = 0;
+
+out:
+	ACPI_FREE(buffer.pointer);
+	return ret;
+}
+
+static struct cix_cppc_thermal_data *
+cix_cppc_thermal_parse(struct cpufreq_policy *policy,
+		       struct cppc_cpudata *cpu_data)
+{
+	struct cix_cppc_thermal_data *thermal;
+	struct acpi_object_list input;
+	union acpi_object params[2];
+	unsigned int expected = UINT_MAX;
+	unsigned int level_index = 0;
+	u32 domain;
+	int ret = -ENODATA;
+
+	ret = cix_cppc_thermal_policy_domain(policy, &domain);
+	if (ret)
+		return ERR_PTR(ret);
+
+	ret = cix_cppc_thermal_check_power_units(domain);
+	if (ret)
+		return ERR_PTR(ret);
+
+	thermal = kzalloc_obj(*thermal);
+	if (!thermal)
+		return ERR_PTR(-ENOMEM);
+
+	params[0].type = ACPI_TYPE_INTEGER;
+	params[0].integer.value = domain;
+	params[1].type = ACPI_TYPE_INTEGER;
+	input.count = ARRAY_SIZE(params);
+	input.pointer = params;
+
+	for (;;) {
+		struct acpi_buffer buffer = { ACPI_ALLOCATE_BUFFER, NULL };
+		union acpi_object *object;
+		unsigned int returned, remaining, i;
+		u32 level_counts;
+		const u8 *data;
+		acpi_status status;
+		s32 scmi_status;
+		size_t needed;
+
+		params[1].integer.value = level_index;
+		status = acpi_evaluate_object(NULL, "\\_SB.PMMX.PEFG", &input,
+					      &buffer);
+		if (ACPI_FAILURE(status)) {
+			ret = status == AE_NOT_FOUND ? -ENODEV : -EIO;
+			goto free_buffer;
+		}
+
+		object = buffer.pointer;
+		if (!object || object->type != ACPI_TYPE_BUFFER ||
+		    !object->buffer.pointer || object->buffer.length < 8) {
+			ret = -EBADMSG;
+			goto free_buffer;
+		}
+
+		data = object->buffer.pointer;
+		scmi_status = get_unaligned_le32(data);
+		level_counts = get_unaligned_le32(data + 4);
+		/* Sky1 implements SCMI v1.0: bits 15:12 are reserved. */
+		if (level_counts & GENMASK(15, 12)) {
+			ret = -EBADMSG;
+			goto free_buffer;
+		}
+		returned = level_counts & GENMASK(11, 0);
+		remaining = level_counts >> 16;
+
+		if (scmi_status || !returned ||
+		    returned > CIX_CPPC_THERMAL_MAX_OPPS - thermal->count ||
+		    remaining > CIX_CPPC_THERMAL_MAX_OPPS - thermal->count - returned ||
+		    (expected != UINT_MAX && returned + remaining != expected)) {
+			ret = -EBADMSG;
+			goto free_buffer;
+		}
+
+		needed = 8 + returned * 12;
+		/* Validate all records reported within the padded firmware buffer. */
+		if (object->buffer.length < needed) {
+			ret = -EBADMSG;
+			goto free_buffer;
+		}
+
+		for (i = 0; i < returned; i++) {
+			struct cix_cppc_opp *opp;
+			const u8 *entry = data + 8 + i * 12;
+
+			/* The final u16 is reserved in SCMI performance v1. */
+			if (get_unaligned_le16(entry + 10)) {
+				ret = -EBADMSG;
+				goto free_buffer;
+			}
+
+			opp = &thermal->opp[thermal->count++];
+			opp->perf = get_unaligned_le32(entry);
+			opp->power_mw = get_unaligned_le32(entry + 4);
+			opp->freq_khz =
+				cppc_perf_to_khz(&cpu_data->perf_caps, opp->perf);
+		}
+
+		level_index += returned;
+		expected = remaining;
+		ret = 0;
+
+free_buffer:
+		ACPI_FREE(buffer.pointer);
+		if (ret || !remaining)
+			break;
+	}
+
+	if (ret)
+		goto free_thermal;
+
+	sort(thermal->opp, thermal->count, sizeof(thermal->opp[0]),
+	     cix_cppc_opp_cmp, NULL);
+
+	for (level_index = 0; level_index < thermal->count; level_index++) {
+		struct cix_cppc_opp *opp = &thermal->opp[level_index];
+
+		if (!opp->perf || !opp->power_mw || !opp->freq_khz ||
+		    opp->perf < cpu_data->perf_caps.lowest_perf ||
+		    opp->perf > cpu_data->perf_caps.highest_perf ||
+		    (level_index &&
+		     (opp->perf <= thermal->opp[level_index - 1].perf ||
+		      opp->power_mw <= thermal->opp[level_index - 1].power_mw ||
+		      opp->freq_khz <= thermal->opp[level_index - 1].freq_khz))) {
+			ret = -ERANGE;
+			goto free_thermal;
+		}
+	}
+
+	if (thermal->count < 2) {
+		ret = -ENODATA;
+		goto free_thermal;
+	}
+	if (thermal->opp[0].perf != cpu_data->perf_caps.lowest_perf ||
+	    thermal->opp[thermal->count - 1].perf !=
+		cpu_data->perf_caps.highest_perf) {
+		ret = -ERANGE;
+		goto free_thermal;
+	}
+
+	return thermal;
+
+free_thermal:
+	kfree(thermal);
+	return ERR_PTR(ret);
+}
