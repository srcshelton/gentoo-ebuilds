+#ifdef CONFIG_CIX_THERMAL
+static bool
+cix_thermal_build_policy_model(struct cpufreq_policy *policy,
+			       const struct cpumask *related_cpus,
+			       struct cix_thermal_actor_cache *model)
+{
+	int count, state;
+
+	memset(model, 0, sizeof(*model));
+	cpumask_copy(&model->related_cpus, related_cpus);
+	model->min_freq = policy->cpuinfo.min_freq;
+	model->max_freq = policy->cpuinfo.max_freq;
+	model->shared_type = policy->shared_type;
+	model->frequency_model_valid = model->min_freq && model->max_freq &&
+		model->min_freq <= model->max_freq;
+
+	count = cix_cppc_thermal_opp_count(policy);
+	if (count <= 1 || count > CIX_CPPC_THERMAL_MAX_OPPS)
+		return false;
+
+	for (state = 0; state < count; state++) {
+		if (cix_cppc_thermal_state_to_freq(policy, state,
+						   &model->freq_khz[state]) ||
+		    cix_cppc_thermal_state_to_power(policy, state,
+						    &model->power_mw[state]))
+			return false;
+	}
+
+	/* State zero must be no stricter than the complete policy contract. */
+	if (model->freq_khz[0] != model->max_freq ||
+	    model->freq_khz[count - 1] != model->min_freq)
+		return false;
+
+	model->opp_count = count;
+	return true;
+}
+
+static bool
+cix_thermal_frequency_model_equal(const struct cix_thermal_actor_cache *a,
+				  const struct cix_thermal_actor_cache *b)
+{
+	return a->opp_count == b->opp_count &&
+	       !memcmp(a->freq_khz, b->freq_khz,
+		       a->opp_count * sizeof(a->freq_khz[0]));
+}
+
+static bool
+cix_thermal_policy_identity_equal(const struct cix_thermal_actor_cache *a,
+				  const struct cix_thermal_actor_cache *b)
+{
+	return cpumask_equal(&a->related_cpus, &b->related_cpus) &&
+	       a->shared_type == b->shared_type;
+}
+
+static bool
+cix_thermal_policy_contract_equal(const struct cix_thermal_actor_cache *a,
+				  const struct cix_thermal_actor_cache *b)
+{
+	return cix_thermal_policy_identity_equal(a, b) &&
+	       a->min_freq == b->min_freq && a->max_freq == b->max_freq;
+}
+
+static void
+cix_thermal_refresh_cached_model(const struct cix_thermal_actor_cache *cached,
+				 const struct cix_thermal_actor_cache *model)
+{
+	unsigned long flags;
+	unsigned int cpu;
+
+	spin_lock_irqsave(&cix_thermal_cache_lock, flags);
+	for_each_cpu(cpu, &cached->related_cpus) {
+		struct cix_thermal_actor_cache *cache =
+			&per_cpu(cix_thermal_cache, cpu);
+
+		if (!cache->active ||
+		    !cix_thermal_policy_contract_equal(cache, cached) ||
+		    !cix_thermal_frequency_model_equal(cache, cached))
+			continue;
+
+		memcpy(cache->power_mw, model->power_mw,
+		       model->opp_count * sizeof(model->power_mw[0]));
+		cache->degraded = false;
+	}
+	spin_unlock_irqrestore(&cix_thermal_cache_lock, flags);
+}
+
+static void
+cix_thermal_clear_degraded(const struct cix_thermal_actor_cache *cached)
+{
+	unsigned long flags;
+	unsigned int cpu;
+
+	spin_lock_irqsave(&cix_thermal_cache_lock, flags);
+	for_each_cpu(cpu, &cached->related_cpus) {
+		struct cix_thermal_actor_cache *cache =
+			&per_cpu(cix_thermal_cache, cpu);
+
+		if (cache->active &&
+		    cix_thermal_policy_contract_equal(cache, cached) &&
+		    cix_thermal_frequency_model_equal(cache, cached))
+			cache->degraded = false;
+	}
+	spin_unlock_irqrestore(&cix_thermal_cache_lock, flags);
+}
+
+static void
+cix_thermal_fail_closed(struct cpufreq_policy *policy,
+			const struct cix_thermal_actor_cache *cached)
+{
+	unsigned int state = cached->opp_count > 1 ? cached->opp_count - 1 :
+						 cpufreq_thermal_max_step;
+	unsigned long flags;
+	unsigned int cpu;
+	bool bounded = false;
+
+	/*
+	 * The old requests remain attached to this policy across the lightweight
+	 * CPU-hotplug restart.  Apply the new policy minimum before making the
+	 * cached actor unavailable to power_allocator callbacks.
+	 */
+	mutex_lock(&cix_thermal_qos_lock);
+	for_each_cpu(cpu, &cached->related_cpus) {
+		struct acpi_processor *pr = per_cpu(processors, cpu);
+		int ret;
+
+		if (!pr || !freq_qos_request_active(&pr->thermal_req))
+			continue;
+
+		ret = freq_qos_update_request(&pr->thermal_req,
+					      policy->cpuinfo.min_freq);
+		if (ret < 0)
+			pr_err("Failed to bound restarted CPU%d thermal policy (%d)\n",
+			       cpu, ret);
+		else
+			bounded = true;
+	}
+
+	spin_lock_irqsave(&cix_thermal_cache_lock, flags);
+	for_each_cpu(cpu, &cached->related_cpus) {
+		struct cix_thermal_actor_cache *cache =
+			&per_cpu(cix_thermal_cache, cpu);
+
+		if (cache->active)
+			cache->degraded = true;
+	}
+	spin_unlock_irqrestore(&cix_thermal_cache_lock, flags);
+	for_each_cpu(cpu, &cached->related_cpus)
+		WRITE_ONCE(reduction_step(cpu), state);
+	mutex_unlock(&cix_thermal_qos_lock);
+
+	if (!bounded)
+		pr_crit("CPU%d CIX thermal restart could not install a fail-closed frequency cap\n",
+			policy->cpu);
+
+	for_each_cpu(cpu, &cached->related_cpus) {
+		struct acpi_processor *pr = per_cpu(processors, cpu);
+
+		if (pr && pr->cdev)
+			thermal_cooling_device_update(pr->cdev);
+	}
+}
+
+int acpi_thermal_cpufreq_cix_restart(struct cpufreq_policy *policy)
+{
+	struct cix_thermal_actor_cache cached, model;
+	bool model_valid;
+	bool contract_equal;
+	bool identity_equal;
+
+	cix_thermal_actor_snapshot(policy->cpu, &cached);
+	if (!cached.active)
+		return 0;
+
+	model_valid = cix_thermal_build_policy_model(policy,
+						     policy->cpus, &model);
+	identity_equal = cix_thermal_policy_identity_equal(&cached, &model);
+	contract_equal = cix_thermal_policy_contract_equal(&cached, &model);
+
+	/*
+	 * The cpufreq core has not yet copied policy->cpus into related_cpus or
+	 * rebuilt its per-CPU policy links.  Reject an identity change rather
+	 * than accepting a partially mapped policy.
+	 */
+	if (!identity_equal) {
+		cix_thermal_fail_closed(policy, &cached);
+		pr_err("CPU%d CIX thermal policy CPU mask or shared type changed; rejecting the unsupported restart\n",
+		       policy->cpu);
+		return -EINVAL;
+	}
+
+	/* A generic, non-PEFG cooling device never became a PA power actor. */
+	if (cached.opp_count <= 1 && contract_equal) {
+		if (cached.degraded) {
+			cix_thermal_clear_degraded(&cached);
+			pr_info("CPU%d restored its bounded generic thermal policy contract\n",
+				policy->cpu);
+		}
+		return 0;
+	}
+
+	if (contract_equal) {
+		if (!model_valid && !cached.degraded) {
+			pr_warn("CPU%d retained its last validated CIX thermal model after a transient PEFG failure\n",
+				policy->cpu);
+			return 0;
+		}
+
+		if (model_valid &&
+		    cix_thermal_frequency_model_equal(&cached, &model)) {
+			cix_thermal_refresh_cached_model(&cached, &model);
+			if (cached.degraded)
+				pr_info("CPU%d restored its validated CIX thermal policy contract\n",
+					policy->cpu);
+			return 0;
+		}
+	}
+
+	/*
+	 * An admitted power actor must not silently disappear.  If a restarted
+	 * policy no longer matches its validated model, retain that model for
+	 * comparison and keep the policy at its bounded minimum until a later
+	 * restart proves that the complete contract has returned.
+	 */
+	cix_thermal_fail_closed(policy, &cached);
+	pr_err("CPU%d CIX thermal policy contract changed or remained unverified; retaining a bounded minimum-frequency cap\n",
+	       policy->cpu);
+	return 0;
+}
+
+bool acpi_processor_cix_thermal_actor_usable(unsigned int cpu)
+{
+	struct cix_thermal_actor_cache model;
+
+	if (cpu >= nr_cpu_ids)
