+	if (!pr || pr->id >= nr_cpu_ids)
+		return false;
+
+	if (!acpi_processor_cix_thermal_actor_usable(pr->id))
+		return false;
+
+	for (i = 0; i < trip->devices.count; i++) {
+		struct acpi_device *other_adev;
+		struct acpi_processor *other;
+
+		other_adev = acpi_fetch_acpi_dev(trip->devices.handles[i]);
+		if (!acpi_thermal_cix_is_processor(other_adev))
+			continue;
+
+		other = acpi_driver_data(other_adev);
+		if (!other || other->id >= nr_cpu_ids)
