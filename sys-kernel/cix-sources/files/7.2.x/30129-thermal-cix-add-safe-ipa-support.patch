+static void acpi_thermal_init_cix_power_allocator(struct acpi_thermal *tz)
+{
+	struct acpi_thermal_trip *passive = &tz->trips.passive.trip;
+	unsigned long long switch_on, sustainable;
+	bool has_cpu_actor = false;
+	bool has_swit, has_sstp;
+	unsigned int i;
+
+	has_swit = acpi_has_method(tz->device->handle, "SWIT");
+	has_sstp = acpi_has_method(tz->device->handle, "SSTP");
+	tz->cix_power_allocator_candidate = has_swit || has_sstp;
+
+	if (!tz->polling_frequency ||
+	    !acpi_thermal_trip_valid(passive) ||
+	    !has_swit || !has_sstp)
+		return;
+
+	if (ACPI_FAILURE(acpi_evaluate_integer(tz->device->handle, "SWIT",
+					       NULL, &switch_on)) ||
+	    ACPI_FAILURE(acpi_evaluate_integer(tz->device->handle, "SSTP",
