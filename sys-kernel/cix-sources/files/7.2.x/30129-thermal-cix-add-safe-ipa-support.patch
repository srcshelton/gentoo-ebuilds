+static void
+cix_processor_online_cpus(const struct cix_thermal_actor_cache *model,
+			  struct cpumask *online_cpus)
+{
+	unsigned int cpu;
+
+	cpumask_clear(online_cpus);
+	/*
+	 * Cooling callbacks can run with the cooling-device lock held, so they
+	 * must not nest a CPU-hotplug read lock against policy teardown.  The
+	 * possible mask and logical MPIDR map are stable; cpu_online() is sampled
+	 * locklessly and is therefore an advisory mask for this control interval.
+	 */
+	for_each_cpu(cpu, &model->related_cpus)
+		if (cpu_online(cpu))
+			cpumask_set_cpu(cpu, online_cpus);
+}
+
+static int cix_processor_get_power(unsigned int cpu, const char *method,
+				   u32 *power)
+{
+	struct acpi_object_list args;
+	union acpi_object arg;
+	unsigned long long value;
+	unsigned int firmware_cpu;
+	acpi_status status;
+
+	if (cpu >= nr_cpu_ids || !cpu_possible(cpu))
+		return -ENODEV;
+
+	/* SPRG/DPRG use the physical Sky1 telemetry-record index, not _UID. */
+	firmware_cpu = MPIDR_AFFINITY_LEVEL(cpu_logical_map(cpu), 1);
+	if (firmware_cpu >= CIX_SKY1_CPU_COUNT)
+		return -ERANGE;
+
+	arg.type = ACPI_TYPE_INTEGER;
+	arg.integer.value = firmware_cpu;
+	args.count = 1;
+	args.pointer = &arg;
+
+	status = acpi_evaluate_integer(NULL, (acpi_string)method, &args, &value);
+	if (ACPI_FAILURE(status))
+		return status == AE_NOT_FOUND ? -ENODEV : -EIO;
+
+	/* The firmware fields are signed 32-bit values; reject negative data. */
+	if (value > INT_MAX)
+		return -ERANGE;
+
+	*power = value;
+	return 0;
+}
+
+static int cix_processor_get_policy_power(const struct cpumask *online_cpus,
+					  const char *method, u32 *power)
+{
+	u32 total = 0;
+	unsigned int cpu;
+	int ret;
+
+	if (cpumask_empty(online_cpus))
+		return -ENODEV;
+
+	for_each_cpu(cpu, online_cpus) {
+		u32 cpu_power;
+
+		ret = cix_processor_get_power(cpu, method, &cpu_power);
+		if (ret)
+			return ret;
+		if (total > U32_MAX - cpu_power)
+			return -ERANGE;
+
+		total += cpu_power;
+	}
+
+	*power = total;
+	return 0;
+}
+
+static int cix_processor_get_cached_power(const struct cpumask *online_cpus,
+					  unsigned int actor_cpu,
+					  const char *method, bool dynamic,
+					  u32 *power)
+{
+	struct cix_thermal_actor_cache *cache =
+		&per_cpu(cix_thermal_cache, actor_cpu);
+	unsigned long flags;
+	bool used_cache = false;
+	int ret;
+
+	ret = cix_processor_get_policy_power(online_cpus, method, power);
+	spin_lock_irqsave(&cix_thermal_cache_lock, flags);
+	if (!cache->active || cache->degraded) {
+		ret = -ENODEV;
+	} else if (!ret) {
+		if (dynamic) {
+			cache->dynamic_power = *power;
+			cpumask_copy(&cache->dynamic_power_cpus, online_cpus);
+			cache->dynamic_power_valid = true;
+		} else {
+			cache->static_power = *power;
+			cpumask_copy(&cache->static_power_cpus, online_cpus);
+			cache->static_power_valid = true;
+		}
+	} else if ((dynamic ? cache->dynamic_power_valid :
+			      cache->static_power_valid) &&
+		   cpumask_equal(dynamic ? &cache->dynamic_power_cpus :
+					 &cache->static_power_cpus,
+			 online_cpus)) {
+		*power = dynamic ? cache->dynamic_power : cache->static_power;
+		used_cache = true;
+		ret = 0;
+	}
+	spin_unlock_irqrestore(&cix_thermal_cache_lock, flags);
+
+	if (used_cache)
+		pr_warn_ratelimited("CIX CPU%d using cached %s power telemetry\n",
+				    actor_cpu, method);
+	if (!ret)
+		return 0;
+
+	pr_warn_ratelimited("CIX CPU%d %s power telemetry failed (%d)\n",
+			    actor_cpu, method, ret);
+	return ret;
+}
+
+static u32 cix_processor_get_policy_load(const struct cpumask *online_cpus)
+{
+	u32 total_load = 0;
+	unsigned int cpu;
+
+	for_each_cpu(cpu, online_cpus) {
+		unsigned long capacity = arch_scale_cpu_capacity(cpu);
+
+		if (capacity)
+			total_load += min_t(unsigned long,
+					    (sched_cpu_util(cpu) * 100) / capacity,
+					    100);
+	}
+
+	return total_load;
+}
+
+static void cix_processor_cache_policy_load(unsigned int actor_cpu,
+					    const struct cpumask *online_cpus,
+					    u32 policy_load)
+{
+	struct cix_thermal_actor_cache *cache =
+		&per_cpu(cix_thermal_cache, actor_cpu);
+	unsigned long flags;
+
+	spin_lock_irqsave(&cix_thermal_cache_lock, flags);
+	if (cache->active && !cache->degraded) {
+		cache->policy_load = policy_load;
+		cpumask_copy(&cache->policy_load_cpus, online_cpus);
+		cache->policy_load_valid = true;
+	}
+	spin_unlock_irqrestore(&cix_thermal_cache_lock, flags);
+}
+
+static bool cix_processor_cached_policy_load(unsigned int actor_cpu,
+					     const struct cpumask *online_cpus,
+					     u32 *policy_load)
+{
+	struct cix_thermal_actor_cache *cache =
+		&per_cpu(cix_thermal_cache, actor_cpu);
+	unsigned long flags;
+	bool valid;
+
+	spin_lock_irqsave(&cix_thermal_cache_lock, flags);
+	valid = cache->active && !cache->degraded &&
+		cache->policy_load_valid &&
+		cpumask_equal(&cache->policy_load_cpus, online_cpus);
+	if (valid)
+		*policy_load = cache->policy_load;
+	spin_unlock_irqrestore(&cix_thermal_cache_lock, flags);
+
+	return valid;
+}
+
+static int processor_get_requested_power(struct thermal_cooling_device *cdev,
+					 u32 *power)
+{
+	struct acpi_device *device = cdev->devdata;
+	struct cix_thermal_actor_cache model;
+	cpumask_t online_cpus;
+	struct acpi_processor *pr;
+	u32 static_power, dynamic_power, policy_load;
+	int ret;
+
+	if (!device)
+		return -EINVAL;
+
+	pr = acpi_driver_data(device);
+	if (!pr || pr->id >= nr_cpu_ids)
+		return -EINVAL;
+
+	cix_thermal_actor_snapshot(pr->id, &model);
+	if (!model.active || model.degraded || model.opp_count <= 1)
+		return -ENODEV;
+
+	cix_processor_online_cpus(&model, &online_cpus);
+	if (cpumask_empty(&online_cpus)) {
+		*power = 0;
+		return 0;
+	}
+
+	policy_load = cix_processor_get_policy_load(&online_cpus);
+	cix_processor_cache_policy_load(pr->id, &online_cpus, policy_load);
+
+	ret = cix_processor_get_cached_power(&online_cpus, pr->id, "\\_SB.SPRG",
+					     false, &static_power);
+	if (ret)
+		return ret;
+	ret = cix_processor_get_cached_power(&online_cpus, pr->id, "\\_SB.DPRG",
+					     true, &dynamic_power);
+	if (ret)
+		return ret;
+	if (static_power > U32_MAX - dynamic_power)
+		return -ERANGE;
+
+	*power = static_power + dynamic_power;
+	return 0;
+}
+
+static int processor_state2power(struct thermal_cooling_device *cdev,
+				 unsigned long state, u32 *power)
+{
+	struct acpi_device *device = cdev->devdata;
+	struct cix_thermal_actor_cache model;
+	cpumask_t online_cpus;
+	struct acpi_processor *pr;
+	u32 dynamic_power, static_power;
+	u64 dynamic_total;
+	int ret;
+
+	if (!device)
+		return -EINVAL;
+
+	pr = acpi_driver_data(device);
+	if (!pr || pr->id >= nr_cpu_ids)
+		return -EINVAL;
+
+	cix_thermal_actor_snapshot(pr->id, &model);
+	if (!model.active || model.degraded || model.opp_count <= 1)
+		return -ENODEV;
+
+	cix_processor_online_cpus(&model, &online_cpus);
+	if (cpumask_empty(&online_cpus)) {
+		*power = 0;
+		return 0;
+	}
+
+	if (state >= model.opp_count)
+		return -EINVAL;
+
+	dynamic_power = model.power_mw[state];
+	ret = cix_processor_get_cached_power(&online_cpus, pr->id, "\\_SB.SPRG",
+					     false, &static_power);
+	if (ret)
+		return ret;
+
+	dynamic_total = (u64)dynamic_power * cpumask_weight(&online_cpus);
+	if (dynamic_total > U32_MAX - static_power)
+		return -ERANGE;
+
+	*power = dynamic_total + static_power;
+	return 0;
+}
+
+static int processor_power2state(struct thermal_cooling_device *cdev,
+				 u32 power, unsigned long *state)
+{
+	struct acpi_device *device = cdev->devdata;
+	struct cix_thermal_actor_cache model;
+	cpumask_t online_cpus;
+	struct acpi_processor *pr;
+	u32 dynamic_budget, last_load, static_power;
+	u64 normalised_power;
+	unsigned int i;
+	int ret;
+
+	if (!device)
+		return -EINVAL;
+
+	pr = acpi_driver_data(device);
+	if (!pr || pr->id >= nr_cpu_ids)
+		return -EINVAL;
+
+	cix_thermal_actor_snapshot(pr->id, &model);
+	if (!model.active || model.degraded || model.opp_count <= 1)
+		return -ENODEV;
+
+	cix_processor_online_cpus(&model, &online_cpus);
+	if (cpumask_empty(&online_cpus)) {
+		*state = 0;
+		return 0;
+	}
+
+	ret = cix_processor_get_cached_power(&online_cpus, pr->id, "\\_SB.SPRG",
+					     false, &static_power);
+	if (ret)
+		return ret;
+
+	dynamic_budget = power > static_power ? power - static_power : 0;
+	if (!cix_processor_cached_policy_load(pr->id, &online_cpus,
+					      &last_load))
+		last_load = cix_processor_get_policy_load(&online_cpus);
+	last_load = last_load ?: 1;
+	normalised_power = div_u64((u64)dynamic_budget * 100,
+				   last_load);
+	dynamic_budget = min_t(u64, normalised_power, U32_MAX);
+
+	for (i = 0; i < model.opp_count; i++)
+		if (dynamic_budget >= model.power_mw[i])
+			break;
+	*state = i == model.opp_count ? model.opp_count - 1 : i;
+	return 0;
+}
+#endif
+
 const struct thermal_cooling_device_ops processor_cooling_ops = {
 	.get_max_state = processor_get_max_state,
 	.get_cur_state = processor_get_cur_state,
 	.set_cur_state = processor_set_cur_state,
+#ifdef CONFIG_CIX_THERMAL
+	.get_requested_power = processor_get_requested_power,
+	.state2power = processor_state2power,
+	.power2state = processor_power2state,
+#endif
 };
 
 int acpi_processor_thermal_init(struct acpi_processor *pr,
