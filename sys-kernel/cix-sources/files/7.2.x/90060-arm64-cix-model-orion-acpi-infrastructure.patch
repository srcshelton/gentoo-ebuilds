arm64: cix: model Orion ACPI infrastructure dependencies

Make the Orion ACPI firmware choice own the early mailbox, SCMI clock,
resource-lookup, pinctrl and wake-controller infrastructure that cannot be
deferred to loadable consumers. Keep optional power-domain, GPIO, I2C and
accelerator drivers modular when their consumers are modular.

Describe the known Orion ACPI provider relationships for Panthor and O6
HDA. Express the HDA controller's clock, reset and modular GPIO providers
as one kmod-compatible soft dependency.

diff --git a/arch/arm64/Kconfig.platforms b/arch/arm64/Kconfig.platforms
--- a/arch/arm64/Kconfig.platforms
+++ b/arch/arm64/Kconfig.platforms
@@ -158,6 +158,24 @@ config CIX_RADXA_ORION_O6N
 	  systems. O6N keeps common CIX P1 SoC support but has
 	  board-specific USB, PCIe, audio, and EC/fan-control defaults.
 
+config CIX_RADXA_ORION_ACPI_INFRASTRUCTURE
+	bool
+	depends on ARCH_CIX && ACPI
+	select MAILBOX
+	select ARM_SCMI_PROTOCOL
+	select ARM_SCMI_TRANSPORT_MAILBOX
+	select CIX_MBOX
+	select COMMON_CLK
+	select COMMON_CLK_SCMI
+	select RESET_CONTROLLER
+	select CLK_SKY1_ACPI
+	select CIX_ACPI_RESOURCE_LOOKUP
+	select CIX_ACPI_PCIE_SCAN
+	select CIX_ACPI_USB_SCAN
+	select PINCTRL
+	select PINCTRL_SKY1
+	select SKY1_PDC
+
 choice
 	prompt "Radxa Orion firmware interface"
 	depends on (CIX_RADXA_ORION_O6 || CIX_RADXA_ORION_O6N) && (ACPI || OF)
@@ -167,6 +185,7 @@ choice
 config CIX_RADXA_ORION_ACPI
 	bool "ACPI firmware interface"
 	depends on ACPI
+	select CIX_RADXA_ORION_ACPI_INFRASTRUCTURE
 
 config CIX_RADXA_ORION_DT
 	bool "Device Tree firmware interface"
