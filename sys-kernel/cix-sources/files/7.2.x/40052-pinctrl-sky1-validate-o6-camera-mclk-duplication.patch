O6/O6N firmware assigns I2S3_MCLK pin 65 to both camera groups. Filter it from cam1 only when both cam0 and cam1 carry the exact known pin, offset and configuration tuple; unexpected firmware data remains visible and fails normally.

diff --git a/drivers/pinctrl/cix/pinctrl-sky1-base.c b/drivers/pinctrl/cix/pinctrl-sky1-base.c
--- a/drivers/pinctrl/cix/pinctrl-sky1-base.c
+++ b/drivers/pinctrl/cix/pinctrl-sky1-base.c
@@ -34,6 +34,9 @@
 #define PADS_FUNCS_MASK		GENMASK(1, 0)
 #define PADS_FUNCS_BITS		7
 #define PADS_CONFS_MASK		GENMASK(6, 0)
+#define SKY1_O6_CAM_MCLK_PIN	65
+#define SKY1_O6_CAM_MCLK_OFFSET	0x0104
+#define SKY1_O6_CAM_MCLK_CONFIG	0x009c
 
 static const unsigned char sky1_ds_table[] = {
 	2, 3, 5, 6, 8, 9, 11, 12, 13, 14, 17, 18, 20, 21, 23, 24,
@@ -827,16 +830,55 @@ sky1_free_acpi_group_desc(struct pinctrl_acpi_group_desc *acpi_grp_desc)
 	kfree(acpi_grp_desc);
 }
 
+static bool
+sky1_acpi_group_has_o6_cam_mclk(const struct pinctrl_acpi_group_desc *group)
+{
+	const __be16 *vendor;
+	unsigned int i;
+
+	if (!group->pins || !group->vendor_data ||
+	    group->vendor_length != group->num_pins * 2 * sizeof(u16))
+		return false;
+
+	vendor = (const __be16 *)group->vendor_data;
+	for (i = 0; i < group->num_pins; i++, vendor += 2)
+		if (group->pins[i] == SKY1_O6_CAM_MCLK_PIN &&
+		    be16_to_cpu(vendor[0]) == SKY1_O6_CAM_MCLK_OFFSET &&
+		    be16_to_cpu(vendor[1]) == SKY1_O6_CAM_MCLK_CONFIG)
+			return true;
+
+	return false;
+}
+
+static bool
+sky1_acpi_group_is_o6_cam1_duplicate(struct list_head *groups,
+				      const struct pinctrl_acpi_group_desc *group)
+{
+	struct pinctrl_acpi_group_desc *candidate;
+
+	if (!group->name || strcmp(group->name, "pinctrl_cam1_hw") ||
+	    !sky1_acpi_group_has_o6_cam_mclk(group))
+		return false;
+
+	list_for_each_entry(candidate, groups, list)
+		if (candidate->name &&
+		    !strcmp(candidate->name, "pinctrl_cam0_hw"))
+			return sky1_acpi_group_has_o6_cam_mclk(candidate);
+
+	return false;
+}
+
