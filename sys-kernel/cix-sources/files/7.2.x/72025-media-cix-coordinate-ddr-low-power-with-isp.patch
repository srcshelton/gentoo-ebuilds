diff --git a/drivers/soc/cix/cix-ddr-lp.c b/drivers/soc/cix/cix-ddr-lp.c
new file mode 100644
--- /dev/null
+++ b/drivers/soc/cix/cix-ddr-lp.c
@@ -0,0 +1,332 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * CIX Sky1 DDR low-power policy and coordination
+ *
+ * The firmware interface saves and clears the DDR low-power controls when
+ * performance is requested, then restores the saved controls when firmware
+ * policy is requested. Serialize it here so policy changes and independent
+ * kernel consumers cannot overwrite that single firmware-owned saved state.
+ */
+
+#include <linux/arm-smccc.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/errno.h>
+#include <linux/export.h>
+#include <linux/kernel.h>
+#include <linux/kobject.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/soc/cix/cix_ddr_lp.h>
+#include <linux/string.h>
+#include <linux/sysfs.h>
+
+#define CIX_SIP_SVC_SET_DDR_LP	0xc2000010
+
+enum cix_ddr_lp_policy {
+	CIX_DDR_LP_POLICY_FIRMWARE,
+	CIX_DDR_LP_POLICY_PERFORMANCE,
+};
+
+struct cix_ddr_lp {
+	struct device *dev;
+	bool held;
+};
+
+static DEFINE_MUTEX(cix_ddr_lp_lock);
+static enum cix_ddr_lp_policy cix_ddr_lp_policy =
+	CIX_DDR_LP_POLICY_FIRMWARE;
+static enum cix_ddr_lp_policy cix_ddr_lp_effective =
+	CIX_DDR_LP_POLICY_FIRMWARE;
+static unsigned int cix_ddr_lp_holders;
+static bool cix_ddr_lp_unsupported;
+static struct kobject *cix_firmware_kobj;
+static struct kobject *cix_ddr_lp_kobj;
+
+static const char *cix_ddr_lp_policy_name(enum cix_ddr_lp_policy policy)
+{
+	return policy == CIX_DDR_LP_POLICY_PERFORMANCE ?
+		"performance" : "firmware";
+}
+
+static enum cix_ddr_lp_policy
+cix_ddr_lp_target(enum cix_ddr_lp_policy policy, unsigned int holders)
+{
+	if (policy == CIX_DDR_LP_POLICY_PERFORMANCE || holders)
+		return CIX_DDR_LP_POLICY_PERFORMANCE;
+
+	return CIX_DDR_LP_POLICY_FIRMWARE;
+}
+
+static int cix_ddr_lp_set_firmware(enum cix_ddr_lp_policy target)
+{
+	struct arm_smccc_res res;
+	long status;
+
+	if (cix_ddr_lp_unsupported)
+		return -EOPNOTSUPP;
+
+	arm_smccc_smc(CIX_SIP_SVC_SET_DDR_LP,
+		      target == CIX_DDR_LP_POLICY_FIRMWARE,
+		      0, 0, 0, 0, 0, 0, &res);
+	status = (long)res.a0;
+	if (status == SMCCC_RET_SUCCESS)
+		return 0;
+	if (status == SMCCC_RET_NOT_SUPPORTED) {
+		cix_ddr_lp_unsupported = true;
+		return -EOPNOTSUPP;
+	}
+
+	return -EIO;
+}
+
+static int cix_ddr_lp_apply_locked(enum cix_ddr_lp_policy target)
+{
+	int ret;
+
+	if (target == cix_ddr_lp_effective)
+		return 0;
+
+	ret = cix_ddr_lp_set_firmware(target);
+	if (ret)
+		return ret;
+
+	/*
+	 * Match the settling intervals in CIX's public ISP integration.
+	 * Inhibiting entry must complete before capture starts.
+	 */
+	if (target == CIX_DDR_LP_POLICY_PERFORMANCE)
+		usleep_range(1000, 1100);
+	else
+		usleep_range(100, 200);
+
+	cix_ddr_lp_effective = target;
+	if (cix_ddr_lp_kobj)
+		sysfs_notify(cix_ddr_lp_kobj, NULL, "effective_policy");
+
+	return 0;
+}
+
+static ssize_t policy_show(struct kobject *kobj,
+			   struct kobj_attribute *attr, char *buf)
+{
+	enum cix_ddr_lp_policy policy;
+
+	mutex_lock(&cix_ddr_lp_lock);
+	policy = cix_ddr_lp_policy;
+	mutex_unlock(&cix_ddr_lp_lock);
+
+	return sysfs_emit(buf, "%s\n", cix_ddr_lp_policy_name(policy));
+}
+
+static ssize_t policy_store(struct kobject *kobj,
+			    struct kobj_attribute *attr, const char *buf,
+			    size_t count)
+{
+	enum cix_ddr_lp_policy policy;
+	enum cix_ddr_lp_policy target;
+	int ret;
+
+	if (sysfs_streq(buf, "firmware"))
+		policy = CIX_DDR_LP_POLICY_FIRMWARE;
+	else if (sysfs_streq(buf, "performance"))
+		policy = CIX_DDR_LP_POLICY_PERFORMANCE;
+	else
+		return -EINVAL;
+
+	mutex_lock(&cix_ddr_lp_lock);
+	target = cix_ddr_lp_target(policy, cix_ddr_lp_holders);
+	ret = cix_ddr_lp_apply_locked(target);
+	if (!ret)
+		cix_ddr_lp_policy = policy;
+	mutex_unlock(&cix_ddr_lp_lock);
+
+	return ret ? ret : count;
+}
+
+static ssize_t effective_policy_show(struct kobject *kobj,
+				     struct kobj_attribute *attr, char *buf)
+{
+	enum cix_ddr_lp_policy policy;
+
+	mutex_lock(&cix_ddr_lp_lock);
+	policy = cix_ddr_lp_effective;
+	mutex_unlock(&cix_ddr_lp_lock);
+
+	return sysfs_emit(buf, "%s\n", cix_ddr_lp_policy_name(policy));
+}
+
+static struct kobj_attribute policy_attr = __ATTR_RW(policy);
+static struct kobj_attribute effective_policy_attr =
+	__ATTR_RO(effective_policy);
+
+static struct attribute *cix_ddr_lp_attrs[] = {
+	&policy_attr.attr,
+	&effective_policy_attr.attr,
+	NULL,
+};
+
+static const struct attribute_group cix_ddr_lp_attr_group = {
+	.attrs = cix_ddr_lp_attrs,
+};
+
+struct cix_ddr_lp *cix_ddr_lp_get(struct device *dev)
+{
+	struct cix_ddr_lp *ddr_lp;
+
+	if (!dev)
+		return ERR_PTR(-EINVAL);
+
+	ddr_lp = kzalloc_obj(*ddr_lp);
+	if (!ddr_lp)
+		return ERR_PTR(-ENOMEM);
+
+	ddr_lp->dev = get_device(dev);
+	return ddr_lp;
+}
+EXPORT_SYMBOL_GPL(cix_ddr_lp_get);
+
+int cix_ddr_lp_disable(struct cix_ddr_lp *ddr_lp)
+{
+	int ret;
+
+	if (IS_ERR_OR_NULL(ddr_lp))
+		return -EINVAL;
+
+	mutex_lock(&cix_ddr_lp_lock);
+	if (ddr_lp->held) {
+		ret = 0;
+		goto out;
+	}
+
+	ret = cix_ddr_lp_apply_locked(CIX_DDR_LP_POLICY_PERFORMANCE);
+	if (ret)
+		goto out;
+
+	cix_ddr_lp_holders++;
+	ddr_lp->held = true;
+out:
+	mutex_unlock(&cix_ddr_lp_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(cix_ddr_lp_disable);
+
+static int cix_ddr_lp_release_locked(struct cix_ddr_lp *ddr_lp, bool discard)
+{
+	enum cix_ddr_lp_policy target;
+	int ret;
+
+	if (!ddr_lp->held)
+		return 0;
+
+	if (WARN_ON(!cix_ddr_lp_holders)) {
+		ddr_lp->held = false;
+		return 0;
+	}
+
+	target = cix_ddr_lp_target(cix_ddr_lp_policy,
+				   cix_ddr_lp_holders - 1);
+	ret = cix_ddr_lp_apply_locked(target);
+	if (ret && !discard)
+		return ret;
+
+	cix_ddr_lp_holders--;
+	ddr_lp->held = false;
+	return ret;
+}
+
+int cix_ddr_lp_enable(struct cix_ddr_lp *ddr_lp)
+{
+	int ret;
+
+	if (IS_ERR_OR_NULL(ddr_lp))
+		return -EINVAL;
+
+	mutex_lock(&cix_ddr_lp_lock);
+	ret = cix_ddr_lp_release_locked(ddr_lp, false);
+	mutex_unlock(&cix_ddr_lp_lock);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(cix_ddr_lp_enable);
+
+void cix_ddr_lp_put(struct cix_ddr_lp *ddr_lp)
+{
+	int ret;
+
+	if (IS_ERR_OR_NULL(ddr_lp))
+		return;
+
+	mutex_lock(&cix_ddr_lp_lock);
+	ret = cix_ddr_lp_release_locked(ddr_lp, true);
+	mutex_unlock(&cix_ddr_lp_lock);
+	if (ret)
+		dev_err(ddr_lp->dev,
+			"failed to restore firmware DDR low-power policy: %d\n",
+			ret);
+
+	put_device(ddr_lp->dev);
+	kfree(ddr_lp);
+}
+EXPORT_SYMBOL_GPL(cix_ddr_lp_put);
+
+static void cix_ddr_lp_remove_sysfs(void)
+{
+	if (cix_ddr_lp_kobj) {
+		sysfs_remove_group(cix_ddr_lp_kobj, &cix_ddr_lp_attr_group);
+		kobject_put(cix_ddr_lp_kobj);
+		cix_ddr_lp_kobj = NULL;
+	}
+	kobject_put(cix_firmware_kobj);
+	cix_firmware_kobj = NULL;
+}
+
+static int __init cix_ddr_lp_init(void)
+{
+	int ret;
+
+	cix_firmware_kobj = kobject_create_and_add("cix", firmware_kobj);
+	if (!cix_firmware_kobj) {
+		pr_warn("failed to create /sys/firmware/cix\n");
+		return -ENOMEM;
+	}
+
+	cix_ddr_lp_kobj = kobject_create_and_add("ddr_low_power",
+						 cix_firmware_kobj);
+	if (!cix_ddr_lp_kobj) {
+		pr_warn("failed to create /sys/firmware/cix/ddr_low_power\n");
+		cix_ddr_lp_remove_sysfs();
+		return -ENOMEM;
+	}
+
+	ret = sysfs_create_group(cix_ddr_lp_kobj, &cix_ddr_lp_attr_group);
+	if (ret) {
+		pr_warn("failed to create DDR low-power policy attributes: %d\n",
+			ret);
+		cix_ddr_lp_remove_sysfs();
+		return ret;
+	}
+
+	return 0;
+}
+module_init(cix_ddr_lp_init);
+
+static void __exit cix_ddr_lp_exit(void)
+{
+	int ret;
+
+	cix_ddr_lp_remove_sysfs();
+
+	mutex_lock(&cix_ddr_lp_lock);
+	ret = cix_ddr_lp_apply_locked(CIX_DDR_LP_POLICY_FIRMWARE);
+	mutex_unlock(&cix_ddr_lp_lock);
+	if (ret)
+		pr_err("failed to restore firmware DDR low-power policy: %d\n",
+		       ret);
+}
+module_exit(cix_ddr_lp_exit);
+
+MODULE_DESCRIPTION("CIX Sky1 DDR low-power policy and coordination");
+MODULE_LICENSE("GPL");
