Sky1 firmware publishes connection identifiers longer than clkdev's
historical fixed 16-byte buffer. Allocate the owned device and connection
identifier strings to fit instead of replacing that limit with another
arbitrary constant.

diff --git a/drivers/clk/clkdev.c b/drivers/clk/clkdev.c
--- a/drivers/clk/clkdev.c
+++ b/drivers/clk/clkdev.c
@@ -144,13 +144,9 @@ void clkdev_add_table(struct clk_lookup *cl, size_t num)
 	mutex_unlock(&clocks_mutex);
 }
 
-#define MAX_DEV_ID	24
-#define MAX_CON_ID	16
-
 struct clk_lookup_alloc {
 	struct clk_lookup cl;
-	char	dev_id[MAX_DEV_ID];
-	char	con_id[MAX_CON_ID];
+	char ids[];
 };
 
 static __printf(3, 0) struct clk_lookup * __ref
@@ -158,60 +154,39 @@ vclkdev_alloc(struct clk_hw *hw, const char *con_id, const char *dev_fmt,
 	va_list ap)
 {
 	struct clk_lookup_alloc *cla;
-	struct va_format vaf;
-	const char *failure;
+	char *id;
 	va_list ap_copy;
-	size_t max_size;
-	ssize_t res;
+	size_t con_len = con_id ? strlen(con_id) + 1 : 0;
+	size_t dev_len = 0;
+	int len;
+
+	if (dev_fmt) {
+		va_copy(ap_copy, ap);
+		len = vsnprintf(NULL, 0, dev_fmt, ap_copy);
+		va_end(ap_copy);
+		if (len < 0)
+			return NULL;
+		dev_len = (size_t)len + 1;
+	}
 
-	cla = kzalloc_obj(*cla);
+	cla = kzalloc(struct_size(cla, ids, size_add(con_len, dev_len)),
+		      GFP_KERNEL);
 	if (!cla)
 		return NULL;
 
-	va_copy(ap_copy, ap);
-
 	cla->cl.clk_hw = hw;
+	id = cla->ids;
 	if (con_id) {
-		res = strscpy(cla->con_id, con_id, sizeof(cla->con_id));
-		if (res < 0) {
-			max_size = sizeof(cla->con_id);
-			failure = "connection";
-			goto fail;
-		}
-		cla->cl.con_id = cla->con_id;
+		memcpy(id, con_id, con_len);
+		cla->cl.con_id = id;
+		id += con_len;
 	}
 
 	if (dev_fmt) {
-		res = vsnprintf(cla->dev_id, sizeof(cla->dev_id), dev_fmt, ap);
-		if (res >= sizeof(cla->dev_id)) {
-			max_size = sizeof(cla->dev_id);
-			failure = "device";
-			goto fail;
-		}
-		cla->cl.dev_id = cla->dev_id;
+		vsnprintf(id, dev_len, dev_fmt, ap);
+		cla->cl.dev_id = id;
 	}
 
-	va_end(ap_copy);
-
-	return &cla->cl;
-
-fail:
-	if (dev_fmt)
-		vaf.fmt = dev_fmt;
-	else
-		vaf.fmt = "null-device";
-	vaf.va = &ap_copy;
-	pr_err("%pV:%s: %s ID is greater than %zu\n",
-	       &vaf, con_id, failure, max_size);
-	va_end(ap_copy);
-
-	/*
-	 * Don't fail in this case, but as the entry won't ever match just
-	 * fill it with something that also won't match.
-	 */
-	strscpy(cla->con_id, "bad", sizeof(cla->con_id));
-	strscpy(cla->dev_id, "bad", sizeof(cla->dev_id));
-
 	return &cla->cl;
 }
 
