-//  0x0430  RW  TR_DPTX_HDCP_BKSV_31_0 / HDCP_RRX_31_0
-//  0x0434  RW  TR_DPTX_HDCP_BKSV_63_32 / HDCP_RRX_63_32
-//
-//  Parameters:
-//  hdnl - hdcp device handle
-//  rrx  - pointer to 8-byte random rrx value
-//
-//  Returns:
-//  true=OK / false=fail
