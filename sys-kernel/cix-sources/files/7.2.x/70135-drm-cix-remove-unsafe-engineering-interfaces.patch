-int cix_hdcp_hpd_event_process(struct cix_hdcp *hdcp, bool plugged)
-{
-	struct hdcp_event *e;
-
-	if (!hdcp->opened) {
-		if (plugged == true)
-			hdcp->state = ST2_H1;
-		else
-			hdcp->state = ST2_H0;
-		return 0;
-	}
-
-	e = kmalloc(sizeof(struct hdcp_event), GFP_KERNEL);
-
-	if (plugged == true) {
-		e->event = EV2_TX_RX_CONNECT;
-		hdcp->state = ST2_H1;
