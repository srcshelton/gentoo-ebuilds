+static struct fwnode_handle *
+acpi_graph_get_cix_remote_endpoint(const struct fwnode_handle *fwnode,
+				   bool allow_repairs)
+{
+	const struct acpi_device_data *data;
+	const union acpi_object *element;
+	const union acpi_object *obj;
+	const char *target_hid;
+	struct fwnode_handle *endpoint;
+	struct fwnode_handle *remote;
+	struct fwnode_handle *target;
+	struct acpi_device *source_device;
+	struct acpi_device *device;
+	unsigned int i;
+	int ret;
+
+	source_device = acpi_graph_get_cix_device(fwnode);
+	if (!source_device || !acpi_device_is_present(source_device))
+		return NULL;
+
+	data = acpi_device_data_of_node(fwnode);
+	if (!data)
+		return NULL;
+
+	ret = acpi_data_get_property(data, "remote-endpoint",
+				     ACPI_TYPE_PACKAGE, &obj);
+	if (ret || obj->package.count < 3 || obj->package.count > 4)
+		return NULL;
+
+	element = obj->package.elements;
+	if (element->type != ACPI_TYPE_LOCAL_REFERENCE)
+		return NULL;
