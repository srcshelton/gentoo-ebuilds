+static struct fwnode_handle *
+acpi_graph_walk_cix_path(struct fwnode_handle *fwnode,
+			 const union acpi_object *element,
+			 unsigned int count)
+{
+	struct fwnode_handle *child;
+	struct fwnode_handle *ref = fwnode;
+	bool ref_needs_put = false;
+	unsigned int i;
+
+	for (i = 0; i < count; i++) {
+		const char *child_name = element[i].string.pointer;
+
+		child = acpi_fwnode_get_named_child_node(ref, child_name);
+		if (!child)
+			goto err_put_ref;
+
+		if (ref_needs_put)
+			fwnode_handle_put(ref);
+		ref = child;
+		ref_needs_put = true;
+	}
+
+	return ref_needs_put ? ref : NULL;
+
+err_put_ref:
+	if (ref_needs_put)
+		fwnode_handle_put(ref);
+	return NULL;
+}
