+static struct fwnode_handle *
+acpi_graph_get_cix_port2_endpoint(struct fwnode_handle *fwnode)
+{
+	struct fwnode_handle *candidate = NULL;
+	struct fwnode_handle *connector;
+	bool ambiguous = false;
+
+	fwnode_for_each_child_node(fwnode, connector) {
+		struct fwnode_handle *endpoint;
+		struct fwnode_handle *child;
+		struct fwnode_handle *port;
+		unsigned int endpoint_count = 0;
+		u32 reg;
+
+		port = acpi_fwnode_get_named_child_node(connector, "port@2");
+		if (!port)
+			continue;
+		if (fwnode_property_read_u32(port, "reg", &reg) || reg != 2)
+			goto next_connector;
+
+		fwnode_for_each_child_node(port, child)
+			if (is_acpi_graph_node(child, "endpoint"))
+				endpoint_count++;
+		if (endpoint_count != 1)
+			goto next_connector;
+
+		endpoint = acpi_fwnode_get_named_child_node(port, "endpoint@1");
+		if (!endpoint)
+			goto next_connector;
+		if (fwnode_property_read_u32(endpoint, "reg", &reg) || reg != 1) {
+			fwnode_handle_put(endpoint);
+			goto next_connector;
+		}
+
+		if (candidate || ambiguous) {
+			fwnode_handle_put(endpoint);
+			fwnode_handle_put(candidate);
+			candidate = NULL;
+			ambiguous = true;
+		} else {
+			candidate = endpoint;
+		}
+
+next_connector:
+		fwnode_handle_put(port);
+	}
+
+	return ambiguous ? NULL : candidate;
+}
