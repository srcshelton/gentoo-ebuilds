+static struct fwnode_handle *
+acpi_graph_get_cix_unique_subpath(struct fwnode_handle *fwnode,
+				  const union acpi_object *element,
+				  unsigned int count)
+{
+	struct fwnode_handle *candidate = NULL;
+	struct fwnode_handle *child;
+	bool ambiguous = false;
+
+	fwnode_for_each_child_node(fwnode, child) {
+		struct fwnode_handle *endpoint;
+
+		endpoint = acpi_graph_walk_cix_path(child, element, count);
+		if (!endpoint)
+			continue;
+
+		if (candidate || ambiguous) {
+			fwnode_handle_put(endpoint);
+			fwnode_handle_put(candidate);
+			candidate = NULL;
+			ambiguous = true;
+			continue;
+		}
+
+		candidate = endpoint;
+	}
+
+	return ambiguous ? NULL : candidate;
+}
