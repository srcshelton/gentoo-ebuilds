@@ -3471,8 +3471,15 @@ int trilin_dp_probe(struct trilin_dpsub *dpsub, struct drm_device *drm)
 	dp->link_config.max_lanes = dp->num_lanes;
 	dp->link_config.max_rate = dp->max_rate;
 
-	dp->phy_reset = devm_reset_control_get(dev, "phy_reset");
-	dp->reset = devm_reset_control_get(dev, "dp_reset");
+	dp->phy_reset = devm_reset_control_get_optional_exclusive(dev, "phy_reset");
+	if (IS_ERR(dp->phy_reset))
+		return dev_err_probe(dev, PTR_ERR(dp->phy_reset),
+				     "failed to get PHY reset\n");
+
+	dp->reset = devm_reset_control_get_optional_exclusive(dev, "dp_reset");
+	if (IS_ERR(dp->reset))
