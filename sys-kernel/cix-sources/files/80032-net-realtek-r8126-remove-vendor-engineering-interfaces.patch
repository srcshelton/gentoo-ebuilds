-        u16 pp = 0;
-
-        if (pair_num > 3)
-                goto exit;
-
-        rtl8126_mdio_direct_write_phy_ocp(tp, 0xA436, 0x8028 + 4 * pair_num);
-        pp = rtl8126_mdio_direct_read_phy_ocp(tp, 0xA438);
