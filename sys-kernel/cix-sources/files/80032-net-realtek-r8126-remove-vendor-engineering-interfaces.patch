-                for (i = 0; i < tp->HwSuppNumRxQueues; i++) {
-                        struct rtl8126_ring *lib_ring = &tp->lib_rx_ring[i];
-                        if (lib_ring->enabled) {
-                                seq_printf(m, "\ndump lib rx %d desc:%d\n", i,
-                                           lib_ring->ring_size);
