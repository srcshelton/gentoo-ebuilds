-static void rtl8126_get_cp_status(struct rtl8126_private *tp,
-                                  int cp_status[RTL8126_CP_NUM],
-                                  bool poe_mode)
-{
-        u32 status;
-        int i;
-
-        status = rtl8126_get_phy_status(tp);
