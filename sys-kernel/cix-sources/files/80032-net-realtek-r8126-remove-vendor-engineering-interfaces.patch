--- a/drivers/net/ethernet/realtek/r8126/Kconfig
+++ b/drivers/net/ethernet/realtek/r8126/Kconfig
@@ -11,13 +11,3 @@ config R8126
 
 	  To compile this driver as a module, choose M here. The module
 	  will be called r8126.
-
-config R8126_UNSAFE_DIAGNOSTICS
-	bool "Enable unsafe RTL8126 vendor diagnostics"
-	depends on R8126 && EXPERT
-	help
-	  Enable the vendor's raw register, PCI configuration, PHY and
-	  EEPROM access ioctl together with its procfs and sysfs test
-	  interfaces. These facilities can modify hardware outside normal
-	  network-driver operations and are not required for networking,
-	  RSS or wake-on-LAN. Leave this disabled on normal systems.
