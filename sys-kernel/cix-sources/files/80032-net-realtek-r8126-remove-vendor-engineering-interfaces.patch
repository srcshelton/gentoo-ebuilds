-        if (poe_mode) {
-                for (i=0; i<RTL8126_CP_NUM; i++) {
-                        if (cp_status[i] == rtl8126_cp_mismatch)
-                                cp_status[i] = rtl8126_cp_normal;
-                }
-        }
