new file mode 100644
--- /dev/null
+++ b/drivers/misc/armchina-npu-common/aipu_file.c
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <linux/device.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+
+#include "aipu_file.h"
+
+static void aipu_file_ctx_release(struct kref *kref)
+{
+	struct aipu_file_ctx *ctx = container_of(kref, struct aipu_file_ctx, kref);
+
+	ctx->ops->priv_put(ctx->priv);
+	kfree(ctx);
+}
+
+void aipu_file_ctx_get(struct aipu_file_ctx *ctx)
+{
+	if (ctx)
+		kref_get(&ctx->kref);
+}
+EXPORT_SYMBOL_GPL(aipu_file_ctx_get);
+
+void aipu_file_ctx_put(struct aipu_file_ctx *ctx)
+{
+	if (ctx)
+		kref_put(&ctx->kref, aipu_file_ctx_release);
+}
+EXPORT_SYMBOL_GPL(aipu_file_ctx_put);
+
+static void aipu_file_ctx_finish(struct aipu_file_ctx *ctx, struct file *filp)
+{
+	WRITE_ONCE(ctx->released, true);
+	ctx->ops->release(ctx, filp);
+	aipu_file_ctx_put(ctx);
+}
+
+static void aipu_file_ctx_close_work(struct work_struct *work)
+{
+	struct delayed_work *dwork = to_delayed_work(work);
+	struct aipu_file_ctx *ctx = container_of(dwork, struct aipu_file_ctx,
+						 close_work);
+	struct file filp = { .private_data = ctx };
+	struct module *module = ctx->module;
+	int ret;
+
+	ret = ctx->ops->quiesce(ctx, &filp);
+	if (ret) {
+		dev_warn_ratelimited(ctx->ops->dev(ctx->priv),
+				     "deferred release still cannot quiesce hardware: %d\n",
+				     ret);
+		mod_delayed_work(system_long_wq, &ctx->close_work,
+				 msecs_to_jiffies(1000));
+		return;
+	}
+
+	aipu_file_ctx_finish(ctx, &filp);
+	module_put(module);
+}
+
+struct aipu_file_ctx *aipu_file_ctx_alloc(void *priv,
+					  const struct aipu_file_ctx_ops *ops,
+					  struct module *module)
+{
+	struct aipu_file_ctx *ctx;
+
+	if (!priv || !ops || !ops->quiesce || !ops->release ||
+	    !ops->priv_put || !ops->dev)
+		return ERR_PTR(-EINVAL);
+	ctx = kzalloc_obj(*ctx);
+	if (!ctx)
+		return ERR_PTR(-ENOMEM);
+	ctx->priv = priv;
+	ctx->ops = ops;
+	ctx->module = module;
+	kref_init(&ctx->kref);
+	INIT_DELAYED_WORK(&ctx->close_work, aipu_file_ctx_close_work);
+
+	return ctx;
+}
+EXPORT_SYMBOL_GPL(aipu_file_ctx_alloc);
+
+int aipu_file_ctx_close(struct file *filp)
+{
+	struct aipu_file_ctx *ctx = aipu_file_ctx(filp);
+	int ret;
+
+	if (!ctx)
+		return 0;
+	ret = ctx->ops->quiesce(ctx, filp);
+	if (ret) {
+		dev_warn(ctx->ops->dev(ctx->priv),
+			 "deferring release until hardware can be quiesced: %d\n", ret);
+		filp->private_data = NULL;
+		if (WARN_ON(!try_module_get(ctx->module)))
+			return ret;
+		mod_delayed_work(system_long_wq, &ctx->close_work,
+				 msecs_to_jiffies(100));
+		return 0;
+	}
+
+	aipu_file_ctx_finish(ctx, filp);
+	filp->private_data = NULL;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(aipu_file_ctx_close);
+
+MODULE_DESCRIPTION("ArmChina NPU per-client lifetime helpers");
+MODULE_LICENSE("GPL");
diff --git a/drivers/misc/armchina-npu-common/aipu_file.h b/drivers/misc/armchina-npu-common/aipu_file.h
new file mode 100644
--- /dev/null
+++ b/drivers/misc/armchina-npu-common/aipu_file.h
@@ -0,0 +1,64 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+
+#ifndef __ARMCHINA_NPU_FILE_H__
+#define __ARMCHINA_NPU_FILE_H__
+
+#include <linux/fs.h>
+#include <linux/kref.h>
+#include <linux/module.h>
+#include <linux/workqueue.h>
+
+struct aipu_file_ctx;
+
+enum aipu_file_abi_bit {
+	AIPU_FILE_ABI_P1,
+};
+
+struct aipu_file_ctx_ops {
+	int (*quiesce)(struct aipu_file_ctx *ctx, struct file *filp);
+	void (*release)(struct aipu_file_ctx *ctx, struct file *filp);
+	void (*priv_put)(void *priv);
+	struct device *(*dev)(void *priv);
+};
+
+/*
+ * Allocation and job ownership must outlive struct file when a shared command
+ * pool prevents an immediate, owner-local close.
+ */
+struct aipu_file_ctx {
+	void *priv;
+	const struct aipu_file_ctx_ops *ops;
+	struct module *module;
+	struct kref kref;
+	struct work_struct cleanup_work;
+	struct delayed_work close_work;
+	unsigned long abi_mask;
+	unsigned int tick_counter_refs;
+	bool released;
+};
+
+struct aipu_file_ctx *aipu_file_ctx_alloc(void *priv,
+					  const struct aipu_file_ctx_ops *ops,
+					  struct module *module);
+void aipu_file_ctx_get(struct aipu_file_ctx *ctx);
+void aipu_file_ctx_put(struct aipu_file_ctx *ctx);
+int aipu_file_ctx_close(struct file *filp);
+
+static inline bool aipu_file_ctx_is_released(const struct aipu_file_ctx *ctx)
+{
+	return ctx && READ_ONCE(ctx->released);
+}
+
+static inline struct aipu_file_ctx *aipu_file_ctx(struct file *filp)
+{
+	return filp ? filp->private_data : NULL;
+}
+
+static inline void *aipu_file_priv(struct file *filp)
+{
+	struct aipu_file_ctx *ctx = aipu_file_ctx(filp);
+
+	return ctx ? ctx->priv : NULL;
+}
+
+#endif /* __ARMCHINA_NPU_FILE_H__ */
