diff --git a/drivers/reset/reset-sky1-audss.c b/drivers/reset/reset-sky1-audss.c
new file mode 100644
--- /dev/null
+++ b/drivers/reset/reset-sky1-audss.c
@@ -0,0 +1,396 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Cix Sky1 Audio Subsystem reset controller driver
+ *
+ * Copyright 2026 Cix Technology Group Co., Ltd.
+ */
+
+#include <dt-bindings/reset/cix,sky1-audss-cru.h>
+
+#include <linux/acpi.h>
+#include <linux/auxiliary_bus.h>
+#include <linux/delay.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <linux/reset-controller.h>
+
+#define SKY1_RESET_SLEEP_MIN_US		50
+#define SKY1_RESET_SLEEP_MAX_US		100
+
+#define AUDSS_SW_RST			0x78
+
+struct sky1_audss_reset_map {
+	unsigned int offset;
+	unsigned int mask;
+};
+
+struct sky1_audss_reset {
+	struct reset_controller_dev rcdev;
+	struct regmap *regmap;
+	const struct sky1_audss_reset_map *map;
+	struct device *pm_dev;
+};
+
+static const struct sky1_audss_reset_map sky1_audss_reset_map[] = {
+	[AUDSS_I2S0_SW_RST]   = { AUDSS_SW_RST, BIT(0) },
+	[AUDSS_I2S1_SW_RST]   = { AUDSS_SW_RST, BIT(1) },
+	[AUDSS_I2S2_SW_RST]   = { AUDSS_SW_RST, BIT(2) },
+	[AUDSS_I2S3_SW_RST]   = { AUDSS_SW_RST, BIT(3) },
+	[AUDSS_I2S4_SW_RST]   = { AUDSS_SW_RST, BIT(4) },
+	[AUDSS_I2S5_SW_RST]   = { AUDSS_SW_RST, BIT(5) },
+	[AUDSS_I2S6_SW_RST]   = { AUDSS_SW_RST, BIT(6) },
+	[AUDSS_I2S7_SW_RST]   = { AUDSS_SW_RST, BIT(7) },
+	[AUDSS_I2S8_SW_RST]   = { AUDSS_SW_RST, BIT(8) },
+	[AUDSS_I2S9_SW_RST]   = { AUDSS_SW_RST, BIT(9) },
+	[AUDSS_WDT_SW_RST]    = { AUDSS_SW_RST, BIT(10) },
+	[AUDSS_TIMER_SW_RST]  = { AUDSS_SW_RST, BIT(11) },
+	[AUDSS_MB0_SW_RST]    = { AUDSS_SW_RST, BIT(12) },
+	[AUDSS_MB1_SW_RST]    = { AUDSS_SW_RST, BIT(13) },
+	[AUDSS_HDA_SW_RST]    = { AUDSS_SW_RST, BIT(14) },
+	[AUDSS_DMAC_SW_RST]   = { AUDSS_SW_RST, BIT(15) },
+};
+
+static struct sky1_audss_reset *
+to_sky1_audss_reset(struct reset_controller_dev *rcdev)
+{
+	return container_of(rcdev, struct sky1_audss_reset, rcdev);
+}
+
+static const struct sky1_audss_reset_map *
+sky1_audss_reset_signal(struct reset_controller_dev *rcdev, unsigned long id)
+{
+	struct sky1_audss_reset *priv = to_sky1_audss_reset(rcdev);
+	const struct sky1_audss_reset_map *signal;
+
+	if (id >= rcdev->nr_resets)
+		return ERR_PTR(-EINVAL);
+
+	signal = &priv->map[id];
+	if (!signal->mask)
+		return ERR_PTR(-EINVAL);
+
+	return signal;
+}
+
+static int sky1_audss_reset_pm_get(struct sky1_audss_reset *priv)
+{
+	if (!priv->pm_dev)
+		return 0;
+
+	return pm_runtime_resume_and_get(priv->pm_dev);
+}
+
+static void sky1_audss_reset_pm_put(struct sky1_audss_reset *priv)
+{
+	if (priv->pm_dev)
+		pm_runtime_put(priv->pm_dev);
+}
+
+static int
+sky1_audss_reset_update(struct sky1_audss_reset *priv,
+			const struct sky1_audss_reset_map *signal, bool assert)
+{
+	unsigned int value;
+
+	value = assert ? 0 : signal->mask;
+
+	return regmap_update_bits(priv->regmap, signal->offset,
+				  signal->mask, value);
+}
+
+static int sky1_audss_reset_set(struct reset_controller_dev *rcdev,
+				unsigned long id, bool assert)
+{
+	struct sky1_audss_reset *priv = to_sky1_audss_reset(rcdev);
+	const struct sky1_audss_reset_map *signal;
+	int ret;
+
+	signal = sky1_audss_reset_signal(rcdev, id);
+	if (IS_ERR(signal))
+		return PTR_ERR(signal);
+
+	ret = sky1_audss_reset_pm_get(priv);
+	if (ret)
+		return ret;
+
+	ret = sky1_audss_reset_update(priv, signal, assert);
+	if (!ret)
+		usleep_range(SKY1_RESET_SLEEP_MIN_US,
+			     SKY1_RESET_SLEEP_MAX_US);
+	sky1_audss_reset_pm_put(priv);
+
+	return ret;
+}
+
+static int sky1_audss_reset_assert(struct reset_controller_dev *rcdev,
+				   unsigned long id)
+{
+	return sky1_audss_reset_set(rcdev, id, true);
+}
+
+static int sky1_audss_reset_deassert(struct reset_controller_dev *rcdev,
+				     unsigned long id)
+{
+	return sky1_audss_reset_set(rcdev, id, false);
+}
+
+static int sky1_audss_reset(struct reset_controller_dev *rcdev,
+			    unsigned long id)
+{
+	struct sky1_audss_reset *priv = to_sky1_audss_reset(rcdev);
+	const struct sky1_audss_reset_map *signal;
+	int ret;
+
+	signal = sky1_audss_reset_signal(rcdev, id);
+	if (IS_ERR(signal))
+		return PTR_ERR(signal);
+
+	ret = sky1_audss_reset_pm_get(priv);
+	if (ret)
+		return ret;
+
+	ret = sky1_audss_reset_update(priv, signal, true);
+	if (ret)
+		goto out_pm_put;
+
+	usleep_range(SKY1_RESET_SLEEP_MIN_US, SKY1_RESET_SLEEP_MAX_US);
+
+	ret = sky1_audss_reset_update(priv, signal, false);
+	if (!ret)
+		usleep_range(SKY1_RESET_SLEEP_MIN_US,
+			     SKY1_RESET_SLEEP_MAX_US);
+
+out_pm_put:
+	sky1_audss_reset_pm_put(priv);
+	return ret;
+}
+
+static int sky1_audss_reset_status(struct reset_controller_dev *rcdev,
+				   unsigned long id)
+{
+	struct sky1_audss_reset *priv = to_sky1_audss_reset(rcdev);
+	const struct sky1_audss_reset_map *signal;
+	unsigned int value;
+	int ret;
+
+	signal = sky1_audss_reset_signal(rcdev, id);
+	if (IS_ERR(signal))
+		return PTR_ERR(signal);
+
+	ret = sky1_audss_reset_pm_get(priv);
+	if (ret)
+		return ret;
+
+	ret = regmap_read(priv->regmap, signal->offset, &value);
+	sky1_audss_reset_pm_put(priv);
+	if (ret)
+		return ret;
+
+	return !(value & signal->mask);
+}
+
+static const struct reset_control_ops sky1_audss_reset_ops = {
+	.reset = sky1_audss_reset,
+	.assert = sky1_audss_reset_assert,
+	.deassert = sky1_audss_reset_deassert,
+	.status = sky1_audss_reset_status,
+};
+
+static int sky1_audss_reset_register(struct device *dev, struct regmap *regmap,
+				     struct device *pm_dev)
+{
+	struct sky1_audss_reset *priv;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->regmap = regmap;
+	priv->map = sky1_audss_reset_map;
+	priv->pm_dev = pm_dev;
+	priv->rcdev.owner = THIS_MODULE;
+	priv->rcdev.nr_resets = ARRAY_SIZE(sky1_audss_reset_map);
+	priv->rcdev.ops = &sky1_audss_reset_ops;
+	priv->rcdev.of_node = dev->of_node;
+	priv->rcdev.dev = dev;
+
+	return devm_reset_controller_register(dev, &priv->rcdev);
+}
+
+static int sky1_audss_reset_aux_probe(struct auxiliary_device *adev,
+				      const struct auxiliary_device_id *id)
+{
+	struct device *dev = &adev->dev;
+	struct regmap *regmap;
+
+	regmap = dev_get_regmap(dev->parent, NULL);
+	if (!regmap)
+		return dev_err_probe(dev, -EPROBE_DEFER,
+				     "failed to get parent regmap\n");
+
+	return sky1_audss_reset_register(dev, regmap, dev->parent);
+}
+
+static const struct auxiliary_device_id sky1_audss_reset_ids[] = {
+	{ .name = "clk_sky1_audss.reset" },
+	{ }
+};
+MODULE_DEVICE_TABLE(auxiliary, sky1_audss_reset_ids);
+
+static struct auxiliary_driver sky1_audss_reset_aux_driver = {
+	.probe = sky1_audss_reset_aux_probe,
+	.id_table = sky1_audss_reset_ids,
+};
+
+static struct regmap *sky1_audss_platform_regmap(struct device *dev)
+{
+	struct device_node *parent;
+	struct regmap *regmap;
+
+	if (has_acpi_companion(dev))
+		return device_syscon_regmap_lookup_by_property(dev, "audss_cru");
+
+	parent = of_get_parent(dev->of_node);
+	if (!parent)
+		return ERR_PTR(-ENODEV);
+
+	regmap = syscon_node_to_regmap(parent);
+	of_node_put(parent);
+
+	return regmap;
+}
+
+static struct device *sky1_audss_reset_acpi_supplier(struct device *dev)
+{
+#if IS_ENABLED(CONFIG_ACPI)
+	struct acpi_device *adev;
+	struct device *supplier;
+	acpi_handle handle;
+	acpi_status status;
+	int ret = 0;
+
+	status = acpi_get_handle(ACPI_HANDLE(dev), "^ACLK", &handle);
+	if (ACPI_FAILURE(status))
+		return ERR_PTR(-ENODEV);
+
+	adev = acpi_fetch_acpi_dev(handle);
+	if (!adev)
+		return ERR_PTR(-EPROBE_DEFER);
+
+	supplier = bus_find_device_by_fwnode(&platform_bus_type,
+					     acpi_fwnode_handle(adev));
+	if (!supplier)
+		return ERR_PTR(-EPROBE_DEFER);
+
+	device_lock(supplier);
+	if (supplier->links.status == DL_DEV_UNBINDING) {
+		ret = -EPROBE_DEFER;
+	} else if (!device_link_add(dev, supplier,
+				    DL_FLAG_AUTOPROBE_CONSUMER)) {
+		ret = -EINVAL;
+	} else if (!device_is_bound(supplier) ||
+		   supplier->links.status != DL_DEV_DRIVER_BOUND) {
+		ret = -EPROBE_DEFER;
+	}
+	device_unlock(supplier);
+
+	if (ret) {
+		put_device(supplier);
+		return ERR_PTR(ret);
+	}
+
+	return supplier;
+#else
+	return ERR_PTR(-ENODEV);
+#endif
+}
+
+static void sky1_audss_reset_acpi_clear_dependencies(struct device *dev)
+{
+#ifdef CONFIG_ACPI
+	if (has_acpi_companion(dev))
+		acpi_dev_clear_dependencies(ACPI_COMPANION(dev));
+#endif
+}
+
+static int sky1_audss_reset_platform_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device *pm_dev = NULL;
+	struct regmap *regmap;
+	int ret;
+
+	regmap = sky1_audss_platform_regmap(dev);
+	if (IS_ERR(regmap))
+		return dev_err_probe(dev, PTR_ERR(regmap),
+				     "failed to get AUDSS CRU regmap\n");
+
+	if (has_acpi_companion(dev)) {
+		pm_dev = sky1_audss_reset_acpi_supplier(dev);
+		if (IS_ERR(pm_dev))
+			return dev_err_probe(dev, PTR_ERR(pm_dev),
+					     "failed to link AUDSS clock supplier\n");
+	}
+
+	ret = sky1_audss_reset_register(dev, regmap, pm_dev);
+	put_device(pm_dev);
+	if (ret)
+		return ret;
+
+	sky1_audss_reset_acpi_clear_dependencies(dev);
+
+	return 0;
+}
+
+static const struct of_device_id sky1_audss_reset_of_match[] = {
+	{ .compatible = "cix,sky1-audss-reset" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sky1_audss_reset_of_match);
+
+static const struct acpi_device_id sky1_audss_reset_acpi_match[] = {
+	{ "CIXH6062", 0 },
+	{ }
+};
+MODULE_DEVICE_TABLE(acpi, sky1_audss_reset_acpi_match);
+
+static struct platform_driver sky1_audss_reset_platform_driver = {
+	.probe = sky1_audss_reset_platform_probe,
+	.driver = {
+		.name = "sky1-audss-reset",
+		.suppress_bind_attrs = true,
+		.of_match_table = sky1_audss_reset_of_match,
+		.acpi_match_table = ACPI_PTR(sky1_audss_reset_acpi_match),
+	},
+};
+
+static int __init sky1_audss_reset_init(void)
+{
+	int ret;
+
+	ret = platform_driver_register(&sky1_audss_reset_platform_driver);
+	if (ret)
+		return ret;
+
+	ret = auxiliary_driver_register(&sky1_audss_reset_aux_driver);
+	if (ret)
+		platform_driver_unregister(&sky1_audss_reset_platform_driver);
+
+	return ret;
+}
+module_init(sky1_audss_reset_init);
+
+static void __exit sky1_audss_reset_exit(void)
+{
+	auxiliary_driver_unregister(&sky1_audss_reset_aux_driver);
+	platform_driver_unregister(&sky1_audss_reset_platform_driver);
+}
+module_exit(sky1_audss_reset_exit);
+
+MODULE_AUTHOR("Joakim Zhang <joakim.zhang@cixtech.com>");
+MODULE_DESCRIPTION("Cix Sky1 Audio Subsystem reset driver");
+MODULE_LICENSE("GPL");
