diff --git a/drivers/usb/cdns3/Makefile b/drivers/usb/cdns3/Makefile
--- a/drivers/usb/cdns3/Makefile
+++ b/drivers/usb/cdns3/Makefile
@@ -26,13 +26,35 @@ obj-$(CONFIG_USB_CDNS3_TI)			+= cdns3-ti.o
 obj-$(CONFIG_USB_CDNS3_IMX)			+= cdns3-imx.o
 obj-$(CONFIG_USB_CDNS3_STARFIVE)		+= cdns3-starfive.o
 
+# CDNSP platform driver (for SoCs with integrated USBSSP)
+cdnsp-y						:= cdnsp-plat.o
+
+ifdef CONFIG_USB_CDNSP
+ifeq ($(CONFIG_USB),m)
+obj-m						+= cdnsp.o
+else
+obj-$(CONFIG_USB_CDNSP)				+= cdnsp.o
+endif
+endif
+
+cdnsp-$(CONFIG_USB_CDNSP_GADGET)		+= cdnsp-ring.o cdnsp-gadget.o \
+						   cdnsp-mem.o cdnsp-ep0.o
+
+ifneq ($(CONFIG_USB_CDNSP_GADGET),)
+cdnsp-$(CONFIG_TRACING)				+= cdnsp-trace.o
+endif
+
+# CDNSP Sky1 glue layer
+obj-$(CONFIG_USB_CDNSP_SKY1)			+= cdnsp-sky1.o
+
+# CDNSP PCI driver
 cdnsp-udc-pci-y					:= cdnsp-pci.o
 
 ifdef CONFIG_USB_CDNSP_PCI
 ifeq ($(CONFIG_USB),m)
 obj-m						+= cdnsp-udc-pci.o
 else
-obj-$(CONFIG_USB_CDNSP_PCI) 			+= cdnsp-udc-pci.o
+obj-$(CONFIG_USB_CDNSP_PCI)			+= cdnsp-udc-pci.o
 endif
 endif
 
diff --git a/drivers/usb/cdns3/cdnsp-plat.c b/drivers/usb/cdns3/cdnsp-plat.c
new file mode 100644
--- /dev/null
+++ b/drivers/usb/cdns3/cdnsp-plat.c
@@ -0,0 +1,560 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Cadence USBSSP DRD platform-device support
+ *
+ * Based on cdns3-plat.c.
+ *
+ * Copyright (C) 2018-2020 Cadence Design Systems.
+ * Copyright (C) 2017-2018 NXP
+ * Copyright (C) 2019 Texas Instruments
+ */
+
+#include <linux/acpi.h>
+#include <linux/device.h>
+#include <linux/irq.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/phy/phy.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/property.h>
+
+#include "core.h"
+#include "drd.h"
+#include "gadget-export.h"
+
+struct cdnsp_phy_ref {
+	struct device *provider;
+	struct phy *phy;
+};
+
+static void cdnsp_phy_ref_release(struct device *dev, void *res)
+{
+	struct cdnsp_phy_ref *ref = res;
+
+	phy_put(ref->provider, ref->phy);
+	put_device(ref->provider);
+}
+
+/*
+ * CIX ACPI describes PHYs with _DSD references to PHY child objects.  The
+ * generic PHY lookup table is keyed by the provider device name and the
+ * referenced child name, so keep the provider reference used by phy_get()
+ * until the consumer's devres is released.
+ */
+static struct phy *cdnsp_acpi_phy_ref_get(struct device *dev,
+					  const char *property)
+{
+	struct fwnode_handle *ref_fwnode, *parent_fwnode;
+	struct cdnsp_phy_ref *resource;
+	struct device_link *link;
+	struct device *provider;
+	const char *con_id;
+	struct phy *phy;
+
+	if (!fwnode_property_present(dev_fwnode(dev), property))
+		return NULL;
+
+	ref_fwnode = fwnode_find_reference(dev_fwnode(dev), property, 0);
+	if (IS_ERR(ref_fwnode))
+		return ERR_CAST(ref_fwnode);
+
+	con_id = fwnode_get_name(ref_fwnode);
+	parent_fwnode = fwnode_get_parent(ref_fwnode);
+	if (!con_id || !parent_fwnode) {
+		phy = ERR_PTR(-EINVAL);
+		goto out_put_ref;
+	}
+
+	provider = bus_find_device_by_fwnode(&platform_bus_type, parent_fwnode);
+	fwnode_handle_put(parent_fwnode);
+	if (!provider) {
+		phy = ERR_PTR(-EPROBE_DEFER);
+		goto out_put_ref;
+	}
+
+	resource = devres_alloc(cdnsp_phy_ref_release, sizeof(*resource),
+				GFP_KERNEL);
+	if (!resource) {
+		phy = ERR_PTR(-ENOMEM);
+		goto out_put_provider;
+	}
+
+	phy = phy_get(provider, con_id);
+	if (IS_ERR(phy)) {
+		if (PTR_ERR(phy) == -ENODEV)
+			phy = ERR_PTR(-EPROBE_DEFER);
+		goto out_free_resource;
+	}
+
+	/*
+	 * phy_get() above creates a link from the lookup-key provider, not
+	 * from this controller.  Add the real consumer dependency explicitly.
+	 */
+	link = device_link_add(dev, provider,
+			       DL_FLAG_PM_RUNTIME | DL_FLAG_AUTOREMOVE_CONSUMER);
+	if (!link) {
+		phy_put(provider, phy);
+		phy = ERR_PTR(-EINVAL);
+		goto out_free_resource;
+	}
+
+	resource->provider = provider;
+	resource->phy = phy;
+	devres_add(dev, resource);
+	fwnode_handle_put(ref_fwnode);
+	return phy;
+
+out_free_resource:
+	devres_free(resource);
+out_put_provider:
+	put_device(provider);
+out_put_ref:
+	fwnode_handle_put(ref_fwnode);
+	return phy;
+}
+
+static struct phy *cdnsp_phy_get(struct device *dev, const char *name)
+{
+	if (has_acpi_companion(dev))
+		return cdnsp_acpi_phy_ref_get(dev, name);
+
+	return devm_phy_optional_get(dev, name);
+}
+
+static int cdnsp_phys_init(struct cdns *cdns)
+{
+	int ret;
+
+	if (!cdns->usb2_phy_initialized) {
+		ret = phy_init(cdns->usb2_phy);
+		if (ret)
+			return ret;
+		cdns->usb2_phy_initialized = true;
+	}
+
+	if (!cdns->usb3_phy_initialized) {
+		ret = phy_init(cdns->usb3_phy);
+		if (ret)
+			return ret;
+		cdns->usb3_phy_initialized = true;
+	}
+
+	return 0;
+}
+
+static int cdnsp_phys_exit(struct cdns *cdns)
+{
+	int first_error = 0;
+	int ret;
+
+	if (cdns->usb3_phy_initialized) {
+		ret = phy_exit(cdns->usb3_phy);
+		if (ret)
+			first_error = ret;
+		else
+			cdns->usb3_phy_initialized = false;
+	}
+
+	if (cdns->usb2_phy_initialized) {
+		ret = phy_exit(cdns->usb2_phy);
+		if (ret && !first_error)
+			first_error = ret;
+		else if (!ret)
+			cdns->usb2_phy_initialized = false;
+	}
+
+	return first_error;
+}
+
+static int cdnsp_phys_power_on(struct cdns *cdns)
+{
+	int ret;
+
+	if (!cdns->usb2_phy_powered) {
+		ret = phy_power_on(cdns->usb2_phy);
+		if (ret)
+			return ret;
+		cdns->usb2_phy_powered = true;
+	}
+
+	if (!cdns->usb3_phy_powered) {
+		ret = phy_power_on(cdns->usb3_phy);
+		if (ret)
+			return ret;
+		cdns->usb3_phy_powered = true;
+	}
+
+	return 0;
+}
+
+static int cdnsp_phys_power_off(struct cdns *cdns)
+{
+	int first_error = 0;
+	int ret;
+
+	if (cdns->usb3_phy_powered) {
+		ret = phy_power_off(cdns->usb3_phy);
+		if (ret)
+			first_error = ret;
+		else
+			cdns->usb3_phy_powered = false;
+	}
+
+	if (cdns->usb2_phy_powered) {
+		ret = phy_power_off(cdns->usb2_phy);
+		if (ret && !first_error)
+			first_error = ret;
+		else if (!ret)
+			cdns->usb2_phy_powered = false;
+	}
+
+	return first_error;
+}
+
+static int cdnsp_phys_reinit(struct cdns *cdns)
+{
+	int ret;
+
+	ret = cdnsp_phys_exit(cdns);
+	if (ret)
+		return ret;
+
+	return cdnsp_phys_init(cdns);
+}
+
+static int cdnsp_set_platform_suspend(struct cdns *cdns, bool suspend,
+				      bool wakeup)
+{
+	if (cdns->pdata && cdns->pdata->platform_suspend)
+		return cdns->pdata->platform_suspend(cdns->dev, suspend, wakeup);
+
+	return 0;
+}
+
+static int cdnsp_restore_platform(struct cdns *cdns)
+{
+	if (cdns->pdata && cdns->pdata->platform_restore)
+		return cdns->pdata->platform_restore(cdns->dev);
+
+	return 0;
+}
+
+/**
+ * cdnsp_plat_probe() - probe a CDNSP platform controller
+ * @pdev: platform device containing the controller resources
+ *
+ * Return: 0 on success or a negative errno.
+ */
+static int cdnsp_plat_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct resource *res;
+	struct cdns *cdns;
+	void __iomem *regs;
+	int ret;
+
+	cdns = devm_kzalloc(dev, sizeof(*cdns), GFP_KERNEL);
+	if (!cdns)
+		return -ENOMEM;
+
+	cdns->dev = dev;
+	cdns->pdata = dev_get_platdata(dev);
+	if (has_acpi_companion(dev) && !cdns->pdata)
+		return dev_err_probe(dev, -EPROBE_DEFER,
+				     "waiting for Sky1 wrapper data\n");
+
+	platform_set_drvdata(pdev, cdns);
+
+	ret = platform_get_irq_byname(pdev, "host");
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "failed to get host IRQ\n");
+
+	cdns->xhci_res[0].start = ret;
+	cdns->xhci_res[0].end = ret;
+	cdns->xhci_res[0].flags = IORESOURCE_IRQ | irq_get_trigger_type(ret);
+	cdns->xhci_res[0].name = "host";
+
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "xhci");
+	if (!res)
+		return dev_err_probe(dev, -ENXIO,
+				     "failed to get xHCI resource\n");
+	cdns->xhci_res[1] = *res;
+
+	cdns->dev_irq = platform_get_irq_byname(pdev, "peripheral");
+	if (cdns->dev_irq < 0)
+		return dev_err_probe(dev, cdns->dev_irq,
+				     "failed to get peripheral IRQ\n");
+
+	regs = devm_platform_ioremap_resource_byname(pdev, "dev");
+	if (IS_ERR(regs))
+		return dev_err_probe(dev, PTR_ERR(regs),
+				     "failed to map device registers\n");
+	cdns->dev_regs = regs;
+
+	cdns->otg_irq = platform_get_irq_byname(pdev, "otg");
+	if (cdns->otg_irq < 0)
+		return dev_err_probe(dev, cdns->otg_irq,
+				     "failed to get OTG IRQ\n");
+
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "otg");
+	if (!res)
+		return dev_err_probe(dev, -ENXIO,
+				     "failed to get OTG resource\n");
+	cdns->otg_res = *res;
+
+	cdns->phyrst_a_enable =
+		device_property_read_bool(dev, "cdns,phyrst-a-enable");
+
+	cdns->wakeup_irq = platform_get_irq_byname_optional(pdev, "wakeup");
+	if (cdns->wakeup_irq == -EPROBE_DEFER)
+		return cdns->wakeup_irq;
+	if (cdns->wakeup_irq < 0) {
+		dev_dbg(dev, "optional wakeup IRQ is unavailable\n");
+		cdns->wakeup_irq = 0;
+	}
+
+	cdns->usb2_phy = cdnsp_phy_get(dev, "cdnsp,usb2-phy");
+	if (IS_ERR(cdns->usb2_phy))
+		return dev_err_probe(dev, PTR_ERR(cdns->usb2_phy),
+				     "failed to get USB2 PHY\n");
+
+	cdns->usb3_phy = cdnsp_phy_get(dev, "cdnsp,usb3-phy");
+	if (IS_ERR(cdns->usb3_phy))
+		return dev_err_probe(dev, PTR_ERR(cdns->usb3_phy),
+				     "failed to get USB3 PHY\n");
+
+	ret = cdnsp_phys_init(cdns);
+	if (ret)
+		goto err_exit_phys;
+
+	ret = cdnsp_phys_power_on(cdns);
+	if (ret)
+		goto err_power_off_phys;
+
+	cdns->gadget_init = cdnsp_gadget_init;
+	ret = cdns_init(cdns);
+	if (ret)
+		goto err_power_off_phys;
+
+	device_set_wakeup_capable(dev, true);
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+	if (!(cdns->pdata &&
+	      cdns->pdata->quirks & CDNS3_DEFAULT_PM_RUNTIME_ALLOW))
+		pm_runtime_forbid(dev);
+
+	pm_runtime_set_autosuspend_delay(dev, 200);
+	pm_runtime_mark_last_busy(dev);
+	pm_runtime_use_autosuspend(dev);
+
+	return 0;
+
+err_power_off_phys:
+	cdnsp_phys_power_off(cdns);
+err_exit_phys:
+	cdnsp_phys_exit(cdns);
+	return ret;
+}
+
+/**
+ * cdnsp_plat_remove() - unbind a CDNSP platform controller
+ * @pdev: platform device containing the controller
+ */
+static void cdnsp_plat_remove(struct platform_device *pdev)
+{
+	struct cdns *cdns = platform_get_drvdata(pdev);
+	struct device *dev = &pdev->dev;
+	int ret;
+
+	ret = pm_runtime_get_sync(dev);
+	if (ret < 0)
+		dev_warn(dev, "failed to resume controller for removal: %d\n", ret);
+	if (!(cdns->pdata &&
+	      cdns->pdata->quirks & CDNS3_DEFAULT_PM_RUNTIME_ALLOW))
+		pm_runtime_allow(dev);
+	pm_runtime_disable(dev);
+	pm_runtime_put_noidle(dev);
+
+	cdns_remove(cdns);
+
+	ret = cdnsp_phys_power_off(cdns);
+	if (ret)
+		dev_warn(dev, "failed to power off PHYs: %d\n", ret);
+	ret = cdnsp_phys_exit(cdns);
+	if (ret)
+		dev_warn(dev, "failed to exit PHYs: %d\n", ret);
+}
+
+static int cdnsp_controller_suspend(struct device *dev, pm_message_t msg)
+{
+	struct cdns *cdns = dev_get_drvdata(dev);
+	unsigned long flags;
+	bool wakeup;
+	int ret;
+
+	if (READ_ONCE(cdns->in_lpm))
+		return 0;
+
+	wakeup = PMSG_IS_AUTO(msg) || device_may_wakeup(dev);
+	ret = cdnsp_set_platform_suspend(cdns, true, wakeup);
+	if (ret)
+		return ret;
+
+	ret = cdnsp_phys_power_off(cdns);
+	if (ret) {
+		cdnsp_set_platform_suspend(cdns, false, false);
+		return ret;
+	}
+
+	spin_lock_irqsave(&cdns->lock, flags);
+	cdns->in_lpm = true;
+	spin_unlock_irqrestore(&cdns->lock, flags);
+
+	return 0;
+}
+
+static int cdnsp_controller_resume(struct device *dev, pm_message_t msg)
+{
+	struct cdns *cdns = dev_get_drvdata(dev);
+	unsigned long flags;
+	bool power_lost;
+	int ret;
+
+	if (!READ_ONCE(cdns->in_lpm))
+		return 0;
+
+	power_lost = cdns_power_is_lost(cdns);
+	if (power_lost) {
+		ret = cdnsp_restore_platform(cdns);
+		if (ret)
+			return ret;
+		cdns->phys_reinit_pending = true;
+	}
+
+	if (cdns->phys_reinit_pending) {
+		ret = cdnsp_phys_reinit(cdns);
+		if (ret)
+			return ret;
+		cdns->phys_reinit_pending = false;
+	}
+
+	ret = cdnsp_phys_power_on(cdns);
+	if (ret)
+		return ret;
+
+	ret = cdnsp_set_platform_suspend(cdns, false, false);
+	if (ret)
+		goto err_power_off_phys;
+
+	ret = cdns_resume(cdns);
+	if (ret)
+		goto err_enter_low_power;
+
+	spin_lock_irqsave(&cdns->lock, flags);
+	cdns->in_lpm = false;
+	spin_unlock_irqrestore(&cdns->lock, flags);
+
+	cdns_set_active(cdns, !PMSG_IS_AUTO(msg));
+	if (cdns->wakeup_pending) {
+		cdns->wakeup_pending = false;
+		enable_irq(cdns->wakeup_irq);
+	}
+
+	return 0;
+
+err_enter_low_power:
+	cdnsp_set_platform_suspend(cdns, true, false);
+err_power_off_phys:
+	cdnsp_phys_power_off(cdns);
+	return ret;
+}
+
+static int cdnsp_plat_runtime_suspend(struct device *dev)
+{
+	return cdnsp_controller_suspend(dev, PMSG_AUTO_SUSPEND);
+}
+
+static int cdnsp_plat_runtime_resume(struct device *dev)
+{
+	return cdnsp_controller_resume(dev, PMSG_AUTO_RESUME);
+}
+
+static int cdnsp_plat_suspend(struct device *dev)
+{
+	struct cdns *cdns = dev_get_drvdata(dev);
+	int ret;
+
+	ret = cdns_suspend(cdns);
+	if (ret)
+		return ret;
+
+	ret = cdnsp_controller_suspend(dev, PMSG_SUSPEND);
+	if (ret) {
+		cdns_resume(cdns);
+		return ret;
+	}
+
+	if (device_may_wakeup(dev) && cdns->wakeup_irq) {
+		ret = enable_irq_wake(cdns->wakeup_irq);
+		if (ret) {
+			cdnsp_controller_resume(dev, PMSG_RESUME);
+			return ret;
+		}
+	}
+
+	return 0;
+}
+
+static int cdnsp_plat_resume(struct device *dev)
+{
+	struct cdns *cdns = dev_get_drvdata(dev);
+	int ret;
+
+	ret = cdnsp_controller_resume(dev, PMSG_RESUME);
+	if (ret)
+		return ret;
+
+	if (device_may_wakeup(dev) && cdns->wakeup_irq)
+		return disable_irq_wake(cdns->wakeup_irq);
+
+	return 0;
+}
+
+static const struct dev_pm_ops cdnsp_pm_ops = {
+	SYSTEM_SLEEP_PM_OPS(cdnsp_plat_suspend, cdnsp_plat_resume)
+	RUNTIME_PM_OPS(cdnsp_plat_runtime_suspend,
+		       cdnsp_plat_runtime_resume, NULL)
+};
+
+static const struct of_device_id of_cdnsp_match[] = {
+	{ .compatible = "cdns,usbssp" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, of_cdnsp_match);
+
+static const struct acpi_device_id acpi_cdnsp_match[] = {
+	{ "CIXH2031" },
+	{}
+};
+MODULE_DEVICE_TABLE(acpi, acpi_cdnsp_match);
+
+static struct platform_driver cdnsp_driver = {
+	.probe = cdnsp_plat_probe,
+	.remove = cdnsp_plat_remove,
+	.shutdown = cdnsp_plat_remove,
+	.driver = {
+		.name = "cdns-usbssp",
+		.of_match_table = of_cdnsp_match,
+		.acpi_match_table = ACPI_PTR(acpi_cdnsp_match),
+		.pm = pm_ptr(&cdnsp_pm_ops),
+	},
+};
+module_platform_driver(cdnsp_driver);
+
+MODULE_ALIAS("platform:cdnsp");
