ACPI: demote verified CIX Sky1 PCI ECAM duplicates

Stock CIXTEK SKY1EDK2 firmware describes the PCI ECAM windows again through
PNP0C02 UID 0.  Recognise only the complete five-window form or the exact
combined-window form, and demote the message only when the conflicting resource
is named PCI ECAM.  All other reservation conflicts retain the generic
informational diagnostic.  No firmware version string is consulted.

---
diff --git a/drivers/acpi/scan.c b/drivers/acpi/scan.c
--- a/drivers/acpi/scan.c
+++ b/drivers/acpi/scan.c
@@ -24,6 +24,7 @@
 #include <linux/pgtable.h>
 #include <linux/crc32.h>
 #include <linux/dma-direct.h>
+#include <linux/string.h>
 
 #include "internal.h"
 #include "sleep.h"
@@ -2623,22 +2624,76 @@ static void acpi_scan_postponed(void)
 	mutex_unlock(&acpi_dep_list_lock);
 }
 
+static bool
+acpi_scan_has_exact_cix_sky1_ecam_resources(struct acpi_device *adev,
+					    struct list_head *resource_list)
+{
+	static const struct acpi_platform_list cix_sky1_platforms[] = {
+		{"CIXTEK", "SKY1EDK2", 0, ACPI_SIG_DSDT, all_versions},
+		{ }
+	};
+	unsigned int count = 0, ranges = 0;
+	struct resource_entry *rentry;
+
+	if (acpi_match_platform_list(cix_sky1_platforms) < 0 ||
+	    !acpi_dev_hid_uid_match(adev, "PNP0C02", 0))
+		return false;
+
+	list_for_each_entry(rentry, resource_list, node) {
+		struct resource *res = rentry->res;
+
+		if (resource_type(res) != IORESOURCE_MEM ||
+		    res->flags & IORESOURCE_DISABLED)
+			continue;
+
+		count++;
+		if (res->start == 0x20000000 && res->end == 0x2fffffff)
+			ranges |= 0x20;
+		else if (res->start == 0x20000000 &&
+			 res->end == 0x21ffffff)
+			ranges |= 0x01;
+		else if (res->start == 0x23000000 &&
+			 res->end == 0x24ffffff)
+			ranges |= 0x02;
+		else if (res->start == 0x26000000 &&
+			 res->end == 0x27ffffff)
+			ranges |= 0x04;
+		else if (res->start == 0x29000000 &&
+			 res->end == 0x2affffff)
+			ranges |= 0x08;
+		else if (res->start == 0x2c000000 &&
+			 res->end == 0x2fffffff)
+			ranges |= 0x10;
+		else
+			return false;
+	}
+
+	return (count == 1 && ranges == 0x20) ||
+	       (count == 5 && ranges == 0x1f);
+}
