+static const struct snd_soc_dapm_route sky1_sof_routes[] = {
+	{ "HiFi5 Process Playback", NULL, "BUF4.1" },
+	{ "PCM2C", NULL, "HiFi5 Process Capture" },
+};
+
+static int sky1_sof_add_dai_link(struct snd_soc_card *card,
+				 struct snd_soc_dai_link *link)
+{
+	if (!strcmp(link->name, "HiFi5 Process"))
+		link->be_hw_params_fixup = NULL;
+
+	return 0;
+}
+
+static int sky1_sof_physical_link(struct device *dev,
+				  struct snd_soc_dai_link *link,
+				  struct snd_soc_dai_driver *dai)
+{
+	struct snd_soc_dai_link_component *components;
+
+	components = devm_kcalloc(dev, 2, sizeof(*components), GFP_KERNEL);
+	if (!components)
+		return -ENOMEM;
+
+	link->name = devm_kasprintf(dev, GFP_KERNEL, "NoCodec-%u", dai->id);
+	if (!link->name)
+		return -ENOMEM;
+
+	link->stream_name = link->name;
+	link->cpus = &components[0];
+	link->codecs = &snd_soc_dummy_dlc;
+	link->platforms = &components[1];
+	link->num_cpus = 1;
+	link->num_codecs = 1;
+	link->num_platforms = 1;
+	link->id = dai->id;
+	link->no_pcm = 1;
+	link->cpus->dai_name = dai->name;
+	link->platforms->name = dev_name(dev->parent);
+	link->playback_only = dai->playback.channels_min &&
+			      !dai->capture.channels_min;
+	link->capture_only = !dai->playback.channels_min &&
+			     dai->capture.channels_min;
+	link->be_hw_params_fixup = sof_pcm_dai_link_fixup;
+
+	return 0;
+}
+
+static int sky1_sof_process_link(struct device *dev,
+				 struct snd_soc_dai_link *link)
+{
+	struct snd_soc_dai_link_component *components;
+
+	components = devm_kcalloc(dev, 2, sizeof(*components), GFP_KERNEL);
+	if (!components)
+		return -ENOMEM;
+
+	link->name = "HiFi5 Process";
+	link->stream_name = link->name;
+	link->cpus = &components[0];
+	link->codecs = &snd_soc_dummy_dlc;
+	link->platforms = &components[1];
+	link->num_cpus = 1;
+	link->num_codecs = 1;
+	link->num_platforms = 1;
+	link->id = 4;
+	link->no_pcm = 1;
+	link->cpus->dai_name = "host-process";
+	link->platforms->name = dev_name(dev->parent);
+
+	return 0;
+}
+
+static int sky1_sof_nocodec_probe(struct platform_device *pdev)
+{
+	struct snd_soc_acpi_mach *mach = dev_get_platdata(&pdev->dev);
+	struct snd_soc_card *card;
+	struct snd_soc_dai_link *links;
+	unsigned int i;
+	int ret;
+
+	if (!mach || mach->mach_params.num_dai_drivers != 2)
+		return dev_err_probe(&pdev->dev, -EINVAL,
+				     "expected two physical DSP DAIs\n");
+
+	card = devm_kzalloc(&pdev->dev, sizeof(*card), GFP_KERNEL);
+	links = devm_kcalloc(&pdev->dev, 3, sizeof(*links), GFP_KERNEL);
+	if (!card || !links)
+		return -ENOMEM;
+
+	for (i = 0; i < mach->mach_params.num_dai_drivers; i++) {
+		ret = sky1_sof_physical_link(&pdev->dev, &links[i],
+					     &mach->mach_params.dai_drivers[i]);
+		if (ret)
+			return ret;
+	}
+
+	ret = sky1_sof_process_link(&pdev->dev, &links[i]);
+	if (ret)
+		return ret;
+
+	card->name = "nocodec";
+	strscpy(card->topology_shortname, "sof-nocodec",
+		sizeof(card->topology_shortname));
+	card->topology_shortname_created = true;
+	card->owner = THIS_MODULE;
+	card->dev = &pdev->dev;
+	card->dai_link = links;
+	card->num_links = 3;
+	card->dapm_routes = sky1_sof_routes;
+	card->num_dapm_routes = ARRAY_SIZE(sky1_sof_routes);
+	card->add_dai_link = sky1_sof_add_dai_link;
+
+	return devm_snd_soc_register_card(&pdev->dev, card);
+}
+
+static struct platform_driver sky1_sof_nocodec_driver = {
+	.probe = sky1_sof_nocodec_probe,
+	.driver = {
+		.name = "sof-cix-sky1-nocodec",
+		.pm = &snd_soc_pm_ops,
+	},
+};
+module_platform_driver(sky1_sof_nocodec_driver);
+
+MODULE_DESCRIPTION("CIX Sky1 SOF codec-free ASoC machine driver");
+MODULE_LICENSE("Dual BSD/GPL");
+MODULE_ALIAS("platform:sof-cix-sky1-nocodec");
