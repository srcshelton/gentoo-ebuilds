+#ifndef __INCLUDE_SOUND_SOF_DAI_CIX_H__
+#define __INCLUDE_SOUND_SOF_DAI_CIX_H__
+
+#include <sound/sof/header.h>
+
+/* Wire identifiers used by the released Sky1 SOF firmware ABI. */
+#define SOF_DAI_CIX_I2S_SC_IPC		12U
+#define SOF_DAI_CIX_I2S_MC_IPC		13U
+
+struct sof_ipc_dai_i2s_sc_params {
+	struct sof_ipc_hdr hdr;
+	u32 rate;
+	u16 channels;
+	u16 format;
+	u16 mclk_id;
+	u16 mclk_fs;
+	u16 playback_dma_ch;
+	u16 capture_dma_ch;
+	u32 tdm_slots;
+	u32 tdm_rx_slot_mask;
+	u32 tdm_tx_slot_mask;
+	u32 tdm_slot_width;
+} __packed;
+
+struct sof_ipc_dai_i2s_mc_params {
+	struct sof_ipc_hdr hdr;
+	u32 rate;
+	u16 channels;
+	u16 format;
+	u16 mclk_id;
+	u16 mclk_fs;
+	u16 playback_dma_ch;
+	u16 capture_dma_ch;
+	u16 pin_rx_mask;
+	u16 pin_tx_mask;
+} __packed;
+
+#endif /* __INCLUDE_SOUND_SOF_DAI_CIX_H__ */
