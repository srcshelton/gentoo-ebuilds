+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-3-Clause)
+/*
+ * Codec-free ASoC machine support for the CIX Sky1 HiFi5 DSP
+ *
+ * Copyright 2026 CIX kernel overlay maintainers
+ */
+
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <sound/sof.h>
+#include <sound/soc.h>
+
+#include "../sof-audio.h"
