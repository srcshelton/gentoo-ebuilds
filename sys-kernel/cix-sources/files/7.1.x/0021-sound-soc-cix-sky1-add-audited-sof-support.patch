+	},
+};
+
+static struct snd_soc_acpi_mach sky1_sof_machine = {
+	.drv_name = "sof-cix-sky1-nocodec",
+	.sof_tplg_filename = "sof-sky1-nocodec.tplg",
+};
+
+static struct snd_soc_acpi_mach *sky1_sof_machine_select(struct snd_sof_dev *sdev)
+{
+	sdev->pdata->tplg_filename = sky1_sof_machine.sof_tplg_filename;
+
+	return &sky1_sof_machine;
+}
+
+static void sky1_sof_set_mach_params(struct snd_soc_acpi_mach *mach,
+				     struct snd_sof_dev *sdev)
+{
+	struct snd_soc_acpi_mach_params *params = &mach->mach_params;
+
+	params->platform = dev_name(sdev->dev);
+	params->num_dai_drivers = 2;
+	params->dai_drivers = sky1_sof_dais;
+}
+
+static const struct snd_sof_dsp_ops sky1_sof_ops = {
+	.probe = sky1_sof_probe,
+	.remove = sky1_sof_remove,
+	.shutdown = sky1_sof_shutdown,
+	.reset = sky1_sof_reset,
+	.pre_fw_run = sky1_sof_pre_fw_run,
+	.run = sky1_sof_run,
+	.block_read = sof_block_read,
+	.block_write = sof_block_write,
+	.mailbox_read = sof_mailbox_read,
+	.mailbox_write = sof_mailbox_write,
+	.send_msg = sky1_sof_send_msg,
+	.ipc_msg_data = sof_ipc_msg_data,
+	.set_stream_data_offset = sof_set_stream_data_offset,
+	.load_firmware = snd_sof_load_firmware_memcpy,
+	.get_bar_index = sky1_sof_get_bar_index,
+	.get_mailbox_offset = sky1_sof_get_mailbox_offset,
+	.get_window_offset = sky1_sof_get_window_offset,
+	.pcm_open = sof_stream_pcm_open,
+	.pcm_close = sof_stream_pcm_close,
+	.dbg_dump = sky1_sof_dump,
+	.debugfs_add_region_item = snd_sof_debugfs_add_region_item_iomem,
+	.suspend = sky1_sof_suspend,
+	.resume = sky1_sof_resume,
+	.runtime_suspend = sky1_sof_runtime_suspend,
+	.runtime_resume = sky1_sof_runtime_resume,
+	.set_power_state = sky1_sof_set_power_state,
+	.set_mach_params = sky1_sof_set_mach_params,
+	.machine_select = sky1_sof_machine_select,
+	.machine_register = sof_machine_register,
+	.machine_unregister = sof_machine_unregister,
+	.drv = sky1_sof_dais,
