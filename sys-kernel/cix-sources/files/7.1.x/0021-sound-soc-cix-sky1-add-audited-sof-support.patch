+							 SNDRV_PCM_HW_PARAM_CHANNELS);
+	struct snd_interval *rate = hw_param_interval(params, SNDRV_PCM_HW_PARAM_RATE);
+
+	rate->min = config->cix_i2s_mc.rate;
+	rate->max = config->cix_i2s_mc.rate;
+	channels->min = config->cix_i2s_mc.channels;
+	channels->max = config->cix_i2s_mc.channels;
+
+	return 0;
+}
+
+const struct sof_ipc3_platform_dai
+sky1_sof_ipc3_dais[SKY1_SOF_IPC3_DAI_COUNT] = {
