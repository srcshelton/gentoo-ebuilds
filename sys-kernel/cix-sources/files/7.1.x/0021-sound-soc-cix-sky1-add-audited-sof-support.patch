+			.tokens = sky1_i2s_mc_tokens,
+			.count = ARRAY_SIZE(sky1_i2s_mc_tokens),
+		},
+		.config_offset = offsetof(struct sof_ipc_dai_config, cix_i2s_mc),
+		.config_size = sizeof(struct sof_ipc_dai_i2s_mc_params),
+		.hw_config_optional = true,
