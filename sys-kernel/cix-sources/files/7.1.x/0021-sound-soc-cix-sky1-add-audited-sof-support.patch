diff --git a/sound/soc/sof/cix/Kconfig b/sound/soc/sof/cix/Kconfig
new file mode 100644
--- /dev/null
+++ b/sound/soc/sof/cix/Kconfig
@@ -0,0 +1,34 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-3-Clause)
+
+config SND_SOC_SOF_CIX_SKY1
+	tristate "SOF support for the CIX Sky1 HiFi5 DSP"
+	depends on (ARCH_CIX && ACPI) || COMPILE_TEST
+	depends on CIX_HIFI5_FIRMWARE_SOF
+	select CIX_HIFI5_COMMON if ARM64
+	select CIX_MBOX
+	select DMA_DECLARE_COHERENT
+	select MAILBOX
+	select MFD_SYSCON
+	select RESET_CONTROLLER
+	select SND_SOC_SOF
+	select SND_SOC_SOF_ACPI_DEV
+	select SND_SOC_SOF_COMPRESS
+	select SND_SOC_SOF_IPC3
+	select SND_SOC_SOF_CIX_SKY1_NOCODEC
+	select SND_SOC_SOF_XTENSA
+	help
+	  Enable the ACPI-native Sound Open Firmware owner for the HiFi5 DSP
+	  in CIX Sky1 systems.  The driver requires firmware tables that expose
+	  the AP-to-DSP and DSP-to-AP doorbell mailbox channels as txdb and rxdb.
+
+	  If firmware exposes the fixed audio aperture as System RAM, the built-in
+	  CIX platform helper reserves it automatically before allocation.
+	  cix_hifi5_legacy_reserve=0 disables that compatibility correction.
+
+	  The driver may be built as a module.  A small built-in CIX platform
+	  helper owns the early memory reservation and shared hardware-resource
+	  sequencing needed by the unloadable SOF driver.
+
+config SND_SOC_SOF_CIX_SKY1_NOCODEC
+	tristate
+	depends on SND_SOC
