diff --git a/sound/soc/sof/cix/cix-sky1-ipc3.c b/sound/soc/sof/cix/cix-sky1-ipc3.c
new file mode 100644
--- /dev/null
+++ b/sound/soc/sof/cix/cix-sky1-ipc3.c
@@ -0,0 +1,215 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-3-Clause)
+/*
+ * Sound Open Firmware IPC3 topology support for the CIX Sky1 HiFi5 DSP
+ *
+ * Copyright 2024 Cix Technology Group Co., Ltd.
+ * Copyright 2026 CIX kernel overlay maintainers
+ */
+
+#include <linux/bits.h>
+#include <linux/kernel.h>
+#include <sound/pcm_params.h>
+#include <sound/sof/dai.h>
+#include <uapi/sound/sof/tokens.h>
+
+#include "cix-sky1-ipc3.h"
+
+static const struct sof_topology_token sky1_i2s_sc_tokens[] = {
+	{ SOF_TKN_CIX_I2S_SC_RATE, SND_SOC_TPLG_TUPLE_TYPE_WORD, NULL,
+		offsetof(struct sof_ipc_dai_i2s_sc_params, rate) },
+	{ SOF_TKN_CIX_I2S_SC_CHANNELS, SND_SOC_TPLG_TUPLE_TYPE_SHORT, NULL,
+		offsetof(struct sof_ipc_dai_i2s_sc_params, channels) },
+	{ SOF_TKN_CIX_I2S_SC_FORMAT, SND_SOC_TPLG_TUPLE_TYPE_SHORT, NULL,
+		offsetof(struct sof_ipc_dai_i2s_sc_params, format) },
+	{ SOF_TKN_CIX_I2S_SC_MCLK_ID, SND_SOC_TPLG_TUPLE_TYPE_SHORT, NULL,
+		offsetof(struct sof_ipc_dai_i2s_sc_params, mclk_id) },
+	{ SOF_TKN_CIX_I2S_SC_MCLK_FS, SND_SOC_TPLG_TUPLE_TYPE_SHORT, NULL,
+		offsetof(struct sof_ipc_dai_i2s_sc_params, mclk_fs) },
+	{ SOF_TKN_CIX_I2S_SC_PLAYBACK_DMA_CH, SND_SOC_TPLG_TUPLE_TYPE_SHORT, NULL,
+		offsetof(struct sof_ipc_dai_i2s_sc_params, playback_dma_ch) },
+	{ SOF_TKN_CIX_I2S_SC_CAPTURE_DMA_CH, SND_SOC_TPLG_TUPLE_TYPE_SHORT, NULL,
+		offsetof(struct sof_ipc_dai_i2s_sc_params, capture_dma_ch) },
+};
+
+static const struct sof_topology_token sky1_i2s_mc_tokens[] = {
+	{ SOF_TKN_CIX_I2S_MC_RATE, SND_SOC_TPLG_TUPLE_TYPE_WORD, NULL,
+		offsetof(struct sof_ipc_dai_i2s_mc_params, rate) },
+	{ SOF_TKN_CIX_I2S_MC_CHANNELS, SND_SOC_TPLG_TUPLE_TYPE_SHORT, NULL,
+		offsetof(struct sof_ipc_dai_i2s_mc_params, channels) },
+	{ SOF_TKN_CIX_I2S_MC_FORMAT, SND_SOC_TPLG_TUPLE_TYPE_SHORT, NULL,
+		offsetof(struct sof_ipc_dai_i2s_mc_params, format) },
+	{ SOF_TKN_CIX_I2S_MC_MCLK_ID, SND_SOC_TPLG_TUPLE_TYPE_SHORT, NULL,
+		offsetof(struct sof_ipc_dai_i2s_mc_params, mclk_id) },
+	{ SOF_TKN_CIX_I2S_MC_MCLK_FS, SND_SOC_TPLG_TUPLE_TYPE_SHORT, NULL,
+		offsetof(struct sof_ipc_dai_i2s_mc_params, mclk_fs) },
+	{ SOF_TKN_CIX_I2S_MC_PLAYBACK_DMA_CH, SND_SOC_TPLG_TUPLE_TYPE_SHORT, NULL,
+		offsetof(struct sof_ipc_dai_i2s_mc_params, playback_dma_ch) },
+	{ SOF_TKN_CIX_I2S_MC_CAPTURE_DMA_CH, SND_SOC_TPLG_TUPLE_TYPE_SHORT, NULL,
+		offsetof(struct sof_ipc_dai_i2s_mc_params, capture_dma_ch) },
+	{ SOF_TKN_CIX_I2S_MC_PIN_RX_MASK, SND_SOC_TPLG_TUPLE_TYPE_SHORT, NULL,
+		offsetof(struct sof_ipc_dai_i2s_mc_params, pin_rx_mask) },
+	{ SOF_TKN_CIX_I2S_MC_PIN_TX_MASK, SND_SOC_TPLG_TUPLE_TYPE_SHORT, NULL,
+		offsetof(struct sof_ipc_dai_i2s_mc_params, pin_tx_mask) },
+};
+
+static int sky1_i2s_validate_common(struct snd_soc_component *scomp, const char *name,
+				    u32 rate, u16 channels, u16 playback_dma_ch,
+				    u16 capture_dma_ch, u16 min_channels)
+{
+	if (rate < 8000 || rate > 192000) {
+		dev_err(scomp->dev, "%s has invalid sample rate %u\n", name, rate);
+		return -EINVAL;
+	}
+
+	if (channels < min_channels || channels > 16) {
+		dev_err(scomp->dev, "%s has invalid channel count %u\n", name, channels);
+		return -EINVAL;
+	}
+
+	if (playback_dma_ch == capture_dma_ch) {
+		dev_err(scomp->dev, "%s reuses DMA channel %u for playback and capture\n",
+			name, playback_dma_ch);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int sky1_i2s_sc_finalize(struct snd_soc_component *scomp,
+				const struct snd_sof_dai_link *slink,
+				struct sof_ipc_dai_config *config)
+{
+	struct sof_ipc_dai_i2s_sc_params *params = &config->cix_i2s_sc;
+	int ret;
+
+	ret = sky1_i2s_validate_common(scomp, "I2SSC", params->rate,
+				       params->channels, params->playback_dma_ch,
+				       params->capture_dma_ch, 1);
+	if (ret)
+		return ret;
+
+	if (slink->num_hw_configs) {
+		const struct snd_soc_tplg_hw_config *hw_config = slink->hw_configs;
+
+		params->tdm_slots = le32_to_cpu(hw_config->tdm_slots);
+		params->tdm_slot_width = le32_to_cpu(hw_config->tdm_slot_width);
+		params->tdm_rx_slot_mask = le32_to_cpu(hw_config->rx_slots);
+		params->tdm_tx_slot_mask = le32_to_cpu(hw_config->tx_slots);
+	}
+
+	if (!!params->tdm_slots != !!params->tdm_slot_width ||
+	    params->tdm_slots > 32 || params->tdm_slot_width > 64 ||
+	    (params->tdm_slots && params->channels > params->tdm_slots)) {
+		dev_err(scomp->dev, "I2SSC has invalid TDM shape: %u channels, %u slots x %u bits\n",
+			params->channels, params->tdm_slots, params->tdm_slot_width);
+		return -EINVAL;
+	}
+
+	if ((!params->tdm_slots &&
+	     (params->tdm_rx_slot_mask || params->tdm_tx_slot_mask)) ||
+	    (params->tdm_slots && params->tdm_slots < 32 &&
+	     ((params->tdm_rx_slot_mask | params->tdm_tx_slot_mask) &
+	      ~GENMASK(params->tdm_slots - 1, 0)))) {
+		dev_err(scomp->dev, "I2SSC slot mask exceeds its TDM slot count\n");
+		return -EINVAL;
+	}
+
+	dev_dbg(scomp->dev,
+		"I2SSC%u: rate %u, channels %u, DMA %u/%u, TDM %u x %u\n",
+		config->dai_index, params->rate, params->channels,
+		params->playback_dma_ch, params->capture_dma_ch,
+		params->tdm_slots, params->tdm_slot_width);
+
+	return 0;
+}
+
+static int sky1_i2s_mc_finalize(struct snd_soc_component *scomp,
+				const struct snd_sof_dai_link *slink __maybe_unused,
+				struct sof_ipc_dai_config *config)
+{
+	struct sof_ipc_dai_i2s_mc_params *params = &config->cix_i2s_mc;
+	int ret;
+
+	ret = sky1_i2s_validate_common(scomp, "I2SMC", params->rate,
+				       params->channels, params->playback_dma_ch,
+				       params->capture_dma_ch, 2);
+	if (ret)
+		return ret;
+
+	if (!(params->pin_rx_mask | params->pin_tx_mask)) {
+		dev_err(scomp->dev, "I2SMC has no active data pins\n");
+		return -EINVAL;
+	}
+
+	dev_dbg(scomp->dev,
+		"I2SMC%u: rate %u, channels %u, DMA %u/%u, pin masks %#x/%#x\n",
+		config->dai_index, params->rate, params->channels,
+		params->playback_dma_ch, params->capture_dma_ch,
+		params->pin_rx_mask, params->pin_tx_mask);
+
+	return 0;
+}
+
+static int sky1_i2s_sc_link_fixup(struct snd_soc_pcm_runtime *rtd __maybe_unused,
+				  struct snd_pcm_hw_params *params,
+				  const struct sof_ipc_dai_config *config)
+{
+	struct snd_interval *channels = hw_param_interval(params,
+							 SNDRV_PCM_HW_PARAM_CHANNELS);
+	struct snd_interval *rate = hw_param_interval(params, SNDRV_PCM_HW_PARAM_RATE);
+
+	rate->min = config->cix_i2s_sc.rate;
+	rate->max = config->cix_i2s_sc.rate;
+	channels->min = config->cix_i2s_sc.channels;
+	channels->max = config->cix_i2s_sc.channels;
+
+	return 0;
+}
+
+static int sky1_i2s_mc_link_fixup(struct snd_soc_pcm_runtime *rtd __maybe_unused,
+				  struct snd_pcm_hw_params *params,
+				  const struct sof_ipc_dai_config *config)
+{
