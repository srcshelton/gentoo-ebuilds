+	.ipc3_dais = sky1_sof_ipc3_dais,
+	.num_ipc3_dais = SKY1_SOF_IPC3_DAI_COUNT,
+	.hw_info = SNDRV_PCM_INFO_MMAP |
+		   SNDRV_PCM_INFO_MMAP_VALID |
