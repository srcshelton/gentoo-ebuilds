+static int sof_ipc3_validate_platform_tokens(struct snd_soc_component *scomp,
+					     const struct snd_sof_dai_link *slink)
+{
+	const struct sof_token_info *token_info = &slink->platform_dai->tokens;
+	int i;
+
+	for (i = 0; i < token_info->count; i++) {
+		int count = 0;
+		int j;
+
+		for (j = 0; j < slink->num_tuples; j++) {
+			if (slink->tuples[j].token == token_info->tokens[i].token)
+				count++;
+		}
+
+		if (count != 1) {
+			dev_err(scomp->dev,
+				"DAI link %s requires exactly one %s token %u, found %d\n",
+				slink->link->name, token_info->name,
+				token_info->tokens[i].token, count);
+			return -EINVAL;
+		}
+	}
+
+	return 0;
+}
+
+static int sof_ipc3_validate_platform_widget(struct snd_soc_component *scomp,
+					     const struct snd_sof_widget *swidget,
+					     const struct sof_ipc3_platform_dai *platform_dai)
+{
+	const char *name = NULL;
+	int count = 0;
+	int i;
+
+	for (i = 0; i < swidget->num_tuples; i++) {
+		if (swidget->tuples[i].token != SOF_TKN_DAI_TYPE)
+			continue;
+
+		name = swidget->tuples[i].value.s;
+		count++;
+	}
+
+	if (count != 1 || !name || strcmp(name, platform_dai->name)) {
+		dev_err(scomp->dev,
+			"DAI widget %s type does not match platform link type %s\n",
+			swidget->widget->name, platform_dai->name);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int sof_link_platform_dai_load(struct snd_soc_component *scomp,
+				      struct snd_sof_dai_link *slink,
+				      struct sof_ipc_dai_config *config,
+				      struct snd_sof_dai *dai)
+{
+	const struct sof_ipc3_platform_dai *platform_dai = slink->platform_dai;
+	struct sof_dai_private_data *private = dai->private;
+	const struct sof_ipc_comp_dai *comp_dai = private->comp_dai;
+	void *platform_config;
+	int ret;
+
+	if (slink->num_hw_configs > 1 ||
+	    (!slink->num_hw_configs && !platform_dai->hw_config_optional)) {
+		dev_err(scomp->dev, "DAI link %s has %d hardware configs, expected %s\n",
+			slink->link->name, slink->num_hw_configs,
+			platform_dai->hw_config_optional ? "zero or one" : "one");
+		return -EINVAL;
+	}
+
+	if (platform_dai->config_offset > sizeof(*config) ||
+	    platform_dai->config_size > sizeof(*config) - platform_dai->config_offset) {
+		dev_err(scomp->dev, "Invalid platform DAI config layout for %s\n",
+			platform_dai->name);
+		return -EINVAL;
+	}
+
+	ret = sof_ipc3_validate_platform_tokens(scomp, slink);
+	if (ret)
+		return ret;
+
+	config->hdr.cmd = SOF_IPC_GLB_DAI_MSG | SOF_IPC_DAI_CONFIG;
+	config->hdr.size = sizeof(*config);
+	config->type = platform_dai->ipc_type;
+	config->dai_index = comp_dai->dai_index;
+	if (slink->num_hw_configs)
+		sof_dai_set_format(slink->hw_configs, config);
+	platform_config = (u8 *)config + platform_dai->config_offset;
+	memset(platform_config, 0, platform_dai->config_size);
+
+	ret = sof_update_ipc_object_token_info(scomp, platform_config,
+					       &platform_dai->tokens, slink->tuples,
+					       slink->num_tuples,
+					       platform_dai->config_size, 1);
+	if (ret)
+		return ret;
+
+	if (platform_dai->config_finalize) {
+		ret = platform_dai->config_finalize(scomp, slink, config);
+		if (ret)
+			return ret;
+	}
+
+	dai->number_configs = 1;
+	dai->current_config = 0;
+	private->dai_config = kmemdup(config, sizeof(*config), GFP_KERNEL);
+	if (!private->dai_config)
+		return -ENOMEM;
+
+	return 0;
+}
