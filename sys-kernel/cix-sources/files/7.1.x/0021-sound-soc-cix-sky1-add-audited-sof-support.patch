diff --git a/sound/soc/sof/cix/cix-sky1.c b/sound/soc/sof/cix/cix-sky1.c
new file mode 100644
--- /dev/null
+++ b/sound/soc/sof/cix/cix-sky1.c
@@ -0,0 +1,572 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-3-Clause)
+/*
+ * Sound Open Firmware support for the CIX Sky1 HiFi5 DSP
+ *
+ * Copyright 2024 Cix Technology Group Co., Ltd.
+ * Copyright 2026 CIX kernel overlay maintainers
+ */
+
+#include <linux/acpi.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/mailbox_client.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/property.h>
+#include <linux/regmap.h>
+#include <linux/reset.h>
+#include <linux/soc/cix/cix_hifi5.h>
+
+#include <sound/sof.h>
+#include <sound/sof/xtensa.h>
+
+#include "../ops.h"
+#include "../sof-acpi-dev.h"
+#include "../sof-audio.h"
+#include "cix-sky1-ipc3.h"
+
+#define SKY1_HIFI2			0x08
+#define SKY1_HIFI2_RUN_STALL		BIT(1)
+
+#define SKY1_SOF_IRAM_BASE		0x1c80400000ULL
+#define SKY1_SOF_IRAM_SIZE		SZ_1M
+#define SKY1_SOF_SHARED_BASE		0xce000000ULL
+#define SKY1_SOF_SHARED_SIZE		SZ_16M
+#define SKY1_SOF_MAILBOX_OFFSET		0x00800000
+#define SKY1_SOF_STACK_WORDS		32
+#define SKY1_SOF_EXCEPT_MAX_HDR_SIZE	0x400
+
+struct sky1_sof {
+	struct device *dev;
+	struct snd_sof_dev *sdev;
+	struct cix_hifi5_hw hw;
+	struct mbox_client tx_client;
+	struct mbox_client rx_client;
+	struct mbox_chan *tx_chan;
+	struct mbox_chan *rx_chan;
+	bool resources_enabled;
+};
+
+static void sky1_sof_free_mailboxes(struct sky1_sof *priv)
+{
+	if (priv->rx_chan) {
+		mbox_free_channel(priv->rx_chan);
+		priv->rx_chan = NULL;
+	}
+
+	if (priv->tx_chan) {
+		mbox_free_channel(priv->tx_chan);
+		priv->tx_chan = NULL;
+	}
+}
+
+static void sky1_sof_handle_reply(struct mbox_client *client, void *message)
+{
+	struct sky1_sof *priv =
+		container_of(client, struct sky1_sof, tx_client);
+	unsigned long flags;
+
+	spin_lock_irqsave(&priv->sdev->ipc_lock, flags);
+	snd_sof_ipc_process_reply(priv->sdev, 0);
+	spin_unlock_irqrestore(&priv->sdev->ipc_lock, flags);
+
+	mbox_client_txdone(priv->tx_chan, 0);
+}
+
+static void sky1_sof_handle_request(struct mbox_client *client, void *message)
+{
+	struct sky1_sof *priv =
+		container_of(client, struct sky1_sof, rx_client);
+	u32 panic_code;
+
+	sof_mailbox_read(priv->sdev, priv->sdev->debug_box.offset + sizeof(u32),
+			 &panic_code, sizeof(panic_code));
+	if ((panic_code & SOF_IPC_PANIC_MAGIC_MASK) == SOF_IPC_PANIC_MAGIC)
+		snd_sof_dsp_panic(priv->sdev, panic_code, true);
+	else
+		snd_sof_ipc_msgs_rx(priv->sdev);
+}
+
+static int sky1_sof_request_mailboxes(struct sky1_sof *priv)
+{
+	struct mbox_client *client;
+	int ret;
+
+	client = &priv->tx_client;
+	client->dev = priv->dev;
+	client->tx_block = false;
+	client->knows_txdone = false;
+	client->rx_callback = sky1_sof_handle_reply;
+
+	priv->tx_chan = mbox_request_channel_byname(client, "txdb");
+	if (IS_ERR(priv->tx_chan)) {
+		ret = PTR_ERR(priv->tx_chan);
+		priv->tx_chan = NULL;
+		return ret;
+	}
+
+	client = &priv->rx_client;
+	client->dev = priv->dev;
+	client->tx_block = false;
+	client->knows_txdone = false;
+	client->rx_callback = sky1_sof_handle_request;
+
+	priv->rx_chan = mbox_request_channel_byname(client, "rxdb");
+	if (IS_ERR(priv->rx_chan)) {
+		ret = PTR_ERR(priv->rx_chan);
+		priv->rx_chan = NULL;
+		mbox_free_channel(priv->tx_chan);
+		priv->tx_chan = NULL;
+		return ret;
+	}
+
+	return 0;
+}
+
+static int sky1_sof_enable_resources(struct sky1_sof *priv)
+{
+	int ret;
+
+	if (priv->resources_enabled)
+		return 0;
+
+	ret = cix_hifi5_hw_enable(&priv->hw);
+	if (ret)
+		return ret;
+
+	ret = sky1_sof_request_mailboxes(priv);
+	if (!ret) {
+		priv->resources_enabled = true;
+		return 0;
+	}
+
+	cix_hifi5_hw_disable(&priv->hw);
+	return ret;
+}
+
+static void sky1_sof_disable_resources(struct sky1_sof *priv)
+{
+	sky1_sof_free_mailboxes(priv);
+	cix_hifi5_hw_disable(&priv->hw);
+	priv->resources_enabled = false;
+}
+
+static int sky1_sof_send_msg(struct snd_sof_dev *sdev,
+			     struct snd_sof_ipc_msg *message)
+{
+	struct sky1_sof *priv = sdev->pdata->hw_pdata;
+	int ret;
+
+	sof_mailbox_write(sdev, sdev->host_box.offset, message->msg_data,
+			  message->msg_size);
+	dma_wmb();
+
+	ret = mbox_send_message(priv->tx_chan, NULL);
+	return ret < 0 ? ret : 0;
+}
+
+static int sky1_sof_reset(struct snd_sof_dev *sdev)
+{
+	struct sky1_sof *priv = sdev->pdata->hw_pdata;
+	int ret;
+
+	ret = reset_control_assert(priv->hw.dsp_reset);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(priv->hw.ctrl, SKY1_HIFI2,
+				 SKY1_HIFI2_RUN_STALL, SKY1_HIFI2_RUN_STALL);
+	if (ret)
+		return ret;
+
+	usleep_range(1, 2);
+	return reset_control_deassert(priv->hw.dsp_reset);
+}
+
+static int sky1_sof_pre_fw_run(struct snd_sof_dev *sdev)
+{
+	struct sky1_sof *priv = sdev->pdata->hw_pdata;
+	int ret;
+
+	ret = reset_control_assert(priv->hw.dsp_reset);
+	if (ret)
+		return ret;
+
+	usleep_range(1, 2);
+	return reset_control_deassert(priv->hw.dsp_reset);
+}
+
+static int sky1_sof_run(struct snd_sof_dev *sdev)
+{
+	struct sky1_sof *priv = sdev->pdata->hw_pdata;
+	int ret;
+
+	dma_wmb();
+	ret = regmap_update_bits(priv->hw.ctrl, SKY1_HIFI2,
+				 SKY1_HIFI2_RUN_STALL, 0);
+	if (ret)
+		return ret;
+
+	return 0;
+}
+
+static int sky1_sof_shutdown(struct snd_sof_dev *sdev)
+{
+	struct sky1_sof *priv = sdev->pdata->hw_pdata;
+	int reset_ret;
+	int stall_ret;
+
+	stall_ret = regmap_update_bits(priv->hw.ctrl, SKY1_HIFI2,
+				       SKY1_HIFI2_RUN_STALL,
+				       SKY1_HIFI2_RUN_STALL);
+	reset_ret = reset_control_assert(priv->hw.dsp_reset);
+
+	return stall_ret ?: reset_ret;
+}
+
+static void sky1_sof_get_registers(struct snd_sof_dev *sdev,
+				   struct sof_ipc_dsp_oops_xtensa *oops,
+				   struct sof_ipc_panic_info *panic_info,
+				   u32 *stack, size_t stack_words)
+{
+	u32 offset = sdev->dsp_oops_offset;
+
+	sof_mailbox_read(sdev, offset, oops, sizeof(*oops));
+	if (oops->arch_hdr.totalsize > SKY1_SOF_EXCEPT_MAX_HDR_SIZE) {
+		dev_err(sdev->dev, "invalid DSP exception header size %#x\n",
+			oops->arch_hdr.totalsize);
+		return;
+	}
+
+	offset += oops->arch_hdr.totalsize;
+	sof_mailbox_read(sdev, offset, panic_info, sizeof(*panic_info));
+	offset += sizeof(*panic_info);
+	sof_mailbox_read(sdev, offset, stack, stack_words * sizeof(*stack));
+}
+
+static void sky1_sof_dump(struct snd_sof_dev *sdev, u32 flags)
+{
+	struct sof_ipc_dsp_oops_xtensa oops;
+	struct sof_ipc_panic_info panic_info;
+	u32 stack[SKY1_SOF_STACK_WORDS];
+	u32 status;
+
+	sof_mailbox_read(sdev, sdev->debug_box.offset + sizeof(u32), &status,
+			 sizeof(status));
+	sky1_sof_get_registers(sdev, &oops, &panic_info, stack,
+			       ARRAY_SIZE(stack));
+	sof_print_oops_and_stack(sdev, KERN_ERR, status, status, &oops,
+				 &panic_info, stack, ARRAY_SIZE(stack));
+}
+
+static int sky1_sof_get_bar_index(struct snd_sof_dev *sdev, u32 type)
+{
+	switch (type) {
+	case SOF_FW_BLK_TYPE_IRAM:
+	case SOF_FW_BLK_TYPE_SRAM:
+		return type;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int sky1_sof_get_mailbox_offset(struct snd_sof_dev *sdev)
+{
+	return SKY1_SOF_MAILBOX_OFFSET;
+}
+
+static int sky1_sof_get_window_offset(struct snd_sof_dev *sdev, u32 id)
+{
+	return SKY1_SOF_MAILBOX_OFFSET;
+}
+
+static int sky1_sof_set_power_state(struct snd_sof_dev *sdev,
+				    const struct sof_dsp_power_state *target)
+{
+	sdev->dsp_power_state = *target;
+	return 0;
+}
+
+static int sky1_sof_resume_resources(struct sky1_sof *priv)
+{
+	return sky1_sof_enable_resources(priv);
+}
+
+static int sky1_sof_runtime_resume(struct snd_sof_dev *sdev)
+{
+	const struct sof_dsp_power_state state = { .state = SOF_DSP_PM_D0 };
+	struct sky1_sof *priv = sdev->pdata->hw_pdata;
+	int ret;
+
+	ret = sky1_sof_resume_resources(priv);
+	if (ret)
+		return ret;
+
+	return snd_sof_dsp_set_power_state(sdev, &state);
+}
+
+static int sky1_sof_runtime_suspend(struct snd_sof_dev *sdev)
+{
+	const struct sof_dsp_power_state state = { .state = SOF_DSP_PM_D3 };
+	struct sky1_sof *priv = sdev->pdata->hw_pdata;
+
+	sky1_sof_disable_resources(priv);
+	return snd_sof_dsp_set_power_state(sdev, &state);
+}
+
+static int sky1_sof_resume(struct snd_sof_dev *sdev)
+{
+	const struct sof_dsp_power_state state = { .state = SOF_DSP_PM_D0 };
+	struct sky1_sof *priv = sdev->pdata->hw_pdata;
+	int ret;
+
+	ret = sky1_sof_resume_resources(priv);
+	if (ret)
+		return ret;
+
+	return snd_sof_dsp_set_power_state(sdev, &state);
+}
+
+static int sky1_sof_suspend(struct snd_sof_dev *sdev, u32 target_state)
+{
+	const struct sof_dsp_power_state state = { .state = target_state };
+	struct sky1_sof *priv = sdev->pdata->hw_pdata;
+
+	sky1_sof_disable_resources(priv);
+	return snd_sof_dsp_set_power_state(sdev, &state);
+}
+
+static int sky1_sof_probe(struct snd_sof_dev *sdev)
+{
+	struct device *dev = sdev->dev;
+	struct sky1_sof *priv;
+	int ret;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->dev = dev;
+	priv->sdev = sdev;
+	sdev->pdata->hw_pdata = priv;
+	sdev->num_cores = 1;
+
+	sdev->bar[SOF_FW_BLK_TYPE_IRAM] =
+		devm_ioremap_wc(dev, SKY1_SOF_IRAM_BASE, SKY1_SOF_IRAM_SIZE);
+	if (!sdev->bar[SOF_FW_BLK_TYPE_IRAM])
+		return dev_err_probe(dev, -ENOMEM, "failed to map DSP IRAM\n");
+	sdev->mmio_bar = SOF_FW_BLK_TYPE_IRAM;
+
+	sdev->bar[SOF_FW_BLK_TYPE_SRAM] =
+		devm_ioremap_wc(dev, SKY1_SOF_SHARED_BASE, SKY1_SOF_SHARED_SIZE);
+	if (!sdev->bar[SOF_FW_BLK_TYPE_SRAM])
+		return dev_err_probe(dev, -ENOMEM,
+				     "failed to map DSP shared SRAM\n");
+	sdev->mailbox_bar = SOF_FW_BLK_TYPE_SRAM;
+	sdev->dsp_box.offset = SKY1_SOF_MAILBOX_OFFSET;
+
+	ret = cix_hifi5_hw_init(dev, &priv->hw);
+	if (ret)
+		return ret;
+
+	ret = devm_cix_hifi5_declare_dma_pool(dev);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "failed to declare DSP coherent pool\n");
+
+	ret = sky1_sof_enable_resources(priv);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "failed to enable DSP resources\n");
+
+	return 0;
+}
+
+static void sky1_sof_remove(struct snd_sof_dev *sdev)
+{
+	struct sky1_sof *priv = sdev->pdata->hw_pdata;
+
+	sky1_sof_disable_resources(priv);
+}
+
+static struct snd_soc_dai_driver sky1_sof_dais[] = {
+	{
+		.name = "i2s0",
+		.id = 0,
+		.playback = {
+			.channels_min = 1,
+			.channels_max = 16,
+		},
+		.capture = {
+			.channels_min = 1,
+			.channels_max = 16,
+		},
+		.symmetric_rate = 1,
