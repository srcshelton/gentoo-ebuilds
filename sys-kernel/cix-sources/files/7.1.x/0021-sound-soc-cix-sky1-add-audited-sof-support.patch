+static void cix_hifi5_release_dma_pool(void *data)
+{
+	dma_release_coherent_memory(data);
+}
+
+/* Keep unexported DMA internals and the devres callback in built-in code. */
+int devm_cix_hifi5_declare_dma_pool(struct device *dev)
+{
+	int ret;
