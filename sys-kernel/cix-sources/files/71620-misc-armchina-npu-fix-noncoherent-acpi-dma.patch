+static void *aipu_mm_vmap_noncontiguous(struct sg_table *sgt, u64 bytes)
+{
+	struct sg_page_iter piter;
+	unsigned long count = bytes >> PAGE_SHIFT;
+	struct page **pages;
+	unsigned long i = 0;
+	void *vaddr;
+
+	pages = kvmalloc_array(count, sizeof(*pages), GFP_KERNEL);
+	if (!pages)
+		return NULL;
+
+	for_each_sgtable_page(sgt, &piter, 0) {
+		if (WARN_ON(i == count)) {
+			vaddr = NULL;
+			goto out;
+		}
+		pages[i++] = sg_page_iter_page(&piter);
+	}
+	if (WARN_ON(i != count)) {
+		vaddr = NULL;
+		goto out;
+	}
+
+	vaddr = vmap(pages, count, VM_MAP, pgprot_dmacoherent(PAGE_KERNEL));
+out:
+	kvfree(pages);
+	return vaddr;
+}
