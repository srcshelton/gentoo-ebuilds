+static int dptx_audio_write_infoframe(struct trilin_dp *dp,
+				      const struct hdmi_audio_infoframe *frame)
+{
+	struct dp_sdp sdp;
+	int ret;
+
+	ret = hdmi_audio_infoframe_pack_for_dp(frame, &sdp,
+					       dp->dpcd[DP_DPCD_REV]);
+	if (ret < 0) {
+		dev_err(dp->dev, "failed to pack audio infoframe: %d\n", ret);
+		return ret;
+	}
+
+	cix_infoframe_write_packet(dp, DPTX_AUDIO_SOURCE, CIX_AUDIO_INFO_SDP,
+				   &sdp, 1);
+
+	return 0;
+}
