+int aipu_mm_bind_exported_dma_buf(struct aipu_memory_manager *mm,
+				  struct aipu_bind_buf_desc *desc,
+				  struct file *filp, u64 source_pa,
+				  struct aipu_dma_buf_binding *binding)
+{
+	struct aipu_file_ctx *owner = aipu_file_ctx(filp);
+	struct aipu_mem_region *bound = NULL;
+	struct aipu_iova_arena *arena;
+	struct aipu_mem_region *source;
+	int ret;
+
+	if (!mm || !desc || !owner || !binding || !desc->exec_id ||
+	    !mm->iova_arenas_ready)
+		return -EINVAL;
+
+	mutex_lock(&mm->lock);
+	source = aipu_mm_find_region_no_lock(mm, source_pa, "bind source");
+	if (!source || source->base_iova != source_pa || source->owner ||
+	    source->mapping_kind != AIPU_MAPPING_IOVA_ARENA ||
+	    !source->phys_pages || !source->phys_page_count ||
+	    source->phys_page_count != source->bytes >> PAGE_SHIFT) {
+		ret = source ? -EOPNOTSUPP : -EINVAL;
+		goto unlock;
+	}
+	arena = aipu_mm_find_iova_arena_no_lock(mm, owner, desc->exec_id);
+	if (!arena) {
+		ret = -ENOENT;
+		goto unlock;
+	}
+
+	aipu_mm_sync_arena_region(source, 0, source->bytes, false);
+	ret = aipu_mm_bind_pages_no_lock(mm, desc, owner, arena,
+					 source->phys_pages,
+					 source->phys_page_count, source->bytes,
+					 source->base_va, 0, binding, &bound);
+	if (ret)
+		aipu_mm_sync_arena_region(source, 0, source->bytes, true);
+	else
+		aipu_mm_sync_arena_region(bound, 0, bound->bytes, true);
 unlock:
 	mutex_unlock(&mm->lock);
 	return ret;
 }
 
+int aipu_mm_bind_page_backed_dma_buf(struct aipu_memory_manager *mm,
+				     struct aipu_bind_buf_desc *desc,
+				     struct file *filp, struct page **pages,
+				     unsigned long page_count, u64 bytes,
+				     struct aipu_dma_buf_binding *binding)
+{
+	struct aipu_file_ctx *owner = aipu_file_ctx(filp);
+	struct aipu_iova_arena *arena;
+	int ret;
+
+	if (!mm || !desc || !owner || !binding || !desc->exec_id ||
+	    !mm->iova_arenas_ready)
+		return -EINVAL;
+
+	mutex_lock(&mm->lock);
+	arena = aipu_mm_find_iova_arena_no_lock(mm, owner, desc->exec_id);
+	if (!arena)
+		ret = -ENOENT;
+	else
+		ret = aipu_mm_bind_pages_no_lock(mm, desc, owner, arena, pages,
+						 page_count, bytes, NULL,
+						 DMA_ATTR_SKIP_CPU_SYNC,
+						 binding, NULL);
+	mutex_unlock(&mm->lock);
+	return ret;
+}
