+static int aipu_dma_buf_collect_pages(struct sg_table *table, size_t bytes,
+				      struct page ***result,
+				      unsigned long *result_count)
+{
+	struct sg_page_iter piter;
+	struct scatterlist *sg;
+	struct page **pages;
+	unsigned long count;
+	unsigned long page = 0;
+	unsigned int entry;
+
+	if (!table || !table->orig_nents || !bytes ||
+	    !IS_ALIGNED(bytes, PAGE_SIZE))
+		return -EOPNOTSUPP;
+	count = bytes >> PAGE_SHIFT;
+	pages = kvmalloc_array(count, sizeof(*pages), GFP_KERNEL);
+	if (!pages)
+		return -ENOMEM;
+
+	for_each_sg(table->sgl, sg, table->orig_nents, entry) {
+		if (!sg_page(sg) || sg->offset ||
+		    !IS_ALIGNED(sg->length, PAGE_SIZE))
+			goto unsupported;
+	}
+	for_each_sgtable_page(table, &piter, 0) {
+		struct page *backing = sg_page_iter_page(&piter);
+
+		if (page == count)
+			goto unsupported;
+		if (!backing || is_zone_device_page(backing))
+			goto unsupported;
+		pages[page++] = backing;
+	}
+	if (page != count)
+		goto unsupported;
+
+	*result = pages;
+	*result_count = count;
+	return 0;
+
+unsupported:
+	kvfree(pages);
+	return -EOPNOTSUPP;
+}
