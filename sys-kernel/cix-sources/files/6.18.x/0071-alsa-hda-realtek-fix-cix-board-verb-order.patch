+	[ALC269_FIXUP_CIX_SKY1_ORAPI_6P_AMP] = {
+		.type = HDA_FIXUP_FUNC,
+		.v.func = alc269_cix_orapi_6p_amp_fixup,
+		.chained = true,
+		.chain_id = ALC256_FIXUP_CIX_SKY1_NO_AUTO_MIC
