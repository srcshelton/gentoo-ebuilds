 	},
 	[ALC256_FIXUP_CIX_SKY1_ORION_O6] = {
 		.type = HDA_FIXUP_PINS,
@@ -6764,7 +6807,9 @@ static const struct hda_fixup alc269_fixups[] = {
 			{ 0x57, AC_VERB_SET_COEF_INDEX, 0x03 },
 			{ 0x57, AC_VERB_SET_PROC_COEF,  0x09a3 },
 			{ }
-		}
+		},
+		.chained = true,
+		.chain_id = ALC256_FIXUP_CIX_SKY1_NO_AUTO_MIC
 	},
 	[ALC269_FIXUP_CIX_SKY1_ORAPI_6P] = {
 		.type = HDA_FIXUP_PINS,
@@ -6803,12 +6848,20 @@ static const struct hda_fixup alc269_fixups[] = {
 			{ 0x20, AC_VERB_SET_PROC_COEF,  0x8002 },
 			{ 0x20, AC_VERB_SET_COEF_INDEX, 0x15 },
 			{ 0x20, AC_VERB_SET_PROC_COEF,  0x8002 },
