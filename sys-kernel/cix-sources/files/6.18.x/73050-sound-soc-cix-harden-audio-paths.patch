  * ACPI HDMI audio topology for Sky1 Orion O6.
  *
  * Under ACPI, the DAI link topology is fixed:
- *   I2S5 (CIXH6011:02) → hdmi-audio-codec.0 (DP0)
- *   I2S6 (CIXH6011:03) → hdmi-audio-codec.1 (DP1)
- *   I2S7 (CIXH6011:04) → hdmi-audio-codec.2 (DP2/eDP)
- *   I2S8 (CIXH6011:05) → hdmi-audio-codec.3 (DP3)
- *   I2S9 (CIXH6011:06) → hdmi-audio-codec.4 (DP4)
+ *   I2S5 (CIXH6011:02) → CIXH502F UID 0 (DP0)
+ *   I2S6 (CIXH6011:03) → CIXH502F UID 1 (DP1)
+ *   I2S7 (CIXH6011:04) → CIXH502F UID 2 (DP2/eDP)
+ *   I2S8 (CIXH6011:05) → CIXH502F UID 3 (DP3)
+ *   I2S9 (CIXH6011:06) → CIXH502F UID 4 (DP4)
+ *
+ * Each display controller creates its HDMI codec with
+ * PLATFORM_DEVID_AUTO. Resolve that child below the firmware-identified DP
+ * device rather than assuming a global platform-device number.
  */
 #define SKY1_HDMI_LINKS	5
 
 static const struct {
 	const char *i2s_name;	/* ACPI platform device name */
-	int codec_id;		/* hdmi-audio-codec.N */
+	const char *dp_uid;	/* CIXH502F _UID */
 	const char *stream;	/* ALSA stream name */
+	const char *prefix;	/* unique codec widget/control prefix */
 } sky1_hdmi_topology[SKY1_HDMI_LINKS] = {
-	{ "CIXH6011:02", 0, "HDMI/DP 0" },
-	{ "CIXH6011:03", 1, "HDMI/DP 1" },
-	{ "CIXH6011:04", 2, "HDMI/DP 2" },
-	{ "CIXH6011:05", 3, "HDMI/DP 3" },
-	{ "CIXH6011:06", 4, "HDMI/DP 4" },
+	{ "CIXH6011:02", "0", "HDMI/DP 0", "DP0" },
+	{ "CIXH6011:03", "1", "HDMI/DP 1", "DP1" },
+	{ "CIXH6011:04", "2", "HDMI/DP 2", "DP2" },
+	{ "CIXH6011:05", "3", "HDMI/DP 3", "DP3" },
+	{ "CIXH6011:06", "4", "HDMI/DP 4", "DP4" },
 };
 
+static int cix_hdmi_codec_child(struct device *child, const void *data)
+{
+	return child->bus == data &&
+	       str_has_prefix(dev_name(child), HDMI_CODEC_DRV_NAME ".");
+}
+
+static int cix_hdmi_codec_name(struct device *dev, const char *uid,
+			       const char **name)
+{
+	struct acpi_device *adev;
+	struct device *codec_dev;
+	struct device *dp_dev;
+	const char *codec_name;
+
+	adev = acpi_dev_get_first_match_dev("CIXH502F", uid, -1);
+	if (!adev)
+		return -ENODEV;
+
+	dp_dev = bus_find_device_by_acpi_dev(&platform_bus_type, adev);
+	acpi_dev_put(adev);
+	if (!dp_dev)
+		return -EPROBE_DEFER;
+
+	codec_dev = device_find_child(dp_dev, &platform_bus_type,
+				      cix_hdmi_codec_child);
+	put_device(dp_dev);
+	if (!codec_dev)
+		return -EPROBE_DEFER;
+
+	codec_name = devm_kstrdup(dev, dev_name(codec_dev), GFP_KERNEL);
+	put_device(codec_dev);
+	if (!codec_name)
+		return -ENOMEM;
+
+	*name = codec_name;
+	return 0;
+}
