 }
 
 static const struct dev_pm_ops cdnsp_pci_pm_ops = {
diff --git a/drivers/usb/cdns3/core.c b/drivers/usb/cdns3/core.c
--- a/drivers/usb/cdns3/core.c
+++ b/drivers/usb/cdns3/core.c
@@ -508,17 +508,18 @@ int cdns_suspend(struct cdns *cdns)
 {
 	struct device *dev = cdns->dev;
 	unsigned long flags;
+	int ret = 0;
 
 	if (pm_runtime_status_suspended(dev))
 		pm_runtime_resume(dev);
 
 	if (cdns->roles[cdns->role]->suspend) {
 		spin_lock_irqsave(&cdns->lock, flags);
-		cdns->roles[cdns->role]->suspend(cdns, false);
+		ret = cdns->roles[cdns->role]->suspend(cdns, false);
 		spin_unlock_irqrestore(&cdns->lock, flags);
 	}
 
-	return 0;
+	return ret;
 }
 EXPORT_SYMBOL_GPL(cdns_suspend);
 
@@ -552,7 +553,7 @@ int cdns_resume(struct cdns *cdns)
 	}
 
 	if (!role_changed && cdns->roles[cdns->role]->resume)
-		cdns->roles[cdns->role]->resume(cdns, power_lost);
+		return cdns->roles[cdns->role]->resume(cdns, power_lost);
 
 	return 0;
 }
