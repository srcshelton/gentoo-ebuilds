+static int aipu_cancel_file_jobs(struct aipu_file_ctx *ctx, struct file *filp)
+{
+	struct aipu_priv *aipu = ctx->aipu;
+	struct aipu_job_manager *manager = &aipu->job_manager;
+	struct aipu_partition *part;
+	bool hardware;
+	int ret;
+
+	ret = aipu_job_manager_cancel_jobs(manager, filp);
+	if (!ret || manager->version < AIPU_ISA_VERSION_ZHOUYI_V3 ||
+	    !manager->partitions || manager->partition_cnt < 1)
+		return ret;
+
+	/* A failed pool abort leaves the shared engine faulted; reset it globally. */
+	part = &manager->partitions[0];
+	hardware = manager->version >= AIPU_ISA_VERSION_ZHOUYI_V3_2_0 &&
+		aipu->reset_gpio && part->ops && part->ops->hw_reset;
+	ret = aipu_job_manager_reset(manager, part, hardware);
+	if (ret)
+		dev_warn(aipu->dev, "release recovery reset failed: %d\n", ret);
+
+	return aipu_job_manager_cancel_jobs(manager, filp);
+}
+
+static void aipu_finish_file_release(struct aipu_file_ctx *ctx,
+				     struct file *filp)
+{
+	struct aipu_priv *aipu = ctx->aipu;
+	int ret;
+
+	aipu_detach_dma_bufs(&aipu->mm, filp);
+	aipu_job_manager_free_file_ids(&aipu->job_manager, ctx);
+	WRITE_ONCE(ctx->released, true);
+	aipu_mm_free_buffers(&aipu->mm, filp);
+	ret = aipu_soc_pm_put(aipu);
+	if (ret)
+		dev_warn(aipu->dev, "runtime-PM put during release failed: %d\n", ret);
+	aipu_file_ctx_put(ctx);
+}
+
+static void aipu_close_retry_work(struct work_struct *work)
+{
+	struct delayed_work *dwork = to_delayed_work(work);
+	struct aipu_file_ctx *ctx = container_of(dwork, struct aipu_file_ctx,
+						 close_work);
+	struct file filp = { .private_data = ctx };
+	int ret;
+
+	ret = aipu_cancel_file_jobs(ctx, &filp);
+	if (ret) {
+		dev_warn_ratelimited(ctx->aipu->dev,
+			"deferred release still cannot quiesce hardware: %d\n", ret);
+		mod_delayed_work(system_long_wq, &ctx->close_work,
+				 msecs_to_jiffies(1000));
+		return;
+	}
+
+	aipu_finish_file_release(ctx, &filp);
+	module_put(THIS_MODULE);
+}
 
