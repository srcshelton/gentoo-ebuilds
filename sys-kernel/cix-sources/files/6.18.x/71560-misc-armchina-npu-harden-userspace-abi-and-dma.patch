diff --git a/drivers/misc/armchina-npu/aipu_abi_p1.c b/drivers/misc/armchina-npu/aipu_abi_p1.c
new file mode 100644
--- /dev/null
+++ b/drivers/misc/armchina-npu/aipu_abi_p1.c
@@ -0,0 +1,124 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/errno.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+
+#include "aipu_abi_p1.h"
+#include "aipu_file.h"
+#include "aipu_job_manager.h"
+#include "aipu_mm.h"
+#include "aipu_priv.h"
+
+static void aipu_p1_desc_to_internal(const struct aipu_p1_buf_desc *user,
+				     struct aipu_buf_desc *internal)
+{
+	memset(internal, 0, sizeof(*internal));
+	internal->pa = user->pa;
+	internal->dev_offset = user->dev_offset;
+	internal->bytes = user->bytes;
+	internal->exec_id = user->exec_id;
+	internal->region = user->region;
+	internal->asid = user->asid;
+	/* P1 has tail padding here, not the later driver's free-mode field. */
+	internal->mode = AIPU_DMA_BUF_FREE_DEFAULT;
+}
+
+static long aipu_p1_free_buf(struct aipu_priv *aipu, struct file *filp,
+			     unsigned long arg)
+{
+	struct aipu_p1_buf_desc user;
+	struct aipu_buf_desc internal;
+	int ret;
+
+	if (copy_from_user(&user, (void __user *)arg, sizeof(user)))
+		return -EFAULT;
+
+	aipu_p1_desc_to_internal(&user, &internal);
+	ret = aipu_job_manager_owner_guard_begin(&aipu->job_manager,
+						 aipu_file_ctx(filp));
+	if (ret)
+		return ret;
+
+	ret = aipu_free_dma_iova_phy(&aipu->mm, &internal, filp);
+	aipu_job_manager_owner_guard_end(&aipu->job_manager);
+	return ret;
+}
+
+static long aipu_p1_schedule_job(struct aipu_priv *aipu, struct file *filp,
+				 unsigned long arg)
+{
+	struct aipu_p1_job_desc user;
+	struct aipu_job_desc internal = { 0 };
+
+	if (copy_from_user(&user, (void __user *)arg, sizeof(user)))
+		return -EFAULT;
+	/* The official P1 header defines these controls as strict booleans. */
+	if (user.is_defer_run > 1 || user.version_compatible > 1 ||
+	    user.do_trigger > 1 || user.enable_prof > 1 ||
+	    user.enable_poll_opt > 1 || user.is_coredump_en > 1)
+		return -EINVAL;
+
+	internal.is_defer_run = user.is_defer_run;
+	internal.version_compatible = user.version_compatible;
+	internal.core_id = user.core_id;
+	internal.partition_id = user.partition_id;
+	internal.do_trigger = user.do_trigger;
+	internal.aipu_arch = user.aipu_arch;
+	internal.aipu_version = user.aipu_version;
+	internal.aipu_config = user.aipu_config;
+	internal.start_pc_addr = user.start_pc_addr;
+	internal.intr_handler_addr = user.intr_handler_addr;
+	internal.data_0_addr = user.data_0_addr;
+	internal.data_1_addr = user.data_1_addr;
+	internal.enable_prof = user.enable_prof;
+	internal.enable_poll_opt = user.enable_poll_opt;
+	/* P1 debug-dispatch bit 5 selects the engine's identical opcode-5 path. */
+	internal.exec_flag = user.exec_flag;
+	internal.dtcm_size_kb = user.dtcm_size_kb;
+	internal.is_coredump_en = user.is_coredump_en;
+	/* P1/V3 has no per-job group ID; the private engine field is unused. */
+	internal.group_id = 0;
+	internal.profile_sz = user.profile_sz;
+	internal.profile_fd = user.profile_fd;
+	internal.profile_pa = user.profile_pa;
+	internal.job_id = user.job_id;
+	internal.head_tcb_pa = user.head_tcb_pa;
+	internal.first_task_tcb_pa = user.first_task_tcb_pa;
+	internal.last_task_tcb_pa = user.last_task_tcb_pa;
+	internal.tail_tcb_pa = user.tail_tcb_pa;
+	/* Never trust a process-supplied translation base. */
+	internal.asid0_base = aipu->job_manager.asid0_base;
+
+	return aipu_job_manager_scheduler(&aipu->job_manager, &internal, filp);
+}
+
+static long aipu_p1_cache_op(struct aipu_priv *aipu, struct file *filp,
+			     unsigned long arg, bool invalidate)
+{
+	struct aipu_p1_buf_desc user;
+	struct aipu_buf_desc internal;
+
+	if (copy_from_user(&user, (void __user *)arg, sizeof(user)))
+		return -EFAULT;
+
+	aipu_p1_desc_to_internal(&user, &internal);
+	return invalidate ? aipu_mm_cache_invalid(&aipu->mm, &internal, filp) :
+			    aipu_mm_cache_flush(&aipu->mm, &internal, filp);
+}
+
+long aipu_p1_ioctl(struct aipu_priv *aipu, struct file *filp,
+		   unsigned int cmd, unsigned long arg)
+{
+	switch (cmd) {
+	case AIPU_P1_IOCTL_FREE_BUF:
+		return aipu_p1_free_buf(aipu, filp, arg);
+	case AIPU_P1_IOCTL_SCHEDULE_JOB:
+		return aipu_p1_schedule_job(aipu, filp, arg);
+	case AIPU_P1_IOCTL_BUF_CACHE_INVALID:
+		return aipu_p1_cache_op(aipu, filp, arg, true);
+	case AIPU_P1_IOCTL_BUF_CACHE_FLUSH:
+		return aipu_p1_cache_op(aipu, filp, arg, false);
+	default:
+		return -ENOIOCTLCMD;
+	}
+}
