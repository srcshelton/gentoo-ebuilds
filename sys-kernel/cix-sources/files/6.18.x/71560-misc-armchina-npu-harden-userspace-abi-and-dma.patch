+static atomic_t *aipu_mm_get_map_count(struct aipu_mem_region *reg, u64 iova)
+{
+	struct aipu_virt_page *page;
+	unsigned long bitmap_no;
+
+	if (!reg || iova < reg->base_iova)
+		return NULL;
+	if (!reg->reserved)
+		return &reg->map_count;
+
+	bitmap_no = (iova - reg->base_iova) >> PAGE_SHIFT;
+	if (bitmap_no >= reg->count)
+		return NULL;
+	page = reg->pages[bitmap_no];
+	if (!page || !page->contiguous_alloc_len)
+		return NULL;
+
+	return &page->map_count;
+}
