+static void aipu_mm_vma_open(struct vm_area_struct *vma)
+{
+	struct aipu_vma_ctx *ctx = vma->vm_private_data;
+
+	if (WARN_ON(!ctx || !ctx->map_count || !ctx->owner))
+		return;
+	refcount_inc(&ctx->refs);
+	atomic_inc(ctx->map_count);
+	aipu_file_ctx_get(ctx->owner);
+}
+
+static void aipu_mm_vma_close(struct vm_area_struct *vma)
+{
+	struct aipu_vma_ctx *ctx = vma->vm_private_data;
+	bool last_mapping;
+
+	if (WARN_ON(!ctx || !ctx->map_count || !ctx->owner))
+		return;
+	last_mapping = atomic_dec_and_test(ctx->map_count);
+	if (last_mapping && aipu_file_ctx_is_released(ctx->owner))
+		aipu_mm_free_owner(ctx->mm, &ctx->desc, ctx->owner, true);
+	aipu_file_ctx_put(ctx->owner);
+	if (refcount_dec_and_test(&ctx->refs))
+		kfree(ctx);
+}
