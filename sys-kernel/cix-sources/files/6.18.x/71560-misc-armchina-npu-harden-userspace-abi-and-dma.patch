+int aipu_mm_pin_job_tcb(struct aipu_memory_manager *mm, struct file *filp,
+			 u64 head, u64 tail, size_t tcb_bytes,
+			 struct aipu_tcb_mapping *mapping)
+{
+	struct aipu_file_ctx *owner = aipu_file_ctx(filp);
+	struct aipu_mem_region *reg;
+	struct aipu_tcb_buf *tbuf;
+	unsigned long flags;
+	u64 requested_end;
+	int ret = 0;
+
+	if (!mm || !owner || !mapping || !tcb_bytes || head > tail ||
+	    !IS_ALIGNED(head, sizeof(u32)) || !IS_ALIGNED(tail, sizeof(u32)))
+		return -EINVAL;
+	if (check_add_overflow(tail, (u64)tcb_bytes, &requested_end))
+		return -EOVERFLOW;
+
+	memset(mapping, 0, sizeof(*mapping));
+	mutex_lock(&mm->lock);
+	reg = aipu_mm_find_region_no_lock(mm, head, "pin_job_tcb");
+	if (!reg) {
+		ret = -EINVAL;
+		goto unlock_mm;
+	}
+
+	spin_lock_irqsave(&mm->slock, flags);
+	tbuf = aipu_mm_find_tbuf_in_region_no_lock(mm, reg, head);
+	if (!tbuf || tbuf->owner != owner || tail < tbuf->alloc_head ||
+	    requested_end - tbuf->alloc_head > tbuf->alloc_bytes) {
+		ret = tbuf && tbuf->owner != owner ? -EPERM : -EINVAL;
+		goto unlock_tbuf;
+	}
+	if (tbuf->active_jobs == UINT_MAX) {
+		ret = -EOVERFLOW;
+		goto unlock_tbuf;
+	}
+
+	tbuf->active_jobs++;
+	mapping->tbuf = tbuf;
+	mapping->dev_pa = tbuf->alloc_head;
+	mapping->bytes = tbuf->alloc_bytes;
+	mapping->va = (char *)reg->base_va + tbuf->alloc_head - reg->base_iova;
+	mapping->owner = owner;
+	aipu_file_ctx_get(owner);
+
+unlock_tbuf:
+	spin_unlock_irqrestore(&mm->slock, flags);
+unlock_mm:
+	mutex_unlock(&mm->lock);
+	return ret;
+}
+
+void aipu_mm_unpin_job_tcb(struct aipu_memory_manager *mm,
+			   struct aipu_tcb_mapping *mapping)
+{
+	struct aipu_file_ctx *owner;
+	unsigned long flags;
+	bool last;
+
+	if (!mm || !mapping || !mapping->tbuf)
+		return;
+	owner = mapping->owner;
+
+	spin_lock_irqsave(&mm->slock, flags);
+	if (WARN_ON(!mapping->tbuf->active_jobs)) {
+		spin_unlock_irqrestore(&mm->slock, flags);
+		return;
+	}
+	mapping->tbuf->active_jobs--;
+	last = !mapping->tbuf->active_jobs;
+	spin_unlock_irqrestore(&mm->slock, flags);
+	memset(mapping, 0, sizeof(*mapping));
+	if (last)
+		aipu_mm_schedule_owner_cleanup(owner);
+	aipu_file_ctx_put(owner);
+}
+
+int aipu_mm_clone_tcb_mapping(struct aipu_memory_manager *mm,
+			      const struct aipu_tcb_mapping *source,
+			      struct aipu_tcb_mapping *clone)
+{
+	unsigned long flags;
+	int ret = 0;
+
+	if (!mm || !source || !source->tbuf || !clone)
+		return -EINVAL;
+
+	spin_lock_irqsave(&mm->slock, flags);
+	if (!source->tbuf->active_jobs) {
+		ret = -ENOENT;
+	} else if (source->tbuf->active_jobs == UINT_MAX) {
+		ret = -EOVERFLOW;
+	} else {
+		source->tbuf->active_jobs++;
+		*clone = *source;
+		aipu_file_ctx_get(clone->owner);
+	}
+	spin_unlock_irqrestore(&mm->slock, flags);
+	return ret;
+}
