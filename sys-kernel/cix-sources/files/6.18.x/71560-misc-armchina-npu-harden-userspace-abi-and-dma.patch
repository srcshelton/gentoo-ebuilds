new file mode 100644
--- /dev/null
+++ b/drivers/misc/armchina-npu/aipu_file.h
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* Copyright (c) 2023-2025 Arm Technology (China) Co. Ltd. */
+
+#ifndef __AIPU_FILE_H__
+#define __AIPU_FILE_H__
+
+#include <linux/fs.h>
+#include <linux/kref.h>
+#include <linux/workqueue.h>
+
+struct aipu_priv;
+
+enum aipu_file_abi_bit {
+	AIPU_FILE_ABI_P1,
+};
+
+/*
+ * Allocation and job ownership must outlive struct file when a failed hardware
+ * quiesce forces the driver to retain DMA-visible state during release.
+ */
+struct aipu_file_ctx {
+	struct aipu_priv *aipu;
+	struct kref kref;
+	struct work_struct cleanup_work;
+	struct delayed_work close_work;
+	unsigned long abi_mask;
+	bool released;
+};
+
+void aipu_file_ctx_get(struct aipu_file_ctx *ctx);
+void aipu_file_ctx_put(struct aipu_file_ctx *ctx);
+
+static inline bool aipu_file_ctx_is_released(const struct aipu_file_ctx *ctx)
+{
+	return ctx && READ_ONCE(ctx->released);
+}
+
+static inline struct aipu_file_ctx *aipu_file_ctx(struct file *filp)
+{
+	return filp ? filp->private_data : NULL;
+}
+
+static inline struct aipu_priv *aipu_file_priv(struct file *filp)
+{
+	struct aipu_file_ctx *ctx = aipu_file_ctx(filp);
+
+	return ctx ? ctx->aipu : NULL;
+}
+
+#endif /* __AIPU_FILE_H__ */
