+static int aipu_mm_validate_allocation(struct aipu_mem_region *reg, u64 iova,
+				       u64 bytes, struct aipu_file_ctx *owner)
+{
+	struct aipu_virt_page *page;
+	unsigned long bitmap_no;
+	u64 available;
+	u64 offset;
+
+	if (!reg || iova < reg->base_iova)
+		return -EINVAL;
+
+	offset = iova - reg->base_iova;
+	if (offset >= reg->bytes)
+		return -EINVAL;
+
+	if (!reg->reserved) {
+		if (offset)
+			return -EINVAL;
+		if (owner && reg->owner != owner)
+			return -EPERM;
+		available = reg->bytes;
+	} else {
+		if (!IS_ALIGNED(offset, PAGE_SIZE))
+			return -EINVAL;
+
+		bitmap_no = offset >> PAGE_SHIFT;
+		if (bitmap_no >= reg->count || !test_bit(bitmap_no, reg->bitmap))
+			return -EINVAL;
+
+		page = reg->pages[bitmap_no];
+		if (!page || !page->contiguous_alloc_len)
+			return -EINVAL;
+		if (owner && page->owner != owner)
+			return -EPERM;
+		available = (u64)page->contiguous_alloc_len << PAGE_SHIFT;
+	}
+
+	if (bytes && bytes > available)
+		return -EINVAL;
+
+	return 0;
+}
+
+static int aipu_mm_validate_export_allocation(struct aipu_mem_region *reg,
+					      u64 iova, u64 bytes)
+{
+	struct aipu_virt_page *page;
+	unsigned long bitmap_no;
+	u64 available;
+
+	if (!reg || !bytes || iova < reg->base_iova)
+		return -EINVAL;
+
+	if (!reg->reserved) {
+		if (iova != reg->base_iova || reg->owner || reg->bytes != bytes)
+			return -EPERM;
+		available = reg->bytes;
+	} else {
+		if (!IS_ALIGNED(iova - reg->base_iova, PAGE_SIZE))
+			return -EINVAL;
+		bitmap_no = (iova - reg->base_iova) >> PAGE_SHIFT;
+		if (bitmap_no >= reg->count || !test_bit(bitmap_no, reg->bitmap))
+			return -EINVAL;
+		page = reg->pages[bitmap_no];
+		if (!page || page->owner || !page->contiguous_alloc_len)
+			return -EPERM;
+		available = (u64)page->contiguous_alloc_len << PAGE_SHIFT;
+	}
+
+	return available == bytes ? 0 : -EINVAL;
+}
