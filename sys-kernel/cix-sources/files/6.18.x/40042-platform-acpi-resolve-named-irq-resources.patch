Named lookup can find an ACPI IRQ resource before its GSI has been mapped.
Translate the named resource to its IRQ ordinal, then delegate mapping,
trigger setup, and error handling to platform_get_irq_optional(). This is a
bounded correction for observed CIX ACPI runtime failures.

diff --git a/drivers/base/platform.c b/drivers/base/platform.c
--- a/drivers/base/platform.c
+++ b/drivers/base/platform.c
@@ -436,6 +436,24 @@ struct resource *platform_get_resource_byname(struct platform_device *dev,
 }
 EXPORT_SYMBOL_GPL(platform_get_resource_byname);
 
+static int platform_get_irq_resource_index(struct platform_device *dev,
+					   struct resource *target)
+{
+	unsigned int i, index = 0;
+
+	for (i = 0; i < dev->num_resources; i++) {
+		struct resource *res = &dev->resource[i];
+
+		if (resource_type(res) != IORESOURCE_IRQ)
+			continue;
+		if (res == target)
+			return index;
+		index++;
+	}
+
+	return -EINVAL;
+}
+
 static int __platform_get_irq_byname(struct platform_device *dev,
 				     const char *name)
 {
@@ -448,6 +466,13 @@ static int __platform_get_irq_byname(struct platform_device *dev,
 
 	r = platform_get_resource_byname(dev, IORESOURCE_IRQ, name);
 	if (r) {
+		if (is_acpi_device_node(dev_fwnode(&dev->dev)) &&
+		    r->flags & IORESOURCE_DISABLED) {
+			ret = platform_get_irq_resource_index(dev, r);
+			if (ret < 0)
+				return ret;
+			return platform_get_irq_optional(dev, ret);
+		}
 		if (WARN(!r->start, "0 is an invalid IRQ number\n"))
 			return -EINVAL;
 		return r->start;
