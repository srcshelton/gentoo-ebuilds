+static struct sky1_src *to_sky1_src(struct reset_controller_dev *rcdev)
+{
+	return container_of(rcdev, struct sky1_src, rcdev);
+}
+
+static int sky1_reset_set(struct reset_controller_dev *rcdev,
+			  unsigned long id, bool assert)
+{
+	struct sky1_src *sky1src = to_sky1_src(rcdev);
+	const struct sky1_src_signal *signal;
+	unsigned int value;
+
+	if (id >= rcdev->nr_resets)
+		return -EINVAL;
+
+	signal = &sky1src->signals[id];
+	if (!signal->bit)
+		return -EINVAL;
+
+	value = assert ? 0 : signal->bit;
+
+	return regmap_update_bits(sky1src->regmap,
+				  signal->offset, signal->bit, value);
+}
+
+static int sky1_reset_assert(struct reset_controller_dev *rcdev,
+			     unsigned long id)
+{
+	int ret;
+
+	ret = sky1_reset_set(rcdev, id, true);
+	if (ret)
+		return ret;
+
+	usleep_range(SKY1_RESET_SLEEP_MIN_US,
+		     SKY1_RESET_SLEEP_MAX_US);
+	return 0;
+}
+
+static int sky1_reset_deassert(struct reset_controller_dev *rcdev,
+			       unsigned long id)
+{
+	int ret;
+
+	ret = sky1_reset_set(rcdev, id, false);
+	if (ret)
+		return ret;
+
+	usleep_range(SKY1_RESET_SLEEP_MIN_US,
+		     SKY1_RESET_SLEEP_MAX_US);
+	return 0;
+}
+
+static int sky1_reset(struct reset_controller_dev *rcdev,
+		      unsigned long id)
+{
+	int ret;
+
+	ret = sky1_reset_assert(rcdev, id);
+	if (ret)
+		return ret;
+
+	return sky1_reset_deassert(rcdev, id);
+}
+
+static int sky1_reset_status(struct reset_controller_dev *rcdev,
+			     unsigned long id)
+{
+	struct sky1_src *sky1src = to_sky1_src(rcdev);
+	const struct sky1_src_signal *signal;
+	unsigned int value;
+	int ret;
+
+	if (id >= rcdev->nr_resets)
+		return -EINVAL;
+
+	signal = &sky1src->signals[id];
+	if (!signal->bit)
+		return -EINVAL;
+
+	ret = regmap_read(sky1src->regmap, signal->offset, &value);
+	if (ret)
+		return ret;
+
+	return !(value & signal->bit);
+}
+
+static const struct reset_control_ops sky1_src_ops = {
+	.reset    = sky1_reset,
+	.assert   = sky1_reset_assert,
+	.deassert = sky1_reset_deassert,
+	.status   = sky1_reset_status,
+};
+
+struct sky1_src_regmap_match {
+	struct device *consumer;
+	resource_size_t start;
+	resource_size_t size;
+};
+
+static int sky1_src_match_regmap(struct device *candidate, const void *data)
+{
+	const struct sky1_src_regmap_match *match = data;
+	struct platform_device *pdev = to_platform_device(candidate);
+	struct acpi_device *adev = ACPI_COMPANION(candidate);
+	struct resource *res;
+
+	if (candidate == match->consumer || !adev ||
+	    !acpi_dev_hid_uid_match(adev, "CIXHA018", NULL))
+		return 0;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	return res && res->start == match->start &&
+	       resource_size(res) == match->size;
+}
+
+static struct regmap *sky1_src_shared_regmap(struct device *dev,
+					     struct resource *res)
+{
+	struct sky1_src_regmap_match match = {
+		.consumer = dev,
+		.start = res->start,
+		.size = resource_size(res),
+	};
+	struct device *supplier;
+	struct regmap *regmap;
+
+	supplier = bus_find_device(&platform_bus_type, NULL, &match,
+				   sky1_src_match_regmap);
+	if (!supplier)
+		return ERR_PTR(-EPROBE_DEFER);
+
+	device_lock(supplier);
+	if (supplier->links.status == DL_DEV_UNBINDING) {
+		regmap = ERR_PTR(-EPROBE_DEFER);
+	} else if (!device_link_add(dev, supplier,
+				    DL_FLAG_AUTOPROBE_CONSUMER)) {
+		regmap = ERR_PTR(-EINVAL);
+	} else if (!device_is_bound(supplier) ||
+		   supplier->links.status != DL_DEV_DRIVER_BOUND) {
+		regmap = ERR_PTR(-EPROBE_DEFER);
+	} else {
+		regmap = dev_get_regmap(supplier, NULL);
+		if (!regmap)
+			regmap = ERR_PTR(-EPROBE_DEFER);
+	}
+	device_unlock(supplier);
+
+	put_device(supplier);
+	return regmap;
+}
+
+static struct regmap *sky1_src_private_regmap(struct platform_device *pdev,
+					      struct resource *res,
+					     resource_size_t size)
+{
+	struct device *dev = &pdev->dev;
+	struct resource window = *res;
+	const struct regmap_config config = {
+		.reg_bits = 32,
+		.val_bits = 32,
+		.reg_stride = 4,
+		.max_register = FCH_SW_XSPI,
+		.name = "sky1-reset",
+	};
+	void __iomem *base;
+
+	if (size != SKY1_FCH_RESET_MMIO_SIZE || resource_size(res) < size)
+		return ERR_PTR(-EINVAL);
+
+	window.end = window.start + size - 1;
+	base = devm_ioremap_resource(dev, &window);
+	if (IS_ERR(base))
+		return ERR_CAST(base);
+
+	return devm_regmap_init_mmio(dev, base, &config);
+}
+
+static struct regmap *sky1_src_get_regmap(struct platform_device *pdev,
+					  const struct sky1_src_variant *variant)
+{
+	struct device *dev = &pdev->dev;
+	struct resource *res;
+
+	if (dev->of_node)
+		return syscon_node_to_regmap(dev->of_node);
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res)
+		return ERR_PTR(-ENOENT);
+
+	if (variant->shared_regmap)
+		return sky1_src_shared_regmap(dev, res);
+
+	return sky1_src_private_regmap(pdev, res, variant->mmio_size);
+}
+
+static int sky1_reset_probe(struct platform_device *pdev)
+{
+	struct sky1_src *sky1src;
+	struct device *dev = &pdev->dev;
+	const struct sky1_src_variant *variant;
+	int ret;
+
+	sky1src = devm_kzalloc(dev, sizeof(*sky1src), GFP_KERNEL);
+	if (!sky1src)
+		return -ENOMEM;
+
+	variant = device_get_match_data(dev);
+	if (!variant)
+		return dev_err_probe(dev, -ENODEV, "missing reset variant\n");
+
+	sky1src->regmap = sky1_src_get_regmap(pdev, variant);
+	if (IS_ERR(sky1src->regmap))
+		return dev_err_probe(dev, PTR_ERR(sky1src->regmap),
+				     "failed to get reset regmap\n");
+
+	sky1src->signals = variant->signals;
+	sky1src->rcdev.owner     = THIS_MODULE;
+	sky1src->rcdev.nr_resets = variant->signals_num;
+	sky1src->rcdev.ops       = &sky1_src_ops;
+	sky1src->rcdev.of_node   = dev->of_node;
+	sky1src->rcdev.dev       = dev;
+
+	ret = devm_reset_controller_register(dev, &sky1src->rcdev);
+	if (ret)
+		return ret;
+
+#ifdef CONFIG_ACPI
+	if (has_acpi_companion(dev))
+		acpi_dev_clear_dependencies(ACPI_COMPANION(dev));
+#endif
+
+	return 0;
+}
+
+static const struct of_device_id sky1_sysreg_of_match[] = {
+	{ .compatible = "cix,sky1-system-control", .data = &variant_sky1_fch },
+	{ .compatible = "cix,sky1-s5-system-control", .data = &variant_sky1 },
+	{ .compatible = "cix,sky1-src-fch", .data = &variant_sky1_fch },
+	{ .compatible = "cix,sky1-src", .data = &variant_sky1 },
+	{},
+};
+MODULE_DEVICE_TABLE(of, sky1_sysreg_of_match);
+
+static const struct acpi_device_id sky1_reset_acpi_match[] = {
+	{ "CIXHA020", .driver_data = (kernel_ulong_t)&variant_sky1 },
+	{ "CIXHA021", .driver_data = (kernel_ulong_t)&variant_sky1_fch },
+	{},
+};
+MODULE_DEVICE_TABLE(acpi, sky1_reset_acpi_match);
+
+static struct platform_driver sky1_reset_driver = {
+	.probe	= sky1_reset_probe,
+	.driver = {
+		.name		= "cix,sky1-rst",
+		.suppress_bind_attrs = true,
+		.of_match_table = sky1_sysreg_of_match,
+		.acpi_match_table = ACPI_PTR(sky1_reset_acpi_match),
+	},
+};
+module_platform_driver(sky1_reset_driver);
+
+MODULE_AUTHOR("Jerry Zhu <jerry.zhu@cixtech.com>");
+MODULE_DESCRIPTION("Cix Sky1 reset driver");
+MODULE_LICENSE("GPL");
