 #define to_scmi_clk(clk) container_of(clk, struct scmi_clk, hw)
 
+struct scmi_clk_acpi_provider {
+	struct list_head node;
+	struct device *dev;
+	struct clk_hw_onecell_data *clk_data;
+};
+
+static LIST_HEAD(scmi_clk_acpi_providers);
+static DEFINE_MUTEX(scmi_clk_acpi_lock);
+
+static void scmi_clk_acpi_provider_remove(void *data)
+{
+	struct scmi_clk_acpi_provider *provider = data;
+
+	mutex_lock(&scmi_clk_acpi_lock);
+	list_del_init(&provider->node);
+	mutex_unlock(&scmi_clk_acpi_lock);
+}
+
+static int
+scmi_clk_acpi_provider_add(struct device *dev,
+			   struct clk_hw_onecell_data *clk_data)
+{
+	struct scmi_clk_acpi_provider *provider;
+	int ret;
+
+	provider = devm_kzalloc(dev, sizeof(*provider), GFP_KERNEL);
+	if (!provider)
+		return -ENOMEM;
+
+	provider->dev = dev;
+	provider->clk_data = clk_data;
+	INIT_LIST_HEAD(&provider->node);
+
+	mutex_lock(&scmi_clk_acpi_lock);
+	list_add_tail(&provider->node, &scmi_clk_acpi_providers);
+	mutex_unlock(&scmi_clk_acpi_lock);
+
+	ret = devm_add_action_or_reset(dev, scmi_clk_acpi_provider_remove,
+				       provider);
+	return ret;
+}
+
+struct clk_hw *scmi_clk_acpi_get_hw(struct device *consumer,
+				    unsigned int index)
+{
+	struct scmi_clk_acpi_provider *provider, *selected = NULL;
+	struct device *supplier;
+	struct clk_hw *hw;
+
+	if (!consumer)
+		return ERR_PTR(-EINVAL);
+
+	mutex_lock(&scmi_clk_acpi_lock);
+	list_for_each_entry(provider, &scmi_clk_acpi_providers, node) {
+		if (selected) {
+			hw = ERR_PTR(-ENOTUNIQ);
+			goto unlock;
+		}
+		selected = provider;
+	}
+
+	if (!selected) {
+		hw = ERR_PTR(-EPROBE_DEFER);
+		goto unlock;
+	}
+
+	supplier = get_device(selected->dev);
+	mutex_unlock(&scmi_clk_acpi_lock);
+
+	/* Serialize against supplier unbind and its devres teardown. */
+	device_lock(supplier);
+	mutex_lock(&scmi_clk_acpi_lock);
+	selected = NULL;
+	list_for_each_entry(provider, &scmi_clk_acpi_providers, node) {
+		if (selected) {
+			hw = ERR_PTR(-ENOTUNIQ);
+			goto unlock_revalidated;
+		}
+		selected = provider;
+	}
+
+	if (!selected || selected->dev != supplier ||
+	    !device_is_bound(supplier) ||
+	    supplier->links.status != DL_DEV_DRIVER_BOUND) {
+		hw = ERR_PTR(-EPROBE_DEFER);
+		goto unlock_revalidated;
+	}
+
+	if (index >= selected->clk_data->num ||
+	    !selected->clk_data->hws[index] ||
+	    IS_ERR(selected->clk_data->hws[index])) {
+		hw = ERR_PTR(-ENOENT);
+		goto unlock_revalidated;
+	}
+
+	hw = selected->clk_data->hws[index];
+	if (!device_link_add(consumer, supplier,
+			     DL_FLAG_AUTOPROBE_CONSUMER))
+		hw = ERR_PTR(-EPROBE_DEFER);
+
+unlock_revalidated:
+	mutex_unlock(&scmi_clk_acpi_lock);
+	device_unlock(supplier);
+	put_device(supplier);
+	return hw;
+
+unlock:
+	mutex_unlock(&scmi_clk_acpi_lock);
+	return hw;
+}
+EXPORT_SYMBOL_GPL(scmi_clk_acpi_get_hw);
