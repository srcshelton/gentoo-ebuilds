diff --git a/drivers/dma-buf/heaps/cix_dsp_heap.c b/drivers/dma-buf/heaps/cix_dsp_heap.c
new file mode 100644
--- /dev/null
+++ b/drivers/dma-buf/heaps/cix_dsp_heap.c
@@ -0,0 +1,181 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* CIX Sky1 fixed XAF userspace heap. */
+
+#include <linux/acpi.h>
+#include <linux/dma-buf.h>
+#include <linux/dma-heap.h>
+#include <linux/io.h>
+#include <linux/ioport.h>
+#include <linux/mm.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/slab.h>
+#include <linux/soc/cix/cix_hifi5.h>
+
+struct cix_dsp_heap {
+	/* Serializes the single fixed-aperture allocation. */
+	struct mutex lock;
+	bool allocated;
+};
+
+struct cix_dsp_heap_buffer {
+	struct cix_dsp_heap *heap;
+};
+
+static struct sg_table *
+cix_dsp_heap_map_dma_buf(struct dma_buf_attachment *attachment,
+			 enum dma_data_direction direction)
+{
+	return ERR_PTR(-EOPNOTSUPP);
+}
+
+static void
+cix_dsp_heap_unmap_dma_buf(struct dma_buf_attachment *attachment,
+			   struct sg_table *table,
+			   enum dma_data_direction direction)
+{
+}
+
+static int cix_dsp_heap_begin_cpu_access(struct dma_buf *dmabuf,
+					 enum dma_data_direction direction)
+{
+	dma_rmb();
+	return 0;
+}
+
+static int cix_dsp_heap_end_cpu_access(struct dma_buf *dmabuf,
+				       enum dma_data_direction direction)
+{
+	dma_wmb();
+	return 0;
+}
+
+static int cix_dsp_heap_mmap(struct dma_buf *dmabuf,
+			     struct vm_area_struct *vma)
+{
+	unsigned long size = vma->vm_end - vma->vm_start;
+
+	if (!(vma->vm_flags & VM_SHARED) || vma->vm_pgoff ||
+	    size != CIX_HIFI5_DMA_SIZE)
+		return -EINVAL;
+
+	vm_flags_set(vma, VM_IO | VM_PFNMAP | VM_DONTEXPAND | VM_DONTDUMP);
+	vma->vm_page_prot = pgprot_writecombine(vma->vm_page_prot);
+
+	return remap_pfn_range(vma, vma->vm_start,
+			       PHYS_PFN(CIX_HIFI5_DMA_BASE), size,
+			       vma->vm_page_prot);
+}
+
+static void cix_dsp_heap_release(struct dma_buf *dmabuf)
+{
+	struct cix_dsp_heap_buffer *buffer = dmabuf->priv;
+
+	mutex_lock(&buffer->heap->lock);
+	buffer->heap->allocated = false;
+	mutex_unlock(&buffer->heap->lock);
+	kfree(buffer);
+}
+
+static const struct dma_buf_ops cix_dsp_heap_buf_ops = {
+	.map_dma_buf = cix_dsp_heap_map_dma_buf,
+	.unmap_dma_buf = cix_dsp_heap_unmap_dma_buf,
+	.begin_cpu_access = cix_dsp_heap_begin_cpu_access,
+	.end_cpu_access = cix_dsp_heap_end_cpu_access,
+	.mmap = cix_dsp_heap_mmap,
+	.release = cix_dsp_heap_release,
+};
+
+static struct dma_buf *cix_dsp_heap_allocate(struct dma_heap *dma_heap,
+					     unsigned long len,
+					      u32 fd_flags,
+					      u64 heap_flags)
+{
+	struct cix_dsp_heap *heap = dma_heap_get_drvdata(dma_heap);
+	struct cix_dsp_heap_buffer *buffer;
+	DEFINE_DMA_BUF_EXPORT_INFO(exp_info);
+	struct dma_buf *dmabuf;
+
+	if (len != CIX_HIFI5_DMA_SIZE || heap_flags)
+		return ERR_PTR(-EINVAL);
+
+	buffer = kzalloc_obj(*buffer);
+	if (!buffer)
+		return ERR_PTR(-ENOMEM);
+
+	mutex_lock(&heap->lock);
+	if (heap->allocated) {
+		mutex_unlock(&heap->lock);
+		kfree(buffer);
+		return ERR_PTR(-EBUSY);
+	}
+	heap->allocated = true;
+	mutex_unlock(&heap->lock);
+
+	buffer->heap = heap;
+	exp_info.exp_name = dma_heap_get_name(dma_heap);
+	exp_info.ops = &cix_dsp_heap_buf_ops;
+	exp_info.size = len;
+	exp_info.flags = fd_flags;
+	exp_info.priv = buffer;
+
+	dmabuf = dma_buf_export(&exp_info);
+	if (IS_ERR(dmabuf)) {
+		mutex_lock(&heap->lock);
+		heap->allocated = false;
+		mutex_unlock(&heap->lock);
+		kfree(buffer);
+	}
+
+	return dmabuf;
+}
+
+static const struct dma_heap_ops cix_dsp_heap_ops = {
+	.allocate = cix_dsp_heap_allocate,
+};
+
+static bool __init cix_dsp_present(void)
+{
+	struct device_node *np;
+
+	if (acpi_dev_present("CIXH6000", NULL, -1))
+		return true;
+
+	np = of_find_compatible_node(NULL, NULL, "cix,sky1-hifi5");
+	if (!np)
+		return false;
+
+	of_node_put(np);
+	return true;
+}
+
+static int __init cix_dsp_heap_init(void)
+{
+	static struct cix_dsp_heap heap;
+	struct dma_heap_export_info exp_info = {
+		.name = "dsp",
+		.ops = &cix_dsp_heap_ops,
+		.priv = &heap,
+	};
+	struct dma_heap *dma_heap;
+	int ret;
+
+	if (!cix_dsp_present())
+		return 0;
+
+	ret = region_intersects(CIX_HIFI5_DMA_BASE, CIX_HIFI5_DMA_SIZE,
+				IORESOURCE_SYSTEM_RAM, IORES_DESC_NONE);
+	if (ret != REGION_DISJOINT) {
+		pr_warn("CIX HiFi5: not registering DSP heap because it overlaps System RAM\n");
+		return 0;
+	}
+
+	mutex_init(&heap.lock);
+	dma_heap = dma_heap_add(&exp_info);
+	if (IS_ERR(dma_heap))
+		return PTR_ERR(dma_heap);
+
+	pr_info("CIX HiFi5: registered 16 MiB write-combined XAF heap\n");
+	return 0;
+}
+device_initcall(cix_dsp_heap_init);
