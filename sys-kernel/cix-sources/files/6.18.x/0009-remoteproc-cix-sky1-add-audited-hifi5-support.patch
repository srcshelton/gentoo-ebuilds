diff --git a/drivers/soc/cix/cix-hifi5.c b/drivers/soc/cix/cix-hifi5.c
new file mode 100644
--- /dev/null
+++ b/drivers/soc/cix/cix-hifi5.c
@@ -0,0 +1,192 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* CIX Sky1 HiFi5 shared resource management. */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/export.h>
+#include <linux/init.h>
+#include <linux/ioport.h>
+#include <linux/kstrtox.h>
+#include <linux/memblock.h>
+#include <linux/mfd/syscon.h>
+#include <linux/printk.h>
+#include <linux/property.h>
+#include <linux/regmap.h>
+#include <linux/reset.h>
+#include <linux/soc/cix/cix_hifi5.h>
+
+static const char * const cix_hifi5_clock_names[CIX_HIFI5_NUM_CLOCKS] = {
+	"clk",
+	"bclk",
+	"pbclk",
+	"sramclk",
+	"mb0clk",
+	"mb1clk",
+};
+
+static bool cix_hifi5_legacy_reserve_enabled __initdata = true;
+
+int cix_hifi5_validate_memory(struct device *dev)
+{
+	int ret;
+
+	ret = region_intersects(CIX_HIFI5_AUDIO_BASE, CIX_HIFI5_AUDIO_SIZE,
+				IORESOURCE_SYSTEM_RAM, IORES_DESC_NONE);
+	if (ret != REGION_DISJOINT)
+		return dev_err_probe(dev, -EBUSY,
+			"DSP audio aperture overlaps System RAM; on legacy firmware reserve it with cix_hifi5_legacy_reserve=1\n");
+
+	if (device_get_dma_attr(dev) != DEV_DMA_COHERENT)
+		return dev_err_probe(dev, -EOPNOTSUPP,
+				     "cache-coherent DMA is required\n");
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(cix_hifi5_validate_memory);
+
+int cix_hifi5_hw_init(struct device *dev, struct cix_hifi5_hw *hw)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(hw->clks); i++)
+		hw->clks[i].id = cix_hifi5_clock_names[i];
+
+	ret = devm_clk_bulk_get(dev, ARRAY_SIZE(hw->clks), hw->clks);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get DSP clocks\n");
+
+	hw->dsp_reset = devm_reset_control_get_exclusive(dev, "dsp");
+	if (IS_ERR(hw->dsp_reset))
+		return dev_err_probe(dev, PTR_ERR(hw->dsp_reset),
+				     "failed to get DSP reset\n");
+
+	hw->mb0_reset = devm_reset_control_get_exclusive(dev, "mb0");
+	if (IS_ERR(hw->mb0_reset))
+		return dev_err_probe(dev, PTR_ERR(hw->mb0_reset),
+				     "failed to get mailbox 0 reset\n");
+
+	hw->mb1_reset = devm_reset_control_get_exclusive(dev, "mb1");
+	if (IS_ERR(hw->mb1_reset))
+		return dev_err_probe(dev, PTR_ERR(hw->mb1_reset),
+				     "failed to get mailbox 1 reset\n");
+
+	hw->ctrl = device_syscon_regmap_lookup_by_property(dev, "cix,dsp-ctrl");
+	if (IS_ERR(hw->ctrl))
+		return dev_err_probe(dev, PTR_ERR(hw->ctrl),
+				     "failed to get DSP control regmap\n");
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(cix_hifi5_hw_init);
+
+int cix_hifi5_hw_enable(struct cix_hifi5_hw *hw)
+{
+	int ret;
+
+	if (hw->clocks_enabled)
+		return 0;
+
+	ret = clk_bulk_prepare_enable(ARRAY_SIZE(hw->clks), hw->clks);
+	if (ret)
+		return ret;
+	hw->clocks_enabled = true;
+
+	ret = reset_control_assert(hw->dsp_reset);
+	if (ret)
+		goto disable_clocks;
+
+	ret = reset_control_assert(hw->mb0_reset);
+	if (ret)
+		goto disable_clocks;
+
+	ret = reset_control_assert(hw->mb1_reset);
+	if (ret)
+		goto disable_clocks;
+
+	usleep_range(1, 2);
+
+	ret = reset_control_deassert(hw->mb0_reset);
+	if (ret)
+		goto disable_clocks;
+
+	ret = reset_control_deassert(hw->mb1_reset);
+	if (!ret)
+		return 0;
+
+	reset_control_assert(hw->mb0_reset);
+
+disable_clocks:
+	clk_bulk_disable_unprepare(ARRAY_SIZE(hw->clks), hw->clks);
+	hw->clocks_enabled = false;
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(cix_hifi5_hw_enable);
+
+void cix_hifi5_hw_disable(struct cix_hifi5_hw *hw)
+{
+	reset_control_assert(hw->dsp_reset);
+	reset_control_assert(hw->mb1_reset);
+	reset_control_assert(hw->mb0_reset);
+
+	if (hw->clocks_enabled) {
+		clk_bulk_disable_unprepare(ARRAY_SIZE(hw->clks), hw->clks);
+		hw->clocks_enabled = false;
+	}
+}
+EXPORT_SYMBOL_GPL(cix_hifi5_hw_disable);
+
+static int __init cix_hifi5_legacy_reserve(char *arg)
+{
+	bool enable = true;
+	int ret;
+
+	if (arg && *arg) {
+		ret = kstrtobool(arg, &enable);
+		if (ret)
+			return ret;
+	}
+
+	cix_hifi5_legacy_reserve_enabled = enable;
+	return 0;
+}
+early_param("cix_hifi5_legacy_reserve", cix_hifi5_legacy_reserve);
+
+void __init cix_hifi5_reserve_legacy_aperture(void)
+{
+	int ret;
+
+	if (!cix_hifi5_legacy_reserve_enabled) {
+		pr_info("CIX HiFi5: automatic legacy audio-aperture reservation disabled\n");
+		return;
+	}
+
+	if (!memblock_is_region_memory(CIX_HIFI5_AUDIO_BASE,
+				       CIX_HIFI5_AUDIO_SIZE)) {
+		if (memblock_overlaps_region(&memblock.memory,
+					     CIX_HIFI5_AUDIO_BASE,
+					     CIX_HIFI5_AUDIO_SIZE))
+			pr_err("CIX HiFi5: audio aperture is only partly System RAM; refusing legacy reservation\n");
+		else
+			pr_info("CIX HiFi5: audio aperture is already excluded from System RAM\n");
+		return;
+	}
+
+	if (memblock_is_region_reserved(CIX_HIFI5_AUDIO_BASE,
+					CIX_HIFI5_AUDIO_SIZE)) {
+		pr_err("CIX HiFi5: audio aperture overlaps an existing reservation; refusing legacy reservation\n");
+		return;
+	}
+
+	ret = memblock_mark_nomap(CIX_HIFI5_AUDIO_BASE,
+				  CIX_HIFI5_AUDIO_SIZE);
+	if (ret) {
+		pr_err("CIX HiFi5: failed to reserve legacy audio aperture: %d\n",
+		       ret);
+		return;
+	}
+
+	pr_info("CIX HiFi5: reserved legacy 34 MiB audio aperture as non-mapped memory\n");
+}
