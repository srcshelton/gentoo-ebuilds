+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/remoteproc/cix,sky1-hifi5.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: CIX Sky1 HiFi5 Audio DSP
+
+maintainers:
+  - CIX Linux Kernel Upstream Group <cix-kernel-upstream@cixtech.com>
+
+description:
+  The CIX Sky1 SoC contains a Cadence HiFi5 DSP used for audio processing.
+  The host controls its clocks and resets, loads an ELF firmware image into
+  the DSP address space and exchanges virtio RPMsg notifications through the
+  CIX mailbox controller.
+
+properties:
+  compatible:
+    const: cix,sky1-hifi5
+
+  dma-coherent: true
+
+  clocks:
+    maxItems: 6
+
+  clock-names:
+    items:
+      - const: clk
+      - const: bclk
+      - const: pbclk
+      - const: sramclk
+      - const: mb0clk
+      - const: mb1clk
+
+  resets:
+    maxItems: 3
+
+  reset-names:
+    items:
+      - const: dsp
+      - const: mb0
+      - const: mb1
+
+  interrupts:
+    maxItems: 1
+    description: DSP watchdog interrupt.
+
+  mboxes:
+    maxItems: 2
+
+  mbox-names:
+    items:
+      - const: tx0
+      - const: rx0
+
+  firmware-name:
+    $ref: /schemas/types.yaml#/definitions/string
+    description: Name of the ELF firmware image in the firmware search path.
+
+  cix,dsp-ctrl:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Phandle to the syscon containing the DSP control registers.
+
+required:
+  - compatible
+  - dma-coherent
+  - clocks
+  - clock-names
+  - resets
+  - reset-names
+  - interrupts
+  - mboxes
+  - mbox-names
+  - firmware-name
+  - cix,dsp-ctrl
+
+additionalProperties: false
+
+...
