diff --git a/drivers/remoteproc/cix_dsp_rproc.c b/drivers/remoteproc/cix_dsp_rproc.c
new file mode 100644
--- /dev/null
+++ b/drivers/remoteproc/cix_dsp_rproc.c
@@ -0,0 +1,804 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * CIX Sky1 HiFi5 remote processor support
+ *
+ * Copyright 2024 Cix Technology Group Co., Ltd.
+ * Copyright 2026 CIX kernel overlay maintainers
+ */
+
+#include <linux/acpi.h>
+#include <linux/atomic.h>
+#include <linux/completion.h>
+#include <linux/delay.h>
+#include <linux/elf.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/mailbox_client.h>
+#include <linux/mm.h>
+#include <linux/module.h>
+#include <linux/overflow.h>
+#include <linux/platform_device.h>
+#include <linux/property.h>
+#include <linux/regmap.h>
+#include <linux/remoteproc.h>
+#include <linux/reset.h>
+#include <linux/soc/cix/cix_hifi5.h>
+#include <linux/workqueue.h>
+
+#include "remoteproc_internal.h"
+
+#define SKY1_HIFI0			0x00
+#define SKY1_HIFI1			0x04
+#define SKY1_HIFI2			0x08
+
+#define SKY1_HIFI1_SELECT_VECTOR	BIT(0)
+#define SKY1_HIFI2_RUN_STALL		BIT(1)
+
+#define CIX_DSP_MBOX_WORDS		2
+#define CIX_DSP_MBOX_BYTES		(CIX_DSP_MBOX_WORDS * sizeof(u32))
+#define CIX_DSP_MBOX_SIZE_MASK		0x7f
+#define CIX_DSP_MBOX_TIMEOUT_MS		100
+#define CIX_DSP_VRING_COUNT		2
+#define CIX_DSP_READY_TIMEOUT_MS	1500
+#define CIX_DSP_VDEV_BUFFER_DA		0x3de08000
+#define CIX_DSP_VDEV_BUFFER_SA		0xcde08000
+#define CIX_DSP_VDEV_BUFFER_SIZE	0x00100000
+#define CIX_DSP_VDEV_BUFFER_OFFSET	\
+	(PAGE_ALIGN(CIX_DSP_VDEV_BUFFER_DA) - CIX_DSP_VDEV_BUFFER_DA)
+#define CIX_DSP_WORKING_DA		0x3e000000
+#define CIX_DSP_WORKING_SIZE		0x01000000
+
+enum cix_dsp_message {
+	CIX_DSP_MSG_READY		= 0xfff0,
+	CIX_DSP_MSG_CRASH		= 0xfff1,
+	CIX_DSP_MSG_SYSTEM_SUSPEND	= 0xfff2,
+	CIX_DSP_MSG_SUSPEND_ACK		= 0xfff3,
+	CIX_DSP_MSG_SYSTEM_RESUME	= 0xfff4,
+	CIX_DSP_MSG_RESUME_ACK		= 0xfff5,
+	CIX_DSP_MSG_STOP		= 0xfff6,
+	CIX_DSP_MSG_STOP_ACK		= 0xfff7,
+};
+
+enum cix_dsp_map_type {
+	CIX_DSP_MAP_IO,
+	CIX_DSP_MAP_DMA_POOL,
+};
+
+struct cix_dsp_region {
+	const char *name;
+	u32 da;
+	phys_addr_t sa;
+	size_t len;
+	enum cix_dsp_map_type type;
+	bool coredump;
+};
+
+/*
+ * The first four ranges are DSP-local memories reached through the Sky1
+ * system address map.  The RPMsg ranges and the 16 MiB DSP working area are
+ * carved from the firmware's reserved audio aperture.  dsp_fw.bin stores its
+ * allocator, RPMsg and resume state in dsp-reserved, so a cold boot must clear
+ * that range before releasing the DSP.  The final 16 MiB shared XAF pool is
+ * owned by the userspace client and is deliberately not mapped here.
+ */
+static const struct cix_dsp_region sky1_dsp_regions[] = {
+	{
+		.name = "iram",
+		.da = 0x20200000,
+		.sa = 0x1c80200000,
+		.len = 0x00020000,
+		.type = CIX_DSP_MAP_IO,
+		.coredump = true,
+	},
+	{
+		.name = "dram0",
+		.da = 0x20220000,
+		.sa = 0x1c80220000,
+		.len = 0x00020000,
+		.type = CIX_DSP_MAP_IO,
+		.coredump = true,
+	},
+	{
+		.name = "dram1",
+		.da = 0x20240000,
+		.sa = 0x1c80240000,
+		.len = 0x00020000,
+		.type = CIX_DSP_MAP_IO,
+		.coredump = true,
+	},
+	{
+		.name = "ext-sram",
+		.da = 0x20400000,
+		.sa = 0x1c80400000,
+		.len = 0x00100000,
+		.type = CIX_DSP_MAP_IO,
+		.coredump = true,
+	},
+	{
+		.name = "vdev0vring0",
+		.da = 0x3de00000,
+		.sa = 0xcde00000,
+		.len = 0x00004000,
+		.type = CIX_DSP_MAP_IO,
+	},
+	{
+		.name = "vdev0vring1",
+		.da = 0x3de04000,
+		.sa = 0xcde04000,
+		.len = 0x00004000,
+		.type = CIX_DSP_MAP_IO,
+	},
+	{
+		.name = "vdev0buffer",
+		/*
+		 * Coherent DMA pools allocate in CPU pages; retain only the
+		 * page-aligned subrange of the firmware's fixed 1 MiB buffer.
+		 */
+		.da = CIX_DSP_VDEV_BUFFER_DA + CIX_DSP_VDEV_BUFFER_OFFSET,
+		.sa = CIX_DSP_VDEV_BUFFER_SA + CIX_DSP_VDEV_BUFFER_OFFSET,
+		.len = PAGE_ALIGN_DOWN(CIX_DSP_VDEV_BUFFER_SIZE -
+				       CIX_DSP_VDEV_BUFFER_OFFSET),
+		.type = CIX_DSP_MAP_DMA_POOL,
+	},
+	{
+		.name = "dsp-reserved",
+		.da = CIX_DSP_WORKING_DA,
+		.sa = 0xce000000,
+		.len = CIX_DSP_WORKING_SIZE,
+		.type = CIX_DSP_MAP_IO,
+	},
+};
+
+struct cix_dsp_rproc {
+	struct device *dev;
+	struct rproc *rproc;
+	struct cix_hifi5_hw hw;
+	struct mbox_client mbox_client;
+	struct mbox_chan *tx_chan;
+	struct mbox_chan *rx_chan;
+	struct completion ready;
+	struct completion response;
+	struct delayed_work vq_work;
+	/* Serializes virtqueue state with the mailbox hard-IRQ callback. */
+	spinlock_t vq_lock;
+	unsigned long vq_pending;
+	bool vq_active;
+	int watchdog_irq;
+	atomic_t watchdog_enabled;
+	atomic_t crashed;
+};
+
+static int cix_dsp_io_mem_alloc(struct rproc *rproc,
+				struct rproc_mem_entry *mem)
+{
+	void __iomem *va;
+
+	va = ioremap_wc(mem->dma, mem->len);
+	if (!va)
+		return -ENOMEM;
+
+	mem->va = (void *)va;
+	mem->is_iomem = true;
+
+	return 0;
+}
+
+static int cix_dsp_io_mem_release(struct rproc *rproc,
+				  struct rproc_mem_entry *mem)
+{
+	if (mem->va)
+		iounmap((void __iomem *)mem->va);
+
+	return 0;
+}
+
+static int cix_dsp_add_carveouts(struct cix_dsp_rproc *priv)
+{
+	struct rproc_mem_entry *entries[ARRAY_SIZE(sky1_dsp_regions)];
+	struct device *dev = priv->dev;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(sky1_dsp_regions); i++) {
+		const struct cix_dsp_region *region = &sky1_dsp_regions[i];
+		int (*alloc)(struct rproc *rproc,
+			     struct rproc_mem_entry *mem);
+		int (*release)(struct rproc *rproc,
+			       struct rproc_mem_entry *mem);
+
+		switch (region->type) {
+		case CIX_DSP_MAP_IO:
+			alloc = cix_dsp_io_mem_alloc;
+			release = cix_dsp_io_mem_release;
+			break;
+		case CIX_DSP_MAP_DMA_POOL:
+			alloc = NULL;
+			release = NULL;
+			break;
+		default:
+			return -EINVAL;
+		}
+
+		entries[i] = rproc_mem_entry_init(dev, NULL, region->sa,
+						  region->len, region->da,
+						  alloc, release,
+						  region->name);
+		if (!entries[i])
+			goto free_entries;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(sky1_dsp_regions); i++) {
+		const struct cix_dsp_region *region = &sky1_dsp_regions[i];
+
+		rproc_add_carveout(priv->rproc, entries[i]);
+		if (region->coredump)
+			rproc_coredump_add_segment(priv->rproc, region->da,
+						   region->len);
+	}
+
+	return 0;
+
+free_entries:
+	while (i--)
+		kfree(entries[i]);
+
+	return -ENOMEM;
+}
+
+static int cix_dsp_request_mailboxes(struct cix_dsp_rproc *priv);
+
+static void cix_dsp_vq_work(struct work_struct *work)
+{
+	struct cix_dsp_rproc *priv =
+		container_of(to_delayed_work(work), struct cix_dsp_rproc,
+			     vq_work);
+	unsigned long flags;
+	unsigned long pending;
+	unsigned int vqid;
+
+	spin_lock_irqsave(&priv->vq_lock, flags);
+	if (!priv->vq_active || !priv->vq_pending) {
+		spin_unlock_irqrestore(&priv->vq_lock, flags);
+		return;
+	}
+	spin_unlock_irqrestore(&priv->vq_lock, flags);
+
+	/* Remoteproc holds this lock across its start and stop transitions. */
+	if (!mutex_trylock(&priv->rproc->lock)) {
+		schedule_delayed_work(&priv->vq_work, msecs_to_jiffies(1));
+		return;
+	}
+
+	spin_lock_irqsave(&priv->vq_lock, flags);
+	if (!priv->vq_active || priv->rproc->state != RPROC_RUNNING) {
+		spin_unlock_irqrestore(&priv->vq_lock, flags);
+		mutex_unlock(&priv->rproc->lock);
+		return;
+	}
+	pending = priv->vq_pending;
+	priv->vq_pending = 0;
+	spin_unlock_irqrestore(&priv->vq_lock, flags);
+
+	for_each_set_bit(vqid, &pending, CIX_DSP_VRING_COUNT) {
+		if (rproc_vq_interrupt(priv->rproc, vqid) == IRQ_NONE)
+			dev_dbg(priv->dev,
+				"spurious virtqueue notification %u\n", vqid);
+	}
+
+	mutex_unlock(&priv->rproc->lock);
+}
+
+static void cix_dsp_queue_vqs(struct cix_dsp_rproc *priv,
+			      unsigned long pending)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&priv->vq_lock, flags);
+	priv->vq_pending |= pending;
+	if (priv->vq_active)
+		schedule_delayed_work(&priv->vq_work, 0);
+	spin_unlock_irqrestore(&priv->vq_lock, flags);
+}
+
+static void cix_dsp_enable_vqs(struct cix_dsp_rproc *priv)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&priv->vq_lock, flags);
+	priv->vq_active = true;
+	if (priv->vq_pending)
+		schedule_delayed_work(&priv->vq_work, 0);
+	spin_unlock_irqrestore(&priv->vq_lock, flags);
+}
+
+static void cix_dsp_disable_vqs(struct cix_dsp_rproc *priv)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&priv->vq_lock, flags);
+	priv->vq_active = false;
+	priv->vq_pending = 0;
+	spin_unlock_irqrestore(&priv->vq_lock, flags);
+	cancel_delayed_work_sync(&priv->vq_work);
+}
+
+static void cix_dsp_free_mailboxes(struct cix_dsp_rproc *priv)
+{
+	if (priv->rx_chan) {
+		mbox_free_channel(priv->rx_chan);
+		priv->rx_chan = NULL;
+	}
+
+	if (priv->tx_chan) {
+		mbox_free_channel(priv->tx_chan);
+		priv->tx_chan = NULL;
+	}
+}
+
+static int cix_dsp_prepare(struct rproc *rproc)
+{
+	struct cix_dsp_rproc *priv = rproc->priv;
+	int ret;
+
+	ret = cix_hifi5_hw_enable(&priv->hw);
+	if (ret)
+		return dev_err_probe(priv->dev, ret, "failed to prepare DSP\n");
+
+	ret = cix_dsp_request_mailboxes(priv);
+	if (ret)
+		goto disable_resources;
+
+	ret = cix_dsp_add_carveouts(priv);
+	if (ret)
+		goto free_mailboxes;
+
+	return 0;
+
+free_mailboxes:
+	cix_dsp_free_mailboxes(priv);
+disable_resources:
+	cix_hifi5_hw_disable(&priv->hw);
+
+	return dev_err_probe(priv->dev, ret, "failed to prepare DSP\n");
+}
+
+static int cix_dsp_unprepare(struct rproc *rproc)
+{
+	struct cix_dsp_rproc *priv = rproc->priv;
+
+	/* parse_fw failures precede the remoteproc core's resource cleanup. */
+	if (!list_empty(&rproc->carveouts))
+		rproc_resource_cleanup(rproc);
+
+	cix_dsp_disable_vqs(priv);
+
+	if (atomic_xchg(&priv->watchdog_enabled, 0))
+		disable_irq(priv->watchdog_irq);
+
+	cix_dsp_free_mailboxes(priv);
+	cix_hifi5_hw_disable(&priv->hw);
+
+	return 0;
+}
+
+static int cix_dsp_load(struct rproc *rproc, const struct firmware *fw)
+{
+	struct cix_dsp_rproc *priv = rproc->priv;
+	void *dsp_working_mem;
+	u64 bootaddr = rproc->bootaddr;
+	bool is_iomem = false;
+	int ret;
+
+	if (bootaddr != sky1_dsp_regions[0].da) {
+		dev_err(priv->dev, "unsupported DSP entry point %#llx\n",
+			bootaddr);
+		return -EINVAL;
+	}
+
+	ret = reset_control_assert(priv->hw.dsp_reset);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(priv->hw.ctrl, SKY1_HIFI2,
+				 SKY1_HIFI2_RUN_STALL,
+				 SKY1_HIFI2_RUN_STALL);
+	if (ret)
+		return ret;
+
+	/*
+	 * Bit zero selects the alternative reset vector.  The firmware entry
+	 * point is aligned, so the address and selector share this register
+	 * without losing address information.
+	 */
+	ret = regmap_write(priv->hw.ctrl, SKY1_HIFI1,
+			   lower_32_bits(bootaddr));
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(priv->hw.ctrl, SKY1_HIFI1,
+				 SKY1_HIFI1_SELECT_VECTOR,
+				 SKY1_HIFI1_SELECT_VECTOR);
+	if (ret)
+		return ret;
+
+	usleep_range(1, 2);
+
+	ret = reset_control_deassert(priv->hw.dsp_reset);
+	if (ret)
+		return ret;
+
+	dsp_working_mem = rproc_da_to_va(rproc, CIX_DSP_WORKING_DA,
+					 CIX_DSP_WORKING_SIZE, &is_iomem);
+	if (!dsp_working_mem)
+		return dev_err_probe(priv->dev, -ENOMEM,
+				     "DSP working memory is unavailable\n");
+	if (!is_iomem)
+		return dev_err_probe(priv->dev, -EINVAL,
+				     "DSP working memory is not an I/O mapping\n");
+
+	memset_io((void __iomem *)dsp_working_mem, 0,
+		  CIX_DSP_WORKING_SIZE);
+
+	return rproc_elf_load_segments(rproc, fw);
+}
+
+static int cix_dsp_start(struct rproc *rproc)
+{
+	struct cix_dsp_rproc *priv = rproc->priv;
+	unsigned long timeout;
+	int ret;
+
+	cix_dsp_disable_vqs(priv);
+	reinit_completion(&priv->ready);
+	atomic_set(&priv->crashed, 0);
+
+	ret = reset_control_assert(priv->hw.dsp_reset);
+	if (ret)
+		return ret;
+
+	usleep_range(1, 2);
+
+	/*
+	 * Firmware describes the DSP as DMA coherent.  Publish all initialized
+	 * shared memory before releasing the core from reset.
+	 */
+	dma_wmb();
+
+	ret = reset_control_deassert(priv->hw.dsp_reset);
+	if (ret)
+		goto assert_dsp_reset;
+
+	ret = regmap_update_bits(priv->hw.ctrl, SKY1_HIFI2,
+				 SKY1_HIFI2_RUN_STALL, 0);
+	if (ret)
+		goto assert_dsp_reset;
+
+	timeout = wait_for_completion_timeout
+		(&priv->ready, msecs_to_jiffies(CIX_DSP_READY_TIMEOUT_MS));
+	if (timeout) {
+		cix_dsp_enable_vqs(priv);
+		atomic_set(&priv->watchdog_enabled, 1);
+		enable_irq(priv->watchdog_irq);
+		return 0;
+	}
+
+	ret = -ETIMEDOUT;
+	dev_err(priv->dev, "DSP firmware did not report ready\n");
+	regmap_update_bits(priv->hw.ctrl, SKY1_HIFI2,
+			   SKY1_HIFI2_RUN_STALL, SKY1_HIFI2_RUN_STALL);
+
+assert_dsp_reset:
+	reset_control_assert(priv->hw.dsp_reset);
+
+	return ret;
+}
+
+static int cix_dsp_send_control(struct cix_dsp_rproc *priv, u32 command)
+{
+	u32 message[CIX_DSP_MBOX_WORDS] = {
+		CIX_DSP_MBOX_BYTES,
+		command,
+	};
+	int ret;
+
+	ret = mbox_send_message(priv->tx_chan, message);
+	if (ret < 0)
+		return ret;
+
+	return 0;
+}
+
+static int cix_dsp_stop(struct rproc *rproc)
+{
+	struct cix_dsp_rproc *priv = rproc->priv;
+	unsigned long timeout;
+	bool watchdog_was_enabled;
+	int reset_ret;
+	int stall_ret;
+	int ret;
+
+	cix_dsp_disable_vqs(priv);
+
+	watchdog_was_enabled = atomic_xchg(&priv->watchdog_enabled, 0);
+	if (watchdog_was_enabled)
+		disable_irq(priv->watchdog_irq);
+
+	if (!atomic_read(&priv->crashed)) {
+		reinit_completion(&priv->response);
+		ret = cix_dsp_send_control(priv, CIX_DSP_MSG_STOP);
+		if (ret) {
+			dev_warn(priv->dev,
+				 "failed to request a clean DSP stop: %d\n", ret);
+		} else {
+			timeout = wait_for_completion_timeout
+				(&priv->response,
+				 msecs_to_jiffies(CIX_DSP_MBOX_TIMEOUT_MS));
+			if (!timeout)
+				dev_warn(priv->dev,
+					 "DSP did not acknowledge stop; forcing reset\n");
+		}
+	}
+
+	stall_ret = regmap_update_bits(priv->hw.ctrl, SKY1_HIFI2,
+				       SKY1_HIFI2_RUN_STALL,
+				       SKY1_HIFI2_RUN_STALL);
+	if (stall_ret)
+		dev_warn(priv->dev, "failed to stall DSP during stop: %d\n",
+			 stall_ret);
+
+	reset_ret = reset_control_assert(priv->hw.dsp_reset);
+	if (reset_ret) {
+		if (watchdog_was_enabled) {
+			atomic_set(&priv->watchdog_enabled, 1);
+			enable_irq(priv->watchdog_irq);
+		}
+		dev_err(priv->dev, "failed to reset DSP during stop: %d\n",
+			reset_ret);
+		return reset_ret;
+	}
+
+	return 0;
+}
+
+static void cix_dsp_kick(struct rproc *rproc, int vqid)
+{
+	struct cix_dsp_rproc *priv = rproc->priv;
+	u32 message[CIX_DSP_MBOX_WORDS] = {
+		CIX_DSP_MBOX_BYTES,
+		vqid,
+	};
+	int ret;
+
+	if (vqid < 0) {
+		dev_warn_ratelimited(priv->dev,
+				     "refusing invalid virtqueue id %d\n", vqid);
+		return;
+	}
+
+	ret = mbox_send_message(priv->tx_chan, message);
+	if (ret < 0)
+		dev_err_ratelimited(priv->dev,
+				    "failed to notify virtqueue %d: %d\n",
+				    vqid, ret);
+}
+
+static irqreturn_t cix_dsp_watchdog_irq(int irq, void *data)
+{
+	struct cix_dsp_rproc *priv = data;
+
+	if (atomic_xchg(&priv->watchdog_enabled, 0))
+		disable_irq_nosync(irq);
+	if (!atomic_xchg(&priv->crashed, 1))
+		rproc_report_crash(priv->rproc, RPROC_WATCHDOG);
+
+	return IRQ_HANDLED;
+}
+
+static void cix_dsp_mbox_rx(struct mbox_client *client, void *data)
+{
+	struct cix_dsp_rproc *priv =
+		container_of(client, struct cix_dsp_rproc, mbox_client);
+	const u32 *message = data;
+	u32 size;
+	u32 value;
+
+	if (!message) {
+		dev_warn_ratelimited(priv->dev,
+				     "discarding malformed DSP mailbox message\n");
+		return;
+	}
+
+	size = message[0] & CIX_DSP_MBOX_SIZE_MASK;
+
+	/*
+	 * The public CIX DSP firmware's RPMsg path writes its two-word message
+	 * count into the byte-length field.  The mailbox consequently transfers
+	 * only the header, without the virtqueue ID stored in the second word.
+	 * Service both resource-table vrings; a queue with no work returns
+	 * IRQ_NONE.  Control messages use the correct byte length below.
+	 */
+	if (size == CIX_DSP_MBOX_WORDS) {
+		cix_dsp_queue_vqs(priv, GENMASK(CIX_DSP_VRING_COUNT - 1, 0));
+		return;
+	}
+
+	if (size != CIX_DSP_MBOX_BYTES) {
+		dev_warn_ratelimited(priv->dev,
+				     "discarding malformed DSP mailbox message\n");
+		return;
+	}
+
+	value = message[1];
+
+	switch (value) {
+	case CIX_DSP_MSG_READY:
+		complete(&priv->ready);
+		break;
+	case CIX_DSP_MSG_SUSPEND_ACK:
+	case CIX_DSP_MSG_RESUME_ACK:
+	case CIX_DSP_MSG_STOP_ACK:
+		complete(&priv->response);
+		break;
+	case CIX_DSP_MSG_CRASH:
+		if (!atomic_xchg(&priv->crashed, 1))
+			rproc_report_crash(priv->rproc, RPROC_WATCHDOG);
+		break;
+	default:
+		if (value < CIX_DSP_MSG_READY) {
+			if (value >= CIX_DSP_VRING_COUNT) {
+				dev_warn_ratelimited(priv->dev,
+						     "invalid DSP virtqueue notification %u\n",
+						     value);
+				break;
+			}
+
+			cix_dsp_queue_vqs(priv, BIT(value));
+		} else {
+			dev_warn_ratelimited(priv->dev,
+					     "unknown DSP control message %#x\n",
+					     value);
+		}
+		break;
+	}
+}
+
+static int cix_dsp_request_mailboxes(struct cix_dsp_rproc *priv)
+{
+	struct mbox_client *client = &priv->mbox_client;
+	int ret;
+
+	client->dev = priv->dev;
+	client->tx_block = true;
+	client->tx_tout = CIX_DSP_MBOX_TIMEOUT_MS;
+	client->knows_txdone = false;
+	client->rx_callback = cix_dsp_mbox_rx;
+
+	priv->tx_chan = mbox_request_channel_byname(client, "tx0");
+	if (IS_ERR(priv->tx_chan)) {
+		ret = PTR_ERR(priv->tx_chan);
+		priv->tx_chan = NULL;
+		return ret;
+	}
+
+	priv->rx_chan = mbox_request_channel_byname(client, "rx0");
+	if (IS_ERR(priv->rx_chan)) {
+		ret = PTR_ERR(priv->rx_chan);
+		priv->rx_chan = NULL;
+		mbox_free_channel(priv->tx_chan);
+		priv->tx_chan = NULL;
+		return ret;
+	}
+
+	return 0;
+}
+
+static int cix_dsp_system_suspend(struct device *dev)
+{
+	struct rproc *rproc = dev_get_drvdata(dev);
+
+	if (READ_ONCE(rproc->state) == RPROC_RUNNING)
+		return -EBUSY;
+
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(cix_dsp_pm_ops, cix_dsp_system_suspend, NULL);
+
+static const struct rproc_ops cix_dsp_ops = {
+	.prepare = cix_dsp_prepare,
+	.unprepare = cix_dsp_unprepare,
+	.start = cix_dsp_start,
+	.stop = cix_dsp_stop,
+	.kick = cix_dsp_kick,
+	.load = cix_dsp_load,
+	.parse_fw = rproc_elf_load_rsc_table,
+	.find_loaded_rsc_table = rproc_elf_find_loaded_rsc_table,
+	.sanity_check = rproc_elf_sanity_check,
+	.get_boot_addr = rproc_elf_get_boot_addr,
+};
+
+static int cix_dsp_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct cix_dsp_rproc *priv;
+	const char *firmware;
+	struct rproc *rproc;
+	int ret;
+
+	ret = cix_hifi5_validate_memory(dev);
+	if (ret)
+		return ret;
+
+	ret = device_property_read_string(dev, "firmware-name", &firmware);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "firmware-name property is required\n");
+
+	rproc = devm_rproc_alloc(dev, "cix-dsp-rproc", &cix_dsp_ops, firmware,
+				 sizeof(*priv));
+	if (!rproc)
+		return -ENOMEM;
+
+	priv = rproc->priv;
+	priv->dev = dev;
+	priv->rproc = rproc;
+
+	ret = cix_hifi5_hw_init(dev, &priv->hw);
+	if (ret)
+		return ret;
+
+	priv->watchdog_irq = platform_get_irq(pdev, 0);
+	if (priv->watchdog_irq < 0)
+		return priv->watchdog_irq;
+
+	ret = devm_request_irq(dev, priv->watchdog_irq,
+			       cix_dsp_watchdog_irq, IRQF_NO_AUTOEN,
+			       dev_name(dev), priv);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "failed to request DSP watchdog IRQ\n");
+
+	init_completion(&priv->ready);
+	init_completion(&priv->response);
+	INIT_DELAYED_WORK(&priv->vq_work, cix_dsp_vq_work);
+	spin_lock_init(&priv->vq_lock);
+	atomic_set(&priv->watchdog_enabled, 0);
+	atomic_set(&priv->crashed, 0);
+
+	rproc->auto_boot = false;
+	dev_set_drvdata(dev, rproc);
+
+	ret = devm_rproc_add(dev, rproc);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "failed to register remote processor\n");
+
+	rproc_coredump_set_elf_info(rproc, ELFCLASS32, EM_XTENSA);
+
+	return 0;
+}
+
+static const struct of_device_id cix_dsp_of_match[] = {
+	{ .compatible = "cix,sky1-hifi5" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, cix_dsp_of_match);
+
+static const struct acpi_device_id cix_dsp_acpi_match[] = {
+	{ "CIXH6000" },
+	{ }
+};
+MODULE_DEVICE_TABLE(acpi, cix_dsp_acpi_match);
+
+static struct platform_driver cix_dsp_driver = {
+	.probe = cix_dsp_probe,
+	.driver = {
+		.name = "cix-dsp-rproc",
+		.of_match_table = cix_dsp_of_match,
+		.acpi_match_table = cix_dsp_acpi_match,
+		.pm = pm_sleep_ptr(&cix_dsp_pm_ops),
+	},
+};
+module_platform_driver(cix_dsp_driver);
+
+MODULE_DESCRIPTION("CIX Sky1 HiFi5 remote processor driver");
+MODULE_LICENSE("GPL");
