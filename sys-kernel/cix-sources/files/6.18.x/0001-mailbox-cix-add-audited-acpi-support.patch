+static int cix_mbox_get_dir(struct device *dev)
+{
+	const char *dir_str;
+	u32 dir;
+
+	if (!device_property_read_u32(dev, "cix,mbox_dir", &dir)) {
+		if (dir == CIX_MBOX_TX || dir == CIX_MBOX_RX)
+			return dir;
+
+		dev_err(dev, "invalid cix,mbox_dir value %u\n", dir);
+		return -EINVAL;
+	}
+
+	if (device_property_read_string(dev, "cix,mbox-dir", &dir_str)) {
+		dev_err(dev, "missing cix,mbox_dir or cix,mbox-dir property\n");
+		return -EINVAL;
+	}
+
+	if (!strcmp(dir_str, "tx"))
+		return CIX_MBOX_TX;
+	if (!strcmp(dir_str, "rx"))
+		return CIX_MBOX_RX;
+
+	dev_err(dev, "invalid cix,mbox-dir value %s\n", dir_str);
+	return -EINVAL;
+}
