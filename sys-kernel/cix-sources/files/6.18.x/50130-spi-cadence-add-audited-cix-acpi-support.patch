diff --git a/drivers/spi/spi-cadence.c b/drivers/spi/spi-cadence.c
--- a/drivers/spi/spi-cadence.c
+++ b/drivers/spi/spi-cadence.c
@@ -7,6 +7,7 @@
  * based on Blackfin On-Chip SPI Driver (spi_bfin5xx.c)
  */
 
+#include <linux/acpi.h>
 #include <linux/clk.h>
 #include <linux/delay.h>
 #include <linux/gpio/consumer.h>
@@ -18,6 +19,7 @@
 #include <linux/of_address.h>
 #include <linux/platform_device.h>
 #include <linux/pm_runtime.h>
+#include <linux/property.h>
 #include <linux/reset.h>
 #include <linux/spi/spi.h>
 
@@ -97,6 +99,13 @@
 
 /* Default number of chip select lines */
 #define CDNS_SPI_DEFAULT_NUM_CS		4
+#define CDNS_SPI_MAX_DECODED_CS		16
+
+struct cdns_spi_devtype_data {
+	const char *reset_name;
+	u32 bits_per_word_mask;
+	bool reset_required;
+};
 
 /**
  * struct cdns_spi - This definition defines spi driver instance
@@ -641,17 +650,22 @@ static int cdns_target_abort(struct spi_controller *ctlr)
  */
 static int cdns_spi_probe(struct platform_device *pdev)
 {
+	const struct cdns_spi_devtype_data *data;
+	struct device *dev = &pdev->dev;
 	int ret = 0, irq;
 	struct spi_controller *ctlr;
 	struct cdns_spi *xspi;
+	const char *reset_name;
 	u32 num_cs;
 	bool target;
 
-	target = of_property_read_bool(pdev->dev.of_node, "spi-slave");
+	data = device_get_match_data(dev);
+	reset_name = data ? data->reset_name : "spi";
+	target = device_property_read_bool(dev, "spi-slave");
 	if (target)
-		ctlr = spi_alloc_target(&pdev->dev, sizeof(*xspi));
+		ctlr = spi_alloc_target(dev, sizeof(*xspi));
 	else
-		ctlr = spi_alloc_host(&pdev->dev, sizeof(*xspi));
+		ctlr = spi_alloc_host(dev, sizeof(*xspi));
 
 	if (!ctlr)
 		return -ENOMEM;
@@ -666,47 +680,74 @@ static int cdns_spi_probe(struct platform_device *pdev)
 		goto remove_ctlr;
 	}
 
-	xspi->pclk = devm_clk_get_enabled(&pdev->dev, "pclk");
+	xspi->pclk = devm_clk_get_enabled(dev, "pclk");
 	if (IS_ERR(xspi->pclk)) {
-		dev_err(&pdev->dev, "pclk clock not found.\n");
 		ret = PTR_ERR(xspi->pclk);
+		dev_err_probe(dev, ret, "Cannot get pclk clock\n");
 		goto remove_ctlr;
 	}
 
-	xspi->rstc = devm_reset_control_get_optional_exclusive(&pdev->dev, "spi");
+	if (data && data->reset_required)
+		xspi->rstc = devm_reset_control_get_exclusive(dev, reset_name);
+	else
+		xspi->rstc = devm_reset_control_get_optional_exclusive(dev, reset_name);
 	if (IS_ERR(xspi->rstc)) {
-		ret = dev_err_probe(&pdev->dev, PTR_ERR(xspi->rstc),
+		ret = dev_err_probe(dev, PTR_ERR(xspi->rstc),
 				    "Cannot get SPI reset.\n");
 		goto remove_ctlr;
 	}
 
-	reset_control_assert(xspi->rstc);
-	reset_control_deassert(xspi->rstc);
+	ret = reset_control_assert(xspi->rstc);
+	if (ret) {
+		dev_err_probe(dev, ret, "Cannot assert SPI reset\n");
+		goto remove_ctlr;
+	}
+
+	ret = reset_control_deassert(xspi->rstc);
+	if (ret) {
+		dev_err_probe(dev, ret, "Cannot deassert SPI reset\n");
+		goto remove_ctlr;
+	}
 
-	xspi->ref_clk = devm_clk_get_enabled(&pdev->dev, "ref_clk");
+	xspi->ref_clk = devm_clk_get_enabled(dev, "ref_clk");
 	if (IS_ERR(xspi->ref_clk)) {
-		dev_err(&pdev->dev, "ref_clk clock not found.\n");
 		ret = PTR_ERR(xspi->ref_clk);
+		dev_err_probe(dev, ret, "Cannot get ref_clk clock\n");
 		goto remove_ctlr;
 	}
 
 	if (!spi_controller_is_target(ctlr)) {
-		pm_runtime_use_autosuspend(&pdev->dev);
-		pm_runtime_set_autosuspend_delay(&pdev->dev, SPI_AUTOSUSPEND_TIMEOUT);
-		pm_runtime_get_noresume(&pdev->dev);
-		pm_runtime_set_active(&pdev->dev);
-		pm_runtime_enable(&pdev->dev);
-
-		ret = of_property_read_u32(pdev->dev.of_node, "num-cs", &num_cs);
-		if (ret < 0)
-			ctlr->num_chipselect = CDNS_SPI_DEFAULT_NUM_CS;
-		else
-			ctlr->num_chipselect = num_cs;
+		if (device_property_present(dev, "is-decoded-cs")) {
+			ret = device_property_read_u32(dev, "is-decoded-cs",
+						       &xspi->is_decoded_cs);
+			if (ret)
+				goto property_error;
+		}
+		if (xspi->is_decoded_cs > 1) {
+			ret = -EINVAL;
+			goto property_error;
+		}
 
-		ret = of_property_read_u32(pdev->dev.of_node, "is-decoded-cs",
-					   &xspi->is_decoded_cs);
-		if (ret < 0)
-			xspi->is_decoded_cs = 0;
+		if (device_property_present(dev, "num-cs")) {
+			ret = device_property_read_u32(dev, "num-cs", &num_cs);
+			if (ret)
+				goto property_error;
+		} else {
+			num_cs = CDNS_SPI_DEFAULT_NUM_CS;
+		}
+		if (!num_cs || num_cs > (xspi->is_decoded_cs ?
+						 CDNS_SPI_MAX_DECODED_CS :
+						 CDNS_SPI_DEFAULT_NUM_CS)) {
+			ret = -EINVAL;
+			goto property_error;
+		}
+		ctlr->num_chipselect = num_cs;
+
+		pm_runtime_use_autosuspend(dev);
+		pm_runtime_set_autosuspend_delay(dev, SPI_AUTOSUSPEND_TIMEOUT);
+		pm_runtime_get_noresume(dev);
+		pm_runtime_set_active(dev);
+		pm_runtime_enable(dev);
 	}
 
 	cdns_spi_detect_fifo_depth(xspi);
@@ -720,11 +761,10 @@ static int cdns_spi_probe(struct platform_device *pdev)
 		goto clk_dis_all;
 	}
 
-	ret = devm_request_irq(&pdev->dev, irq, cdns_spi_irq,
+	ret = devm_request_irq(dev, irq, cdns_spi_irq,
 			       0, pdev->name, ctlr);
-	if (ret != 0) {
-		ret = -ENXIO;
-		dev_err(&pdev->dev, "request_irq failed\n");
+	if (ret) {
+		dev_err_probe(dev, ret, "Cannot request SPI IRQ\n");
 		goto clk_dis_all;
 	}
 
@@ -734,17 +774,20 @@ static int cdns_spi_probe(struct platform_device *pdev)
 	ctlr->transfer_one = cdns_transfer_one;
 	ctlr->unprepare_transfer_hardware = cdns_unprepare_transfer_hardware;
 	ctlr->mode_bits = SPI_CPOL | SPI_CPHA;
-	ctlr->bits_per_word_mask = SPI_BPW_MASK(8);
+	ctlr->bits_per_word_mask = data && data->bits_per_word_mask ?
+		data->bits_per_word_mask : SPI_BPW_MASK(8);
 	ctlr->flags = SPI_CONTROLLER_MUST_TX;
 
-	if (of_device_is_compatible(pdev->dev.of_node, "cix,sky1-spi-r1p6"))
-		ctlr->bits_per_word_mask |= SPI_BPW_MASK(16) | SPI_BPW_MASK(32);
-
 	if (!spi_controller_is_target(ctlr)) {
 		ctlr->mode_bits |=  SPI_CS_HIGH;
 		ctlr->set_cs = cdns_spi_chipselect;
 		ctlr->auto_runtime_pm = true;
 		xspi->clk_rate = clk_get_rate(xspi->ref_clk);
+		if (!xspi->clk_rate) {
+			ret = -EINVAL;
+			dev_err(dev, "ref_clk has zero rate\n");
+			goto clk_dis_all;
+		}
 		/* Set to default valid value */
 		ctlr->max_speed_hz = xspi->clk_rate / 4;
 		xspi->speed_hz = ctlr->max_speed_hz;
@@ -763,6 +806,10 @@ static int cdns_spi_probe(struct platform_device *pdev)
 
 	return ret;
 
+property_error:
+	dev_err_probe(dev, ret, "Invalid SPI controller properties\n");
+	goto remove_ctlr;
+
 clk_dis_all:
 	if (!spi_controller_is_target(ctlr)) {
 		pm_runtime_disable(&pdev->dev);
@@ -896,14 +943,35 @@ static const struct dev_pm_ops cdns_spi_dev_pm_ops = {
 	SET_SYSTEM_SLEEP_PM_OPS(cdns_spi_suspend, cdns_spi_resume)
 };
 
+static const struct cdns_spi_devtype_data cix_sky1_spi_data = {
+	.reset_name = "spi",
+	.bits_per_word_mask = SPI_BPW_MASK(8) | SPI_BPW_MASK(16) |
+		SPI_BPW_MASK(32),
+};
+
 static const struct of_device_id cdns_spi_of_match[] = {
 	{ .compatible = "xlnx,zynq-spi-r1p6" },
-	{ .compatible = "cix,sky1-spi-r1p6" },
+	{ .compatible = "cix,sky1-spi-r1p6", .data = &cix_sky1_spi_data },
 	{ .compatible = "cdns,spi-r1p6" },
 	{ /* end of table */ }
 };
 MODULE_DEVICE_TABLE(of, cdns_spi_of_match);
 
+#ifdef CONFIG_ACPI
+static const struct cdns_spi_devtype_data cix_sky1_acpi_spi_data = {
+	.reset_name = "spi_reset",
+	.bits_per_word_mask = SPI_BPW_MASK(8) | SPI_BPW_MASK(16) |
+		SPI_BPW_MASK(32),
+	.reset_required = true,
+};
+
+static const struct acpi_device_id cdns_spi_acpi_match[] = {
+	{ "CIXH2001", (kernel_ulong_t)&cix_sky1_acpi_spi_data },
+	{ }
+};
+MODULE_DEVICE_TABLE(acpi, cdns_spi_acpi_match);
+#endif
+
 /* cdns_spi_driver - This structure defines the SPI subsystem platform driver */
 static struct platform_driver cdns_spi_driver = {
 	.probe	= cdns_spi_probe,
@@ -911,6 +979,7 @@ static struct platform_driver cdns_spi_driver = {
 	.driver = {
 		.name = CDNS_SPI_NAME,
 		.of_match_table = cdns_spi_of_match,
+		.acpi_match_table = ACPI_PTR(cdns_spi_acpi_match),
 		.pm = &cdns_spi_dev_pm_ops,
 	},
 };
