+		.pins = sky1_gpio5_6_pins,
+		.npins = ARRAY_SIZE(sky1_gpio5_6_pins),
+	},
+};
+
+static int cdns_gpio_sky1_add_pin_ranges(struct gpio_chip *chip)
+{
+	const struct sky1_gpio_pin_range *range;
+	u64 uid;
+	int ret;
+
+	ret = acpi_dev_uid_to_integer(ACPI_COMPANION(chip->parent), &uid);
+	if (ret)
+		return ret;
+	if (uid >= ARRAY_SIZE(sky1_gpio_pin_ranges))
+		return -EINVAL;
+
+	range = &sky1_gpio_pin_ranges[uid];
+	if (chip->ngpio != range->npins)
+		return -EINVAL;
+
+	return gpiochip_add_sparse_pin_range(chip, range->pinctrl, 0,
+					      range->pins, range->npins);
+}
