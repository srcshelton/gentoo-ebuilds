diff --git a/drivers/net/ethernet/realtek/r8126/r8126.h b/drivers/net/ethernet/realtek/r8126/r8126.h
--- a/drivers/net/ethernet/realtek/r8126/r8126.h
+++ b/drivers/net/ethernet/realtek/r8126/r8126.h
@@ -2497,6 +2497,9 @@ struct rtl8126_private {
         struct net_device *dev;
         struct r8126_napi r8126napi[R8126_MAX_MSIX_VEC];
         struct r8126_irq irq_tbl[R8126_MAX_MSIX_VEC];
+#ifdef CONFIG_ARM64
+        struct cpumask *performance_core_mask;
+#endif
         unsigned int irq_nvecs;
         unsigned int max_irq_nvecs;
         unsigned int min_irq_nvecs;
diff --git a/drivers/net/ethernet/realtek/r8126/r8126_n.c b/drivers/net/ethernet/realtek/r8126/r8126_n.c
--- a/drivers/net/ethernet/realtek/r8126/r8126_n.c
+++ b/drivers/net/ethernet/realtek/r8126/r8126_n.c
@@ -71,6 +71,10 @@
 #else
 #include <linux/dma-mapping.h>
 #include <linux/moduleparam.h>
+#include <linux/slab.h>
+#ifdef CONFIG_ARM64
+#include <linux/arch_topology.h>
+#endif
 #endif
 
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(2,6,31)
@@ -13991,6 +13995,10 @@ static void rtl8126_free_irq(struct rtl8126_private *tp)
                 struct r8126_napi *r8126napi = &tp->r8126napi[i];
 
                 if (irq->requested) {
+#ifdef CONFIG_ARM64
+                        if (tp->performance_core_mask)
+                                irq_update_affinity_hint(irq->vector, NULL);
+#endif
                         irq->requested = 0;
 #if defined(RTL_USE_NEW_INTR_API)
                         pci_free_irq(tp->pci_dev, i, r8126napi);
@@ -13999,7 +14007,36 @@ static void rtl8126_free_irq(struct rtl8126_private *tp)
 #endif
                 }
         }
+#ifdef CONFIG_ARM64
+        kfree(tp->performance_core_mask);
+        tp->performance_core_mask = NULL;
+#endif
+}
+
+#ifdef CONFIG_ARM64
+#define RTL8126_LITTLE_CORE_CAPACITY 512
+
+static struct cpumask *rtl8126_alloc_performance_core_mask(void)
+{
+        struct cpumask *mask;
+        int cpu;
+
+        mask = kzalloc(cpumask_size(), GFP_KERNEL);
+        if (!mask)
+                return NULL;
+
+        for_each_online_cpu(cpu) {
+                if (topology_get_cpu_scale(cpu) >= RTL8126_LITTLE_CORE_CAPACITY)
+                        cpumask_set_cpu(cpu, mask);
+        }
+
+        if (!cpumask_empty(mask))
+                return mask;
+
+        kfree(mask);
+        return NULL;
 }
+#endif
 
 static int rtl8126_alloc_irq(struct rtl8126_private *tp)
 {
@@ -14009,6 +14046,9 @@ static int rtl8126_alloc_irq(struct rtl8126_private *tp)
         struct r8126_napi *r8126napi;
         int i = 0;
         const int len = sizeof(tp->irq_tbl[0].name);
+#ifdef CONFIG_ARM64
+        tp->performance_core_mask = rtl8126_alloc_performance_core_mask();
+#endif
 #if defined(RTL_USE_NEW_INTR_API)
         for (i=0; i<tp->irq_nvecs; i++) {
                 irq = &tp->irq_tbl[i];
@@ -14027,6 +14067,18 @@ static int rtl8126_alloc_irq(struct rtl8126_private *tp)
 
                 irq->vector = pci_irq_vector(tp->pci_dev, i);
                 irq->requested = 1;
+#ifdef CONFIG_ARM64
+                if (tp->performance_core_mask) {
+                        int affinity_rc;
+
+                        affinity_rc = irq_set_affinity_and_hint(
+                                irq->vector, tp->performance_core_mask);
+                        if (affinity_rc)
+                                netdev_warn(dev,
+                                            "failed to prefer performance cores for IRQ %u: %d\n",
+                                            irq->vector, affinity_rc);
+                }
+#endif
         }
 #else
         unsigned long irq_flags = 0;
