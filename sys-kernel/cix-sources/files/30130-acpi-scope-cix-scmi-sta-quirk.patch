ACPI: apply the CIX SCMI status quirk only without firmware policy

Evaluate _STA before using it as input to the legacy CIX override. Only
unhide the known zero-status SCMI children when firmware does not expose
SCMS in the controller's enclosing scope. Radxa Orion firmware uses SCMS
to control DVFS and clock protocol visibility, so a zero _STA on these
systems can be an intentional UEFI setting.

diff --git a/drivers/acpi/bus.c b/drivers/acpi/bus.c
--- a/drivers/acpi/bus.c
+++ b/drivers/acpi/bus.c
@@ -102,11 +102,6 @@ int acpi_bus_get_status(struct acpi_device *device)
 		return 0;
 	}
 
-	if (acpi_sta_override_firmware_quirk(device, &sta)) {
-		acpi_set_device_status(device, sta);
-		return 0;
-	}
-
 	/* Battery devices must have their deps met before calling _STA */
 	if (acpi_device_is_battery(device) && device->dep_unmet) {
 		acpi_set_device_status(device, 0);
@@ -117,6 +112,11 @@ int acpi_bus_get_status(struct acpi_device *device)
 	if (ACPI_FAILURE(status))
 		return -ENODEV;
 
+	if (acpi_sta_override_firmware_quirk(device, &sta)) {
+		acpi_set_device_status(device, sta);
+		return 0;
+	}
+
 	if (!device->status.present && device->status.enabled) {
 		pr_info(FW_BUG "Device [%s] status [%08x]: not present and enabled\n",
 			device->pnp.bus_id, (u32)sta);
diff --git a/drivers/acpi/sta_quirk.c b/drivers/acpi/sta_quirk.c
--- a/drivers/acpi/sta_quirk.c
+++ b/drivers/acpi/sta_quirk.c
@@ -25,12 +25,26 @@ static const struct acpi_device_id cix_scmi_proto_sta_ids[] = {
 bool acpi_sta_override_firmware_quirk(struct acpi_device *adev,
 				       unsigned long long *status)
 {
+	struct acpi_device *parent;
+	acpi_handle scms;
+
 	if (acpi_match_device_ids(adev, cix_scmi_proto_sta_ids))
 		return false;
 
+	parent = acpi_dev_parent(adev);
+	if (!parent || !acpi_dev_hid_uid_match(parent, "CIXHA006", NULL))
+		return false;
+
 	if (!acpi_dev_uid_match(adev, 0))
 		return false;
 
+	if (*status != 0)
+		return false;
+
+	/* SCMS is the firmware policy object in the scope containing SCMI. */
+	if (acpi_get_handle(parent->handle, "^SCMS", &scms) != AE_NOT_FOUND)
+		return false;
+
 	*status = ACPI_STA_DEFAULT;
 	return true;
 }
