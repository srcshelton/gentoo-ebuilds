new file mode 100644
--- /dev/null
+++ b/drivers/media/platform/cix/armcb-isp/isp/armcb_v4l2_buffer.h
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __ARMCB_V4L2_BUFFER_H__
+#define __ARMCB_V4L2_BUFFER_H__
+
+#include <linux/types.h>
+
+enum armcb_v4l2_buffer_action {
+	ARMCB_BUFFER_DISCARD_ONLY,
+	ARMCB_BUFFER_RETAIN_AND_DISCARD,
+	ARMCB_BUFFER_COMPLETE,
+	ARMCB_BUFFER_COMPLETE_AND_DISCARD,
+};
+
+/*
+ * SOL programs the newest busy buffer before the preceding frame-done event
+ * is handled. Retain a newly observed singleton for one completion cycle;
+ * complete an older head immediately when a newer tail is already armed.
+ */
+static inline enum armcb_v4l2_buffer_action
+armcb_v4l2_buffer_action(bool empty, bool singular, bool pending_matches)
+{
+	if (empty)
+		return ARMCB_BUFFER_DISCARD_ONLY;
+	if (!singular)
+		return ARMCB_BUFFER_COMPLETE;
+	if (!pending_matches)
+		return ARMCB_BUFFER_RETAIN_AND_DISCARD;
+	return ARMCB_BUFFER_COMPLETE_AND_DISCARD;
+}
+
+#endif
diff --git a/drivers/media/platform/cix/armcb-isp/isp/armcb_v4l2_buffer_test.c b/drivers/media/platform/cix/armcb-isp/isp/armcb_v4l2_buffer_test.c
new file mode 100644
--- /dev/null
+++ b/drivers/media/platform/cix/armcb-isp/isp/armcb_v4l2_buffer_test.c
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <kunit/test.h>
+#include <linux/module.h>
+
+#include "armcb_v4l2_buffer.h"
+
+static void armcb_empty_uses_discard(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test,
+		armcb_v4l2_buffer_action(true, false, false),
+		ARMCB_BUFFER_DISCARD_ONLY);
+}
+
+static void armcb_new_singleton_is_retained(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test,
+		armcb_v4l2_buffer_action(false, true, false),
+		ARMCB_BUFFER_RETAIN_AND_DISCARD);
+}
+
+static void armcb_retained_singleton_completes_after_discard(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test,
+		armcb_v4l2_buffer_action(false, true, true),
+		ARMCB_BUFFER_COMPLETE_AND_DISCARD);
+}
+
+static void armcb_older_head_completes_with_new_tail(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test,
+		armcb_v4l2_buffer_action(false, false, false),
+		ARMCB_BUFFER_COMPLETE);
+	KUNIT_EXPECT_EQ(test,
+		armcb_v4l2_buffer_action(false, false, true),
+		ARMCB_BUFFER_COMPLETE);
+}
+
+static struct kunit_case armcb_v4l2_buffer_cases[] = {
+	KUNIT_CASE(armcb_empty_uses_discard),
+	KUNIT_CASE(armcb_new_singleton_is_retained),
+	KUNIT_CASE(armcb_retained_singleton_completes_after_discard),
+	KUNIT_CASE(armcb_older_head_completes_with_new_tail),
+	{}
+};
+
+static struct kunit_suite armcb_v4l2_buffer_suite = {
+	.name = "armcb-v4l2-buffer",
+	.test_cases = armcb_v4l2_buffer_cases,
+};
+
+kunit_test_suite(armcb_v4l2_buffer_suite);
+
+MODULE_LICENSE("GPL");
