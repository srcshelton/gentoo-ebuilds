+static int sky1_pinctrl_probe_acpi(struct platform_device *pdev,
+				   struct sky1_pinctrl *spctl)
+{
+	struct pinctrl_acpi_group_desc *acpi_grp, *temp;
+	struct list_head groups;
+	struct acpi_device *acpi_dev = ACPI_COMPANION(&pdev->dev);
+	const char **group_names;
+	struct pinctrl_dev *pctl = spctl->pctl;
+	unsigned int num_groups = 0;
+	unsigned int index = 0;
+	int ret;
+
+	if (!acpi_dev)
+		return -ENODEV;
+
+	INIT_LIST_HEAD(&groups);
+	ret = pinctrl_acpi_get_pin_groups(acpi_dev, &groups);
+	if (ret)
+		return ret;
+
+	list_for_each_entry(acpi_grp, &groups, list) {
+		if (!acpi_grp->name || !*acpi_grp->name) {
+			dev_err(&pdev->dev, "unnamed ACPI pin group\n");
+			ret = -EINVAL;
+			goto out_free_groups;
+		}
+		if (!sky1_acpi_group_name_is_unique(&groups, acpi_grp)) {
+			dev_err(&pdev->dev, "duplicate ACPI pin group %s\n",
+				acpi_grp->name);
+			ret = -EINVAL;
+			goto out_free_groups;
+		}
+		num_groups++;
+		if (sky1_acpi_missing_alias(&groups, acpi_grp->name))
+			num_groups++;
+	}
+
+	if (!num_groups) {
+		dev_err(&pdev->dev, "no pin groups found in ACPI resources\n");
+		return -EINVAL;
+	}
+
+	group_names = devm_kcalloc(spctl->dev, num_groups,
+				   sizeof(*group_names), GFP_KERNEL);
+	if (!group_names) {
+		ret = -ENOMEM;
+		goto out_free_groups;
+	}
+
+	list_for_each_entry(acpi_grp, &groups, list) {
+		const char *compat_alias;
+
+		group_names[index] = devm_kstrdup(spctl->dev, acpi_grp->name,
+						  GFP_KERNEL);
+		if (!group_names[index++]) {
+			ret = -ENOMEM;
+			goto out_free_groups;
+		}
+		compat_alias = sky1_acpi_missing_alias(&groups, acpi_grp->name);
+		if (compat_alias) {
+			group_names[index] = devm_kstrdup(spctl->dev, compat_alias,
+							  GFP_KERNEL);
+			if (!group_names[index++]) {
+				ret = -ENOMEM;
+				goto out_free_groups;
+			}
+		}
+	}
+
+	list_for_each_entry(acpi_grp, &groups, list) {
+		const char *compat_alias;
+
+		compat_alias = sky1_acpi_missing_alias(&groups, acpi_grp->name);
+		ret = sky1_pinctrl_parse_groups_acpi(acpi_grp, spctl, compat_alias);
+		if (ret)
+			goto out_free_groups;
+	}
+
+	list_for_each_entry_safe(acpi_grp, temp, &groups, list) {
+		list_del(&acpi_grp->list);
+		sky1_free_acpi_group_desc(acpi_grp);
+	}
+
+	ret = pinmux_generic_add_function(pctl, dev_name(&pdev->dev),
+					  group_names, num_groups, NULL);
+	return ret < 0 ? ret : 0;
+
+out_free_groups:
+	list_for_each_entry_safe(acpi_grp, temp, &groups, list) {
+		list_del(&acpi_grp->list);
+		sky1_free_acpi_group_desc(acpi_grp);
+	}
+	return ret;
+}
