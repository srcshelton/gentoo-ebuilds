+bool panthor_is_cix_sky1(struct panthor_device *ptdev)
+{
+	struct device *dev = ptdev->base.dev;
+
+	if (has_acpi_companion(dev))
+		return acpi_dev_hid_uid_match(ACPI_COMPANION(dev),
+						"CIXH5000", NULL);
+
+	return of_device_is_compatible(dev->of_node, "arm,mali-valhall") &&
+	       of_machine_is_compatible("cix,sky1");
+}
+
+static int panthor_sky1_acpi_power_on(struct panthor_device *ptdev)
+{
+#if IS_ENABLED(CONFIG_ACPI)
+	static const char * const supply_properties[] = {
+		"mali-supply",
+		"power-supply",
+	};
+	struct device *dev = ptdev->base.dev;
+	struct fwnode_reference_args args;
+	struct acpi_device *supply;
+	unsigned int i;
+	int ret;
+
+	if (!panthor_is_cix_sky1(ptdev) ||
+	    !has_acpi_companion(dev))
+		return 0;
+
+	for (i = 0; i < ARRAY_SIZE(supply_properties); i++) {
+		ret = fwnode_property_get_reference_args(dev_fwnode(dev),
+							 supply_properties[i], NULL, 0, 0,
+							 &args);
+		if (!ret)
+			break;
+		if (ret != -ENOENT)
+			return dev_err_probe(dev, ret,
+				"invalid Sky1 GPU %s reference\n",
+				supply_properties[i]);
+	}
+	if (i == ARRAY_SIZE(supply_properties))
+		return dev_err_probe(dev, -ENODEV,
+				     "Sky1 GPU ACPI power resource is missing\n");
+
+	if (!is_acpi_device_node(args.fwnode)) {
+		fwnode_handle_put(args.fwnode);
+		return dev_err_probe(dev, -EINVAL,
+				     "Sky1 GPU power resource is not an ACPI device\n");
+	}
+
+	supply = to_acpi_device_node(args.fwnode);
+	ret = acpi_device_set_power(supply, ACPI_STATE_D0);
+	fwnode_handle_put(args.fwnode);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "failed to enable Sky1 GPU ACPI power resource\n");
+#endif
+	return 0;
+}
+
+static int panthor_sky1_hw_prepare(struct panthor_device *ptdev)
+{
+	u32 pgctrl;
+	int ret;
+
+	if (!panthor_is_cix_sky1(ptdev))
+		return 0;
+
+	if (ptdev->gpu_reset) {
+		ret = reset_control_assert(ptdev->gpu_reset);
+		if (ret)
+			return dev_err_probe(ptdev->base.dev, ret,
+					     "failed to assert Sky1 GPU reset\n");
+
+		usleep_range(10, 20);
+
+		ret = reset_control_deassert(ptdev->gpu_reset);
+		if (ret)
+			return dev_err_probe(ptdev->base.dev, ret,
+					     "failed to deassert Sky1 GPU reset\n");
+	}
+
+	pgctrl = readl(ptdev->sky1_rcsu_reg + 0x218);
+	writel(pgctrl | BIT(0), ptdev->sky1_rcsu_reg + 0x218);
+
+	return 0;
+}
