+struct panthor_devfreq_cleanup {
+	struct device *dev;
+	struct device *opp_dev;
+	struct device_link *link;
+	unsigned long *added_freqs;
+	unsigned int num_added;
+	bool detach_opp_dev;
+};
+
+static void panthor_devfreq_remove_opps(struct panthor_devfreq_cleanup *cleanup)
+{
+	while (cleanup->num_added)
+		dev_pm_opp_remove(cleanup->dev,
+				  cleanup->added_freqs[--cleanup->num_added]);
+}
+
+static void panthor_devfreq_cleanup(void *data)
+{
+	struct panthor_devfreq_cleanup *cleanup = data;
+
+	panthor_devfreq_remove_opps(cleanup);
+	if (cleanup->link)
+		device_link_del(cleanup->link);
+	if (cleanup->detach_opp_dev)
+		dev_pm_domain_detach(cleanup->opp_dev, true);
+}
+
+static int panthor_devfreq_set_rate(struct panthor_devfreq *pdevfreq,
+				    struct device *dev, unsigned long freq)
+{
+	struct dev_pm_opp *opp;
+	int ret;
+
+	if (!pdevfreq->opp_dev)
+		return dev_pm_opp_set_rate(dev, freq);
+
+	opp = dev_pm_opp_find_freq_ceil(pdevfreq->opp_dev, &freq);
+	if (IS_ERR(opp))
+		return PTR_ERR(opp);
+
+	ret = dev_pm_opp_set_opp(pdevfreq->opp_dev, opp);
+	dev_pm_opp_put(opp);
+
+	return ret;
+}
+
+static int panthor_devfreq_scmi_init(struct panthor_device *ptdev,
+				     struct panthor_devfreq *pdevfreq)
+{
+	struct panthor_devfreq_cleanup *cleanup;
+	struct device *dev = ptdev->base.dev;
+	struct device *opp_dev = NULL;
+	struct dev_pm_opp *opp;
+	unsigned long freq;
+	int count, i, index, ret;
+	u32 link_flags = DL_FLAG_PM_RUNTIME | DL_FLAG_STATELESS |
+			 DL_FLAG_RPM_ACTIVE;
+	bool attached = false;
+
+	if (!panthor_is_cix_sky1(ptdev))
+		return 0;
+
+	index = fwnode_property_match_string(dev_fwnode(dev),
+					     "power-domain-names", "perf");
+	if (index < 0)
+		return 0;
+
+	if (ptdev->pm_domain_list && index < ptdev->pm_domain_list->num_pds) {
+		opp_dev = ptdev->pm_domain_list->pd_devs[index];
+	} else if (dev_pm_opp_get_opp_count(dev) > 0) {
+		opp_dev = dev;
+	} else {
+		opp_dev = dev_pm_domain_attach_by_name(dev, "perf");
+		if (IS_ERR(opp_dev))
+			return PTR_ERR(opp_dev);
+		if (!opp_dev)
+			return -EPROBE_DEFER;
+		attached = true;
+	}
+
+	if (!opp_dev)
+		return -EPROBE_DEFER;
+
+	count = dev_pm_opp_get_opp_count(opp_dev);
+	if (count <= 0) {
+		ret = count < 0 ? count : -EPROBE_DEFER;
+		goto err_detach;
+	}
+
+	cleanup = devm_kzalloc(dev, sizeof(*cleanup), GFP_KERNEL);
+	if (!cleanup) {
+		ret = -ENOMEM;
+		goto err_detach;
+	}
+	cleanup->dev = dev;
+	cleanup->opp_dev = opp_dev;
+	cleanup->detach_opp_dev = attached;
+
+	if (attached) {
+		cleanup->link = device_link_add(dev, opp_dev, link_flags);
+		if (!cleanup->link) {
+			ret = -ENODEV;
+			goto err_detach;
+		}
+	}
+
+	if (opp_dev != dev) {
+		cleanup->added_freqs =
+			devm_kcalloc(dev, count, sizeof(*cleanup->added_freqs),
+				     GFP_KERNEL);
+		if (!cleanup->added_freqs) {
+			ret = -ENOMEM;
+			goto err_remove_opps;
+		}
+
+		for (i = 0, freq = 0; i < count; i++) {
+			opp = dev_pm_opp_find_freq_ceil(opp_dev, &freq);
+			if (IS_ERR(opp)) {
+				ret = PTR_ERR(opp);
+				goto err_remove_opps;
+			}
+			dev_pm_opp_put(opp);
+
+			ret = dev_pm_opp_add(dev, freq, 0);
+			if (ret && ret != -EEXIST)
+				goto err_remove_opps;
+			if (!ret)
+				cleanup->added_freqs[cleanup->num_added++] = freq;
+
+			if (i != count - 1) {
+				if (freq == ULONG_MAX) {
+					ret = -EOVERFLOW;
+					goto err_remove_opps;
+				}
+				freq++;
+			}
+		}
+		if (!cleanup->num_added && dev_pm_opp_get_opp_count(dev) <= 0) {
+			ret = -ENODEV;
+			goto err_remove_opps;
+		}
+	}
+
+	ret = devm_add_action_or_reset(dev, panthor_devfreq_cleanup, cleanup);
+	if (ret)
+		return ret;
+
+	pdevfreq->opp_dev = opp_dev;
+	return dev_pm_opp_get_opp_count(dev);
+
+err_remove_opps:
+	panthor_devfreq_remove_opps(cleanup);
+	if (cleanup->link)
+		device_link_del(cleanup->link);
+err_detach:
+	if (attached)
+		dev_pm_domain_detach(opp_dev, true);
+	return ret;
+}
