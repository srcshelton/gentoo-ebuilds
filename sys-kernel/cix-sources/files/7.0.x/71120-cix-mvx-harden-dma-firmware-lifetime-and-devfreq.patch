+                  ret);
 
 put_kobject:
     kobject_put(&smem->kobj);
 
+    if (IS_ERR(dmabuf)) {
+        if (ret < 0)
+            return ERR_PTR(ret);
+        if (ret == 0)
+            return ERR_PTR(-ETIMEDOUT);
+    }
+
     return dmabuf;
 }
