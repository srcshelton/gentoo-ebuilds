+/**
+ * __genpd_dev_pm_attach_acpi - ACPI variant of __genpd_dev_pm_attach
+ * @dev: Device to attach to the power domain
+ * @base_dev: Device whose firmware node contains the power-domain reference
+ * @index: Power-domain reference index
+ * @power_on: Whether to power on the domain after attaching
+ *
+ * Uses fwnode_property_get_reference_args() on the base device's "power-domains"
+ * property to resolve the PM domain provider and index, then attaches @dev to
+ * the corresponding generic PM domain.  Mirrors the OF path but works with
+ * ACPI _DSD references and fwnode-based providers.
+ */
+static int __genpd_dev_pm_attach_acpi(struct device *dev,
+				      struct device *base_dev,
+				      unsigned int index,
+				      bool power_on)
+{
+	struct fwnode_reference_args pd_args = {};
+	struct generic_pm_domain *pd;
+	int ret;
+
+	ret = genpd_get_acpi_power_domain_args(base_dev, index, &pd_args);
+	if (ret < 0)
+		return ret;
+
+	mutex_lock(&gpd_list_lock);
+	pd = genpd_get_from_fwnode_provider(pd_args.fwnode, pd_args.args[0]);
+	fwnode_handle_put(pd_args.fwnode);
+	if (IS_ERR(pd)) {
+		ret = PTR_ERR(pd);
+		mutex_unlock(&gpd_list_lock);
+		dev_dbg(dev, "%s() failed to find PM domain: %ld\n",
+			__func__, PTR_ERR(pd));
+		if (ret == -ENOENT)
+			return driver_deferred_probe_check_state(base_dev);
+		return ret;
+	}
+
+	dev_dbg(dev, "adding to PM domain %s\n", pd->name);
+
+	ret = genpd_add_device(pd, dev, base_dev);
+	mutex_unlock(&gpd_list_lock);
+
+	if (ret < 0)
+		return dev_err_probe(dev, ret,
+			"failed to add to PM domain %s\n", pd->name);
+
+	dev->pm_domain->detach = genpd_dev_pm_detach;
+	dev->pm_domain->sync = genpd_dev_pm_sync;
+
+	if (power_on) {
+		genpd_lock(pd);
+		ret = genpd_power_on(pd, 0);
+		genpd_unlock(pd);
+	}
+
+	if (ret) {
+		if (dev_gpd_data(dev)->default_pstate) {
+			dev_pm_genpd_set_performance_state(dev, 0);
+			dev_gpd_data(dev)->default_pstate = 0;
+		}
+
+		genpd_remove_device(pd, dev);
+		return -EPROBE_DEFER;
+	}
+
+	return 1;
+}
