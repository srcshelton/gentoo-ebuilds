+static int genpd_get_acpi_power_domain_args(struct device *dev,
+					    unsigned int index,
+					    struct fwnode_reference_args *args)
+{
+	struct fwnode_reference_args onecell_args = {};
+	struct fwnode_handle *fwnode = dev_fwnode(dev);
+	int ret;
+
+	if (!is_acpi_device_node(fwnode))
+		return -ENOENT;
+
+	/*
+	 * Prefer the provider-advertised cell count when present. Some ACPI
+	 * firmware, including Sky1's SCMI DVFS node, omits the DT-style
+	 * #power-domain-cells property but still encodes a onecell reference as
+	 * Package () { REF, INT }; retry explicitly in that form when the first
+	 * parse found a provider but no arguments.
+	 */
+	ret = fwnode_property_get_reference_args(fwnode, "power-domains",
+						 "#power-domain-cells", 0,
+						 index, args);
+	if (ret)
+		return ret;
+
+	if (args->nargs == 1)
+		return 0;
+
+	if (args->nargs) {
+		fwnode_handle_put(args->fwnode);
+		return -EINVAL;
+	}
+
+	ret = fwnode_property_get_reference_args(fwnode, "power-domains", NULL,
+						 1, index, &onecell_args);
+	fwnode_handle_put(args->fwnode);
+	if (ret)
+		return ret;
+
+	if (onecell_args.nargs != 1) {
+		fwnode_handle_put(onecell_args.fwnode);
+		return -EINVAL;
+	}
+
+	*args = onecell_args;
+
+	return 0;
+}
+
+static int genpd_count_acpi_power_domains(struct device *dev)
+{
+	struct fwnode_reference_args args = {};
+	int count = 0;
+	int ret;
+
+	for (;;) {
+		ret = genpd_get_acpi_power_domain_args(dev, count, &args);
+		if (ret == -ENOENT)
+			return count;
+		if (ret)
+			return ret;
+
+		fwnode_handle_put(args.fwnode);
+		count++;
+	}
+}
