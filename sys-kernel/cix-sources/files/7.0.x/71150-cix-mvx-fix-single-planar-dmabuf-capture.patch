+#include <linux/dma-buf.h>
 #include <linux/sched.h>
+#include <linux/string.h>
 #include <linux/version.h>
 #include <media/v4l2-ctrls.h>
 #include <media/v4l2-event.h>
@@ -586,11 +588,66 @@ static void buf_finish(struct vb2_buffer *vb)
 {
     struct mvx_v4l2_port *vport = vb2_get_drv_priv(vb->vb2_queue);
     struct mvx_v4l2_buffer *vbuf = vb2_to_mvx_v4l2_buffer(vb);
+    struct vb2_v4l2_buffer *v4l2_buf = to_vb2_v4l2_buffer(vb);
+    struct dma_buf *dbuf = vb->planes[0].dbuf;
+    unsigned int bytesused = vb->planes[0].bytesused;
+    unsigned int length = vb->planes[0].length;
+    unsigned int offset = vb->planes[0].data_offset;
+    int end_ret;
+    int ret;
+    void *vaddr;
 
     if (vbuf->buf.planes[0].filled > 0) {
         vport->afbc_crop_left = vbuf->buf.crop_left;
         vport->afbc_crop_top = vbuf->buf.crop_top;
     }
+
+    /*
+     * A single-planar DMABUF descriptor has no data_offset field. The MVX
+     * firmware may nevertheless return a bitstream at a non-zero offset.
+     * Preserve the userspace-visible file descriptor by moving that payload
+     * to the start of the buffer. Imported DMA-BUF cache maintenance belongs
+     * to the exporter, so bracket both the read and write with its CPU-access
+     * callbacks instead of relying on vb2's deliberately skipped memops.
+     */
+    if (V4L2_TYPE_IS_OUTPUT(vb->type) ||
+        V4L2_TYPE_IS_MULTIPLANAR(vb->type) ||
+        vb->memory != VB2_MEMORY_DMABUF || offset == 0)
+        return;
+
+    if (!dbuf || bytesused < offset || bytesused > length)
+        goto invalid_payload;
+
+    ret = dma_buf_begin_cpu_access(dbuf, DMA_BIDIRECTIONAL);
+    if (ret)
+        goto invalid_payload;
+
+    vaddr = vb2_plane_vaddr(vb, 0);
+    if (!vaddr) {
+        ret = -ENOMEM;
+        goto end_cpu_access;
+    }
+
+    memmove(vaddr, vaddr + offset, bytesused - offset);
+
+end_cpu_access:
+    end_ret = dma_buf_end_cpu_access(dbuf, DMA_BIDIRECTIONAL);
+    if (!ret)
+        ret = end_ret;
+    if (ret)
+        goto invalid_payload;
+
+    vb->planes[0].bytesused = bytesused - offset;
+    vb->planes[0].data_offset = 0;
+    return;
+
+invalid_payload:
+    MVX_SESSION_WARN(&vport->vsession->session,
+                     "Cannot represent single-planar DMABUF payload: offset=%u, bytesused=%u, length=%u.",
+                     offset, bytesused, length);
+    v4l2_buf->flags |= V4L2_BUF_FLAG_ERROR;
+    vb->planes[0].bytesused = 0;
+    vb->planes[0].data_offset = 0;
 }
 
