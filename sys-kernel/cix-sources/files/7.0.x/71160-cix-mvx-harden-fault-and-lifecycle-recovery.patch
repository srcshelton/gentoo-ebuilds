diff --git a/drivers/media/platform/cix/if/mvx_buffer_test.c b/drivers/media/platform/cix/if/mvx_buffer_test.c
new file mode 100644
--- /dev/null
+++ b/drivers/media/platform/cix/if/mvx_buffer_test.c
@@ -0,0 +1,48 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include <kunit/test.h>
+#include <linux/module.h>
+
+#include "mvx_buffer.h"
+
+static void mvx_buffer_filled_bounds_test(struct kunit *test)
+{
+	struct mvx_mmu_pages *pages;
+	struct mvx_buffer buf = { 0 };
+	size_t size;
+
+	pages = kunit_kzalloc(test, struct_size(pages, pages, 1), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, pages);
+	pages->count = 2;
+	buf.nplanes = 1;
+	buf.planes[0].pages = pages;
+	size = mvx_buffer_size(&buf, 0);
+
+	KUNIT_EXPECT_EQ(test, mvx_buffer_filled_set(&buf, 0, size, 0), 0);
+	KUNIT_EXPECT_EQ(test, mvx_buffer_filled_set(&buf, 0, 0, size), 0);
+	KUNIT_EXPECT_EQ(test, mvx_buffer_filled_set(&buf, 0, 1, size),
+			-EAGAIN);
+	KUNIT_EXPECT_TRUE(test, buf.flags & MVX_BUFFER_FRAME_NEED_REALLOC);
+
+	buf.flags = 0;
+	KUNIT_EXPECT_EQ(test,
+			mvx_buffer_filled_set(&buf, 0, UINT_MAX, 1), -EAGAIN);
+	KUNIT_EXPECT_TRUE(test, buf.flags & MVX_BUFFER_FRAME_NEED_REALLOC);
+	KUNIT_EXPECT_EQ(test, mvx_buffer_filled_set(&buf, 1, 0, 0), -EINVAL);
+	KUNIT_EXPECT_EQ(test, mvx_buffer_size(&buf, 1), (size_t)0);
+	KUNIT_EXPECT_EQ(test, mvx_buffer_va(&buf, 1), (mvx_mmu_va)0);
+}
+
+static struct kunit_case mvx_buffer_test_cases[] = {
+	KUNIT_CASE(mvx_buffer_filled_bounds_test),
+	{}
+};
+
+static struct kunit_suite mvx_buffer_test_suite = {
+	.name = "cix-mvx-buffer",
+	.test_cases = mvx_buffer_test_cases,
+};
+
+kunit_test_suite(mvx_buffer_test_suite);
+
+MODULE_LICENSE("GPL");
