+# SPDX-License-Identifier: GPL-2.0-only
+
+config CIX_ACPI_RESOURCE_LOOKUP
+	bool "CIX ACPI resource lookup driver"
+	depends on ARCH_CIX || COMPILE_TEST
+	depends on ACPI
+	depends on RESET_CONTROLLER
+	default ARCH_CIX
+	help
+	  Translate the CIX RSTL, RSNL, DLKL, CLKT and CLKA ACPI tables into
+	  reset lookups, named platform resources and persistent device links.
+	  This is an early, built-in compatibility bridge for CIX firmware;
+	  it is not intended to be built as a module.
+
+	  Required for CIX Sky1 ACPI boot with drivers that use
+	  platform_get_resource_byname(), devm_reset_control_get() or
+	  firmware clock mappings.
