+#ifdef CONFIG_PM_SLEEP
+static void cdns_gpio_save_regs(struct cdns_gpio_chip *cgpio)
+{
+	struct cdns_gpio_saved_regs *saved = &cgpio->saved_regs;
+	u32 valid = cgpio->valid_mask;
+
+	saved->bypass_mode =
+		ioread32(cgpio->regs + CDNS_GPIO_BYPASS_MODE) & valid;
+	saved->direction_mode =
+		ioread32(cgpio->regs + CDNS_GPIO_DIRECTION_MODE) & valid;
+	saved->output_en =
+		ioread32(cgpio->regs + CDNS_GPIO_OUTPUT_EN) & valid;
+	saved->output_value =
+		ioread32(cgpio->regs + CDNS_GPIO_OUTPUT_VALUE) & valid;
+	saved->irq_mask = ioread32(cgpio->regs + CDNS_GPIO_IRQ_MASK) & valid;
+	saved->irq_type = ioread32(cgpio->regs + CDNS_GPIO_IRQ_TYPE) & valid;
+	saved->irq_value = ioread32(cgpio->regs + CDNS_GPIO_IRQ_VALUE) & valid;
+	saved->irq_any_edge =
+		ioread32(cgpio->regs + CDNS_GPIO_IRQ_ANY_EDGE) & valid;
+}
+
+static void cdns_gpio_restore_irq_mask(struct cdns_gpio_chip *cgpio, u32 mask)
+{
+	iowrite32(cgpio->valid_mask, cgpio->regs + CDNS_GPIO_IRQ_DIS);
+	iowrite32(cgpio->valid_mask & ~mask, cgpio->regs + CDNS_GPIO_IRQ_EN);
+}
+
+static void cdns_gpio_restore_regs(struct cdns_gpio_chip *cgpio)
+{
+	struct cdns_gpio_saved_regs *saved = &cgpio->saved_regs;
+
+	iowrite32(cgpio->valid_mask, cgpio->regs + CDNS_GPIO_IRQ_DIS);
+
+	cdns_gpio_write_valid(cgpio, CDNS_GPIO_OUTPUT_VALUE,
+			      saved->output_value);
+	cdns_gpio_write_valid(cgpio, CDNS_GPIO_OUTPUT_EN, saved->output_en);
+	cdns_gpio_write_valid(cgpio, CDNS_GPIO_DIRECTION_MODE,
+			      saved->direction_mode);
+	cdns_gpio_write_valid(cgpio, CDNS_GPIO_BYPASS_MODE,
+			      saved->bypass_mode);
+	cdns_gpio_write_valid(cgpio, CDNS_GPIO_IRQ_TYPE, saved->irq_type);
+	cdns_gpio_write_valid(cgpio, CDNS_GPIO_IRQ_VALUE, saved->irq_value);
+	cdns_gpio_write_valid(cgpio, CDNS_GPIO_IRQ_ANY_EDGE,
+			      saved->irq_any_edge);
+
+	cdns_gpio_restore_irq_mask(cgpio, saved->irq_mask);
+}
+
+static int cdns_gpio_suspend_late(struct device *dev)
+{
+	struct cdns_gpio_chip *cgpio = dev_get_drvdata(dev);
+
+	if (!cgpio->quirks->cix_sky1 || !cgpio->has_irq ||
+	    pm_suspend_target_state == PM_SUSPEND_TO_IDLE)
+		return 0;
+
+	disable_irq(cgpio->parent_irq);
+	cgpio->parent_disabled = true;
+
+	return 0;
+}
+
+static int cdns_gpio_resume_early(struct device *dev)
+{
+	struct cdns_gpio_chip *cgpio = dev_get_drvdata(dev);
+
+	if (cgpio->parent_disabled && !cgpio->context_saved) {
+		enable_irq(cgpio->parent_irq);
+		cgpio->parent_disabled = false;
+	}
+
+	return 0;
+}
+
+static int cdns_gpio_suspend_noirq(struct device *dev)
+{
+	struct cdns_gpio_chip *cgpio = dev_get_drvdata(dev);
+	unsigned long flags;
+	u32 wake_mask;
+	int ret = 0;
+
+	if (!cgpio->quirks->cix_sky1 ||
+	    pm_suspend_target_state == PM_SUSPEND_TO_IDLE)
+		return 0;
+
+	cdns_gpio_save_regs(cgpio);
+
+	raw_spin_lock_irqsave(&cgpio->wake_lock, flags);
+	wake_mask = cgpio->wake_active & cgpio->valid_mask;
+	iowrite32(cgpio->valid_mask & ~wake_mask,
+		  cgpio->regs + CDNS_GPIO_IRQ_DIS);
+
+	if (!cgpio->has_sky1_pdc && wake_mask) {
+		ret = -EOPNOTSUPP;
+	} else if (cgpio->has_sky1_pdc) {
+		ret = cdns_gpio_set_pdc_wake(cgpio, true, wake_mask);
+		if (!ret)
+			cgpio->pdc_armed = true;
+	}
+
+	if (ret)
+		cdns_gpio_restore_irq_mask(cgpio, cgpio->saved_regs.irq_mask);
+	raw_spin_unlock_irqrestore(&cgpio->wake_lock, flags);
+
+	if (ret) {
+		if (cgpio->parent_disabled) {
+			enable_irq(cgpio->parent_irq);
+			cgpio->parent_disabled = false;
+		}
+		dev_err(dev, "failed to program Sky1 GPIO wake: %d\n", ret);
+		return ret;
+	}
+
+	cgpio->context_saved = true;
+
+	return 0;
+}
+
+static int cdns_gpio_resume_noirq(struct device *dev)
+{
+	struct cdns_gpio_chip *cgpio = dev_get_drvdata(dev);
+	unsigned long flags;
+	int ret;
+
+	if (!cgpio->context_saved)
+		return 0;
+
+	cdns_gpio_restore_regs(cgpio);
+
+	raw_spin_lock_irqsave(&cgpio->wake_lock, flags);
+	if (cgpio->pdc_armed) {
+		ret = cdns_gpio_clear_pdc_wake(cgpio);
+		if (!ret)
+			cgpio->pdc_armed = false;
+	} else {
+		ret = 0;
+	}
+	raw_spin_unlock_irqrestore(&cgpio->wake_lock, flags);
+
+	cgpio->context_saved = false;
+	if (cgpio->parent_disabled) {
+		enable_irq(cgpio->parent_irq);
+		cgpio->parent_disabled = false;
+	}
+
+	if (ret)
+		dev_err(dev, "failed to clear Sky1 GPIO wake: %d\n", ret);
+
+	return ret;
+}
+
+static const struct dev_pm_ops cdns_gpio_pm_ops = {
