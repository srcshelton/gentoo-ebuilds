+static void cdns_gpio_restore_initial_state(void *data)
+{
+	struct cdns_gpio_chip *cgpio = data;
+
+	if (cgpio->registered || cgpio->quirks->skip_init) {
+		cdns_gpio_write_valid(cgpio, CDNS_GPIO_BYPASS_MODE,
+				      cgpio->bypass_orig);
+		return;
+	}
+
+	cdns_gpio_write_valid(cgpio, CDNS_GPIO_OUTPUT_VALUE,
+			      cgpio->output_value_orig);
+	cdns_gpio_write_valid(cgpio, CDNS_GPIO_OUTPUT_EN,
+			      cgpio->output_en_orig);
+	cdns_gpio_write_valid(cgpio, CDNS_GPIO_DIRECTION_MODE,
+			      cgpio->direction_orig);
+	cdns_gpio_write_valid(cgpio, CDNS_GPIO_BYPASS_MODE,
+			      cgpio->bypass_orig);
+}
