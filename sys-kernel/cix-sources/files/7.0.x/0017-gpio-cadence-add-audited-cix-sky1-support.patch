+				  bool enable, u32 wake_mask)
+{
+	unsigned long flags;
+	int ret;
+
+	raw_spin_lock_irqsave(&cdns_gpio_pdc_lock, flags);
+	ret = cdns_gpio_smc_pdc_wake(cgpio, enable, wake_mask);
+	raw_spin_unlock_irqrestore(&cdns_gpio_pdc_lock, flags);
+
+	return ret;
+}
+#endif
