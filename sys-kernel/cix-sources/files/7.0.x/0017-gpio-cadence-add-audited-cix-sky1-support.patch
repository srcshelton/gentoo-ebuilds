+static int cdns_gpio_irq_set_wake(struct irq_data *d, unsigned int enable)
+{
+	struct gpio_chip *chip = irq_data_get_irq_chip_data(d);
+	struct cdns_gpio_chip *cgpio = gpiochip_get_data(chip);
+	unsigned long flags;
+	u32 mask = BIT(irqd_to_hwirq(d));
+
+	raw_spin_lock_irqsave(&cgpio->wake_lock, flags);
+	if (enable)
+		cgpio->wake_active |= mask;
+	else
+		cgpio->wake_active &= ~mask;
+	cgpio->wake_active &= cgpio->valid_mask;
+	raw_spin_unlock_irqrestore(&cgpio->wake_lock, flags);
+
+	return 0;
+}
