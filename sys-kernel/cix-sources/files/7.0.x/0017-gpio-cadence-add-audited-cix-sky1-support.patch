+static int cdns_gpio_clear_pdc_wake(struct cdns_gpio_chip *cgpio)
+{
+	unsigned long flags;
+	int disable_ret;
+	int clear_ret;
+
+	raw_spin_lock_irqsave(&cdns_gpio_pdc_lock, flags);
+	clear_ret = cdns_gpio_smc_pdc_wake(cgpio, true, 0);
+	disable_ret = cdns_gpio_smc_pdc_wake(cgpio, false, 0);
+	raw_spin_unlock_irqrestore(&cdns_gpio_pdc_lock, flags);
+
+	return clear_ret ?: disable_ret;
+}
