+#ifdef CONFIG_HAVE_ARM_SMCCC
+static int cdns_gpio_smc_pdc_wake(struct cdns_gpio_chip *cgpio,
+				  bool enable, u32 wake_mask)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_smc(SKY1_SIP_GPIO_PDC, SKY1_SIP_GPIO_PDC_SET_WAKE,
+		      cgpio->pdc_hwirq, enable, wake_mask, 0, 0, 0, &res);
+
+	if (!res.a0)
+		return 0;
+	if ((long)res.a0 == SMCCC_RET_NOT_SUPPORTED)
+		return -EOPNOTSUPP;
+
+	return -EIO;
+}
