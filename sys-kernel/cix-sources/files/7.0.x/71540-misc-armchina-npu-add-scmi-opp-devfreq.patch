 #include <linux/string.h>
@@ -69,6 +71,290 @@ static void sky1_priv_release(struct cix_aipu_priv *priv)
 	mutex_unlock(&cix_aipu_lock);
 }
 
+#if IS_REACHABLE(CONFIG_PM_DEVFREQ)
+static int sky1_npu_devfreq_target(struct device *dev, unsigned long *freq,
+				   u32 flags)
+{
+	struct cix_aipu_priv *priv = sky1_priv_get(dev);
+	struct dev_pm_opp *opp;
+	unsigned long previous;
+	int ret;
+
+	if (!priv || !priv->opp_pmdomain)
+		return -ENODEV;
+
+	opp = devfreq_recommended_opp(dev, freq, flags);
+	if (IS_ERR(opp))
+		return PTR_ERR(opp);
+	dev_pm_opp_put(opp);
+
+	opp = dev_pm_opp_find_freq_exact(priv->opp_pmdomain, *freq, true);
+	if (IS_ERR(opp))
+		return PTR_ERR(opp);
+	dev_pm_opp_put(opp);
+
+	previous = READ_ONCE(priv->desired_freq);
+	ret = dev_pm_opp_set_rate(priv->opp_pmdomain, *freq);
+	if (!ret)
+		WRITE_ONCE(priv->desired_freq, *freq);
+
+	dev_dbg(dev, "target=%lu, previous=%lu, desired=%lu\n",
+		*freq, previous, READ_ONCE(priv->desired_freq));
+
+	return ret;
+}
+
+static int sky1_npu_devfreq_get_cur_freq(struct device *dev,
+					 unsigned long *freq)
+{
+	struct cix_aipu_priv *priv = sky1_priv_get(dev);
+
+	if (!priv)
+		return -ENODEV;
+
+	*freq = READ_ONCE(priv->desired_freq);
+	dev_dbg(dev, "desired frequency: %lu\n", *freq);
+
+	return 0;
+}
+
+static int sky1_npu_devfreq_get_dev_status(struct device *dev,
+					   struct devfreq_dev_status *stat)
+{
+	struct cix_aipu_priv *priv = sky1_priv_get(dev);
+
+	if (!priv)
+		return -ENODEV;
+
+	memset(stat, 0, sizeof(*stat));
+	stat->current_frequency = READ_ONCE(priv->desired_freq);
+
+	return 0;
+}
+
+static void sky1_npu_remove_consumer_opps(struct cix_aipu_priv *priv)
+{
+	struct devfreq_dev_profile *profile = &priv->devfreq_profile;
+
+	while (priv->synthetic_opp_count) {
+		priv->synthetic_opp_count--;
+		dev_pm_opp_remove(priv->dev,
+				  profile->freq_table[priv->synthetic_opp_count]);
+	}
+
+	kfree(profile->freq_table);
+	memset(profile, 0, sizeof(*profile));
+	WRITE_ONCE(priv->desired_freq, 0);
+}
+
+static void sky1_npu_devfreq_remove(struct device *dev,
+				    struct cix_aipu_priv *priv)
+{
+	if (priv->opp_notifier_registered) {
+		devfreq_unregister_opp_notifier(dev, priv->devfreq);
+		priv->opp_notifier_registered = false;
+	}
+
+	if (priv->devfreq) {
+		devfreq_remove_device(priv->devfreq);
+		priv->devfreq = NULL;
+	}
+
+	sky1_npu_remove_consumer_opps(priv);
+
+	if (priv->opp_dl) {
+		device_link_del(priv->opp_dl);
+		priv->opp_dl = NULL;
+	}
+	if (priv->opp_pmdomain) {
+		dev_pm_domain_detach(priv->opp_pmdomain, true);
+		priv->opp_pmdomain = NULL;
+	}
+}
+
+static bool sky1_npu_devfreq_error_is_fatal(int ret)
+{
+	return ret == -EPROBE_DEFER || ret == -ENOMEM || ret == -ENOSPC;
+}
+
+static int sky1_npu_devfreq_fail(struct device *dev,
+				 struct cix_aipu_priv *priv, int ret,
+				 const char *reason)
+{
+	sky1_npu_devfreq_remove(dev, priv);
+
+	if (sky1_npu_devfreq_error_is_fatal(ret))
+		return dev_err_probe(dev, ret, "%s\n", reason);
+
+	dev_info(dev, "%s (%pe); using firmware-default fixed performance\n",
+		 reason, ERR_PTR(ret));
+	return 0;
+}
+
+static int sky1_npu_read_opp_table(struct device *table_dev,
+				   struct device *supplier,
+				   unsigned long *freq_table, int count)
+{
+	struct dev_pm_opp *opp;
+	unsigned long freq = 0;
+	int ret;
+	int i;
+
+	for (i = 0; i < count; i++) {
+		opp = dev_pm_opp_find_freq_ceil(table_dev, &freq);
+		if (IS_ERR(opp))
+			return PTR_ERR(opp);
+		freq = dev_pm_opp_get_freq(opp);
+		dev_pm_opp_put(opp);
+		if (!freq)
+			return -EINVAL;
+
+		if (supplier) {
+			opp = dev_pm_opp_find_freq_exact(supplier, freq, true);
+			if (IS_ERR(opp))
+				return PTR_ERR(opp);
+			dev_pm_opp_put(opp);
+		}
+
+		freq_table[i] = freq;
+		if (i + 1 < count && ++freq == 0)
+			return -ERANGE;
+	}
+
+	ret = dev_pm_opp_get_opp_count(table_dev);
+	return ret == count ? 0 : -EAGAIN;
+}
+
+static int sky1_npu_add_consumer_opps(struct cix_aipu_priv *priv,
+				      int supplier_count)
+{
+	struct devfreq_dev_profile *profile = &priv->devfreq_profile;
+	int ret;
+	int i;
+
+	ret = sky1_npu_read_opp_table(priv->opp_pmdomain, NULL,
+				      profile->freq_table, supplier_count);
+	if (ret)
+		return ret;
+
+	/* Do not merge a table which appeared after the initial count. */
+	if (dev_pm_opp_get_opp_count(priv->dev) != -ENODEV)
+		return -EAGAIN;
+
+	for (i = 0; i < supplier_count; i++) {
+		ret = dev_pm_opp_add(priv->dev, profile->freq_table[i], 0);
+		if (ret)
+			return ret;
+		priv->synthetic_opp_count++;
+	}
+
+	if (dev_pm_opp_get_opp_count(priv->dev) != supplier_count ||
+	    dev_pm_opp_get_opp_count(priv->opp_pmdomain) != supplier_count)
+		return -EAGAIN;
+
+	return 0;
+}
+
+static int sky1_npu_devfreq_init(struct device *dev,
+				 struct cix_aipu_priv *priv)
+{
+	struct devfreq_dev_profile *profile = &priv->devfreq_profile;
+	int consumer_count;
+	int profile_count;
+	int supplier_count;
+	int ret;
+
+	priv->opp_pmdomain = dev_pm_domain_attach_by_name(dev, "perf");
+	if (IS_ERR(priv->opp_pmdomain)) {
+		ret = PTR_ERR(priv->opp_pmdomain);
+		priv->opp_pmdomain = NULL;
+		return sky1_npu_devfreq_fail(dev, priv, ret,
+					      "failed to attach NPU perf domain");
+	}
+	if (!priv->opp_pmdomain)
+		return sky1_npu_devfreq_fail(dev, priv, -ENODEV,
+						      "NPU perf domain is unavailable");
+
+	priv->opp_dl = device_link_add(dev, priv->opp_pmdomain,
+				       DL_FLAG_RPM_ACTIVE |
+				       DL_FLAG_PM_RUNTIME |
+				       DL_FLAG_STATELESS);
+	if (IS_ERR_OR_NULL(priv->opp_dl)) {
+		ret = priv->opp_dl ? PTR_ERR(priv->opp_dl) : -ENOMEM;
+		priv->opp_dl = NULL;
+		return sky1_npu_devfreq_fail(dev, priv, ret,
+					      "failed to link NPU perf domain");
+	}
+
+	supplier_count = dev_pm_opp_get_opp_count(priv->opp_pmdomain);
+	if (supplier_count <= 0) {
+		ret = supplier_count ?: -ENODEV;
+		return sky1_npu_devfreq_fail(dev, priv, ret,
+					      "NPU perf domain has no usable OPP table");
+	}
+
+	consumer_count = dev_pm_opp_get_opp_count(dev);
+	if (consumer_count > 0) {
+		profile_count = consumer_count;
+	} else if (consumer_count == -ENODEV) {
+		profile_count = supplier_count;
+	} else {
+		ret = consumer_count ?: -EINVAL;
+		return sky1_npu_devfreq_fail(dev, priv, ret,
+					      "NPU consumer OPP table is unusable");
+	}
+
+	profile->freq_table = kcalloc(profile_count,
+				      sizeof(*profile->freq_table), GFP_KERNEL);
+	if (!profile->freq_table)
+		return sky1_npu_devfreq_fail(dev, priv, -ENOMEM,
+					      "failed to allocate NPU OPP table");
+
+	if (consumer_count > 0) {
+		ret = sky1_npu_read_opp_table(dev, priv->opp_pmdomain,
+					      profile->freq_table, consumer_count);
+		if (!ret && dev_pm_opp_get_opp_count(priv->opp_pmdomain) !=
+			    supplier_count)
+			ret = -EAGAIN;
+	} else {
+		ret = sky1_npu_add_consumer_opps(priv, supplier_count);
+	}
+	if (ret)
+		return sky1_npu_devfreq_fail(dev, priv, ret,
+					      "NPU OPP metadata is inconsistent");
+
+	profile->initial_freq = profile->freq_table[profile_count - 1];
+	profile->max_state = profile_count;
+	profile->polling_ms = 50;
+	profile->target = sky1_npu_devfreq_target;
+	profile->get_dev_status = sky1_npu_devfreq_get_dev_status;
+	profile->get_cur_freq = sky1_npu_devfreq_get_cur_freq;
+	WRITE_ONCE(priv->desired_freq, profile->initial_freq);
+
+	priv->devfreq = devfreq_add_device(dev, profile,
+					   DEVFREQ_GOV_USERSPACE, NULL);
+	if (IS_ERR(priv->devfreq)) {
+		ret = PTR_ERR(priv->devfreq);
+		priv->devfreq = NULL;
+		return sky1_npu_devfreq_fail(dev, priv, ret,
+					      "failed to add NPU devfreq device");
+	}
+
+	ret = devfreq_register_opp_notifier(dev, priv->devfreq);
+	if (ret)
+		return sky1_npu_devfreq_fail(dev, priv, ret,
+					      "failed to register NPU OPP notifier");
+	priv->opp_notifier_registered = true;
+
+	ret = dev_pm_opp_set_rate(priv->opp_pmdomain, profile->initial_freq);
+	if (ret)
+		return sky1_npu_devfreq_fail(dev, priv, ret,
+					      "failed to select initial NPU OPP");
+
+	return 0;
+}
+#endif
