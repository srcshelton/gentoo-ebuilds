The Linlon display driver accessed registers and enabled interrupts after an aclk enable failure.  Propagate the clock error from probe and resume so hardware remains untouched while unclocked.

diff --git a/drivers/gpu/drm/cix/linlon-dp/linlondp_dev.c b/drivers/gpu/drm/cix/linlon-dp/linlondp_dev.c
--- a/drivers/gpu/drm/cix/linlon-dp/linlondp_dev.c
+++ b/drivers/gpu/drm/cix/linlon-dp/linlondp_dev.c
@@ -449,7 +449,10 @@ struct linlondp_dev *linlondp_dev_create(struct device *dev)
 		goto err_cleanup;
 	}
 
-	clk_prepare_enable(mdev->aclk);
+	err = clk_prepare_enable(mdev->aclk);
+	if (err)
+		return ERR_PTR(dev_err_probe(dev, err,
+					     "failed to enable aclk\n"));
 #endif
 	pm_runtime_get_sync(mdev->dev);
 	mdev->funcs = linlondp_identify(mdev->reg_base, &mdev->chip);
@@ -588,8 +591,10 @@ int linlondp_dev_resume(struct linlondp_dev *mdev)
 
 #if !IS_ENABLED(CONFIG_DRM_LINLONDP_CLOCK_FIXED)
 	err = clk_prepare_enable(mdev->aclk);
-	if (err)
-		dev_err(mdev->dev, "%s, failed to enable aclk\n", __func__);
+	if (err) {
+		dev_err(mdev->dev, "failed to enable aclk: %d\n", err);
+		return err;
+	}
 #endif
 	mdev->funcs->enable_irq(mdev);
 
