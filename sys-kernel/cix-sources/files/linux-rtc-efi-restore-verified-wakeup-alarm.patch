Linux removed the EFI RTC alarm callbacks because firmware commonly
advertised wakeup services which failed when called.  Radxa Orion O6
firmware instead owns the board HYM8563 and exposes its working alarm only
through those EFI services, so binding the native I2C driver would conflict
with firmware ownership and leaving rtc-efi without alarm operations hides
the only safe userspace interface.

Restore the standard RTC alarm operations, but advertise them only when the
EFI runtime-services mask permits both wakeup calls and a real
GetWakeupTime() probe succeeds.  Use the EFI status conversion for accurate
errors, pass the specification-defined NULL time when disabling an alarm,
and describe the O6/O6N HYM8563's minute-resolution limit to the RTC core.

diff --git a/drivers/rtc/rtc-efi.c b/drivers/rtc/rtc-efi.c
--- a/drivers/rtc/rtc-efi.c
+++ b/drivers/rtc/rtc-efi.c
@@ -10,6 +10,7 @@
 
 #define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
 
+#include <linux/dmi.h>
 #include <linux/kernel.h>
 #include <linux/module.h>
 #include <linux/stringify.h>
@@ -20,6 +21,24 @@
 
 #define EFI_ISDST (EFI_TIME_ADJUST_DAYLIGHT|EFI_TIME_IN_DAYLIGHT)
 
+static const struct dmi_system_id efi_rtc_minute_alarm_systems[] = {
+	{
+		.matches = {
+			DMI_EXACT_MATCH(DMI_SYS_VENDOR,
+					"Radxa Computer (Shenzhen) Co., Ltd."),
+			DMI_EXACT_MATCH(DMI_PRODUCT_NAME, "Radxa Orion O6"),
+		},
+	},
+	{
+		.matches = {
+			DMI_EXACT_MATCH(DMI_SYS_VENDOR,
+					"Radxa Computer (Shenzhen) Co., Ltd."),
+			DMI_EXACT_MATCH(DMI_PRODUCT_NAME, "Radxa Orion O6N"),
+		},
+	},
+	{}
+};
+
 /*
  * returns day of the year [0-365]
  */
@@ -112,6 +131,45 @@ convert_from_efi_time(efi_time_t *eft, struct rtc_time *wtime)
 	return true;
 }
 
+static int efi_read_alarm(struct device *dev, struct rtc_wkalrm *alarm)
+{
+	efi_bool_t enabled, pending;
+	efi_status_t status;
+	efi_time_t eft;
+
+	status = efi.get_wakeup_time(&enabled, &pending, &eft);
+	if (status != EFI_SUCCESS)
+		return efi_status_to_err(status);
+
+	if (!convert_from_efi_time(&eft, &alarm->time))
+		return -EIO;
+
+	alarm->enabled = enabled;
+	alarm->pending = pending;
+
+	return rtc_valid_tm(&alarm->time);
+}
+
+static int efi_set_alarm(struct device *dev, struct rtc_wkalrm *alarm)
+{
+	efi_time_t eft, *time = NULL;
+
+	if (alarm->enabled) {
+		convert_to_efi_time(&alarm->time, &eft);
+		time = &eft;
+	}
+
+	return efi_status_to_err(efi.set_wakeup_time(alarm->enabled, time));
+}
+
+static int efi_alarm_irq_enable(struct device *dev, unsigned int enabled)
+{
+	if (enabled)
+		return 0;
+
+	return efi_status_to_err(efi.set_wakeup_time(false, NULL));
+}
+
 static int efi_read_time(struct device *dev, struct rtc_time *tm)
 {
 	efi_status_t status;
@@ -183,12 +241,16 @@ static int efi_procfs(struct device *dev, struct seq_file *seq)
 static const struct rtc_class_ops efi_rtc_ops = {
 	.read_time	= efi_read_time,
 	.set_time	= efi_set_time,
+	.read_alarm	= efi_read_alarm,
+	.set_alarm	= efi_set_alarm,
+	.alarm_irq_enable = efi_alarm_irq_enable,
 	.proc		= efi_procfs,
 };
 
 static int __init efi_rtc_probe(struct platform_device *dev)
 {
 	struct rtc_device *rtc;
+	efi_bool_t enabled, pending;
 	efi_time_t eft;
 	efi_time_cap_t cap;
 
@@ -203,7 +265,15 @@ static int __init efi_rtc_probe(struct platform_device *dev)
 	platform_set_drvdata(dev, rtc);
 
 	rtc->ops = &efi_rtc_ops;
-	clear_bit(RTC_FEATURE_ALARM, rtc->features);
+	clear_bit(RTC_FEATURE_UPDATE_INTERRUPT, rtc->features);
+	if (efi_rt_services_supported(EFI_RT_SUPPORTED_WAKEUP_SERVICES) &&
+	    efi.get_wakeup_time(&enabled, &pending, &eft) == EFI_SUCCESS) {
+		set_bit(RTC_FEATURE_ALARM_WAKEUP_ONLY, rtc->features);
+		if (dmi_check_system(efi_rtc_minute_alarm_systems))
+			set_bit(RTC_FEATURE_ALARM_RES_MINUTE, rtc->features);
+	} else {
+		clear_bit(RTC_FEATURE_ALARM, rtc->features);
+	}
 
 	device_init_wakeup(&dev->dev, true);
 
