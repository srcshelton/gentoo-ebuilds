@@ -599,6 +599,46 @@ int dev_pm_genpd_set_performance_state(struct device *dev, unsigned int state)
 }
 EXPORT_SYMBOL_GPL(dev_pm_genpd_set_performance_state);
 
+/**
+ * dev_pm_genpd_get_performance_state - Get the power domain's current state.
+ * @dev: Device attached to the power domain.
+ * @state: Current provider-reported performance state on success.
+ *
+ * Providers that support readback return the performance state currently
+ * applied by the hardware or its controlling firmware.  This is distinct from
+ * the state requested by an individual consumer and from genpd's aggregate
+ * cached request.
+ *
+ * It is assumed that callers guarantee that the genpd will not be detached
+ * while this routine is running.
+ *
+ * Return: 0 on success, -EOPNOTSUPP when the provider has no readback method,
+ * or another negative error code on failure.
+ */
+int dev_pm_genpd_get_performance_state(struct device *dev,
+				       unsigned int *state)
+{
+	struct generic_pm_domain *genpd;
+	int ret;
+
+	if (!state)
+		return -EINVAL;
+
+	genpd = dev_to_genpd_safe(dev);
+	if (!genpd)
+		return -ENODEV;
+
+	if (!genpd->get_performance_state)
+		return -EOPNOTSUPP;
+
+	genpd_lock(genpd);
+	ret = genpd->get_performance_state(genpd, state);
+	genpd_unlock(genpd);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(dev_pm_genpd_get_performance_state);
