diff --git a/drivers/misc/armchina-npu-r2p0/Kconfig b/drivers/misc/armchina-npu-r2p0/Kconfig
new file mode 100644
--- /dev/null
+++ b/drivers/misc/armchina-npu-r2p0/Kconfig
@@ -0,0 +1,21 @@
+# SPDX-License-Identifier: GPL-2.0-only
+
+config ARMCHINA_NPU_R2P0
+	tristate "ArmChina Zhouyi NPU legacy R2P0 backend"
+	depends on ARM64
+	depends on ARCH_CIX || COMPILE_TEST
+	depends on ACPI || OF
+	depends on DMA_SHARED_BUFFER
+	depends on ARMCHINA_NPU != y
+	depends on m || !ARMCHINA_NPU
+	select DEVFREQ_GOV_USERSPACE if PM_DEVFREQ
+	help
+	  Support the CIX Sky1 Zhouyi V3 NPU through the version-matched
+	  R2P0 kernel interface used by cix-noe-umd 2.x and libnoe 0.6.x.
+
+	  This is a separate backend because translating R2P0 requests into the
+	  newer R2P1 scheduler does not produce a working command stream.  When
+	  both backends are modules, armchina_npu is automatically selected for
+	  the ACPI device; unload it before explicitly loading
+	  armchina_npu_r2p0.  Both backends expose /dev/aipu and cannot drive the
+	  same device concurrently.
