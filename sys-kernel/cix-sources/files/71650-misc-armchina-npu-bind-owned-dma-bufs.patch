+int aipu_mm_unbind_dma_buf(struct aipu_memory_manager *mm, u64 pa,
+			   struct file *filp)
+{
+	struct aipu_file_ctx *owner = aipu_file_ctx(filp);
+	struct aipu_mem_region *reg;
+	int ret;
+
+	if (!mm || !owner || !pa)
+		return -EINVAL;
+	mutex_lock(&mm->lock);
+	reg = aipu_mm_find_region_no_lock(mm, pa, "unbind dma-buf");
+	if (!reg || reg->base_iova != pa || !reg->borrowed_backing)
+		ret = -EINVAL;
+	else if (reg->owner != owner)
+		ret = -EPERM;
+	else
+		ret = aipu_mm_direct_free(mm, reg, true);
+	mutex_unlock(&mm->lock);
+	return ret;
+}
