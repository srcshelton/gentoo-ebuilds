+int aipu_mm_bind_exported_dma_buf(struct aipu_memory_manager *mm,
+				  struct aipu_bind_buf_desc *desc,
+				  struct file *filp, u64 source_pa,
+				  struct aipu_dma_buf_binding *binding)
+{
+	struct aipu_file_ctx *owner = aipu_file_ctx(filp);
+	struct genpool_data_align data = { .align = PAGE_SIZE };
+	struct aipu_mem_region_obj *obj = NULL;
+	struct aipu_iova_arena *arena;
+	struct aipu_iova_pool *pool;
+	struct aipu_mem_region *source;
+	struct aipu_mem_region *reg;
+	unsigned long iova;
+	unsigned long page;
+	int ret = 0;
+
+	if (!mm || !desc || !owner || !binding || !desc->exec_id ||
+	    !mm->iova_arenas_ready)
+		return -EINVAL;
+
+	mutex_lock(&mm->lock);
+	source = aipu_mm_find_region_no_lock(mm, source_pa, "bind source");
+	if (!source || source->base_iova != source_pa || source->owner ||
+	    source->mapping_kind != AIPU_MAPPING_IOVA_ARENA ||
+	    !source->phys_pages || !source->phys_page_count ||
+	    source->phys_page_count != source->bytes >> PAGE_SHIFT) {
+		ret = source ? -EOPNOTSUPP : -EINVAL;
+		goto unlock;
+	}
+	arena = aipu_mm_find_iova_arena_no_lock(mm, owner, desc->exec_id);
+	if (!arena) {
+		ret = -ENOENT;
+		goto unlock;
+	}
+	iova = gen_pool_alloc_algo(arena->allocator, source->bytes,
+				   gen_pool_first_fit_align, &data);
+	if (!iova) {
+		ret = -ENOSPC;
+		goto unlock;
+	}
+
+	obj = aipu_mm_create_region_object(mm, AIPU_MEM_REGION_TYPE_MEMORY,
+					   0, 0, 0, owner, false);
+	if (!obj) {
+		ret = -ENOMEM;
+		goto free_iova;
+	}
+	reg = obj->reg;
+	reg->bytes = source->bytes;
+	reg->base_iova = iova;
+	reg->base_pa = iova;
+	reg->base_va = source->base_va;
+	reg->mapping_kind = AIPU_MAPPING_IOVA_ARENA;
+	reg->arena = arena;
+	reg->arena_offset = iova - mm->iova_pools[arena->asid].state.addr;
+	reg->phys_pages = source->phys_pages;
+	reg->phys_page_count = source->phys_page_count;
+	reg->borrowed_backing = true;
+	reg->binding = binding;
+	reg->locked = true;
+	arena->mapped_bytes += reg->bytes;
+	arena->mapping_count++;
+
+	pool = &mm->iova_pools[arena->asid];
+	aipu_mm_sync_arena_region(source, 0, source->bytes, false);
+	for (page = 0; page < reg->phys_page_count; page++) {
+		ret = dma_iova_link(mm->dev, &pool->state,
+				    page_to_phys(reg->phys_pages[page]),
+				    reg->arena_offset + (page << PAGE_SHIFT),
+				    PAGE_SIZE, DMA_BIDIRECTIONAL, 0);
+		if (ret)
+			goto destroy_obj;
+		reg->linked_page_count++;
+	}
+	ret = dma_iova_sync(mm->dev, &pool->state, reg->arena_offset,
+			    reg->bytes);
+	if (ret)
+		goto destroy_obj;
+	aipu_mm_sync_arena_region(reg, 0, reg->bytes, true);
+
+	list_add_tail(&obj->list, &mm->mem.head->list);
+	desc->pa = reg->base_iova;
+	mutex_unlock(&mm->lock);
+	return 0;
+
+destroy_obj:
+	reg->binding = NULL;
+	aipu_mm_destroy_region_object(mm, obj);
+	aipu_mm_sync_arena_region(source, 0, source->bytes, true);
+	mutex_unlock(&mm->lock);
+	return ret;
+
+free_iova:
+	gen_pool_free(arena->allocator, iova, source->bytes);
+unlock:
+	mutex_unlock(&mm->lock);
+	return ret;
+}
