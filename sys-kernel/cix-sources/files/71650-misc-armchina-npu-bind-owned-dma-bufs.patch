+int aipu_bind_dma_buf(struct aipu_memory_manager *mm,
+		      struct aipu_bind_buf_desc *desc, struct file *filp)
+{
+	struct aipu_dma_buf_binding *binding;
+	struct aipu_dma_buf_priv *priv;
+	struct dma_buf *dmabuf;
+	int ret;
+
+	if (!mm || !desc || !filp || desc->fd > INT_MAX || !desc->exec_id)
+		return -EINVAL;
+
+	dmabuf = dma_buf_get(desc->fd);
+	if (IS_ERR(dmabuf))
+		return PTR_ERR(dmabuf);
+	if (dmabuf->ops != &aipu_dma_buf_ops) {
+		ret = -EOPNOTSUPP;
+		goto put_dmabuf;
+	}
+	priv = dmabuf->priv;
+	if (!priv || priv->mm != mm || aipu_priv_is_removing(priv->aipu)) {
+		ret = -EXDEV;
+		goto put_dmabuf;
+	}
+	if (!try_module_get(THIS_MODULE)) {
+		ret = -ENODEV;
+		goto put_dmabuf;
+	}
+	binding = kzalloc(sizeof(*binding), GFP_KERNEL);
+	if (!binding) {
+		module_put(THIS_MODULE);
+		ret = -ENOMEM;
+		goto put_dmabuf;
+	}
+	binding->dmabuf = dmabuf;
+	INIT_WORK(&binding->release_work, aipu_dma_buf_binding_release_work);
+
+	ret = aipu_mm_bind_exported_dma_buf(mm, desc, filp, priv->dev_pa,
+					    binding);
+	if (ret) {
+		kfree(binding);
+		module_put(THIS_MODULE);
+		goto put_dmabuf;
+	}
+	return 0;
+
+put_dmabuf:
+	dma_buf_put(dmabuf);
+	return ret;
+}
