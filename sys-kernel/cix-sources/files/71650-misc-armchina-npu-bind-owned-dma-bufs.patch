+static void aipu_dma_buf_binding_release_work(struct work_struct *work)
+{
+	struct aipu_dma_buf_binding *binding = container_of(work,
+		struct aipu_dma_buf_binding, release_work);
+
+	dma_buf_put(binding->dmabuf);
+	kfree(binding);
+	module_put(THIS_MODULE);
+}
+
+void aipu_dma_buf_release_binding(struct aipu_dma_buf_binding *binding)
+{
+	if (WARN_ON(!binding || !schedule_work(&binding->release_work)))
+		return;
+}
