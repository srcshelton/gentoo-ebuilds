-				INTERRUPT_GROUP_ID_REG(id)));
-		info.cluster_id = GET_INTR_CLUSTER_ID_V3_2(status);
-		info.core_id = GET_INTR_CORE_ID_V3_2(status);
-		info.tec_id = GET_INTR_TEC_ID_V3_2(status);
-
-		if (IS_TEC_IRQ_V3_2(status) && (IS_DONE_IRQ_V3_2(status)))
-			continue;
-
-		//check if do global soft reset
-		if (IS_RESET(status))
-			zhouyi_v3_2_soft_reset_type(cluster, &info, status);
-		else if (IS_TEC_IRQ_V3_2(status) && IS_FAULT_IRQ_V3_2(status))
-			dev_err(cluster->dev, "TEC Fault Error.\n");
-		else if (IS_TEC_IRQ_V3_2(status) && IS_EXCEPTION_IRQ_V3_2(status))
-			dev_err(cluster->dev, "TEC Exception Error.\n");
-		else if (IS_SIGNAL_IRQ_V3_2(status) && IS_EXCEPTION_SIGNAL_V3_2(info.sig_flag))
-			dev_err(cluster->dev, "HW/SW Exception Signal.\n");
-
-		aipu_job_manager_irq_upper_half(cluster, status, &info);
-		aipu_irq_schedulework(cluster->irq_obj);
-	}
-	aipu_write32(cluster->reg, TSM_INTERRUPT_STATUS_REG, irqs);
-	irqs = IS_ALL_CLEAR_IDLE(aipu_read32(cluster->reg, TSM_INTERRUPT_STATUS_REG));
-	if(irqs)
-		dev_warn(cluster->dev, "Clear entry not idle 0x%lx.\n", irqs);
-
-	return IRQ_HANDLED;
-}
