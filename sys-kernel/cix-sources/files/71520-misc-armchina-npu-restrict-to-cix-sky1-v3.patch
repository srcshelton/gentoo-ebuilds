-	/* NOTE: this is a global hardware reset */
-	spin_lock_irqsave(&cluster->io_lock, flags);
-	aipu->ops->global_hw_reset(aipu);
-	cluster->ops->initialize(cluster);
-	spin_unlock_irqrestore(&cluster->io_lock, flags);
