-#ifdef CONFIG_ARMCHINA_NPU_ARCH_V1
-	if (version == AIPU_ISA_VERSION_ZHOUYI_V1) {
-		core->max_sched_num = ZHOUYI_V1_MAX_SCHED_JOB_NUM;
