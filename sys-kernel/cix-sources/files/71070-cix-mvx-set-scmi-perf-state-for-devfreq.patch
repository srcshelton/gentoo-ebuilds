+static int mvx_devfreq_read_perf_state(struct mvx_dev_ctx *ctx,
+				       unsigned int *level,
+				       unsigned long *freq)
+{
+	struct dev_pm_opp *opp;
+	int ret;
+
+	if (!ctx->opp_pmdomain)
+		return -ENODEV;
+
+	ret = dev_pm_genpd_get_performance_state(ctx->opp_pmdomain, level);
+	if (ret)
+		return ret;
+
+	opp = dev_pm_opp_find_level_exact(ctx->opp_pmdomain, *level);
+	if (IS_ERR(opp))
+		return PTR_ERR(opp);
+
+	*freq = dev_pm_opp_get_freq(opp);
+	dev_pm_opp_put(opp);
+
+	return *freq ? 0 : -EINVAL;
+}
+
+static int mvx_devfreq_apply_perf_state(struct mvx_dev_ctx *ctx,
+					unsigned int target_level,
+					unsigned long target_freq,
+					unsigned long *actual_freq)
+{
+	unsigned int actual_level;
+	int read_ret;
+	int ret;
+
+	ret = dev_pm_genpd_set_performance_state(ctx->opp_pmdomain,
+						 target_level);
+	if (ret)
+		return ret;
+
+	/*
+	 * Generic power domains defer a performance-state request while the
+	 * attached device is runtime suspended. The request is restored before
+	 * the device resumes, so the provider must still report the previous
+	 * hardware level here. Accept the queued target without polling; active
+	 * devices continue through the provider-confirmed path below.
+	 */
+	if (pm_runtime_suspended(ctx->opp_pmdomain)) {
+		*actual_freq = target_freq;
+		return 0;
+	}
+
+	/*
+	 * Sky1 firmware can acknowledge a performance-state request before a
+	 * following read reports the new level. Poll for bounded completion so
+	 * devfreq never publishes the previous frequency as the applied result.
+	 */
+	ret = read_poll_timeout(mvx_devfreq_read_perf_state, read_ret,
+				read_ret || actual_level == target_level,
+				MVX_DEVFREQ_POLL_INTERVAL_US,
+				MVX_DEVFREQ_TRANSITION_TIMEOUT_US, false,
+				ctx, &actual_level, actual_freq);
+	if (read_ret)
+		return read_ret;
+
+	return ret;
+}
+
+static int mvx_devfreq_set_perf_state(struct mvx_dev_ctx *ctx,
+				      unsigned long *freq)
+{
+	struct dev_pm_opp *opp;
+	unsigned long previous_freq;
+	unsigned long rollback_freq;
+	unsigned long target_freq = *freq;
+	unsigned int previous_level;
+	unsigned int target_level;
+	int rollback_ret;
+	int ret;
+
+	ret = mvx_devfreq_read_perf_state(ctx, &previous_level,
+					  &previous_freq);
+	if (ret)
+		return ret;
+
+	opp = dev_pm_opp_find_freq_exact(ctx->opp_pmdomain, target_freq, true);
+	if (IS_ERR(opp))
+		return PTR_ERR(opp);
+
+	target_level = dev_pm_opp_get_level(opp);
+	dev_pm_opp_put(opp);
+	if (target_level == OPP_LEVEL_UNSET) {
+		dev_err(ctx->dev,
+			"perf domain OPP for %lu Hz has no performance level\n",
+			target_freq);
+		return -EINVAL;
+	}
+
+	ret = mvx_devfreq_apply_perf_state(ctx, target_level, target_freq, freq);
+	if (!ret)
+		return 0;
+
+	rollback_ret = mvx_devfreq_apply_perf_state(ctx, previous_level,
+						    previous_freq,
+						    &rollback_freq);
+	if (rollback_ret)
+		dev_warn(ctx->dev,
+			 "failed to restore perf state %u after transition error: %d\n",
+			 previous_level, rollback_ret);
+
+	dev_err(ctx->dev, "failed to apply perf state %u for %lu Hz: %d\n",
+		target_level, target_freq, ret);
+	return ret;
+}
+
+static int mvx_devfreq_restore_initial_state(struct mvx_dev_ctx *ctx)
+{
+	struct dev_pm_opp *opp;
+	unsigned long actual_freq;
+	unsigned long initial_freq = ctx->devfreq_profile.initial_freq;
+	unsigned int initial_level;
+	int put_ret;
+	int ret;
+
+	if (!ctx->opp_pmdomain || !initial_freq)
+		return 0;
+
+	opp = dev_pm_opp_find_freq_exact(ctx->opp_pmdomain, initial_freq, true);
+	if (IS_ERR(opp))
+		return PTR_ERR(opp);
+
+	initial_level = dev_pm_opp_get_level(opp);
+	dev_pm_opp_put(opp);
+	if (initial_level == OPP_LEVEL_UNSET)
+		return -EINVAL;
+
+	/*
+	 * A suspended generic power-domain consumer only queues a new vote. Resume
+	 * this virtual SCMI consumer so teardown restores the provider-confirmed
+	 * state which was active before MVX registered, then balance the reference.
+	 */
+	ret = pm_runtime_resume_and_get(ctx->opp_pmdomain);
+	if (ret < 0)
+		return ret;
+
+	ret = mvx_devfreq_apply_perf_state(ctx, initial_level, initial_freq,
+					   &actual_freq);
+	put_ret = pm_runtime_put_sync(ctx->opp_pmdomain);
+	if (!ret && put_ret < 0)
+		ret = put_ret;
+
+	return ret;
+}
